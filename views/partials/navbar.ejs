<!-- Navbar -->
<style>

/* ── NAVBAR STYLE ── */
.navbar {
    background-color: var(--bg-dark);
    padding: 15px 50px;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.logo-img {
    height: 60px;
    width: auto;
    max-width: 160px;
    object-fit: contain;
}

.nav-link {
    color: #ffffff !important;
    font-size: 0.85rem;
    font-weight: 400;
    margin: 0 15px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 0 15px !important;
    transition: opacity 0.3s ease;
}

.nav-link:hover {
    opacity: 0.7;
}

.nav-icons a {
    color: #fff;
    margin-left: 20px;
    font-size: 1.1rem;
    text-decoration: none;
}

.count-badge {
    position: absolute;
    top: -10px;
    right: -10px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #f70000;
    color: #ffffff;
    font-size: 10px;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* ── TABLET AND MOBILE ── */
@media (max-width: 991.98px) {
    .navbar {
        padding: 12px 24px;
    }

    .logo-img {
        height: 48px;
    }

    .navbar .navbar-collapse {
        width: 100%;
        padding-top: 12px;
    }

    .navbar .navbar-nav {
        width: 100%;
        align-items: center;
        margin-right: 0 !important;
    }

    .nav-link {
        margin: 7px 0;
        padding: 8px 12px !important;
        font-size: 0.82rem;
    }

    .nav-icons {
        gap: 24px;
        padding: 12px 0;
    }

    .nav-icons a {
        margin-left: 0;
        font-size: 1.15rem;
    }
}

/* ── SMALL MOBILE ── */
@media (max-width: 480px) {
    .navbar {
        padding: 10px 14px;
    }

    .logo-img {
        height: 40px;
        max-width: 130px;
    }

    .navbar .container-fluid {
        padding-left: 0;
        padding-right: 0;
    }

    .navbar-toggler {
        padding: 4px 7px;
    }

    .navbar .navbar-collapse {
        padding-top: 8px;
    }

    .nav-link {
        font-size: 0.78rem;
        letter-spacing: 1px;
    }

    .nav-icons {
        gap: 22px;
    }

    .nav-icons a {
        font-size: 1.05rem;
    }
}

</style>

<nav class="navbar navbar-expand-lg">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            <img src="/images/logo.png" class="logo-img" alt="OneMore Logo">
        </a>
        <button class="navbar-toggler navbar-dark border-0" type="button" data-bs-toggle="collapse"
            data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav mx-auto text-center mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/shop">Shop</a></li>
                <li class="nav-item"><a class="nav-link" href="/contact">Contact Us</a></li>
                <li class="nav-item"><a class="nav-link" href="/about">About Us</a></li>
            </ul>

            <div class="nav-icons d-flex align-items-center justify-content-center mt-3 mt-lg-0">
                <a href="/profile"><i class="fa-regular fa-user"></i></a>
            <a href="/wishlist" class="position-relative">
                <i class="fa-regular fa-heart"></i>
            
                <% if(wishlistCount> 0){ %>
                    <span id="wishlistCountBadge" class="count-badge">
                        <%= wishlistCount %>
                    </span>
                    <% } %>
            </a>

                <a href="/cart" class="position-relative">
                    <i class="fa-solid fa-bag-shopping"></i>
                
                    <% if(cartCount> 0){ %>
                        <span id="cartCountBadge" class="count-badge">
                            <%= cartCount %>
                        </span>
                        <% } %>
                </a>
            </div>
        </div>
    </div>
</nav>