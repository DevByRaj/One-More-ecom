<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Page Not Found | OneMore</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --ink: #1a1a1a;
            --paper: #f0f0eb;
            --signal: #2f5bff;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: var(--ink);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            color: var(--ink);
        }

        /* NAVBAR */

        nav {
            background: var(--ink);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        }

        .nav-inner {
            height: 90px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-img {
            width: 80px;
            height: auto;
        }

        /* MAIN */

        main {
            flex: 1;
            background: var(--paper);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 60px 20px;
            position: relative;
            overflow: hidden;
        }

        /* Subtle dotted grid, like speaker cloth */

        main::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(26, 26, 26, 0.09) 1px, transparent 1px);
            background-size: 18px 18px;
            -webkit-mask-image: radial-gradient(ellipse at center, #000 20%, transparent 75%);
            mask-image: radial-gradient(ellipse at center, #000 20%, transparent 75%);
            pointer-events: none;
        }

        .background-404 {
            position: absolute;
            font-size: 300px;
            font-weight: 700;
            color: rgba(26, 26, 26, 0.04);
            line-height: 1;
            user-select: none;
            pointer-events: none;
            letter-spacing: -15px;
        }

        /* ERROR CARD */

        .error-card {
            width: 100%;
            max-width: 560px;
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 18px;
            padding: 52px 44px 46px;
            text-align: center;
            position: relative;
            z-index: 2;
            box-shadow: 0 1px 0 #fff inset, 0 24px 60px -20px rgba(0, 0, 0, 0.18);
            animation: cardAppear 0.5s ease;
        }

        @keyframes cardAppear {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* TURNTABLE: record spins, tonearm is parked (nothing is playing) */

        .turntable {
            position: relative;
            width: 210px;
            height: 170px;
            margin: 0 auto 26px;
        }

        .vinyl {
            position: absolute;
            left: 0;
            top: 10px;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: repeating-radial-gradient(circle at center, #1a1a1a 0 2px, #2a2a2a 2px 3px);
            box-shadow: 0 14px 28px -8px rgba(0, 0, 0, 0.45), 0 0 0 4px #111;
            animation: spin 5s linear infinite;
        }

        .vinyl::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: 50%;
            background: conic-gradient(transparent 0 18%, rgba(255, 255, 255, 0.16) 25%, transparent 32% 68%, rgba(255, 255, 255, 0.16) 75%, transparent 82%);
        }

        .vinyl-label {
            position: absolute;
            left: 49px;
            top: 59px;
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: var(--signal);
            color: #fff;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 0 2px rgba(255, 255, 255, 0.25) inset;
        }

        .vinyl-label::after {
            content: "";
            position: absolute;
            top: -3px;
            left: 50%;
            width: 5px;
            height: 5px;
            margin-left: -2.5px;
            border-radius: 50%;
            background: #fff;
            opacity: 0;
        }

        .tonearm {
            position: absolute;
            right: 18px;
            top: 8px;
            width: 5px;
            height: 118px;
            border-radius: 5px;
            background: linear-gradient(#d6d6d0, #a9a9a2);
            transform-origin: top center;
            transform: rotate(-8deg);
        }

        .tonearm::before {
            content: "";
            position: absolute;
            top: -10px;
            left: -9px;
            width: 23px;
            height: 23px;
            border-radius: 50%;
            background: #333;
            box-shadow: 0 0 0 3px #d6d6d0;
        }

        .tonearm::after {
            content: "";
            position: absolute;
            bottom: -9px;
            left: -3px;
            width: 11px;
            height: 15px;
            border-radius: 2px;
            background: #333;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* PLAYER STRIP */

        .player {
            background: var(--paper);
            border: 1px solid #e3e3dc;
            border-radius: 12px;
            padding: 14px 18px 10px;
            margin: 0 auto 30px;
            max-width: 400px;
        }

        .player-meta {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            font-size: 11.5px;
            color: #666;
            margin-bottom: 8px;
            text-align: left;
        }

        .player-meta strong {
            color: var(--ink);
            font-weight: 600;
        }

        .player-time {
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
        }

        /* SIGNAL-LOST WAVEFORM */

        .wave {
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .wave span {
            display: block;
            width: 4px;
            border-radius: 4px;
            background: var(--ink);
            transform-origin: center;
            animation: pulse 1.6s ease-in-out infinite alternate;
        }

        .wave span.flat {
            background: #c9c9c2;
            animation: none;
        }

        .wave .dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--signal);
            margin-left: 4px;
            animation: none;
            box-shadow: 0 0 0 5px rgba(47, 91, 255, 0.16);
        }

        @keyframes pulse {
            from {
                transform: scaleY(0.4);
            }

            to {
                transform: scaleY(1);
            }
        }

        /* TEXT */

        .error-title {
            font-size: 22px;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 10px;
        }

        .error-message {
            font-size: 13.5px;
            font-weight: 300;
            color: #666;
            max-width: 380px;
            margin: 0 auto 24px;
            line-height: 1.8;
        }

        /* BUTTONS */

        .actions {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn-base {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            padding: 12px 26px;
            border-radius: 8px;
            border: 1px solid var(--ink);
            transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        }

        .btn-base svg {
            width: 16px;
            height: 16px;
            stroke: currentColor;
            fill: none;
            stroke-width: 1.8;
        }

        .home-btn {
            background: var(--ink);
            color: #fff;
        }

        .home-btn:hover {
            background: #333;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.18);
        }

        .shop-btn {
            background: transparent;
            color: var(--ink);
        }

        .shop-btn:hover {
            background: var(--ink);
            color: #fff;
            transform: translateY(-2px);
        }

        .btn-base:focus-visible {
            outline: 3px solid var(--signal);
            outline-offset: 3px;
        }

        /* FOOTER */

        footer {
            background: var(--ink);
            color: #fff;
            padding: 28px 20px;
            text-align: center;
        }

        .footer-logo img {
            width: 64px;
            height: auto;
            margin-bottom: 12px;
        }

        .footer-copy {
            font-size: 11px;
            font-weight: 300;
            color: #aaa;
        }

        /* MOBILE */

        @media (max-width: 576px) {
            .nav-inner {
                height: 75px;
            }

            .logo-img {
                width: 70px;
            }

            main {
                padding: 35px 18px;
            }

            .background-404 {
                font-size: 190px;
            }

            .error-card {
                padding: 40px 24px 36px;
                border-radius: 14px;
            }

            .turntable {
                transform: scale(0.88);
                margin-bottom: 14px;
            }

            .error-title {
                font-size: 19px;
            }

            .error-message {
                font-size: 12.5px;
            }

            .wave span {
                width: 3px;
            }

            .wave {
                gap: 3px;
            }

            .btn-base {
                width: 100%;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            .error-card,
            .wave span,
            .vinyl {
                animation: none;
            }
        }
    </style>
</head>


<body>

    <!-- NAVBAR -->

    <nav>
        <div class="nav-inner">
            <img src="/images/logo.png" class="logo-img" alt="OneMore">
        </div>
    </nav>


    <!-- MAIN -->

    <main>

        <div class="background-404" aria-hidden="true">404</div>

        <div class="error-card">

            <!-- Turntable: record spinning, tonearm parked -->
            <div class="turntable" aria-hidden="true">
                <div class="vinyl"></div>
                <div class="vinyl-label">404</div>
                <div class="tonearm"></div>
            </div>

            <h1 class="error-title">This page has gone silent</h1>

            <p class="error-message">
                We couldn't find the page at this address. It may have moved,
                been removed, or the link may be mistyped.
            </p>

            <!-- Player strip: the signal fades to a flatline -->
            <div class="player">
                <div class="player-meta">
                    <span><strong>Now playing:</strong> Track 404, Page not found</span>
                    <span class="player-time">0:00 / 4:04</span>
                </div>
                <div class="wave" aria-hidden="true">
                    <% const total=36; const live=24; for (let i=0; i < total; i++) { if (i < live) { const
                        fade=Math.pow(1 - i / live, 1.4); const h=Math.max(6, Math.round(44 * fade * (0.55 + 0.45 *
                        Math.abs(Math.sin(i * 1.3))))); %>
                        <span style="height: <%= h %>px; animation-delay: <%= (i * 0.07).toFixed(2) %>s"></span>
                        <% } else { %>
                            <span class="flat" style="height: 2px"></span>
                            <% } } %>
                                <span class="dot"></span>
                </div>
            </div>

            <div class="actions">
                <a href="/" class="btn-base home-btn">
                    <svg viewBox="0 0 24 24">
                        <path d="M3 10.5L12 3l9 7.5"></path>
                        <path d="M5.5 9v11h13V9"></path>
                        <path d="M9.5 20v-6h5v6"></path>
                    </svg>
                    Back to home
                </a>

                <!-- Change the href to your products route -->
                <a href="/products" class="btn-base shop-btn">
                    <svg viewBox="0 0 24 24">
                        <path d="M3 13a9 9 0 0 1 18 0"></path>
                        <rect x="3" y="13" width="4" height="7" rx="1.5"></rect>
                        <rect x="17" y="13" width="4" height="7" rx="1.5"></rect>
                    </svg>
                    Browse products
                </a>
            </div>

        </div>

    </main>


    <!-- FOOTER -->

    <footer>
        <div class="footer-logo">
            <img src="/images/logo.png" alt="OneMore">
        </div>

        <p class="footer-copy mb-0">
            © <%= new Date().getFullYear() %> OneMore. All Rights Reserved.
        </p>
    </footer>

</body>

</html>