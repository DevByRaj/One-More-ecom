<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Category Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #000000;
            --card-bg: #0d0d0d;
            --accent-purple: #8a7df0;
            --text-muted: #888888;
            --btn-green: #2ecc71;
            --btn-orange: #e67e22;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 20px;
        }

        .dashboard-container {
            padding: 30px;
            min-height: 90vh;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 20px 10px;
            height: fit-content;
        }

        .nav-link {
            color: #ffffff;
            font-size: 13px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: 0.3s;
        }

        .nav-link i {
            font-size: 18px;
        }

        .nav-link:hover {
            color: var(--accent-purple);
        }

        .nav-link.active {
            color: var(--accent-purple);
            font-weight: 600;
        }

        /* --- TOP SEARCH BAR --- */
        .search-container {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 20px;
            padding: 15px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .search-box {
            background: #ffffff;
            border-radius: 10px;
            display: flex;
            align-items: center;
            padding: 2px 15px;
            width: 250px;
        }

        .search-box input {
            border: none;
            outline: none;
            font-size: 14px;
            padding: 5px;
            width: 100%;
            color: #000;
        }

        /* --- TABLE CONTAINER --- */
        .table-container {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 20px;
        }

        .custom-table {
            color: #ffffff;
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 15px;
        }

        .custom-table thead {
            background: #1a1a1a;
        }

        .custom-table th {
            padding: 15px;
            font-weight: 500;
            font-size: 14px;
            border: none;
            text-align: center;
        }

        .custom-table td {
            padding: 15px;
            font-size: 13px;
            background-color: var(--card-bg);
            text-align: center;
            vertical-align: middle;
            border-bottom: 1px solid #222;
        }

        /* --- BUTTONS --- */
        .btn-edit {
            background-color: var(--btn-green);
            border-radius: 8px;
            padding: 5px 15px;
            font-size: 12px;
            font-weight: 600;
            border: none;
            color: black;
            text-decoration: none;
        }

        .btn-remove {
            background-color: var(--btn-orange);
            border-radius: 8px;
            padding: 5px 15px;
            font-size: 12px;
            font-weight: 600;
            border: none;
            color: black;
            cursor: pointer;
        }

        .btn-add {
            border: 1px solid var(--accent-purple);
            color: #000;
            background-color: var(--accent-purple);
            padding: 8px 20px;
            border-radius: 12px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            transition: 0.3s;
        }

        .btn-add:hover {
            background-color: transparent;
            color: #ffffff;
            border-color: #ffffff;
        }

        /* --- PAGINATION --- */
        .custom-pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            margin-top: 30px;
        }

        .page-btn {
            background: #fff;
            color: #000;
            border-radius: 8px;
            padding: 5px 15px;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
        }

        .page-num {
            width: 35px;
            height: 35px;
            border: 1px solid #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            text-decoration: none;
            font-size: 13px;
        }

        .page-num.active {
            border-color: var(--accent-purple);
            color: var(--accent-purple);
        }

        .footer-text {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 40px;
        }
    </style>
</head>

<body>
    <div id="page-context" data-current-page="<%= currentPage %>" data-search="<%= locals.search || '' %>">
    </div>

    <div class="dashboard-container container-fluid">
        <div class="row">
            <div class="col-lg-2 pe-lg-4">
                <div class="text-center mb-4">
                    <img src="/images/logo.png" alt="Logo" style="width: 60px;">
                </div>
                <div class="sidebar">
                    <nav class="nav flex-column">
                        <a class="nav-link" href="/admin/dashboard"><i class="bi bi-pie-chart"></i> Dashboard</a>
                        <a class="nav-link" href="/admin/products"><i class="bi bi-grid"></i> Products</a>
                        <a class="nav-link" href="/admin/users"><i class="bi bi-person"></i> Customers</a>
                        <a class="nav-link" href="/admin/orders"><i class="bi bi-cart"></i> Orders</a>
                        <a class="nav-link" href="/admin/coupons"><i class="bi bi-ticket-perforated"></i> Coupons</a>
                        <a class="nav-link active" href="/admin/category"><i class="bi bi-app-indicator"></i>
                            Category</a>
                        <a class="nav-link" href="/admin/brand"><i class="bi bi-bag"></i> Brand</a>
                        <a class="nav-link" href="/admin/offers"><i class="bi bi-percent"></i> Offers</a>
                        <a class="nav-link" href="/admin/banner"><i class="bi bi-image"></i> Banner</a>
                        <a class="nav-link" href="/admin/sales-report"><i class="bi bi-bar-chart"></i> Sales Report</a>
                        <a class="nav-link mt-4" href="/admin/logout"><i class="bi bi-power"></i> Logout</a>
                    </nav>
                </div>
            </div>

            <div class="col-lg-10">
                <div class="search-container">
                    <h4 class="mb-0" style="font-weight: 400; letter-spacing: 1px;">Category</h4>

                    <div class="d-flex align-items-center gap-3">
                        <div class="search-box">
                            <form action="/admin/category" method="GET" class="d-flex align-items-center w-100">
                                <i class="bi bi-search me-2" style="color: #000;"></i>
                                <input type="text" name="search" placeholder="Search"
                                    value="<%= locals.search || '' %>">
                                <% if(locals.search){ %>
                                    <a href="/admin/category"
                                        style="color:red; text-decoration:none; font-weight:bold;">×</a>
                                    <% } %>
                            </form>
                        </div>
                        <a href="/admin/addCategory" class="btn-add">
                            <i class="bi bi-plus-lg"></i> Add Category
                        </a>
                    </div>
                </div>

                <div class="table-container">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Sl.No</th>
                                <th>Name</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (categories.length> 0) { %>
                                <% categories.forEach((category, index)=> { %>
                                    <tr>
                                        <td>
                                            <%= (currentPage - 1) * 5 + (index + 1) %>
                                        </td>
                                        <td>
                                            <%= category.name %>
                                        </td>
                                        <td>
                                            <span class="<%= category.isListed ? 'text-success' : 'text-danger' %>">
                                                <%= category.isListed ? 'Active' : 'Inactive' %>
                                            </span>
                                        </td>
                                        <td>
                                            <a href="/admin/editCategory?id=<%= category._id %>"
                                                class="btn-edit me-2">Edit</a>

                                            <form id="form-toggle-<%= category._id %>"
                                                action="/admin/listCategory?id=<%= category._id %>" method="POST"
                                                style="display:inline;">
                                                <button type="button" class="btn-remove border-0"
                                                    data-id="<%= category._id %>"
                                                    data-action="<%= category.isListed ? 'unlist' : 'list' %>"
                                                    onclick="confirmCategoryToggle(this)">
                                                    <%= category.isListed ? 'Unlist' : 'List' %>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="4" class="text-center">No categories found.</td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>

                    <% if (totalPages> 1) { %>
                        <div class="custom-pagination">
                            <% if (currentPage> 1) { %>
                                <a href="?page=<%= currentPage - 1 %>&search=<%= locals.search || '' %>"
                                    class="page-btn">Previous</a>
                                <% } %>

                                    <% for(let i=1; i <=totalPages; i++) { %>
                                        <a href="?page=<%= i %>&search=locals.search || '' %>"
                                            class="page-num <%= currentPage === i ? 'active' : '' %>">
                                            <%= i %>
                                        </a>
                                        <% } %>

                                            <% if (currentPage < totalPages) { %>
                                                <a href="?page=<%= currentPage + 1 %>&search=<%= locals.search || '' %>"
                                                    class="page-btn">Next</a>
                                                <% } %>
                        </div>
                        <% } %>
                </div>
            </div>
        </div>

        <div class="footer-text">
            © 2026 onemore. All Rights Reserved.
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function confirmCategoryToggle(buttonElement) {
            const categoryId = buttonElement.getAttribute('data-id');
            const action = buttonElement.getAttribute('data-action');
            const targetForm = document.getElementById(`form-toggle-${categoryId}`);

            const contextEl = document.getElementById('page-context');
            const currentPage = contextEl.getAttribute('data-current-page') || '1';
            const search = contextEl.getAttribute('data-search') || '';

            Swal.fire({
                title: 'Are you sure?',
                text: `Do you really want to ${action} this category?`,
                icon: 'warning',
                showCancelButton: true,
                background: '#0d0d0d',
                color: '#ffffff',
                confirmButtonColor: action === 'unlist' ? '#e67e22' : '#2ecc71',
                cancelButtonColor: '#444444',
                confirmButtonText: `Yes, ${action} it!`,
                cancelButtonText: 'Cancel',
                customClass: {
                    popup: 'border border-secondary'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    targetForm.action = `/admin/listCategory?id=${categoryId}&page=${currentPage}&search=${encodeURIComponent(search)}`;
                    targetForm.submit();
                }
            });
        }
    </script>
</body>

</html>