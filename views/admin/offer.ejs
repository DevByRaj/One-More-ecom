<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Offers | OneMore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-black: #000000;
            --panel-bg: #0b0b0c;
            --neon-purple: #7a56f5;
            --text-gray: #a0a0a5;
            --btn-green: #00c853;
            --status-delivered: #2ec4b6;
            --status-cancelled: #e61f26;
            --status-processing: #ff9f43;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-black);
            color: #ffffff;
            margin: 0;
            padding: 20px;
        }

        .admin-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* ── LOGO HEADER ── */
        .admin-header {
            padding: 10px 20px;
            margin-bottom: 20px;
        }

        .admin-logo {
            height: 70px;
            width: auto;
            object-fit: contain;
        }

        /* ── MAIN GRID LAYOUT ── */
        .admin-layout-grid {
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 30px;
            align-items: start;
        }

        /* ── SIDEBAR STYLE ── */
        .admin-sidebar {
            background-color: var(--panel-bg);
            border: 2px solid var(--neon-purple);
            border-radius: 15px;
            padding: 25px 15px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sidebar-menu-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 20px;
            color: #ffffff;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .sidebar-menu-item i {
            width: 20px;
            font-size: 1.1rem;
            text-align: center;
            color: var(--text-gray);
        }

        .sidebar-menu-item:hover,
        .sidebar-menu-item.active {
            background-color: rgba(122, 86, 245, 0.15);
            color: #ffffff;
        }

        .sidebar-menu-item:hover i,
        .sidebar-menu-item.active i {
            color: var(--neon-purple);
        }

        /* ── MAIN CONTENT WORKSPACE ── */
        .main-content-area {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        /* Top Control Search Banner Box */
        .top-control-banner {
            background-color: var(--panel-bg);
            border: 1px solid var(--neon-purple);
            border-radius: 12px;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .top-control-banner h4 {
            margin: 0;
            font-weight: 600;
            font-size: 1.3rem;
            letter-spacing: 0.5px;
        }

        /* ── DATA PANEL CONTAINER ── */
        .data-panel {
            background-color: var(--panel-bg);
            border: 1px solid var(--neon-purple);
            border-radius: 15px;
            padding: 25px;
        }

        /* Table Header and Rows matching layout structure */
        .offers-table-header {
            display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.5fr 1fr 1.2fr 1.5fr;

            /* Slightly widened last column for dual buttons */
            background-color: #1a1a1c;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text-gray);
            margin-bottom: 15px;
        }

        .offers-table-row {
            display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.5fr 1fr 1.2fr 1.5fr;

            /* Matched widening */
            align-items: center;
            padding: 20px 20px;
            border-bottom: 1px solid #1f1f22;
            font-size: 0.9rem;
        }

        .data-panel .offers-table-row:last-of-type {
            border-bottom: none;
        }

        .admin-footer {
            text-align: center;
            color: var(--text-gray);
            font-size: 0.8rem;
            margin-top: 40px;
            padding-bottom: 20px;
        }

        @media (max-width: 992px) {
            .admin-layout-grid {
                grid-template-columns: 1fr;
            }

            .offers-table-header,
            .offers-table-row {
                grid-template-columns: 1fr 1fr 1fr;
                gap: 10px;
            }
        }
    </style>
</head>

<body>

    <div class="admin-container">
        <!-- Logo Branding Header Area -->
        <div class="admin-header">
            <img src="/images/logo.png" class="admin-logo" alt="OneMore Logo">
        </div>

        <div class="admin-layout-grid">
            <!-- Sidebar Navigation Column -->
            <aside class="admin-sidebar">
                <a href="/admin/dashboard" class="sidebar-menu-item"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
                <a href="/admin/products" class="sidebar-menu-item"><i class="fa-solid fa-cubes"></i> Products</a>
                <a href="/admin/customers" class="sidebar-menu-item"><i class="fa-solid fa-users"></i> Customers</a>
                <a href="/admin/orders" class="sidebar-menu-item"><i class="fa-solid fa-cart-shopping"></i> Orders</a>
                <a href="/admin/coupons" class="sidebar-menu-item"><i class="fa-solid fa-ticket"></i> Coupons</a>
                <a href="/admin/category" class="sidebar-menu-item"><i class="fa-solid fa-folder-tree"></i> Category</a>
                <a href="/admin/brand" class="sidebar-menu-item"><i class="fa-solid fa-copyright"></i> Brand</a>
                <a href="/admin/offers" class="sidebar-menu-item active"><i class="fa-solid fa-percent"></i> Offers</a>
                <a href="/admin/banner" class="sidebar-menu-item"><i class="fa-solid fa-image"></i> Banner</a>
                <a href="/admin/sales-report" class="sidebar-menu-item"><i class="fa-solid fa-chart-line"></i> Sales
                    Report</a>
                <a href="/admin/logout" class="sidebar-menu-item mt-4"><i class="fa-solid fa-power-off"></i> Logout</a>
            </aside>

            <!-- Main Interactive Display Workspace Context -->
            <main class="main-content-area">
                <!-- Top Header Bar -->
                <div class="top-control-banner">
                    <h4>Offers</h4>
                    <a href="/admin/offers/add" class="btn btn-sm btn-success fw-bold px-3">+ Add New Offer</a>
                </div>

                <!-- Offers Content Data Panel -->
                <div class="data-panel">
                    <div class="offers-table-header">
                        <div>Offer Name</div>
                        <div>Discount</div>
                        <div>Applies To</div>
                        <div>Target</div>
                        <div>Status</div>
                        <div>Expiry Date</div>
                        <div>Action</div>
                    </div>

                    <% if (offers && offers.length> 0) { %>
                        <% offers.forEach(offer=> { %>
                            <div class="offers-table-row">
                                <div class="fw-semibold">
                                    <%= offer.offerName %>
                                </div>
                                <div>
                                    <% if (offer.offerType==="PERCENTAGE" ) { %>
                                        <%= offer.discountValue %>%
                                            <% } else { %>
                                                ₹<%= offer.discountValue %>
                                                    <% } %>
                                </div>
                                <div>
                                    <%= offer.appliesTo==="PRODUCT" ? "Product" : "Category" %>
                                </div>
                                <div>
                                    <% if (offer.appliesTo==="PRODUCT" ) { %>
                                        <%= offer.productId?.productName %>
                                            <% } else { %>
                                                <%= offer.categoryId?.name %>
                                                    <% } %>
                                </div>
                                <div>
                                    <span class="badge <%= offer.isActive ? 'bg-success' : 'bg-danger' %>">
                                        <%= offer.isActive ? 'Active' : 'Inactive' %>
                                    </span>
                                </div>
                                <div>
                                    <%= new Date(offer.endDate).toLocaleDateString("en-IN", { day: "2-digit" , month: "short" , year: "numeric" }) %>
                                </div>

                                <!-- Updated Action Buttons matching image_4f00cc.png -->
                                <div class="d-flex gap-2 align-items-center">
                                    <a href="/admin/offers/edit/<%= offer._id %>" class="btn btn-sm btn-success px-3"
                                        style="border-radius: 4px; font-weight: 500;">Edit</a>
                                    <form action="/admin/offers/delete/<%= offer._id %>" method="POST" class="deleteOfferForm">
                                    
                                        <button type="submit" class="btn btn-sm text-white px-3"
                                            style="background:#ff5722;border-radius:4px;font-weight:500;">
                                            Remove
                                        </button>
                                    
                                    </form>
                                </div>

                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div class="text-center py-4 text-muted">No offers available.</div>
                                    <% } %>
                </div>
            </main>
        </div>

        <footer class="admin-footer">
            © 2026 onemore. All Rights Reserved.
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
document.querySelectorAll(".deleteOfferForm").forEach(form => {

    form.addEventListener("submit", function(e) {

        e.preventDefault();

        Swal.fire({
            title: "Delete Offer?",
            text: "This action cannot be undone.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#d33",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Yes, Delete",
            cancelButtonText: "Cancel"
        }).then((result) => {

            if(result.isConfirmed){
                form.submit();
            }

        });

    });

});
</script>
</body>

</html>