<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - <%= isEdit ? 'Edit Product' : 'Add New Product' %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #000000;
            --card-bg: #0d0d0d;
            --accent-purple: #8a7df0;
            --text-muted: #888888;
            --btn-save: #66ff00;
            --input-border: #444444;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 20px;
        }

        .dashboard-container {
            padding: 30px;
            min-height: 90vh;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 20px 10px;
            height: fit-content;
        }

        .nav-link {
            color: #ffffff;
            font-size: 13px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .nav-link.active {
            color: var(--accent-purple);
            font-weight: 600;
        }

        /* --- FORM PANELS --- */
        .header-panel {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 15px;
            padding: 10px 25px;
            margin-bottom: 20px;
        }

        .form-panel {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 40px;
        }

        /* --- INPUT STYLES --- */
        label {
            font-size: 12px;
            margin-bottom: 5px;
            display: block;
            color: #ffffff;
        }

        .form-control,
        .form-select {
            background-color: transparent;
            border: 1px solid var(--input-border);
            border-radius: 10px;
            color: white;
            font-size: 13px;
            padding: 8px 15px;
            margin-bottom: 20px;
        }

        .form-select option {
            background-color: #111;
            color: white;
        }

        .form-control:focus,
        .form-select:focus {
            background-color: transparent;
            color: white;
            border-color: var(--accent-purple);
            box-shadow: none;
        }

        .input-group-text {
            background-color: transparent;
            border: 1px solid var(--input-border);
            border-left: none;
            color: white;
            font-size: 13px;
            border-radius: 0 10px 10px 0;
        }

        .input-group .form-control {
            margin-bottom: 0;
        }

        .input-group .form-control {
            border-right: none;
        }

        .input-group .form-control:focus {
            border-color: var(--accent-purple);
        }

        .input-group .form-control:focus+.input-group-text {
            border-color: var(--accent-purple);
        }

        textarea.form-control {
            height: 200px;
            resize: none;
        }

        /* --- BUTTONS --- */
        .upload-btn {
            background: #ffffff;
            color: #000;
            border-radius: 10px;
            width: 100%;
            border: none;
            padding: 8px;
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 25px;
        }

        .variant-btn {
            background: #ffffff;
            color: #000;
            border-radius: 20px;
            width: 180px;
            border: none;
            padding: 8px;
            font-weight: 600;
            font-size: 13px;
        }

        .save-btn {
            background-color: var(--btn-save);
            color: #000;
            border-radius: 15px;
            padding: 10px 60px;
            font-weight: 600;
            font-size: 14px;
            border: none;
        }

        .footer-text {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 40px;
        }

        .text-danger {
            font-size: 12px;
            display: block;
            margin-top: -15px;
            margin-bottom: 10px;
        }

        /* ── RESPONSIVE ─────────────────────────────────────── */

        /* Mobile sidebar toggle */
        .sidebar-toggle {
            display: none;
            background: var(--card-bg);
            color: #fff;
            border: 2px solid var(--accent-purple);
            border-radius: 10px;
            padding: 8px 16px;
            font-size: 13px;
            cursor: pointer;
            margin-bottom: 16px;
            width: 100%;
            text-align: left;
        }

        /* Tablet – 992px */
        @media (max-width: 992px) {
            .dashboard-container {
                padding: 16px;
            }

            .form-panel {
                padding: 24px;
            }

            .col-md-7.ps-md-5 {
                padding-left: 0 !important;
            }
        }

        /* Mobile – 768px */
        @media (max-width: 768px) {
            body {
                padding: 10px;
            }

            .dashboard-container {
                padding: 10px;
            }

            /* Show toggle, hide sidebar by default */
            .sidebar-toggle {
                display: block;
            }

            .sidebar-wrapper {
                overflow: hidden;
                max-height: 0;
                transition: max-height 0.35s ease;
            }

            .sidebar-wrapper.open {
                max-height: 800px;
            }

            .sidebar {
                border-radius: 15px;
                margin-bottom: 16px;
            }

            /* Logo on mobile */
            .sidebar-logo {
                margin-bottom: 12px !important;
            }

            /* Header panel */
            .header-panel {
                padding: 10px 16px;
            }

            /* Form panel */
            .form-panel {
                padding: 20px 16px;
                border-radius: 16px;
            }

            /* Description textarea shorter on mobile */
            textarea.form-control {
                height: 140px;
            }

            /* Save button full-width on mobile */
            .save-btn {
                width: 100%;
                padding: 10px;
            }

            .d-flex.justify-content-end {
                justify-content: stretch !important;
            }
        }

        /* Small phones – 480px */
        @media (max-width: 480px) {
            .form-panel {
                padding: 16px 12px;
            }

            .nav-link {
                padding: 10px 14px;
                font-size: 12px;
            }
        }
    </style>
</head>

<body>
    <div class="dashboard-container container-fluid">
        <div class="row">
            <div class="col-lg-2 pe-lg-4 mb-3 mb-lg-0">
                <!-- Mobile sidebar toggle -->
                <button class="sidebar-toggle" onclick="toggleSidebar()" id="sidebarToggleBtn">
                    <i class="bi bi-layout-sidebar me-2"></i> Menu
                </button>

                <div class="text-center mb-4 sidebar-logo">
                    <img src="/images/logo.png" alt="im" style="width: 60px;">
                </div>

                <div class="sidebar-wrapper" id="sidebarWrapper">
                    <div class="sidebar">
                        <nav class="nav flex-column">
                            <a class="nav-link" href="/admin/dashboard"><i class="bi bi-pie-chart"></i> Dashboard</a>
                            <a class="nav-link active" href="/admin/products"><i class="bi bi-grid"></i> Products</a>
                            <a class="nav-link" href="/admin/users"><i class="bi bi-person"></i> Customers</a>
                            <a class="nav-link" href="/admin/orders"><i class="bi bi-cart"></i> Orders</a>
                            <a class="nav-link" href="/admin/coupons"><i class="bi bi-ticket-perforated"></i>
                                Coupons</a>
                            <a class="nav-link" href="/admin/category"><i class="bi bi-app-indicator"></i> Category</a>
                            <a class="nav-link" href="/admin/brand"><i class="bi bi-bag"></i> Brand</a>
                            <a class="nav-link" href="/admin/offers"><i class="bi bi-percent"></i> Offers</a>
                            <a class="nav-link" href="/admin/banner"><i class="bi bi-image"></i> Banner</a>
                            <a class="nav-link" href="/admin/sales-report"><i class="bi bi-bar-chart"></i> Sales
                                Report</a>
                            <a class="nav-link mt-4" href="/admin/logout"><i class="bi bi-power"></i> Logout</a>
                        </nav>
                    </div>
                </div>
            </div>

            <div class="col-lg-10">
                <div class="header-panel">
                    <h5 class="mb-0" style="font-weight: 400; letter-spacing: 1px;">Add New Product</h5>
                </div>

                <div class="form-panel">
                    <form action="<%= isEdit ? '/admin/edit-product/' + product._id : '/admin/add-product' %>"
                        method="POST" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-5">
                                <div class="mb-3">
                                    <label>Product Name</label>
                                    <input type="text" name="productName" class="form-control"
                                        value="<%= oldData?.productName || '' %>">
                                    <% if(errors?.productName){ %>
                                        <small class="text-danger">
                                            <%= errors.productName %>
                                        </small>
                                        <% } %>
                                </div>

                                <div class="mb-3">
                                    <label>Brand</label>
                                    <select name="brand" class="form-select">
                                        <option value="">Select Brand</option>
                                        <% brands.forEach(brand=> { %>
                                            <option value="<%= brand._id %>" <%=oldData?.brand==brand._id.toString()
                                                ? 'selected' : '' %>>
                                                <%= brand.name %>
                                            </option>
                                            <% }) %>
                                    </select>
                                    <% if(errors?.brand){ %>
                                        <small class="text-danger">
                                            <%= errors.brand %>
                                        </small>
                                        <% } %>
                                </div>

                                <div class="mb-3">
                                    <label>Category</label>
                                    <select name="category" id="categorySelect" class="form-select">
                                        <option value="">Select Category</option>
                                        <% categories.forEach(category=> { %>
                                            <option value="<%= category._id %>"
                                                <%=oldData?.category==category._id.toString() ? 'selected' : '' %>>
                                                <%= category.name %>
                                            </option>
                                            <% }) %>
                                    </select>
                                    <% if(errors?.category){ %>
                                        <small class="text-danger">
                                            <%= errors.category %>
                                        </small>
                                        <% } %>
                                </div>

                                <div class="mb-3" id="playtimeField">
                                    <label>Playtime</label>
                                    <div class="input-group">
                                        <input type="number" name="playtime" class="form-control" min="1"
                                            value="<%= oldData?.playtime || '' %>">
                                        <span class="input-group-text">Hrs</span>
                                    </div>
                                </div>
                                <% if(errors?.playtime){ %>
                                    <small class="text-danger">
                                        <%= errors.playtime %>
                                    </small>
                                    <% } %>

                                        <div class="mb-3">
                                            <input type="file" id="fileInput" name="productImage"
                                                class="form-control d-none" accept="image/*">
                                            <div class="form-control d-flex flex-column align-items-center justify-content-center"
                                                style="height: 120px; cursor: pointer;"
                                                onclick="document.getElementById('fileInput').click()">
                                                <i class="bi bi-cloud-upload fs-1 text-muted"></i>
                                                <small class="mt-2">Click to Upload Product Image</small>
                                            </div>
                                            <p id="fileName" class="text-muted small mt-2"></p>
                                            <% if(errors?.productImage){ %>
                                                <small class="text-danger">
                                                    <%= errors.productImage %>
                                                </small>
                                                <% } %>
                                                    <div class="text-center mt-3">
                                                        <img id="previewImage" src="" alt="Preview" style="
                                            width: 150px;
                                            height: 150px;
                                            object-fit: cover;
                                            border-radius: 10px;
                                            display: none;
                                            border: 1px solid #444;
                                        ">
                                                    </div>
                                        </div>
                            </div>

                            <div class="col-md-7 ps-md-5">
                                <div class="mb-3">
                                    <label>Description</label>
                                    <textarea name="description"
                                        class="form-control"><%= oldData?.description || '' %></textarea>
                                    <% if(errors?.description){ %>
                                        <small class="text-danger">
                                            <%= errors.description %>
                                        </small>
                                        <% } %>
                                </div>

                                <div class="d-flex justify-content-end gap-3 mt-5">
                                    <button type="submit" class="save-btn">
                                        <%= isEdit ? 'UPDATE' : 'SAVE' %>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="footer-text">
            © 2026 onemore. All Rights Reserved.
        </div>
    </div>
</body>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Sidebar toggle (mobile only)
    function toggleSidebar() {
        const wrapper = document.getElementById('sidebarWrapper');
        const btn = document.getElementById('sidebarToggleBtn');
        wrapper.classList.toggle('open');
        btn.innerHTML = wrapper.classList.contains('open')
            ? '<i class="bi bi-x-lg me-2"></i> Close'
            : '<i class="bi bi-layout-sidebar me-2"></i> Menu';
    }

    // Keep sidebar always open on desktop
    function handleResize() {
        const wrapper = document.getElementById('sidebarWrapper');
        if (window.innerWidth > 768) {
            wrapper.style.maxHeight = 'none';
            wrapper.style.overflow = 'visible';
        } else {
            wrapper.style.maxHeight = '';
            wrapper.style.overflow = '';
        }
    }

    window.addEventListener('resize', handleResize);
    handleResize();

    // Category playtime toggle
    const categorySelect = document.getElementById("categorySelect");
    const playtimeField = document.getElementById("playtimeField");

    function togglePlaytime() {
        const selectedText = categorySelect.options[categorySelect.selectedIndex].text.toLowerCase();
        playtimeField.style.display = selectedText.includes("wired") ? "none" : "block";
    }

    categorySelect.addEventListener("change", togglePlaytime);
    togglePlaytime();

    // File preview
    const fileInput = document.getElementById("fileInput");
    const previewImage = document.getElementById("previewImage");
    const fileName = document.getElementById("fileName");

    fileInput.addEventListener("change", function () {
        const file = this.files[0];
        if (file) {
            fileName.innerText = file.name;
            const reader = new FileReader();
            reader.onload = function (e) {
                previewImage.src = e.target.result;
                previewImage.style.display = "block";
            };
            reader.readAsDataURL(file);
        }
    });
</script>

</html>