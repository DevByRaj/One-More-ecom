<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - <%= isEdit ? 'Edit Product' : 'Add New Product' %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css">

    <style>
        :root {
            --bg-dark: #000000;
            --card-bg: #0d0d0d;
            --accent-purple: #8a7df0;
            --text-muted: #888888;
            --btn-save: #66ff00;
            --input-border: #444444;
            --error-red: #ff4d4d;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 20px;
        }

        .dashboard-container {
            padding: 30px;
            min-height: 90vh;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 20px 10px;
            height: fit-content;
        }

        .nav-link {
            color: #ffffff;
            font-size: 13px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .nav-link.active {
            color: var(--accent-purple);
            font-weight: 600;
        }

        /* --- FORM PANELS --- */
        .header-panel {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 15px;
            padding: 10px 25px;
            margin-bottom: 20px;
        }

        .form-panel {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 40px;
        }

        /* --- INPUT STYLES --- */
        label {
            font-size: 12px;
            margin-bottom: 5px;
            display: block;
            color: #ffffff;
        }

        .form-control,
        .form-select {
            background-color: transparent;
            border: 1px solid var(--input-border);
            border-radius: 10px;
            color: white;
            font-size: 13px;
            padding: 8px 15px;
            margin-bottom: 20px;
        }

        .form-select option {
            background-color: #111;
            color: white;
        }

        .form-control:focus,
        .form-select:focus {
            background-color: transparent;
            color: white;
            border-color: var(--accent-purple);
            box-shadow: none;
        }

        .input-group-text {
            background-color: transparent;
            border: 1px solid var(--input-border);
            border-left: none;
            color: white;
            font-size: 13px;
            border-radius: 0 10px 10px 0;
        }

        .input-group .form-control {
            margin-bottom: 0;
        }

        .input-group .form-control {
            border-right: none;
        }

        .input-group .form-control:focus {
            border-color: var(--accent-purple);
        }

        .input-group .form-control:focus+.input-group-text {
            border-color: var(--accent-purple);
        }

        textarea.form-control {
            height: 200px;
            resize: none;
        }

        /* --- BUTTONS --- */
        .upload-btn {
            background: #ffffff;
            color: #000;
            border-radius: 10px;
            width: 100%;
            border: none;
            padding: 8px;
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 25px;
        }

        .variant-btn {
            background: #ffffff;
            color: #000;
            border-radius: 20px;
            width: 180px;
            border: none;
            padding: 8px;
            font-weight: 600;
            font-size: 13px;
        }

        .save-btn {
            background-color: var(--btn-save);
            color: #000;
            border-radius: 15px;
            padding: 10px 60px;
            font-weight: 600;
            font-size: 14px;
            border: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.3s ease;
        }

        .footer-text {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 40px;
        }

        .text-danger {
            font-size: 12px;
            display: block;
            margin-top: -15px;
            margin-bottom: 10px;
        }

        .error-message {
            color: var(--error-red);
            font-size: 11px;
            margin-top: 4px;
            display: none;
        }

        /* Container styling to constrain large images within cropping workspace view */
        .cropper-container-wrapper {
            max-height: 450px;
            overflow: hidden;
            background-color: #1b1b1b;
            border-radius: 8px;
        }

        /* --- FULL PAGE LOADING OVERLAY (MATCHING VARIANT PAGE) --- */
        .loader-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 99999;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }

        .loader-overlay.show {
            opacity: 1;
            visibility: visible;
        }

        .spinner-custom {
            width: 55px;
            height: 55px;
            border: 4px solid rgba(138, 125, 240, 0.15);
            border-top: 4px solid var(--accent-purple);
            border-radius: 50%;
            animation: spin 0.85s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        }

        .loader-text {
            margin-top: 22px;
            font-size: 14px;
            font-weight: 400;
            letter-spacing: 0.8px;
            color: #e0e0e0;
        }

        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        /* ── RESPONSIVE ─────────────────────────────────────── */

        /* Mobile sidebar toggle */
        .sidebar-toggle {
            display: none;
            background: var(--card-bg);
            color: #fff;
            border: 2px solid var(--accent-purple);
            border-radius: 10px;
            padding: 8px 16px;
            font-size: 13px;
            cursor: pointer;
            margin-bottom: 16px;
            width: 100%;
            text-align: left;
        }

        /* Tablet – 992px */
        @media (max-width: 992px) {
            .dashboard-container {
                padding: 16px;
            }

            .form-panel {
                padding: 24px;
            }

            .col-md-7.ps-md-5 {
                padding-left: 0 !important;
            }
        }

        /* Mobile – 768px */
        @media (max-width: 768px) {
            body {
                padding: 10px;
            }

            .dashboard-container {
                padding: 10px;
            }

            /* Show toggle, hide sidebar by default */
            .sidebar-toggle {
                display: block;
            }

            .sidebar-wrapper {
                overflow: hidden;
                max-height: 0;
                transition: max-height 0.35s ease;
            }

            .sidebar-wrapper.open {
                max-height: 800px;
            }

            .sidebar {
                border-radius: 15px;
                margin-bottom: 16px;
            }

            /* Logo on mobile */
            .sidebar-logo {
                margin-bottom: 12px !important;
            }

            /* Header panel */
            .header-panel {
                padding: 10px 16px;
            }

            /* Form panel */
            .form-panel {
                padding: 20px 16px;
                border-radius: 16px;
            }

            /* Description textarea shorter on mobile */
            textarea.form-control {
                height: 140px;
            }

            /* Save button full-width on mobile */
            .save-btn {
                width: 100%;
                padding: 10px;
            }

            .d-flex.justify-content-end {
                justify-content: stretch !important;
            }
        }

        /* Small phones – 480px */
        @media (max-width: 480px) {
            .form-panel {
                padding: 16px 12px;
            }

            .nav-link {
                padding: 10px 14px;
                font-size: 12px;
            }
        }
    </style>
</head>

<body>

    <div id="loadingOverlay" class="loader-overlay">
        <div class="spinner-custom"></div>
        <div class="loader-text">Saving product details...</div>
    </div>

    <div class="dashboard-container container-fluid">
        <div class="row">
            <div class="col-lg-2 pe-lg-4 mb-3 mb-lg-0">
                <button class="sidebar-toggle" onclick="toggleSidebar()" id="sidebarToggleBtn">
                    <i class="bi bi-layout-sidebar me-2"></i> Menu
                </button>

                <div class="text-center mb-4 sidebar-logo">
                    <img src="/images/logo.png" alt="im" style="width: 60px;">
                </div>

                <div class="sidebar-wrapper" id="sidebarWrapper">
                    <div class="sidebar">
                        <nav class="nav flex-column">
                            <a class="nav-link" href="/admin/dashboard"><i class="bi bi-pie-chart"></i> Dashboard</a>
                            <a class="nav-link active" href="/admin/products"><i class="bi bi-grid"></i> Products</a>
                            <a class="nav-link" href="/admin/users"><i class="bi bi-person"></i> Customers</a>
                            <a class="nav-link" href="/admin/orders"><i class="bi bi-cart"></i> Orders</a>
                            <a class="nav-link" href="/admin/coupons"><i class="bi bi-ticket-perforated"></i>
                                Coupons</a>
                            <a class="nav-link" href="/admin/category"><i class="bi bi-app-indicator"></i> Category</a>
                            <a class="nav-link" href="/admin/brand"><i class="bi bi-bag"></i> Brand</a>
                            <a class="nav-link" href="/admin/offers"><i class="bi bi-percent"></i> Offers</a>
                            <a class="nav-link" href="/admin/banner"><i class="bi bi-image"></i> Banner</a>
                            <a class="nav-link" href="/admin/sales-report"><i class="bi bi-bar-chart"></i> Sales
                                Report</a>
                            <a class="nav-link mt-4" href="/admin/logout" style="color: #ff4d4d;"><i
                                    class="bi bi-power"></i> Logout</a>
                        </nav>
                    </div>
                </div>
            </div>

            <div class="col-lg-10">
                <div class="header-panel">
                    <h5 class="mb-0" style="font-weight: 400; letter-spacing: 1px;">
                        <%= isEdit ? 'Edit Product' : 'Add New Product' %>
                    </h5>
                </div>

                <div class="form-panel">
                    <form id="productForm"
                        action="<%= isEdit ? '/admin/edit-product/' + product._id : '/admin/add-product' %>"
                        method="POST" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-md-5">
                                <div class="mb-3">
                                    <label>Product Name</label>
                                    <input type="text" name="productName" class="form-control"
                                        value="<%= oldData?.productName || (isEdit ? product.productName : '') %>">
                                    <% if(errors?.productName){ %>
                                        <small class="text-danger">
                                            <%= errors.productName %>
                                        </small>
                                        <% } %>
                                </div>

                                <div class="mb-3">
                                    <label>Brand</label>
                                    <select name="brand" class="form-select">
                                        <option value="">Select Brand</option>
                                        <% brands.forEach(brand=> { %>
                                            <option value="<%= brand._id %>" <%=(oldData?.brand==brand._id.toString() ||
                                                (isEdit && product.brand?.toString()==brand._id.toString()))
                                                ? 'selected' : '' %>>
                                                <%= brand.name %>
                                            </option>
                                            <% }) %>
                                    </select>
                                    <% if(errors?.brand){ %>
                                        <small class="text-danger">
                                            <%= errors.brand %>
                                        </small>
                                        <% } %>
                                </div>

                                <div class="mb-3">
                                    <label>Category</label>
                                    <select name="category" id="categorySelect" class="form-select">
                                        <option value="">Select Category</option>
                                        <% categories.forEach(category=> { %>
                                            <option value="<%= category._id %>"
                                                <%=(oldData?.category==category._id.toString() || (isEdit &&
                                                product.category?.toString()==category._id.toString())) ? 'selected'
                                                : '' %>>
                                                <%= category.name %>
                                            </option>
                                            <% }) %>
                                    </select>
                                    <% if(errors?.category){ %>
                                        <small class="text-danger">
                                            <%= errors.category %>
                                        </small>
                                        <% } %>
                                </div>

                                <div class="mb-3" id="playtimeField">
                                    <label>Playtime</label>
                                    <div class="input-group">
                                        <input type="number" name="playtime" class="form-control" min="1"
                                            value="<%= oldData?.playtime || (isEdit ? product.playtime : '') %>">
                                        <span class="input-group-text">Hrs</span>
                                    </div>
                                </div>
                                <% if(errors?.playtime){ %>
                                    <small class="text-danger">
                                        <%= errors.playtime %>
                                    </small>
                                    <% } %>

                                        <div class="mb-3">
                                            <input type="file" id="fileInput" name="productImage"
                                                class="form-control d-none"
                                                accept="image/jpeg, image/jpg, image/png, image/webp">
                                            <div class="form-control d-flex flex-column align-items-center justify-content-center"
                                                style="height: 120px; cursor: pointer;"
                                                onclick="document.getElementById('fileInput').click()">
                                                <i class="bi bi-cloud-upload fs-1 text-muted"></i>
                                                <small class="mt-2">Click to Upload Product Image</small>
                                            </div>
                                            <p id="fileName" class="text-muted small mt-2">
                                                <%= isEdit && product.productImage ? 'Current image template loaded'
                                                    : '' %>
                                            </p>
                                            <% if(errors?.productImage){ %>
                                                <small class="text-danger">
                                                    <%= errors.productImage %>
                                                </small>
                                                <% } %>

                                                    <div id="imageError" class="error-message mb-2">
                                                        Only JPG, JPEG, PNG and WEBP images are allowed.
                                                    </div>

                                                    <div class="text-center mt-3">
                                                        <img id="previewImage"
                                                            src="<%= isEdit && product.productImage ? product.productImage : '' %>"
                                                            alt="Preview" style="
                                            width: 150px;
                                            height: 150px;
                                            object-fit: cover;
                                            border-radius: 10px;
                                            display: <%= isEdit && product.productImage ? 'inline-block' : 'none' %>;
                                            border: 1px solid #444;
                                        ">
                                                    </div>
                                        </div>
                            </div>

                            <div class="col-md-7 ps-md-5">
                                <div class="mb-3">
                                    <label>Description</label>
                                    <textarea name="description"
                                        class="form-control"><%= oldData?.description || (isEdit ? product.description : '') %></textarea>
                                    <% if(errors?.description){ %>
                                        <small class="text-danger">
                                            <%= errors.description %>
                                        </small>
                                        <% } %>
                                </div>

                                <div class="d-flex justify-content-end gap-3 mt-5">
                                    <button type="submit" class="save-btn" id="submitBtn">
                                        <span id="btnText">
                                            <%= isEdit ? 'UPDATE' : 'SAVE' %>
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="footer-text">
            © 2026 onemore. All Rights Reserved.
        </div>
    </div>

    <div class="modal fade" id="cropModal" data-bs-backdrop="static" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" style="background:#111; color:white; border: 1px solid var(--accent-purple);">
                <div class="modal-header style-border">
                    <h5 class="modal-title">Adjust Product Alignment</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <div class="cropper-container-wrapper">
                        <img id="cropImage" style="max-width:100%; display:block;">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success" id="cropBtn">Crop & Save</button>
                </div>
            </div>
        </div>
    </div>

</body>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>

<script>
    // Sidebar toggle (mobile only)
    function toggleSidebar() {
        const wrapper = document.getElementById('sidebarWrapper');
        const btn = document.getElementById('sidebarToggleBtn');
        wrapper.classList.toggle('open');
        btn.innerHTML = wrapper.classList.contains('open')
            ? '<i class="bi bi-x-lg me-2"></i> Close'
            : '<i class="bi bi-layout-sidebar me-2"></i> Menu';
    }

    // Keep sidebar always open on desktop
    function handleResize() {
        const wrapper = document.getElementById('sidebarWrapper');
        if (window.innerWidth > 768) {
            wrapper.style.maxHeight = 'none';
            wrapper.style.overflow = 'visible';
        } else {
            wrapper.style.maxHeight = '';
            wrapper.style.overflow = '';
        }
    }

    window.addEventListener('resize', handleResize);
    handleResize();

    // Category playtime toggle
    const categorySelect = document.getElementById("categorySelect");
    const playtimeField = document.getElementById("playtimeField");

    function togglePlaytime() {
        if (!categorySelect.selectedIndex) return;
        const selectedText = categorySelect.options[categorySelect.selectedIndex].text.toLowerCase();
        playtimeField.style.display = selectedText.includes("wired") ? "none" : "block";
    }

    categorySelect.addEventListener("change", togglePlaytime);
    togglePlaytime();

    // ── CROPPER WORKSPACE INTERACTION PIPELINE ──
    let cropper;
    const fileInput = document.getElementById("fileInput");
    const previewImage = document.getElementById("previewImage");
    const fileName = document.getElementById("fileName");
    const imageError = document.getElementById("imageError");
    const cropModalEl = document.getElementById("cropModal");
    const cropModal = new bootstrap.Modal(cropModalEl);
    const cropImageInstance = document.getElementById("cropImage");
    const cropBtn = document.getElementById("cropBtn");
    const loadingOverlay = document.getElementById("loadingOverlay");

    let croppedFileBlob = null;

    fileInput.addEventListener("change", function () {
        const file = this.files[0];
        if (file) {
            const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];

            if (!allowedTypes.includes(file.type)) {
                this.value = '';
                fileName.innerText = '';
                imageError.textContent = 'Only JPG, JPEG, PNG and WEBP images are allowed.';
                imageError.style.display = 'block';
                return;
            }

            imageError.style.display = 'none';
            fileName.innerText = file.name;
            const reader = new FileReader();
            reader.onload = function (e) {
                cropImageInstance.src = e.target.result;
                cropModal.show();
            };
            reader.readAsDataURL(file);
        }
    });

    cropModalEl.addEventListener('shown.bs.modal', function () {
        cropper = new Cropper(cropImageInstance, {
            aspectRatio: 1,
            viewMode: 2,
            background: false,
            autoCropArea: 1
        });
    });

    cropModalEl.addEventListener('hidden.bs.modal', function () {
        if (cropper) {
            cropper.destroy();
            cropper = null;
        }
    });

    cropBtn.addEventListener("click", function () {
        if (!cropper) return;

        const canvas = cropper.getCroppedCanvas({
            width: 600,
            height: 600,
            imageSmoothingEnabled: true,
            imageSmoothingQuality: 'high'
        });

        canvas.toBlob(function (blob) {
            croppedFileBlob = blob;
            previewImage.src = URL.createObjectURL(blob);
            previewImage.style.display = "inline-block";
            cropModal.hide();
        }, 'image/jpeg', 0.90);
    });

    // Intercept form dispatch routine
    document.getElementById("productForm").addEventListener("submit", function (e) {
        if (fileInput.files.length > 0) {
            const file = fileInput.files[0];
            const allowedTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
            if (!allowedTypes.includes(file.type)) {
                e.preventDefault();
                imageError.textContent = 'Only JPG, JPEG, PNG and WEBP images are allowed.';
                imageError.style.display = 'block';
                return;
            }
        }

        // Trigger full page variant overlay for fallback standard post paths
        if (!croppedFileBlob) {
            loadingOverlay.classList.add('show');
            return;
        }

        // Handle async boundary delivery if custom cropped blob workspace is selected
        e.preventDefault();
        loadingOverlay.classList.add('show');

        const formElement = this;
        const formData = new FormData(formElement);

        formData.delete("productImage");
        formData.append("productImage", croppedFileBlob, fileName.innerText || "cropped-product.jpg");

        fetch(formElement.action, {
            method: "POST",
            body: formData
        })
            .then(response => {
                if (response.redirected) {
                    window.location.href = response.url;
                } else {
                    return response.text().then(text => {
                        document.open();
                        document.write(text);
                        document.close();
                    });
                }
            })
            .catch(err => {
                console.error("Dispatch multi-part boundary execution error: ", err);
                loadingOverlay.classList.remove('show'); // Remove freeze layout if network stream crashes
            });
    });
</script>

</html>