<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Variant Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #000000;
            --card-bg: #0d0d0d;
            --accent-purple: #8a7df0;
            --text-muted: #888888;
            --btn-green: #2ecc71;
            --btn-orange: #e67e22;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 20px;
        }

        .dashboard-container {
            padding: 30px;
            min-height: 95vh;
        }

        /* --- SIDEBAR PANEL --- */
        .sidebar {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 25px 10px;
            height: fit-content;
        }

        .nav-link {
            color: #ffffff;
            font-size: 13px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: 0.3s;
        }

        .nav-link i {
            font-size: 18px;
        }

        .nav-link:hover {
            color: var(--accent-purple);
        }

        .nav-link.active {
            color: var(--accent-purple);
            font-weight: 600;
        }

        /* --- TITLE BAR PANEL --- */
        .title-panel {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 15px;
            padding: 12px 25px;
            margin-bottom: 20px;
        }

        /* --- TABLE WINDOW PANEL --- */
        .table-panel {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 30px;
        }

        /* --- TOP HEADER CONTENT ACTION --- */
        .action-header-row {
            display: flex;
            justify-content: flex-end;
            margin-bottom: 25px;
        }

        .btn-add-variant {
            background-color: #ffffff;
            color: #000000;
            border-radius: 20px;
            padding: 6px 40px;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            border: none;
            transition: 0.2s ease;
        }

        .btn-add-variant:hover {
            background-color: #e2e2e2;
        }

        /* --- TABLE STYLING --- */
        .custom-table {
            width: 100%;
            color: #ffffff;
            border-collapse: separate;
            border-spacing: 0;
        }

        .custom-table thead {
            background-color: #1a1a1a;
        }

        .custom-table th {
            padding: 12px;
            font-weight: 500;
            font-size: 14px;
            border: none;
            text-align: center;
        }

        /* Match structure exactly */
        .custom-table th:first-child,
        .custom-table td:first-child {
            text-align: left;
            padding-left: 50px;
        }

        .custom-table th:last-child,
        .custom-table td:last-child {
            text-align: right;
            padding-right: 50px;
        }

        .custom-table td {
            padding: 25px 12px;
            font-size: 14px;
            text-align: center;
            vertical-align: middle;
            border-bottom: 1px solid #1a1a1a;
        }

        .variant-img {
            width: 75px;
            height: 75px;
            object-fit: contain;
            border-radius: 8px;
        }

        /* --- UTILITY ROW BUTTONS --- */
        .btn-action-edit {
            background-color: var(--btn-green);
            border-radius: 6px;
            padding: 4px 14px;
            font-size: 13px;
            font-weight: 600;
            border: none;
            color: #000000;
            text-decoration: none;
            display: inline-block;
        }

        .btn-action-remove {
            background-color: var(--btn-orange);
            border-radius: 6px;
            padding: 4px 14px;
            font-size: 13px;
            font-weight: 600;
            border: none;
            color: #000000;
            text-decoration: none;
            display: inline-block;
        }
        .status-listed{

    background: #00c853;
    color: white;

    padding: 6px 14px;

    border-radius: 20px;

    font-size: 13px;

    font-weight: 600;
}

.status-unlisted{

    background: #ff3d00;
    color: white;

    padding: 6px 14px;

    border-radius: 20px;

    font-size: 13px;

    font-weight: 600;
}

        .footer-text {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 50px;
        }
    </style>
</head>

<body>

    <div class="container-fluid dashboard-container">
        <div class="row">
            <div class="col-lg-2 pe-lg-4">
                <div class="text-center mb-4">
                    <img src="/images/logo.png" alt="im" style="width: 70px;">
                </div>
                <div class="sidebar">
                    <nav class="nav flex-column">
                        <a class="nav-link" href="/admin/dashboard"><i class="bi bi-pie-chart"></i> Dashboard</a>
                        <a class="nav-link active" href="/admin/products"><i class="bi bi-grid"></i> Products</a>
                        <a class="nav-link" href="/admin/users"><i class="bi bi-person"></i> Customers</a>
                        <a class="nav-link" href="/admin/orders"><i class="bi bi-cart"></i> Orders</a>
                        <a class="nav-link" href="/admin/coupons"><i class="bi bi-ticket-perforated"></i> Coupons</a>
                        <a class="nav-link" href="/admin/category"><i class="bi bi-app-indicator"></i> Category</a>
                        <a class="nav-link" href="/admin/brand"><i class="bi bi-bag"></i> Brand</a>
                        <a class="nav-link" href="/admin/offers"><i class="bi bi-percent"></i> Offers</a>
                        <a class="nav-link" href="/admin/banner"><i class="bi bi-image"></i> Banner</a>
                        <a class="nav-link" href="/admin/sales-report"><i class="bi bi-bar-chart"></i> Sales Report</a>
                        <a class="nav-link mt-4" href="/admin/logout" style="color: #ff4d4d;"><i
                                class="bi bi-power"></i> Logout</a>
                    </nav>
                </div>
            </div>

            <div class="col-lg-10">
                <div class="title-panel">
                    <h5 class="mb-0" style="font-weight: 400; letter-spacing: 0.5px;">Variant</h5>
                </div>

                <div class="table-panel">
                    <div class="action-header-row">
                        <a href="/admin/add-variant/<%= productId %>" class="btn-add-variant">Add
                            Variant</a>
                    </div>

                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Color</th>
                                <th>Image</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (variants && variants.length> 0) { %>
                                <% variants.forEach(variant=> { %>
                                    <tr>
                                        <td>
                                            <%= variant.variantName %>
                                        </td>
                                        <td>
                                        
                                            <div class="d-flex gap-2 justify-content-center">
                                        
                                                <% variant.variantImage.forEach(image=> { %>
                                        
                                                    <img src="<%= image %>" class="variant-img" alt="Variant image">
                                        
                                                    <% }) %>
                                        
                                            </div>
                                        
                                        </td>
                                        <td>
                                        
                                            <div class="d-flex flex-column align-items-center">
                                        
                                                <span style="
                                                        color: #2ecc71;
                                                        font-size: 18px;
                                                        font-weight: 700;
                                                    ">
                                        
                                                    ₹<%= variant.salePrice %>
                                        
                                                </span>
                                        
                                                <span style="
                                                        color: #888;
                                                        font-size: 13px;
                                                        text-decoration: line-through;
                                                    ">
                                        
                                                    ₹<%= variant.regularPrice %>
                                        
                                                </span>
                                        
                                            </div>
                                        
                                        </td>
                                        <td>
                                            <%= variant.stock %>
                                        </td>
                                        <td>
                                        
                                            <% if(variant.isListed){ %>
                                        
                                                <span class="status-listed">
                                                    Listed
                                                </span>
                                        
                                                <% } else { %>
                                        
                                                    <span class="status-unlisted">
                                                        Unlisted
                                                    </span>
                                        
                                                    <% } %>
                                        
                                        </td>
                                        <td>
                                            <div class="d-inline-flex gap-2">
                                                <a href="/admin/edit-variant/<%= variant._id %>"
                                                    class="btn-action-edit">Edit</a>
                                                <a href="/admin/toggle-variant/<%= variant._id %>" class="
                                                        <%= variant.isListed
                                                            ? 'btn-action-remove'
                                                            : 'btn-action-edit'
                                                        %>
                                                    ">
                                                
                                                    <%= variant.isListed ? 'Unlist' : 'List' %>
                                                
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                        <% } else { %>
                                            <tr>
                                                <td colspan="6" class="text-center py-5 text-muted">
                                                    No variants added for this product yet.
                                                </td>
                                            </tr>
                                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="footer-text">
            © 2026 onemore. All Rights Reserved.
        </div>
    </div>

</body>

</html>