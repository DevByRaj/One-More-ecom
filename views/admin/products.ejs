<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Product Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #000000;
            --card-bg: #0d0d0d;
            --accent-purple: #8a7df0;
            --text-muted: #888888;
            --btn-green: #2ecc71;
            --btn-orange: #e67e22;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 20px;
        }

        .dashboard-container {
            padding: 30px;
            min-height: 90vh;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 20px 10px;
            height: fit-content;
        }

        .nav-link {
            color: #ffffff;
            font-size: 13px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: 0.3s;
        }

        .nav-link i {
            font-size: 18px;
        }

        .nav-link:hover {
            color: var(--accent-purple);
        }

        .nav-link.active {
            color: var(--accent-purple);
            font-weight: 600;
        }

        /* --- HEADER / SEARCH PANEL --- */
        .search-container {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 20px;
            padding: 10px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .search-box {
            background: #ffffff;
            border-radius: 10px;
            display: flex;
            align-items: center;
            padding: 2px 15px;
            width: 250px;
        }

        .search-box input {
            border: none;
            outline: none;
            font-size: 14px;
            padding: 5px;
            width: 100%;
            color: #000;
        }

        .filter-tabs {
            display: flex;
            background: rgba(255, 255, 255, 0.05);
            padding: 5px;
            border-radius: 12px;
            gap: 5px;
        }

        .filter-link {
            text-decoration: none;
            color: var(--text-muted);
            font-size: 12px;
            font-weight: 500;
            padding: 6px 15px;
            border-radius: 8px;
            transition: 0.3s;
        }

        .filter-link:hover {
            color: #fff;
            background: rgba(138, 125, 240, 0.1);
        }

        .filter-link.active {
            background: var(--accent-purple);
            color: #000 !important;
            font-weight: 600;
        }

        /* --- TABLE CONTAINER --- */
        .table-container {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 20px;
        }

        .custom-table {
            color: #ffffff;
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 15px;
        }

        .custom-table thead {
            background: #1a1a1a;
        }

        .custom-table th {
            padding: 15px;
            font-weight: 500;
            font-size: 14px;
            border: none;
            text-align: center;
        }

        .custom-table td {
            padding: 15px;
            font-size: 13px;
            background-color: var(--card-bg);
            text-align: center;
            vertical-align: middle;
            border-bottom: 1px solid #222;
        }

        .product-img {
            width: 80px;
            height: 80px;
            object-fit: contain;
            border-radius: 10px;
        }

        .desc-box {
            width: 160px;
            height: 80px;
            overflow: hidden;
            border: 1px solid #444;
            border-radius: 8px;
            margin: 0 auto;
        }

        /* --- ACTION BUTTONS --- */
        .btn-variant {
            background-color: #ffffff;
            border-radius: 8px;
            padding: 5px 12px;
            font-size: 12px;
            font-weight: 600;
            border: none;
            color: black;
            text-decoration: none;
        }

        .btn-edit {
            background-color: var(--btn-green);
            border-radius: 8px;
            padding: 5px 12px;
            font-size: 12px;
            font-weight: 600;
            border: none;
            color: black;
            text-decoration: none;
        }

        .btn-remove {
            background-color: var(--btn-orange);
            border-radius: 8px;
            padding: 5px 12px;
            font-size: 12px;
            font-weight: 600;
            border: none;
            color: black;
            text-decoration: none;
        }

        .btn-add {
            border: 1px solid white;
            color: white;
            background: transparent;
            padding: 8px 20px;
            border-radius: 12px;
            margin-top: 20px;
            text-decoration: none;
            display: inline-block;
            font-size: 13px;
        }

        /* --- PAGINATION --- */
        .custom-pagination {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            margin-top: 30px;
        }

        .page-btn {
            background: #fff;
            color: #000;
            border-radius: 8px;
            padding: 5px 15px;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
        }

        .page-num {
            width: 35px;
            height: 35px;
            border: 1px solid #fff;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            text-decoration: none;
            font-size: 13px;
        }

        .page-num.active {
            border-color: var(--accent-purple);
            color: var(--accent-purple);
        }

        .footer-text {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 40px;
        }
    </style>
</head>

<body>
    <div class="dashboard-container container-fluid">
        <div class="row">
            <div class="col-lg-2 pe-lg-4">
                <div class="text-center mb-4">
                    <img src="/images/logo.png" alt="im" style="width: 60px;">
                </div>
                <div class="sidebar">
                    <nav class="nav flex-column">
                        <a class="nav-link" href="/admin/dashboard"><i class="bi bi-pie-chart"></i> Dashboard</a>
                        <a class="nav-link active" href="/admin/products"><i class="bi bi-grid"></i> Products</a>
                        <a class="nav-link" href="/admin/users"><i class="bi bi-person"></i> Customers</a>
                        <a class="nav-link" href="/admin/orders"><i class="bi bi-cart"></i> Orders</a>
                        <a class="nav-link" href="/admin/coupons"><i class="bi bi-ticket-perforated"></i> Coupons</a>
                        <a class="nav-link" href="/admin/category"><i class="bi bi-app-indicator"></i> Category</a>
                        <a class="nav-link" href="/admin/brand"><i class="bi bi-bag"></i> Brand</a>
                        <a class="nav-link" href="/admin/offers"><i class="bi bi-percent"></i> Offers</a>
                        <a class="nav-link" href="/admin/banner"><i class="bi bi-image"></i> Banner</a>
                        <a class="nav-link" href="/admin/sales-report"><i class="bi bi-bar-chart"></i> Sales Report</a>
                        <a class="nav-link mt-4" href="/admin/logout"><i class="bi bi-power"></i> Logout</a>
                    </nav>
                </div>
            </div>

            <div class="col-lg-10">
                <div class="search-container">
                    <div class="d-flex align-items-center gap-4">

                        <h4 class="mb-0" style="font-weight: 400; letter-spacing: 1px;">

                            Products

                        </h4>

                        <div class="filter-tabs">

                            <a href="/admin/products?search=<%= search || '' %>"
                                class="filter-link <%= !status ? 'active' : '' %>">

                                All

                            </a>

                            <a href="/admin/products?status=active&search=<%= search || '' %>"
                                class="filter-link <%= status === 'active' ? 'active' : '' %>">

                                Active

                            </a>

                            <a href="/admin/products?status=blocked&search=<%= search || '' %>"
                                class="filter-link <%= status === 'blocked' ? 'active' : '' %>">

                                Blocked

                            </a>

                        </div>

                    </div>

                    <div class="search-box">
                        <form action="/admin/products" method="GET" class="d-flex align-items-center w-100">
                            <i class="bi bi-search me-2" style="color: #000;"></i>
                            <input type="text" name="search" placeholder="Search" value="<%= search || '' %>">
                            <% if(search){ %>

                                <a href="/admin/products" style="color:red; text-decoration:none; font-weight:bold;">
                                    ×
                                </a>

                                <% } %>
                        </form>
                    </div>
                </div>

                <div class="table-container">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Sl.No</th>
                                <th>Brand</th>
                                <th>Image</th>
                                <th>Description</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>

                            <% if(products && products.length> 0){ %>

                                <% products.forEach((product, index)=> { %>

                                    <tr>

                                        <td>
                                            <%= (currentPage - 1) * 5 + (index + 1) %>
                                        </td>

                                        <td>
                                            <%= product.brand?.name || "No Brand" %>
                                        </td>

                                        <td>

                                            <img src="<%= product.productImage && product.productImage.length > 0
                                                    ? product.productImage[0]
                                                    : '/images/default-product.png'
                                                %>" class="product-img" alt="Product">

                                        </td>

                                        <td>

                                            <div class="desc-box d-flex align-items-center justify-content-center px-2">
                                                <small>
                                                    <%= product.description?.slice(0, 50) || 'No Description' %>
                                                </small>
                                            </div>

                                        </td>

                                        <td>
                                            <%= product.category?.name || 'No Category' %>
                                        </td>

                                        <td>
                                            <span class="
                                                <%= product.isListed
                                                    ? 'text-success'
                                                    : 'text-danger'
                                                %>
                                            ">
                                                <%= product.isListed ? 'Listed' : 'Unlisted' %>
                                            </span>
                                        </td>

                                        <td>

                                            <a href="#" class="btn-variant me-2">
                                                Variant
                                            </a>

                                            <a href="/admin/edit-product/<%= product._id %>" class="btn-edit me-2">
                                                Edit
                                            </a>

                                            <a href="/admin/toggle-product?id=<%= product._id %>" class="btn-remove">

                                                <%= product.isListed ? 'Unlist' : 'List' %>

                                            </a>

                                        </td>

                                    </tr>

                                    <% }) %>

                                        <% } else { %>

                                            <tr>

                                                <td colspan="5" class="text-center">
                                                    No products found
                                                </td>

                                            </tr>

                                            <% } %>

                        </tbody>
                    </table>

                    <a href="/admin/add-product" class="btn-add">Add new Product</a>

                    <% if(totalPages> 1){ %>

                        <div class="custom-pagination">

                            <% if(currentPage> 1){ %>

                                <a href="?page=<%= currentPage - 1 %>&search=<%= search || '' %>" class="page-btn">
                                    Previous
                                </a>

                                <% } %>


                                    <% for(let i=1; i <=totalPages; i++){ %>

                                        <a href="?page=<%= i %>&search=<%= search || '' %>"
                                            class="page-num <%= currentPage === i ? 'active' : '' %>">
                                            <%= i %>
                                        </a>

                                        <% } %>


                                            <% if(currentPage < totalPages){ %>

                                                <a href="?page=<%= currentPage + 1 %>&search=<%= search || '' %>"
                                                    class="page-btn">
                                                    Next
                                                </a>

                                                <% } %>

                        </div>

                        <% } %>
                </div>
            </div>
        </div>

        <div class="footer-text">
            © 2026 onemore. All Rights Reserved.
        </div>
    </div>
</body>

</html>