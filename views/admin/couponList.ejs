<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Coupons | OneMore</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts & Font Awesome -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-black: #000000;
            --panel-bg: #0b0b0c;
            --neon-purple: #7a56f5;
            --text-gray: #a0a0a5;
            --btn-green: #00c853;
            --btn-edit: #2ecc71;
            --btn-remove: #ff5722;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-black);
            color: #ffffff;
            margin: 0;
            padding: 20px;
        }

        .admin-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* ── LOGO HEADER ── */
        .admin-header {
            padding: 10px 20px;
            margin-bottom: 20px;
        }

        .admin-logo {
            height: 70px;
            width: auto;
            object-fit: contain;
        }

        /* ── MAIN GRID LAYOUT ── */
        .admin-layout-grid {
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 30px;
            align-items: start;
        }

        /* ── SIDEBAR STYLE ── */
        .admin-sidebar {
            background-color: var(--panel-bg);
            border: 2px solid var(--neon-purple);
            border-radius: 15px;
            padding: 25px 15px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sidebar-menu-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 20px;
            color: #ffffff;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .sidebar-menu-item i {
            width: 20px;
            font-size: 1.1rem;
            text-align: center;
            color: var(--text-gray);
        }

        .sidebar-menu-item:hover,
        .sidebar-menu-item.active {
            background-color: rgba(122, 86, 245, 0.15);
            color: #ffffff;
        }

        .sidebar-menu-item:hover i,
        .sidebar-menu-item.active i {
            color: var(--neon-purple);
        }

        /* ── MAIN CONTENT WORKSPACE ── */
        .main-content-area {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        /* Top Control Search Banner Box */
        .top-control-banner {
            background-color: var(--panel-bg);
            border: 1px solid var(--neon-purple);
            border-radius: 12px;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .top-control-banner h4 {
            margin: 0;
            font-weight: 600;
            font-size: 1.3rem;
            letter-spacing: 0.5px;
        }

        .search-input {
            background-color: #e2e8f0;
            border: none;
            border-radius: 20px;
            padding-left: 40px;
            color: #000;
            font-size: 0.9rem;
        }

        .search-wrapper {
            position: relative;
            width: 280px;
        }

        .search-wrapper i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #6c757d;
        }

        /* ── DATA PANEL CONTAINER ── */
        .data-panel {
            background-color: var(--panel-bg);
            border: 1px solid var(--neon-purple);
            border-radius: 15px;
            padding: 25px;
        }

        /* Custom Table Styling */
        .custom-table {
            color: #151212;
            vertical-align: middle;
        }

        .custom-table thead th {
            background-color: #1a1a1c;
            color: var(--text-gray);
            border: none;
            padding: 12px 16px;
            font-weight: 600;
            font-size: 0.85rem;
        }

        .custom-table thead th:first-child {
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
        }

        .custom-table thead th:last-child {
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }

        .custom-table tbody td {
            padding: 20px 16px;
            border-bottom: 1px solid #ffffff;
            font-size: 0.9rem;
        }

        /* Action Buttons */
        .btn-action-edit {
            background-color: var(--btn-edit);
            color: #000;
            font-weight: 500;
            border: none;
            padding: 5px 16px;
            border-radius: 4px;
            font-size: 0.85rem;
            text-decoration: none;
        }

        .btn-action-remove {
            background-color: var(--btn-remove);
            color: #fff;
            font-weight: 500;
            border: none;
            padding: 5px 16px;
            border-radius: 4px;
            font-size: 0.85rem;
        }

        .btn-add-coupon {
            border: 1px solid #ffffff;
            color: #ffffff;
            background: transparent;
            padding: 8px 24px;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.2s;
            text-decoration: none;
        }

        .btn-add-coupon:hover {
            background: #ffffff;
            color: #000000;
        }

        /* Custom Pagination */
        .custom-pagination .page-btn {
            background-color: transparent;
            border: 1px solid #555;
            color: #fff;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            font-size: 0.85rem;
        }

        .custom-pagination .page-btn.active {
            border-color: #fff;
        }

        .custom-pagination .btn-nav {
            background-color: #e2e8f0;
            color: #000;
            border: none;
            border-radius: 8px;
            padding: 6px 16px;
            font-weight: 600;
            font-size: 0.85rem;
            text-decoration: none;
        }

        .admin-footer {
            text-align: center;
            color: var(--text-gray);
            font-size: 0.8rem;
            margin-top: 40px;
            padding-bottom: 20px;
        }

        @media (max-width: 992px) {
            .admin-layout-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <div class="admin-container">
        <!-- Logo Branding Header Area -->
        <div class="admin-header">
            <img src="/images/logo.png" class="admin-logo" alt="OneMore Logo">
        </div>

        <div class="admin-layout-grid">
            <!-- Sidebar Navigation Column -->
            <aside class="admin-sidebar">
                <a href="/admin/dashboard" class="sidebar-menu-item"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
                <a href="/admin/products" class="sidebar-menu-item"><i class="fa-solid fa-cubes"></i> Products</a>
                <a href="/admin/customers" class="sidebar-menu-item"><i class="fa-solid fa-users"></i> Customers</a>
                <a href="/admin/orders" class="sidebar-menu-item"><i class="fa-solid fa-cart-shopping"></i> Orders</a>
                <a href="/admin/coupons" class="sidebar-menu-item active"><i class="fa-solid fa-ticket"></i> Coupons</a>
                <a href="/admin/category" class="sidebar-menu-item"><i class="fa-solid fa-folder-tree"></i> Category</a>
                <a href="/admin/brand" class="sidebar-menu-item"><i class="fa-solid fa-copyright"></i> Brand</a>
                <a href="/admin/offers" class="sidebar-menu-item"><i class="fa-solid fa-percent"></i> Offers</a>
                <a href="/admin/banner" class="sidebar-menu-item"><i class="fa-solid fa-image"></i> Banner</a>
                <a href="/admin/sales-report" class="sidebar-menu-item"><i class="fa-solid fa-chart-line"></i> Sales
                    Report</a>
                <a href="/admin/logout" class="sidebar-menu-item mt-4"><i class="fa-solid fa-power-off"></i> Logout</a>
            </aside>

            <!-- Main Interactive Display Workspace Context -->
            <main class="main-content-area">

                <!-- Search & Header Bar -->
                <div class="top-control-banner">
                    <h4>Coupons</h4>
                    <form action="/admin/coupons" method="GET" class="search-wrapper">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" name="search" class="form-control search-input" placeholder="Search"
                            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
                    </form>
                </div>

                <!-- Coupons Table Section -->
                <div class="data-panel d-flex flex-column justify-content-between min-vh-50">
                    <div>
                        <div class="table-responsive">
                            <table class="table custom-table text-center align-middle">
                                <thead>
                                    <tr>
                                        <th class="text-start ps-4">Coupon Code</th>
                                        <th>Discount</th>
                                        <th>Start Date</th>
                                        <th>Expiry Date</th>
                                        <th>Max Amount</th>
                                        <th>Min Amount</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (coupons && coupons.length> 0) { %>
                                        <% coupons.forEach(coupon=> { %>
                                            <tr>
                                                <td class="text-start ps-4 fw-medium">
                                                    <%= coupon.couponCode %>
                                                </td>
                                                <td>
                                                    <% if(coupon.discountType==="PERCENTAGE" ){ %>
                                                        <%= coupon.discountValue %>%
                                                            <% } else { %>
                                                                ₹<%= coupon.discountValue %>
                                                                    <% } %>
                                                </td>
                                                <td>
                                                    <%= new Date(coupon.startDate).toLocaleDateString('en-GB') %>
                                                </td>
                                                <td>
                                                    <%= new Date(coupon.endDate).toLocaleDateString('en-GB') %>
                                                </td>
                                                <td>
                                                    <%= coupon.maximumDiscount !==null ? coupon.maximumDiscount
                                                        : "No Limit" %>
                                                </td>
                                                <td>
                                                    <%= coupon.minimumPurchase %>
                                                </td>
                                                <td>
                                                    <div class="d-flex justify-content-center gap-2">
                                                        <a href="/coupons/edit/<%= coupon._id %>"
                                                            class="btn btn-action-edit">Edit</a>
                                                        <form action="/coupons/delete/<%= coupon._id %>?_method=DELETE"
                                                            method="POST" class="d-inline">
                                                            <button type="submit" class="btn btn-action-remove"
                                                                onclick="return confirm('Are you sure?')">Remove</button>
                                                        </form>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }) %>
                                                <% } else { %>
                                                    <tr>
                                                        <td colspan="7" class="text-center py-4 text-muted">No coupons
                                                            found.</td>
                                                    </tr>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Add Button & Pagination Controls -->
                    <div class="mt-4">
                        <div class="d-flex justify-content-end mb-4">
                            <a href="/admin/coupons/add" class="btn btn-add-coupon">Add Coupons</a>
                        </div>

                        <!-- Pagination -->
                        <% if (typeof totalPages !=='undefined' && totalPages> 1) { %>
                            <div class="d-flex justify-content-center align-items-center gap-2 custom-pagination">
                                <% if (currentPage> 1) { %>
                                    <a href="/coupons?page=<%= currentPage - 1 %>" class="btn-nav">Previous</a>
                                    <% } else { %>
                                        <button class="btn-nav opacity-50" disabled>Previous</button>
                                        <% } %>

                                            <% for(let i=1; i <=totalPages; i++) { %>
                                                <a href="/coupons?page=<%= i %>"
                                                    class="page-btn <%= currentPage === i ? 'active' : '' %>">
                                                    <%= i %>
                                                </a>
                                                <% } %>

                                                    <% if (currentPage < totalPages) { %>
                                                        <a href="/coupons?page=<%= currentPage + 1 %>"
                                                            class="btn-nav">Next</a>
                                                        <% } else { %>
                                                            <button class="btn-nav opacity-50" disabled>Next</button>
                                                            <% } %>
                            </div>
                            <% } %>
                    </div>
                </div>
            </main>
        </div>

        <!-- Footer -->
        <footer class="admin-footer">
            © 2026 onemore. All Rights Reserved.
        </footer>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>