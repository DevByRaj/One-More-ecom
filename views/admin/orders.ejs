<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Orders | OneMore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-black: #000000;
            --panel-bg: #0b0b0c;
            --neon-purple: #7a56f5;
            --text-gray: #a0a0a5;
            --btn-green: #00c853;
            --status-delivered: #2ec4b6;
            --status-cancelled: #e61f26;
            --status-processing: #ff9f43;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-black);
            color: #ffffff;
            margin: 0;
            padding: 20px;
        }

        .admin-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* ── LOGO HEADER ── */
        .admin-header {
            padding: 10px 20px;
            margin-bottom: 20px;
        }

        .admin-logo {
            height: 70px;
            width: auto;
            object-fit: contain;
        }

        /* ── MAIN GRID LAYOUT ── */
        .admin-layout-grid {
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 30px;
            align-items: start;
        }

        /* ── SIDEBAR STYLE ── */
        .admin-sidebar {
            background-color: var(--panel-bg);
            border: 2px solid var(--neon-purple);
            border-radius: 15px;
            padding: 25px 15px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sidebar-menu-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 20px;
            color: #ffffff;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .sidebar-menu-item i {
            width: 20px;
            font-size: 1.1rem;
            text-align: center;
            color: var(--text-gray);
        }

        .sidebar-menu-item:hover,
        .sidebar-menu-item.active {
            background-color: rgba(122, 86, 245, 0.15);
            color: #ffffff;
        }

        .sidebar-menu-item:hover i,
        .sidebar-menu-item.active i {
            color: var(--neon-purple);
        }

        /* ── MAIN CONTENT WORKSPACE ── */
        .main-content-area {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        /* Top Control Search Banner Box */
        .top-control-banner {
            background-color: var(--panel-bg);
            border: 1px solid var(--neon-purple);
            border-radius: 12px;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .top-control-banner h4 {
            margin: 0;
            font-weight: 600;
            font-size: 1.3rem;
            letter-spacing: 0.5px;
        }

        .search-wrapper-box {
            position: relative;
            width: 280px;
        }

        .search-wrapper-box input {
            width: 100%;
            background-color: #e0e0e0;
            color: #000000;
            border: none;
            border-radius: 20px;
            padding: 6px 15px 6px 40px;
            font-size: 0.85rem;
            font-weight: 500;
        }

        .search-wrapper-box i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #666666;
            font-size: 0.9rem;
        }

        /* ── DATA PANEL CONTAINER ── */
        .orders-data-panel {
            background-color: var(--panel-bg);
            border: 1px solid var(--neon-purple);
            border-radius: 15px;
            padding: 25px;
        }

        /* Responsive Custom Grid Table Row layout */
        .order-table-header {
            display: grid;
            grid-template-columns: 1.5fr 1.4fr 1.4fr 1.3fr 1fr 1.3fr;
            background-color: #1a1a1c;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text-gray);
            margin-bottom: 15px;
        }

        .order-table-row {
            display: grid;
            grid-template-columns: 1.5fr 1.4fr 1.4fr 1.3fr 1fr 1.3fr;
            align-items: center;
            padding: 25px 20px;
            border-bottom: 1px solid #1f1f22;
            font-size: 0.9rem;
        }

        .orders-data-panel .order-table-row:last-of-type {
            border-bottom: none;
        }

        /* Contextual Status text fields */
        .status-txt-field {
            font-weight: 600;
        }

        .status-txt-field.delivered {
            color: var(--status-delivered);
        }

        .status-txt-field.cancelled {
            color: var(--status-cancelled);
        }

        .status-txt-field.processing {
            color: var(--status-processing);
        }

        .more-details-btn {
            background-color: var(--btn-green);
            color: #000000;
            border: none;
            border-radius: 6px;
            padding: 6px 16px;
            font-size: 0.8rem;
            font-weight: 700;
            text-decoration: none;
            text-align: center;
            transition: opacity 0.2s;
        }

        .more-details-btn:hover {
            opacity: 0.9;
            color: #000000;
        }

        /* ── PAGINATION SYSTEM ── */
        .admin-pagination-box {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin-top: 30px;
        }

        .admin-page-nav {
            background-color: #ffffff;
            color: #000000;
            border: none;
            border-radius: 6px;
            padding: 5px 15px;
            font-size: 0.8rem;
            font-weight: 600;
            text-decoration: none;
        }

        .admin-page-circle {
            width: 28px;
            height: 28px;
            border: 1px solid var(--text-gray);
            border-radius: 50%;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            text-decoration: none;
        }

        .admin-page-circle.active {
            background-color: #ffffff;
            color: #000000;
            border-color: #ffffff;
            font-weight: 600;
        }

        .admin-footer {
            text-align: center;
            color: var(--text-gray);
            font-size: 0.8rem;
            margin-top: 40px;
            padding-bottom: 20px;
        }

        /* Responsive Breakpoints UI */
        @media (max-width: 992px) {
            .admin-layout-grid {
                grid-template-columns: 1fr;
            }

            .order-table-header,
            .order-table-row {
                grid-template-columns: 1fr 1fr 1fr;
                gap: 10px;
            }

            .order-table-header div:nth-child(4),
            .order-table-header div:nth-child(5),
            .order-table-row div:nth-child(4),
            .order-table-row div:nth-child(5) {
                display: none;
                /* Hide transient parameters on tablets */
            }
        }
    </style>
</head>

<body>

    <div class="admin-container">
        <!-- Logo Branding Header Header Area -->
        <div class="admin-header">
            <img src="/images/logo.png" class="admin-logo" alt="OneMore Logo">
        </div>

        <div class="admin-layout-grid">
            <!-- Sidebar Left Navigation Column Box Component -->
            <aside class="admin-sidebar">
                <a href="/admin/dashboard" class="sidebar-menu-item"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
                <a href="/admin/products" class="sidebar-menu-item"><i class="fa-solid fa-cubes"></i> Products</a>
                <a href="/admin/customers" class="sidebar-menu-item"><i class="fa-solid fa-users"></i> Customers</a>
                <a href="/admin/orders" class="sidebar-menu-item active"><i class="fa-solid fa-cart-shopping"></i>
                    Orders</a>
                <a href="/admin/coupons" class="sidebar-menu-item"><i class="fa-solid fa-ticket"></i> Coupons</a>
                <a href="/admin/category" class="sidebar-menu-item"><i class="fa-solid fa-folder-tree"></i> Category</a>
                <a href="/admin/brand" class="sidebar-menu-item"><i class="fa-solid fa-copyright"></i> Brand</a>
                <a href="/admin/offers" class="sidebar-menu-item"><i class="fa-solid fa-percent"></i> Offers</a>
                <a href="/admin/banner" class="sidebar-menu-item"><i class="fa-solid fa-image"></i> Banner</a>
                <a href="/admin/sales-report" class="sidebar-menu-item"><i class="fa-solid fa-chart-line"></i> Sales
                    Report</a>
                <a href="/admin/logout" class="sidebar-menu-item mt-4"><i class="fa-solid fa-power-off"></i> Logout</a>
            </aside>

            <!-- Main Interactive Display Workspace Context -->
            <main class="main-content-area">
                <!-- Search Control Header Section Block -->
                <div class="top-control-banner">
                    <h4>Orders</h4>
                
                    <div class="d-flex align-items-center gap-2">
                
                        <form action="/admin/orders" method="GET" class="search-wrapper-box">
                
                            <input type="hidden" name="status" value="<%= status %>">
                
                            <i class="fa-solid fa-magnifying-glass"></i>
                
                            <input type="text" name="search" value="<%= search %>" placeholder="Search Order ID / Customer">
                
                        </form>
                
                        <form action="/admin/orders" method="GET">
                
                            <input type="hidden" name="search" value="<%= search %>">
                
                            <select name="status" onchange="this.form.submit()" class="form-select form-select-sm">
                
                                <option value="">All Status</option>
                
                                <option value="Pending" <%=status==="Pending" ? "selected" : "" %>>
                                    Pending
                                </option>
                
                                <option value="Processing" <%=status==="Processing" ? "selected" : "" %>>
                                    Processing
                                </option>
                
                                <option value="Shipped" <%=status==="Shipped" ? "selected" : "" %>>
                                    Shipped
                                </option>
                
                                <option value="Out For Delivery" <%=status==="Out For Delivery" ? "selected" : "" %>>
                                    Out For Delivery
                                </option>
                
                                <option value="Delivered" <%=status==="Delivered" ? "selected" : "" %>>
                                    Delivered
                                </option>
                
                                <option value="Cancelled" <%=status==="Cancelled" ? "selected" : "" %>>
                                    Cancelled
                                </option>
                
                                <option value="Return Requested" <%=status==="Return Requested" ? "selected" : "" %>>
                                    Return Requested
                                </option>
                
                                <option value="Returned" <%=status==="Returned" ? "selected" : "" %>>
                                    Returned
                                </option>
                
                            </select>
                
                        </form>
                
                    </div>
                </div>

                <!-- Structured Dynamic Native Orders Grid Container -->
                <div class="orders-data-panel">
                    <div class="order-table-header">
                        <div>Id</div>
                        <div>Name</div>
                        <div>Payment</div>
                        <div>Status</div>
                        <div>Price</div>
                        <div>Action</div>
                    </div>

                    <!-- Dynamic Backend Data Matrix Loop Interface -->
                    <% if(orders && orders.length> 0) { %>
                        <% orders.forEach((item, index)=> { %>
                            <div class="order-item-row order-table-row">
                                <div title="<%= item.orderId %>">
                                    <%= item.orderId %>
                                </div>
                                <div>
                                    <%= item.userId.name %>
                                </div>
                                <div>
                                    <%= item.paymentMethod %>
                                </div>
                                <div>
                                    <span class="status-txt-field <%= (item.orderStatus || '').toLowerCase().replace(/\s+/g, '-') %>">
                                        <%= item.orderStatus %>
                                    </span>
                                </div>
                                <div>₹<%= Number(item.grandTotal).toFixed(2) %>
                                </div>
                                <div>
                                    <a href="/admin/orders/<%= item._id %>" class="more-details-btn">
                                    
                                        More Details
                                    
                                    </a>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div class="text-center py-4 text-muted">No processing orders found.</div>
                                    <% } %>

                </div>

            <% if (totalPages> 1) { %>
            
                <div class="admin-pagination-box">
            
                    <% if(currentPage> 1){ %>
                        <a href="/admin/orders?page=<%= currentPage - 1 %>&search=<%= search %>" class="admin-page-nav">
                            Previous
                        </a>
                        <% } %>
            
                            <% for(let i=1; i <=totalPages; i++){ %>
            
                                <a href="/admin/orders?page=<%= i %>&search=<%= search %>&status=<%= status %>"
                                    class="admin-page-circle <%= currentPage === i ? 'active' : '' %>">
                                    <%= i %>
                                </a>
            
                                <% } %>
            
                                    <% if(currentPage < totalPages){ %>
                                        <a href="/admin/orders?page=<%= currentPage + 1 %>&search=<%= search %>" class="admin-page-nav">
                                            Next
                                        </a>
                                        <% } %>
            
                </div>
            
                <% } %>
            </main>
        </div>

        <footer class="admin-footer">
            © 2026 onemore. All Rights Reserved.
        </footer>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>