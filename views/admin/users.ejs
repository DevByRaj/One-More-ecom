<!DOCTYPE html>
<html lang="en">

<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Admin - Customer Management</title>
 <!-- Bootstrap 5 -->
 <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
 <!-- Bootstrap Icons -->
 <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
 <!-- Google Font: Poppins -->
 <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

 <style>
  :root {
   --bg-dark: #000000;
   --card-bg: #0d0d0d;
   --accent-purple: #8a7df0;
   --text-muted: #888888;
   --btn-green: #00c853;
   --btn-orange: #ff6d00;
  }

  body {
   background-color: var(--bg-dark);
   color: #ffffff;
   font-family: 'Poppins', sans-serif;
   margin: 0;
   padding: 20px;
  }

  .dashboard-container {
   padding: 30px;
   min-height: 90vh;
  }

  /* --- SIDEBAR --- */
  .sidebar {
   background-color: var(--card-bg);
   border: 2px solid var(--accent-purple);
   border-radius: 25px;
   padding: 20px 10px;
   height: fit-content;
  }

  .nav-link {
   color: #ffffff;
   font-size: 13px;
   padding: 12px 20px;
   display: flex;
   align-items: center;
   gap: 15px;
   transition: 0.3s;
  }

  .nav-link i {
   font-size: 18px;
  }

  .nav-link:hover {
   color: var(--accent-purple);
  }

  .nav-link.active {
   color: var(--accent-purple);
   font-weight: 600;
  }

  /* --- TOP SEARCH BAR --- */
  .search-container {
   background-color: var(--card-bg);
   border: 2px solid var(--accent-purple);
   border-radius: 20px;
   padding: 10px 25px;
   display: flex;
   justify-content: space-between;
   align-items: center;
   margin-bottom: 25px;
  }

  .search-box {
   background: #ffffff;
   border-radius: 10px;
   display: flex;
   align-items: center;
   padding: 2px 15px;
   width: 250px;
  }

  .search-box input {
   border: none;
   outline: none;
   font-size: 14px;
   padding: 5px;
   width: 100%;
   color: #000;
  }

  .search-box i {
   color: #000;
  }

  /* --- NEW FILTER TAB STYLES --- */
  .filter-tabs {
   display: flex;
   background: rgba(255, 255, 255, 0.05);
   padding: 5px;
   border-radius: 12px;
   gap: 5px;
  }

  .filter-link {
   text-decoration: none;
   color: var(--text-muted);
   font-size: 12px;
   font-weight: 500;
   padding: 6px 15px;
   border-radius: 8px;
   transition: 0.3s;
  }

  .filter-link:hover {
   color: #fff;
   background: rgba(138, 125, 240, 0.1);
  }

  .filter-link.active {
   background: var(--accent-purple);
   color: #000 !important;
   font-weight: 600;
  }

  /* --- TABLE CONTAINER --- */
  .table-container {
   background-color: var(--card-bg);
   border: 2px solid var(--accent-purple);
   border-radius: 25px;
   padding: 20px;
  }

  .custom-table {
   color: #ffffff;
   width: 100%;
   border-collapse: separate;
   border-spacing: 0 15px;
  }

  .custom-table thead {
   background: #1a1a1a;
  }

  .custom-table th {
   padding: 15px;
   font-weight: 500;
   font-size: 14px;
   border: none;
   text-align: center;
  }

  .custom-table td {
   padding: 15px;
   font-size: 13px;
   background-color: var(--card-bg);
   text-align: center;
   vertical-align: middle;
   border-bottom: 1px solid #222;
  }

  /* --- ACTION BUTTONS --- */
  .btn-action {
   border-radius: 8px;
   padding: 5px 15px;
   font-size: 12px;
   font-weight: 600;
   border: none;
   margin: 0 5px;
  }

  .btn-unblock {
   background-color: var(--btn-green);
   color: #fff;
  }

  .btn-block {
   background-color: var(--btn-orange);
   color: #fff;
  }

  /* --- PAGINATION --- */
  .custom-pagination {
   display: flex;
   justify-content: center;
   align-items: center;
   gap: 15px;
   margin-top: 30px;
  }

  .page-btn {
   background: #fff;
   color: #000;
   border-radius: 8px;
   padding: 5px 15px;
   font-size: 13px;
   font-weight: 600;
   text-decoration: none;
  }

  .page-num {
   width: 35px;
   height: 35px;
   border: 1px solid #fff;
   border-radius: 50%;
   display: flex;
   align-items: center;
   justify-content: center;
   color: #fff;
   text-decoration: none;
   font-size: 13px;
  }

  .page-num.active {
   border-color: var(--accent-purple);
   color: var(--accent-purple);
  }

  .footer-text {
   text-align: center;
   font-size: 12px;
   color: var(--text-muted);
   margin-top: 40px;
  }

  /* 🔥 MODAL */
  .custom-modal {
   position: fixed;
   top: 0;
   left: 0;
   width: 100%;
   height: 100%;
   background: rgba(0, 0, 0, 0.7);
   display: none;
   justify-content: center;
   align-items: center;
   z-index: 999;
  }

  .modal-box {
   background: #111;
   border: 2px solid #8a7df0;
   border-radius: 15px;
   padding: 25px;
   width: 300px;
   text-align: center;
  }

  .modal-box h5 {
   margin-bottom: 20px;
  }

  .modal-actions {
   display: flex;
   justify-content: space-between;
  }

  .cancel-btn {
   background: #555;
   color: white;
   border: none;
   padding: 6px 15px;
   border-radius: 8px;
  }

  .confirm-btn {
   background: #ff6d00;
   color: white;
   border: none;
   padding: 6px 15px;
   border-radius: 8px;
  }
 </style>
</head>

<body>

 <div class="dashboard-container container-fluid">
  <div class="row">
   <!-- Sidebar -->
   <div class="col-lg-2 pe-lg-4">
    <div class="text-center mb-4">
     <img src="/images/logo.png" alt="IM" style="width: 60px;">
    </div>
    <div class="sidebar">
     <nav class="nav flex-column">
      <a class="nav-link" href="/admin/dashboard"><i class="bi bi-pie-chart"></i> Dashboard</a>
      <a class="nav-link" href="/admin/products"><i class="bi bi-grid"></i> Products</a>
      <a class="nav-link active" href="/admin/users"><i class="bi bi-person"></i> Customers</a>
      <a class="nav-link" href="/admin/orders"><i class="bi bi-cart"></i> Orders</a>
      <a class="nav-link" href="/admin/coupons"><i class="bi bi-ticket-perforated"></i> Coupons</a>
      <a class="nav-link" href="/admin/category"><i class="bi bi-app-indicator"></i> Category</a>
      <a class="nav-link" href="/admin/brand"><i class="bi bi-bag"></i> Brand</a>
      <a class="nav-link" href="/admin/offers"><i class="bi bi-percent"></i> Offers</a>
      <a class="nav-link" href="/admin/banner"><i class="bi bi-image"></i> Banner</a>
      <a class="nav-link" href="/admin/sales-report"><i class="bi bi-bar-chart"></i> Sales Report</a>
      <a class="nav-link mt-4" href="/admin/logout"><i class="bi bi-power"></i> Logout</a>
     </nav>
    </div>
   </div>

   <!-- Main Content -->
   <div class="col-lg-10">
    <!-- Top Header Search & Filters -->
    <div class="search-container">
     <div class="d-flex align-items-center gap-4">
      <h4 class="mb-0" style="font-weight: 400; letter-spacing: 1px;">Customers</h4>

      <!-- Filter Tabs -->
      <div class="filter-tabs">
       <a href="/admin/users?search=<%= search %>" class="filter-link <%= !status ? 'active' : '' %>">All</a>
       <a href="/admin/users?status=active&search=<%= search %>"
        class="filter-link <%= status === 'active' ? 'active' : '' %>">Active</a>
       <a href="/admin/users?status=blocked&search=<%= search %>"
        class="filter-link <%= status === 'blocked' ? 'active' : '' %>">Blocked</a>
      </div>
     </div>

     <div class="search-box">
      <form method="GET" action="/admin/users" class="search-box m-0 p-0"
       style="background:none;border:none;width:100%;">

       <i class="bi bi-search"></i>

       <input type="text" name="search" placeholder="Search" value="<%= search || '' %>">

       <!-- keep filter -->
       <% if (status) { %>
        <input type="hidden" name="status" value="<%= status %>">
        <% } %>

         <!-- 🔥 CLEAR BUTTON -->
         <% if (search) { %>
          <a href="/admin/users?status=<%= status %>"
           style="margin-left:5px; color:#000; font-weight:bold; text-decoration:none;">
           ✕
          </a>
          <% } %>

      </form>
     </div>
    </div>

    <!-- User Table -->
    <div class="table-container">
     <table class="custom-table">
      <thead>
       <tr>
        <th>Id</th>
        <th>Name</th>
        <th>Email</th>
        <th>Mobile</th>
        <th>Address</th>
        <th>Action</th>
       </tr>
      </thead>
      <tbody>
       <% users.forEach((user, index)=> { %>
        <tr>
        <td>
          <%= (currentPage - 1) * 6 + index + 1 %>
        </td>
         <td>
          <%= user.name %>
         </td>
         <td>
          <%= user.email %>
         </td>
         <td>
          <%= user.phone || "N/A" %>
         </td>
         <td>
          <%= user.address || "No Address" %>
         </td>
         <td>
          <button type="button" class="btn-action <%= user.isBlocked ? 'btn-unblock' : 'btn-block' %>"
           onclick="openConfirmModal('<%= user._id %>', <%= user.isBlocked %>)">
           <%= user.isBlocked ? 'Unblock' : 'Block' %>
          </button>
         </td>
        </tr>
        <% }) %>
      </tbody>
     </table>

     <form id="blockForm" method="POST"></form>

     <!-- Pagination -->
     <div class="custom-pagination">
      <!-- Previous -->
      <% if (currentPage> 1) { %>
       <a href="/admin/users?page=<%= currentPage - 1 %>&search=<%= search %>&status=<%= status %>" class="page-btn">
        Previous
       </a>
       <% } %>

        <!-- Page Numbers -->
        <% for (let i=1; i <=totalPages; i++) { %>
         <a href="/admin/users?page=<%= i %>&search=<%= search %>&status=<%= status %>"
          class="page-num <%= i === currentPage ? 'active' : '' %>">
          <%= i %>
         </a>
         <% } %>

          <!-- Next -->
          <% if (currentPage < totalPages) { %>
           <a href="/admin/users?page=<%= currentPage + 1 %>&search=<%= search %>&status=<%= status %>"
            class="page-btn">
            Next
           </a>
           <% } %>
     </div>
    </div>
   </div>
  </div>

  <div class="footer-text">
   © 2026 onemore. All Rights Reserved.
  </div>
 </div>

 <!-- Modal -->
 <div id="confirmModal" class="custom-modal">
  <div class="modal-box">
   <h5 id="modalText">Are you sure?</h5>
   <div class="modal-actions">
    <button class="cancel-btn" onclick="closeModal()">Cancel</button>
    <button class="confirm-btn" onclick="submitAction()">Confirm</button>
   </div>
  </div>
 </div>

 <script>
  let selectedUserId = null;
  let isBlockedState = false;

  function openConfirmModal(userId, isBlocked) {
   selectedUserId = userId;
   isBlockedState = isBlocked;

   const modal = document.getElementById("confirmModal");
   const text = document.getElementById("modalText");

   text.innerText = isBlocked
    ? "Do you want to UNBLOCK this user?"
    : "Do you want to BLOCK this user?";

   modal.style.display = "flex";
  }

  function closeModal() {
   document.getElementById("confirmModal").style.display = "none";
  }

  function submitAction() {
   const form = document.getElementById("blockForm");
   form.action = `/admin/users/toggle-block/${selectedUserId}`;
   form.submit();
  }
 </script>
</body>

</html>