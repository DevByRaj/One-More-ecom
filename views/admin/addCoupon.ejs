<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= coupon ? 'Edit Coupon' : 'Add Coupon' %> | OneMore
    </title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts & Font Awesome -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-black: #000000;
            --panel-bg: #0b0b0c;
            --neon-purple: #7a56f5;
            --text-gray: #a0a0a5;
            --input-bg: #1a1a1c;
            --btn-green: #00c853;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-black);
            color: #ffffff;
            margin: 0;
            padding: 20px;
        }

        .admin-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* ── LOGO HEADER ── */
        .admin-header {
            padding: 10px 20px;
            margin-bottom: 20px;
        }

        .admin-logo {
            height: 70px;
            width: auto;
            object-fit: contain;
        }

        /* ── MAIN GRID LAYOUT ── */
        .admin-layout-grid {
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 30px;
            align-items: start;
        }

        /* ── SIDEBAR STYLE ── */
        .admin-sidebar {
            background-color: var(--panel-bg);
            border: 2px solid var(--neon-purple);
            border-radius: 15px;
            padding: 25px 15px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sidebar-menu-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 20px;
            color: #ffffff;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .sidebar-menu-item i {
            width: 20px;
            font-size: 1.1rem;
            text-align: center;
            color: var(--text-gray);
        }

        .sidebar-menu-item:hover,
        .sidebar-menu-item.active {
            background-color: rgba(122, 86, 245, 0.15);
            color: #ffffff;
        }

        .sidebar-menu-item:hover i,
        .sidebar-menu-item.active i {
            color: var(--neon-purple);
        }

        /* ── MAIN CONTENT WORKSPACE ── */
        .main-content-area {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        /* Top Control Banner Box */
        .top-control-banner {
            background-color: var(--panel-bg);
            border: 1px solid var(--neon-purple);
            border-radius: 12px;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .top-control-banner h4 {
            margin: 0;
            font-weight: 600;
            font-size: 1.3rem;
            letter-spacing: 0.5px;
        }

        /* ── DATA PANEL CONTAINER ── */
        .data-panel {
            background-color: var(--panel-bg);
            border: 1px solid var(--neon-purple);
            border-radius: 15px;
            padding: 35px;
        }

        /* Form Control Styling */
        .form-label {
            color: #ffffff;
            font-size: 0.9rem;
            margin-bottom: 8px;
            font-weight: 500;
        }

        .form-control,
        .form-select {
            background-color: var(--input-bg);
            border: 1px solid #2a2a2d;
            border-radius: 10px;
            color: #ffffff;
            padding: 10px 18px;
            font-size: 0.9rem;
            transition: all 0.2s ease;
        }

        .form-control:focus,
        .form-select:focus {
            background-color: var(--input-bg);
            color: #ffffff;
            border-color: var(--neon-purple);
            box-shadow: 0 0 0 0.25rem rgba(122, 86, 245, 0.25);
        }

        .form-control::placeholder {
            color: #666;
        }

        .form-select {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23ffffff'%3e%3cpath fill-rule='evenodd' d='M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z'/%3e%3c/svg%3e");
        }

        input[type="date"]::-webkit-calendar-picker-indicator {
            filter: invert(1);
            cursor: pointer;
        }

        textarea.form-control {
            border-radius: 12px;
            resize: none;
        }

        /* Submit Button */
        .btn-add-coupon {
            border: 1px solid #ffffff;
            color: #ffffff;
            background: transparent;
            padding: 8px 24px;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.2s;
        }

        .btn-add-coupon:hover {
            background: #ffffff;
            color: #000000;
        }

        .admin-footer {
            text-align: center;
            color: var(--text-gray);
            font-size: 0.8rem;
            margin-top: 40px;
            padding-bottom: 20px;
        }

        @media (max-width: 992px) {
            .admin-layout-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <div class="admin-container">
        <!-- Logo Branding Header Area -->
        <div class="admin-header">
            <img src="/images/logo.png" class="admin-logo" alt="OneMore Logo">
        </div>

        <div class="admin-layout-grid">
            <!-- Sidebar Navigation Column -->
            <aside class="admin-sidebar">
                <a href="/admin/dashboard" class="sidebar-menu-item"><i class="fa-solid fa-chart-pie"></i> Dashboard</a>
                <a href="/admin/products" class="sidebar-menu-item"><i class="fa-solid fa-cubes"></i> Products</a>
                <a href="/admin/customers" class="sidebar-menu-item"><i class="fa-solid fa-users"></i> Customers</a>
                <a href="/admin/orders" class="sidebar-menu-item"><i class="fa-solid fa-cart-shopping"></i> Orders</a>
                <a href="/admin/coupons" class="sidebar-menu-item active"><i class="fa-solid fa-ticket"></i> Coupons</a>
                <a href="/admin/category" class="sidebar-menu-item"><i class="fa-solid fa-folder-tree"></i> Category</a>
                <a href="/admin/brand" class="sidebar-menu-item"><i class="fa-solid fa-copyright"></i> Brand</a>
                <a href="/admin/offers" class="sidebar-menu-item"><i class="fa-solid fa-percent"></i> Offers</a>
                <a href="/admin/banner" class="sidebar-menu-item"><i class="fa-solid fa-image"></i> Banner</a>
                <a href="/admin/sales-report" class="sidebar-menu-item"><i class="fa-solid fa-chart-line"></i> Sales
                    Report</a>
                <a href="/admin/logout" class="sidebar-menu-item mt-4"><i class="fa-solid fa-power-off"></i> Logout</a>
            </aside>

            <!-- Main Interactive Display Workspace Context -->
            <main class="main-content-area">

                <!-- Title Top Control Banner -->
                <div class="top-control-banner">
                <h4>
                    <%= coupon ? 'Edit Coupon' : 'Add Coupon' %>
                </h4>
                </div>

                <!-- Form Section Card Panel -->
                <div class="data-panel">

                    <!-- Express Flash Message Alerts -->
                    <% if (typeof error !=='undefined' && error) { %>
                        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                            <%= error %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"
                                    aria-label="Close"></button>
                        </div>
                        <% } %>

                            <form action="<%= coupon ? '/admin/coupons/edit/' + coupon._id : '/admin/coupons/add' %>" method="POST">
                                <div class="row g-4">

                                    <!-- Left Column -->
                                    <div class="col-12 col-md-6 d-flex flex-column gap-3">
                                        <div>
                                            <label for="code" class="form-label">Coupon Code</label>
                                            <input type="text" class="form-control" id="code" name="couponCode" value="<%= coupon ? coupon.couponCode : '' %>"
                                                required placeholder="e.g. SUMMER2026">
                                        </div>

                                        <div>
                                            <label for="startDate" class="form-label">Start Date</label>
                                            <input type="date" class="form-control" id="startDate" name="startDate"
                                                value="<%= coupon ? new Date(coupon.startDate).toISOString().split('T')[0] : '' %>" required>
                                        </div>

                                        <div>
                                            <label for="maxAmount" class="form-label">Maximum Discount</label>
                                            <input type="number" class="form-control" id="maxAmount" name="maximumDiscount"
                                                value="<%= coupon && coupon.maximumDiscount !== null ? coupon.maximumDiscount : '' %>" min="0"
                                                placeholder="1000">
                                        </div>

                                        <div>
                                            <label for="description" class="form-label">Coupon Description</label>
                                        
                                            <textarea class="form-control" id="description" name="description" rows="4"
                                                placeholder="Enter coupon description..."><%= coupon ? coupon.description : '' %></textarea>
                                        </div>

                                    </div>

                                    <!-- Right Column -->
                                    <div class="col-12 col-md-6 d-flex flex-column gap-3">
                                        <div>
                                            <label for="discountType" class="form-label">Discount Type</label>
                                            <select class="form-select" id="discountType" name="discountType" required>
                                                <option value="" disabled <%=!coupon ? 'selected' : '' %>>
                                                    Select Type
                                                </option>
                                                
                                                <option value="PERCENTAGE" <%=coupon && coupon.discountType==='PERCENTAGE' ? 'selected' : '' %>>
                                                    Percentage (%)
                                                </option>
                                                
                                                <option value="FLAT" <%=coupon && coupon.discountType==='FLAT' ? 'selected' : '' %>>
                                                    Flat Amount (₹)
                                                </option>
                                            </select>
                                        </div>

                                        <div>
                                            <label for="discountValue" class="form-label">Discount Value</label>
                                        <input type="number" class="form-control" id="discountValue" name="discountValue"
                                            value="<%= coupon ? coupon.discountValue : '' %>" required min="0.01" step="0.01" placeholder="20">
                                        </div>

                                        <div>
                                            <label for="endDate" class="form-label">End Date</label>
                                            <input type="date" class="form-control" id="endDate" name="endDate"
                                                value="<%= coupon ? new Date(coupon.endDate).toISOString().split('T')[0] : '' %>" required>
                                        </div>

                                        <div>
                                            <label for="minAmount" class="form-label">Min Amount</label>
                                            <input type="number" class="form-control" id="minAmount" name="minimumPurchase"
                                                value="<%= coupon ? coupon.minimumPurchase : '' %>" required min="0" step="0.01" placeholder="100">
                                        </div>

                                        <div>
                                            <label for="usageLimit" class="form-label">Usage Limit</label>
                                            <input type="number" class="form-control" id="usageLimit" name="usageLimit"
                                                value="<%= coupon && coupon.usageLimit !== null ? coupon.usageLimit : '' %>" min="1" placeholder="100">
                                        </div>

                                        <div class="form-check mt-2">
                                            <input class="form-check-input" type="checkbox" id="isActive" name="isActive" <%=!coupon || coupon.isActive ? 'checked'
                                                : '' %>>
                                            <label class="form-check-label text-white" for="isActive">
                                                Active Coupon
                                            </label>
                                        </div>

                                        <!-- Action Button Aligned to Right -->
                                        <div class="mt-auto d-flex justify-content-end pt-3">
                                        <button type="submit" class="btn btn-add-coupon">
                                            <%= coupon ? 'Update' : 'Save' %>
                                        </button>
                                        </div>
                                    </div>

                                </div>
                            </form>
                </div>
            </main>
        </div>

        <!-- Footer -->
        <footer class="admin-footer">
            © 2026 onemore. All Rights Reserved.
        </footer>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const discountType = document.getElementById("discountType")
        const discountValue = document.getElementById("discountValue")
        const minAmount = document.getElementById("minAmount")

        discountType.addEventListener("change", () => {

            if (discountType.value === "PERCENTAGE") {
                discountValue.max = 100
                discountValue.placeholder = "20"
            } else {
                discountValue.removeAttribute("max")
                discountValue.placeholder = "500"
            }

        })

        discountValue.addEventListener("input", () => {

            if (discountType.value === "PERCENTAGE" &&
                Number(discountValue.value) > 100) {

                discountValue.setCustomValidity(
                    "Percentage discount cannot be more than 100%"
                )

            } else if (Number(discountValue.value) <= 0) {

                discountValue.setCustomValidity(
                    "Discount value must be greater than 0"
                )

            } else {

                discountValue.setCustomValidity("")
            }
        })

        minAmount.addEventListener("input", () => {

            if (Number(minAmount.value) < 0) {

                minAmount.setCustomValidity(
                    "Minimum purchase cannot be negative"
                )

            } else {

                minAmount.setCustomValidity("")
            }
            
        })

        if (discountType.value === "PERCENTAGE") {
                discountValue.max = 100
            }
    </script>

</body>

</html>