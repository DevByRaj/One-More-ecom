<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <!-- Google Font: Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --bg-dark: #000000;
            --card-bg: #0d0d0d;
            --accent-purple: #8a7df0;
            --text-muted: #888888;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 20px;
        }

        /* Border removed here */
        .dashboard-container {
            padding: 30px;
            min-height: 90vh;
            position: relative;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 20px 10px;
            height: fit-content;
        }

        .nav-link {
            color: #ffffff;
            font-size: 13px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: 0.3s;
        }

        .nav-link i {
            font-size: 18px;
        }

        .nav-link:hover {
            color: var(--accent-purple);
        }

        .nav-link.active {
            color: var(--accent-purple);
            font-weight: 600;
        }

        /* --- CARDS & CONTENT --- */
        .section-title {
            font-size: 24px;
            letter-spacing: 1px;
            text-decoration: underline;
            text-underline-offset: 8px;
            margin-bottom: 30px;
        }

        .stat-card {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 15px;
            padding: 15px;
            height: 100%;
        }

        .stat-header {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            margin-bottom: 15px;
        }

        .stat-value {
            font-size: 18px;
            font-weight: 500;
        }

        .trend-up {
            color: #f2a900;
        }

        .trend-down {
            color: #ff4d4d;
        }

        .trend-neutral {
            color: #00ff88;
        }

        /* --- CHART AREA --- */
        .chart-container {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 30px;
            margin-top: 25px;
            position: relative;
        }

        .chart-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .view-details-btn {
            border: 1px solid #ffffff;
            color: #ffffff;
            background: transparent;
            border-radius: 20px;
            padding: 5px 20px;
            font-size: 12px;
            text-decoration: none;
        }

        .active-filter {
    background-color: var(--accent-purple);
    border-color: var(--accent-purple);
    color: #ffffff;
}

/* --- BEST SELLING SECTION --- */

.best-selling-section {
    margin-top: 25px;
}

.best-selling-card {
    background-color: var(--card-bg);
    border: 2px solid var(--accent-purple);
    border-radius: 20px;
    padding: 20px;
    height: 100%;
}

.best-selling-title {
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.best-selling-title i {
    color: var(--accent-purple);
}

.best-selling-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.best-selling-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 10px;
    border-radius: 8px;
    background-color: #151515;
    font-size: 12px;
    transition: 0.2s;
}

.best-selling-item:hover {
    background-color: #202020;
}

.best-selling-rank {
    width: 25px;
    font-weight: 600;
    color: var(--accent-purple);
}

.best-selling-name {
    flex: 1;
    margin: 0 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.best-selling-quantity {
    color: var(--text-muted);
    white-space: nowrap;
}

.best-selling-empty {
    text-align: center;
    color: var(--text-muted);
    font-size: 12px;
    padding: 30px 10px;
}

        /* --- TOP TOOLS --- */
        .top-tools {
            display: flex;
            gap: 15px;
            justify-content: flex-end;
            margin-bottom: 20px;
        }

        .btn-download {
            background-color: #e9ecef;
            color: #000;
            border-radius: 15px;
            padding: 8px 30px;
            font-weight: 600;
            border: none;
        }

        .year-select {
            background: transparent;
            color: white;
            border: 1px solid white;
            border-radius: 15px;
            padding: 5px 15px;
        }

        .footer-text {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 40px;
        }
    </style>
</head>

<body>

    <div class="dashboard-container container-fluid">
        <!-- Dashboard Header Label Removed -->

        <div class="row">
            <!-- Sidebar Navigation -->
            <div class="col-lg-2 pe-lg-4">
                <div class="text-center mb-4">
                    <!-- Replace with your actual logo path -->
                    <img src="/images/logo.png" alt="IM" style="width: 60px;">
                </div>
                <div class="sidebar">
                    <nav class="nav flex-column">

                        <a class="nav-link active" href="/admin/dashboard">
                            <i class="bi bi-pie-chart"></i> Dashboard
                        </a>

                        <a class="nav-link" href="/admin/products">
                            <i class="bi bi-grid"></i> Products
                        </a>

                        <a class="nav-link" href="/admin/users">
                            <i class="bi bi-person"></i> Customers
                        </a>

                        <a class="nav-link" href="/admin/orders">
                            <i class="bi bi-cart"></i> Orders
                        </a>

                        <a class="nav-link" href="/admin/coupons">
                            <i class="bi bi-ticket-perforated"></i> Coupons
                        </a>

                        <a class="nav-link" href="/admin/category">
                            <i class="bi bi-app-indicator"></i> Category
                        </a>

                        <a class="nav-link" href="/admin/brand">
                            <i class="bi bi-bag"></i> Brand
                        </a>

                        <a class="nav-link" href="/admin/offers">
                            <i class="bi bi-percent"></i> Offers
                        </a>
                        
                        <a class="nav-link" href="/admin/referral-offers">
                            <i class="bi bi-person-plus"></i> Referral Offers
                        </a>
                        
                        <a class="nav-link" href="/admin/banner">
                            <i class="bi bi-image"></i> Banner
                        </a>

                        <a class="nav-link" href="/admin/sales-report">
                            <i class="bi bi-bar-chart"></i> Sales Report
                        </a>

                        <!-- 🔥 LOGOUT FIX -->
                        <a class="nav-link mt-4" href="/admin/logout">
                            <i class="bi bi-power"></i> Logout
                        </a>

                    </nav>
                </div>
            </div>

            <!-- Main Content Area -->
            <div class="col-lg-10">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="section-title">Sales Summary</h2>
                    <div class="top-tools">
                        <select class="year-select"
                            onchange="window.location.href='/admin/dashboard?year=' + this.value">

                            <% for (let year=2024; year <=new Date().getFullYear(); year++) { %>

                                <option value="<%= year %>" <%=selectedYear===year ? 'selected' : '' %>>
                                    <%= year %>
                                </option>

                                <% } %>

                        </select>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="stat-card">
                            <div class="stat-header"><span>Revenue</span></div>
                            <div class="stat-value">
                                ₹<%= Number(totalRevenue || 0).toLocaleString('en-IN', { minimumFractionDigits: 2,
                                    maximumFractionDigits: 2 }) %>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card">
                            <div class="stat-header"><span>Orders</span></div>
                            <div class="stat-value">
                                <%= Number(totalOrders || 0).toLocaleString('en-IN') %>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card">
                            <div class="stat-header"><span>Products Sold</span>
                            </div>
                            <div class="stat-value">
                                <%= Number(productsSold || 0).toLocaleString('en-IN') %>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="stat-card">
                            <div class="stat-header"><span>Total Customers</span></div>
                            <div class="stat-value">
                                <%= Number(totalCustomers || 0).toLocaleString('en-IN') %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chart Placeholder -->
                <div class="chart-container">
                <div class="chart-header">
                
                    <div class="small">
                        <span style="color: #f2a900;">●</span>
                        Orders Update
                    </div>
                
                    <div class="d-flex gap-2">
                
                        <a href="/admin/dashboard?year=<%= selectedYear %>&filter=weekly"
                            class="view-details-btn <%= filter === 'weekly' ? 'active-filter' : '' %>">
                            Weekly
                        </a>
                
                        <a href="/admin/dashboard?year=<%= selectedYear %>&filter=monthly&month=<%= new Date().getMonth() %>"
                            class="view-details-btn <%= filter === 'monthly' ? 'active-filter' : '' %>">
                            Monthly
                        </a>
                
                        <a href="/admin/dashboard?year=<%= selectedYear %>&filter=yearly"
                            class="view-details-btn <%= filter === 'yearly' ? 'active-filter' : '' %>">
                            Yearly
                        </a>
                
                    </div>
                
                </div>
                    <div style="height: 300px; position: relative;">
                        <canvas id="salesChart" style="width: 100%; height: 100%;"></canvas>
                    </div>
                </div>

                <!-- Best Selling Section -->
                <div class="best-selling-section">
                    <div class="row g-3">
                
                        <!-- Best Selling Products -->
                        <div class="col-lg-4 col-md-6">
                            <div class="best-selling-card">
                
                                <div class="best-selling-title">
                                    <i class="bi bi-trophy"></i>
                                    Best Selling Products
                                </div>
                
                                <div class="best-selling-list">
                
                                    <% if (bestSellingProducts && bestSellingProducts.length> 0) { %>
                
                                        <% bestSellingProducts.forEach((product, index)=> { %>
                
                                            <div class="best-selling-item">
                
                                                <span class="best-selling-rank">
                                                    <%= index + 1 %>
                                                </span>
                
                                                <span class="best-selling-name">
                                                    <%= product.productName %>
                                                </span>
                
                                                <span class="best-selling-quantity">
                                                    <%= product.totalQuantitySold %> sold
                                                </span>
                
                                            </div>
                
                                            <% }) %>
                
                                                <% } else { %>
                
                                                    <div class="best-selling-empty">
                                                        No sales data available
                                                    </div>
                
                                                    <% } %>
                
                                </div>
                            </div>
                        </div>
                
                
                        <!-- Best Selling Categories -->
                        <div class="col-lg-4 col-md-6">
                            <div class="best-selling-card">
                
                                <div class="best-selling-title">
                                    <i class="bi bi-grid"></i>
                                    Best Selling Categories
                                </div>
                
                                <div class="best-selling-list">
                
                                    <% if (bestSellingCategories && bestSellingCategories.length> 0) { %>
                
                                        <% bestSellingCategories.forEach((category, index)=> { %>
                
                                            <div class="best-selling-item">
                
                                                <span class="best-selling-rank">
                                                    <%= index + 1 %>
                                                </span>
                
                                                <span class="best-selling-name">
                                                    <%= category.categoryName %>
                                                </span>
                
                                                <span class="best-selling-quantity">
                                                    <%= category.totalQuantitySold %> sold
                                                </span>
                
                                            </div>
                
                                            <% }) %>
                
                                                <% } else { %>
                
                                                    <div class="best-selling-empty">
                                                        No sales data available
                                                    </div>
                
                                                    <% } %>
                
                                </div>
                            </div>
                        </div>
                
                
                        <!-- Best Selling Brands -->
                        <div class="col-lg-4 col-md-6">
                            <div class="best-selling-card">
                
                                <div class="best-selling-title">
                                    <i class="bi bi-award"></i>
                                    Best Selling Brands
                                </div>
                
                                <div class="best-selling-list">
                
                                    <% if (bestSellingBrands && bestSellingBrands.length> 0) { %>
                
                                        <% bestSellingBrands.forEach((brand, index)=> { %>
                
                                            <div class="best-selling-item">
                
                                                <span class="best-selling-rank">
                                                    <%= index + 1 %>
                                                </span>
                
                                                <span class="best-selling-name">
                                                    <%= brand.brandName %>
                                                </span>
                
                                                <span class="best-selling-quantity">
                                                    <%= brand.totalQuantitySold %> sold
                                                </span>
                
                                            </div>
                
                                            <% }) %>
                
                                                <% } else { %>
                
                                                    <div class="best-selling-empty">
                                                        No sales data available
                                                    </div>
                
                                                    <% } %>
                
                                </div>
                            </div>
                        </div>
                
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-text">
            © 2026 onemore. All Rights Reserved.
        </div>
    </div>

    <script>

        const salesData =
            <%- JSON.stringify(monthlySales) %>;

        const currentFilter =
            "<%= filter %>";


        let chartLabels = [];


        if (currentFilter === "yearly") {

            chartLabels = [
                "Jan",
                "Feb",
                "Mar",
                "Apr",
                "May",
                "Jun",
                "Jul",
                "Aug",
                "Sep",
                "Oct",
                "Nov",
                "Dec"
            ];

        } else if (currentFilter === "monthly") {

            chartLabels =
                salesData.map(item =>
                    item.day
                );

        } else if (currentFilter === "weekly") {

            const today = new Date();

            chartLabels =
                salesData.map((item, index) => {

                    const date =
                        new Date();

                    date.setDate(
                        today.getDate() -
                        (6 - index)
                    );

                    return date.toLocaleDateString(
                        "en-IN",
                        {
                            day: "2-digit",
                            month: "short"
                        }
                    );

                });

        }


        const revenueData =
            salesData.map(
                item => Number(item.revenue || 0)
            );


        const ordersData =
            salesData.map(
                item => Number(item.orders || 0)
            );


        const ctx =
            document.getElementById("salesChart");


        new Chart(ctx, {

            type: "line",

            data: {

                labels: chartLabels,

                datasets: [

                    {
                        label: "Revenue",

                        data: revenueData,

                        borderColor: "#00ff00",
                        backgroundColor: "#00ff00",

                        borderWidth: 2,

                        tension: 0.4,

                        pointBackgroundColor: "#00ff00",
                        pointBorderColor: "#00ff00",

                        yAxisID: "revenue"
                    },


                    {
                        label: "Orders",

                        data: ordersData,

                        borderColor: "#0066cc",
                        backgroundColor: "#0066cc",

                        borderWidth: 2,

                        tension: 0.4,

                        pointBackgroundColor: "#0066cc",
                        pointBorderColor: "#0066cc",

                        yAxisID: "orders"
                    }

                ]

            },


            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                    legend: {

                        labels: {
                            color: "#ffffff"
                        }

                    }

                },


                scales: {

                    x: {

                        ticks: {
                            color: "#888888"
                        },

                        grid: {
                            color: "#222222"
                        }

                    },


                    revenue: {

                        type: "linear",

                        position: "left",

                        ticks: {
                            color: "#888888"
                        },

                        grid: {
                            color: "#222222"
                        }

                    },


                    orders: {

                        type: "linear",

                        position: "right",

                        ticks: {
                            color: "#888888"
                        },

                        grid: {
                            drawOnChartArea: false
                        }

                    }

                }

            }

        });

    </script>

</body>

</html>