<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Admin -
        <%= brand ? 'Edit Brand' : 'Add Brand' %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --bg-dark: #000000;
            --card-bg: #0d0d0d;
            --accent-purple: #8a7df0;
            --text-muted: #888888;
            --input-bg: #1a1a1a;
            --error-red: #ff4d4d;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 20px;
        }

        .dashboard-container {
            padding: 30px;
            min-height: 90vh;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 20px 10px;
            height: fit-content;
        }

        .nav-link {
            color: #ffffff;
            font-size: 13px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: 0.3s;
        }

        .nav-link i {
            font-size: 18px;
        }

        .nav-link:hover {
            color: var(--accent-purple);
        }

        .nav-link.active {
            color: var(--accent-purple);
            font-weight: 600;
        }

        /* --- TOP HEADER (Matching Category Page) --- */
        .search-container {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 20px;
            padding: 14px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        /* --- FORM CONTAINER --- */
        .form-container {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 20px;
            min-height: 400px;
        }

        .form-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
        }

        /* --- INPUTS & BUTTONS --- */
        .custom-label {
            font-size: 0.9rem;
            margin-bottom: 12px;
            color: var(--text-muted);
        }

        .custom-input {
            background-color: var(--input-bg);
            border: 1px solid #333;
            border-radius: 12px;
            color: white;
            padding: 12px 20px;
            width: 100%;
            max-width: 400px;
            outline: none;
            transition: 0.3s;
        }

        .custom-input:focus {
            border-color: var(--accent-purple);
            box-shadow: 0 0 10px rgba(138, 125, 240, 0.2);
        }

        .custom-input.is-invalid {
            border-color: var(--error-red);
        }

        .btn-submit {
            border: 1px solid white;
            background: transparent;
            color: white;
            padding: 8px 60px;
            border-radius: 12px;
            margin-top: 35px;
            font-weight: 600;
            transition: 0.3s;
            font-size: 14px;
        }

        .btn-submit:hover {
            background: white;
            color: black;
        }

        .error-message {
            color: var(--error-red);
            font-size: 0.75rem;
            margin-top: 8px;
            display: none;
        }

        .footer-text {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 40px;
        }
    </style>
</head>

<body>
    <div class="dashboard-container container-fluid">
        <div class="row">
            <div class="col-lg-2 pe-lg-4">
                <div class="text-center mb-4">
                    <img src="/images/logo.png" alt="Logo" style="width: 60px;">
                </div>
                <div class="sidebar">
                    <nav class="nav flex-column">
                        <a class="nav-link" href="/admin/dashboard"><i class="bi bi-pie-chart"></i> Dashboard</a>
                        <a class="nav-link" href="/admin/products"><i class="bi bi-grid"></i> Products</a>
                        <a class="nav-link" href="/admin/users"><i class="bi bi-person"></i> Customers</a>
                        <a class="nav-link" href="/admin/orders"><i class="bi bi-cart"></i> Orders</a>
                        <a class="nav-link" href="/admin/coupons"><i class="bi bi-ticket-perforated"></i> Coupons</a>
                        <a class="nav-link" href="/admin/category"><i class="bi bi-app-indicator"></i> Category</a>
                        <a class="nav-link active" href="/admin/brand"><i class="bi bi-bag"></i> Brand</a>
                        <a class="nav-link" href="/admin/offers"><i class="bi bi-percent"></i> Offers</a>
                        <a class="nav-link" href="/admin/banner"><i class="bi bi-image"></i> Banner</a>
                        <a class="nav-link" href="/admin/sales-report"><i class="bi bi-bar-chart"></i> Sales Report</a>
                        <a class="nav-link mt-4" href="/admin/logout"><i class="bi bi-power"></i> Logout</a>
                    </nav>
                </div>
            </div>

            <div class="col-lg-10">
                <div class="search-container">
                    <h4 class="mb-0" style="font-weight: 400; letter-spacing: 1px;">

                        <%= brand ? 'Edit Brand' : 'Add Brand' %>

                    </h4>
                    <div>
                        <a href="/admin/brand"
                            style="color: var(--accent-purple); text-decoration: none; font-size: 13px;">
                            <i class="bi bi-arrow-left"></i> Back to brand
                        </a>
                    </div>
                </div>

                <div class="form-container">
                    <form id="brandForm" action="<%= brand
    ? '/admin/editBrand?id=' + brand._id
    : '/admin/addBrand'
%>" method="POST" class="form-body" novalidate>

                        <% if (error) { %>
                            <div class="alert alert-dark border-secondary small py-2 px-4 mb-4 text-white text-center">
                                <%= error %>
                            </div>
                            <% } %>

                                <div class="w-100 d-flex flex-column align-items-center">
                                    <label for="brandName" class="custom-label">Brand Name</label>
                                    <input type="text" name="name" id="brandName" class="custom-input"
                                        placeholder="Enter brand name" value="<%= brand ? brand.name : '' %>">
                                    <div id="nameError" class="error-message">Please enter a valid Brand name.</div>

                                    <button type="submit" class="btn-submit">

                                        <%= brand ? 'Update' : 'Submit' %>

                                    </button>
                                </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="footer-text">
            © 2026 onemore. All Rights Reserved.
        </div>
    </div>

    <script>
        document.getElementById('brandForm').addEventListener('submit', function (event) {
            const brandInput = document.getElementById('brandName');
            const nameValue = brandInput.value.trim();
            let isValid = true;

            if (nameValue === "") {
                handleError("Brand name cannot be empty.");
                isValid = false;
            } else if (nameValue.length < 3) {
                handleError("Brand name must be at least 3 characters long.");
                isValid = false;
            } else if (!/^[a-zA-Z\s]+$/.test(nameValue)) {
                handleError("Brand name should only contain letters.");
                isValid = false;
            }

            if (!isValid) {
                event.preventDefault();
            }
        });

        function handleError(msg) {
            const brandInput = document.getElementById('brandName');
            const errorDiv = document.getElementById('nameError');

            brandInput.classList.add('is-invalid');
            errorDiv.textContent = msg;
            errorDiv.style.display = 'block';

            Swal.fire({
                icon: 'error',
                title: 'Validation Error',
                text: msg,
                background: '#111',
                color: '#fff',
                confirmButtonColor: '#8a7df0'
            });
        }

        document.getElementById('brandName').addEventListener('input', function () {
            this.classList.remove('is-invalid');
            document.getElementById('nameError').style.display = 'none';
        });
    </script>
</body>

</html>