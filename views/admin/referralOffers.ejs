<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Referral Offers | OneMore</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-black: #000000;
            --panel-bg: #0b0b0c;
            --neon-purple: #7a56f5;
            --text-gray: #a0a0a5;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-black);
            color: #ffffff;
            margin: 0;
            padding: 20px;
        }

        .admin-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* LOGO */

        .admin-header {
            padding: 10px 20px;
            margin-bottom: 20px;
        }

        .admin-logo {
            height: 70px;
            width: auto;
            object-fit: contain;
        }

        /* LAYOUT */

        .admin-layout-grid {
            display: grid;
            grid-template-columns: 260px 1fr;
            gap: 30px;
            align-items: start;
        }

        /* SIDEBAR */

        .admin-sidebar {
            background-color: var(--panel-bg);
            border: 2px solid var(--neon-purple);
            border-radius: 15px;
            padding: 25px 15px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .sidebar-menu-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 12px 20px;
            color: #ffffff;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .sidebar-menu-item i {
            width: 20px;
            font-size: 1.1rem;
            text-align: center;
            color: var(--text-gray);
        }

        .sidebar-menu-item:hover,
        .sidebar-menu-item.active {
            background-color: rgba(122, 86, 245, 0.15);
            color: #ffffff;
        }

        .sidebar-menu-item:hover i,
        .sidebar-menu-item.active i {
            color: var(--neon-purple);
        }

        /* MAIN */

        .main-content-area {
            display: flex;
            flex-direction: column;
            gap: 25px;
        }

        .top-control-banner {
            background-color: var(--panel-bg);
            border: 1px solid var(--neon-purple);
            border-radius: 12px;
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .top-control-banner h4 {
            margin: 0;
            font-weight: 600;
            font-size: 1.3rem;
            letter-spacing: 0.5px;
        }

        /* DATA PANEL */

        .data-panel {
            background-color: var(--panel-bg);
            border: 1px solid var(--neon-purple);
            border-radius: 15px;
            padding: 25px;
            overflow-x: auto;
        }

        /* TABLE */

        .referral-table-header,
        .referral-table-row {
            display: grid;
            grid-template-columns:
                1.5fr 1fr 1fr 1.5fr 1fr 1.5fr;
        }

        .referral-table-header {
            background-color: #1a1a1c;
            padding: 12px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.85rem;
            color: var(--text-gray);
            margin-bottom: 15px;
            min-width: 850px;
        }

        .referral-table-row {
            align-items: center;
            padding: 20px;
            border-bottom: 1px solid #1f1f22;
            font-size: 0.9rem;
            min-width: 850px;
        }

        .data-panel .referral-table-row:last-of-type {
            border-bottom: none;
        }

        /* STATUS */

        .status-badge {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 5px;
            font-size: 0.75rem;
            font-weight: 500;
        }

        .active-status {
            background-color: #198754;
        }

        .inactive-status {
            background-color: #dc3545;
        }

        /* EMPTY */

        .empty-message {
            text-align: center;
            padding: 40px 20px;
            color: var(--text-gray);
            min-width: 850px;
        }

        /* FOOTER */

        .admin-footer {
            text-align: center;
            color: var(--text-gray);
            font-size: 0.8rem;
            margin-top: 40px;
            padding-bottom: 20px;
        }

        /* MOBILE */

        @media (max-width: 992px) {

            .admin-layout-grid {
                grid-template-columns: 1fr;
            }

            .admin-sidebar {
                width: 100%;
            }

        }
    </style>

</head>

<body>

    <div class="admin-container">

        <!-- LOGO -->

        <div class="admin-header">

            <img src="/images/logo.png" class="admin-logo" alt="OneMore Logo">

        </div>


        <div class="admin-layout-grid">

            <!-- SIDEBAR -->

            <aside class="admin-sidebar">

                <a href="/admin/dashboard" class="sidebar-menu-item">
                    <i class="fa-solid fa-chart-pie"></i>
                    Dashboard
                </a>

                <a href="/admin/products" class="sidebar-menu-item">
                    <i class="fa-solid fa-cubes"></i>
                    Products
                </a>

                <a href="/admin/users" class="sidebar-menu-item">
                    <i class="fa-solid fa-users"></i>
                    Customers
                </a>

                <a href="/admin/orders" class="sidebar-menu-item">
                    <i class="fa-solid fa-cart-shopping"></i>
                    Orders
                </a>

                <a href="/admin/coupons" class="sidebar-menu-item">
                    <i class="fa-solid fa-ticket"></i>
                    Coupons
                </a>

                <a href="/admin/category" class="sidebar-menu-item">
                    <i class="fa-solid fa-folder-tree"></i>
                    Category
                </a>

                <a href="/admin/brand" class="sidebar-menu-item">
                    <i class="fa-solid fa-copyright"></i>
                    Brand
                </a>

                <a href="/admin/offers" class="sidebar-menu-item">
                    <i class="fa-solid fa-percent"></i>
                    Offers
                </a>

                <a href="/admin/referral-offers" class="sidebar-menu-item active">
                    <i class="fa-solid fa-user-plus"></i>
                    Referral Offers
                </a>

                <a href="/admin/banner" class="sidebar-menu-item">
                    <i class="fa-solid fa-image"></i>
                    Banner
                </a>

                <a href="/admin/sales-report" class="sidebar-menu-item">
                    <i class="fa-solid fa-chart-line"></i>
                    Sales Report
                </a>

                <a href="/admin/logout" class="sidebar-menu-item mt-4">
                    <i class="fa-solid fa-power-off"></i>
                    Logout
                </a>

            </aside>


            <!-- MAIN -->

            <main class="main-content-area">

                <!-- HEADER -->

                <div class="top-control-banner">

                    <h4>
                        Referral Offers
                    </h4>

                    <a href="/admin/referral-offers/add" class="btn btn-sm btn-success fw-bold px-3">
                        + Add Referral Offer
                    </a>

                </div>


                <!-- DATA -->

                <div class="data-panel">

                    <!-- TABLE HEADER -->

                    <div class="referral-table-header">

                        <div>
                            Offer Name
                        </div>

                        <div>
                            Referrer Reward
                        </div>

                        <div>
                            New User Reward
                        </div>

                        <div>
                            Validity
                        </div>

                        <div>
                            Status
                        </div>

                        <div>
                            Action
                        </div>

                    </div>


                    <% if (offers && offers.length> 0) { %>

                        <% offers.forEach(offer=> { %>

                            <div class="referral-table-row">

                                <!-- OFFER NAME -->

                                <div class="fw-semibold">

                                    <%= offer.offerName %>

                                </div>


                                <!-- REFERRER REWARD -->

                                <div>

                                    ₹<%= offer.referrerReward %>

                                </div>


                                <!-- NEW USER REWARD -->

                                <div>

                                    ₹<%= offer.referredUserReward %>

                                </div>


                                <!-- VALIDITY -->

                                <div>

                                    <%= new Date(offer.startDate).toLocaleDateString( "en-IN" , { day: "2-digit" ,
                                        month: "short" , year: "numeric" } ) %>

                                        -

                                        <%= new Date(offer.endDate).toLocaleDateString( "en-IN" , { day: "2-digit" ,
                                            month: "short" , year: "numeric" } ) %>

                                </div>


                                <!-- STATUS -->

                                <div>

                                    <span class="status-badge <%= offer.isActive
                                        ? 'active-status'
                                        : 'inactive-status'
                                    %>">

                                        <%= offer.isActive ? 'Active' : 'Inactive' %>

                                    </span>

                                </div>


                                <!-- ACTION -->

                                <div class="d-flex gap-2 align-items-center">

                                    <a href="/admin/referral-offers/edit/<%= offer._id %>"
                                        class="btn btn-sm btn-success px-3" style="border-radius:4px;font-weight:500;">
                                        Edit
                                    </a>


                                    <form action="/admin/referral-offers/delete/<%= offer._id %>" method="POST"
                                        class="deleteReferralOfferForm">

                                        <button type="submit" class="btn btn-sm text-white px-3"
                                            style="background:#ff5722;border-radius:4px;font-weight:500;">
                                            Remove
                                        </button>

                                    </form>

                                </div>

                            </div>

                            <% }) %>


                                <% } else { %>

                                    <div class="empty-message">

                                        No referral offers available.

                                    </div>

                                    <% } %>

                </div>

            </main>

        </div>


        <!-- FOOTER -->

        <footer class="admin-footer">

            © 2026 onemore. All Rights Reserved.

        </footer>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11">
    </script>


    <script>

        document
            .querySelectorAll(".deleteReferralOfferForm")
            .forEach(form => {

                form.addEventListener("submit", function (e) {

                    e.preventDefault();

                    Swal.fire({

                        title: "Delete Referral Offer?",

                        text: "This action cannot be undone.",

                        icon: "warning",

                        showCancelButton: true,

                        confirmButtonColor: "#d33",

                        cancelButtonColor: "#6c757d",

                        confirmButtonText: "Yes, Delete",

                        cancelButtonText: "Cancel"

                    }).then((result) => {

                        if (result.isConfirmed) {

                            form.submit();

                        }

                    });

                });

            });

    </script>

</body>

</html>