<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Best Selling Categories</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <!-- Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #000000;
            --card-bg: #0d0d0d;
            --accent-purple: #8a7df0;
            --text-muted: #888888;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 20px;
        }

        .dashboard-container {
            padding: 30px;
            min-height: 90vh;
            position: relative;
        }

        /* SIDEBAR */

        .sidebar {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 20px 10px;
            height: fit-content;
        }

        .nav-link {
            color: #ffffff;
            font-size: 13px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: 0.3s;
        }

        .nav-link i {
            font-size: 18px;
        }

        .nav-link:hover {
            color: var(--accent-purple);
        }

        .nav-link.active {
            color: var(--accent-purple);
            font-weight: 600;
        }

        /* MAIN TITLE */

        .section-title {
            font-size: 24px;
            letter-spacing: 1px;
            text-decoration: underline;
            text-underline-offset: 8px;
            margin-bottom: 30px;
        }

        /* MAIN CARD */

        .table-container {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 30px;
            margin-top: 10px;
        }

        .table-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .table-title {
            font-size: 16px;
            font-weight: 500;
        }

        .top-ten {
            font-size: 12px;
            color: var(--text-muted);
        }

        /* TABLE */

        .custom-table {
            width: 100%;
            border-collapse: collapse;
        }

        .custom-table thead {
            background-color: #1b1b1b;
        }

        .custom-table th {
            color: #888888;
            font-size: 12px;
            font-weight: 500;
            padding: 15px;
            text-align: left;
        }

        .custom-table td {
            padding: 18px 15px;
            font-size: 13px;
            border-bottom: 1px solid #292929;
        }

        .custom-table tbody tr {
            transition: 0.3s;
        }

        .custom-table tbody tr:hover {
            background-color: #171717;
        }

        .rank {
            font-weight: 600;
            color: var(--accent-purple);
            width: 80px;
        }

        .category-name {
            font-weight: 500;
        }

        .quantity {
            color: #ffffff;
        }

        .revenue {
            font-weight: 500;
        }

        /* EMPTY STATE */

        .empty-message {
            text-align: center;
            padding: 50px;
            color: var(--text-muted);
            font-size: 13px;
        }

        /* PAGINATION */

        .pagination-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 8px;
            margin-top: 30px;
        }

        .pagination-btn {
            text-decoration: none;
            color: #ffffff;
            border: 1px solid #444;
            padding: 7px 13px;
            border-radius: 8px;
            font-size: 12px;
            transition: 0.3s;
        }

        .pagination-btn:hover {
            color: var(--accent-purple);
            border-color: var(--accent-purple);
        }

        .pagination-btn.active {
            background-color: var(--accent-purple);
            color: #000000;
            border-color: var(--accent-purple);
            font-weight: 600;
        }

        .pagination-btn.disabled {
            color: #555555;
            border-color: #222222;
            pointer-events: none;
        }

        /* BACK BUTTON */

        .back-btn {
            border: 1px solid #ffffff;
            color: #ffffff;
            background: transparent;
            border-radius: 20px;
            padding: 6px 20px;
            font-size: 12px;
            text-decoration: none;
            transition: 0.3s;
        }

        .back-btn:hover {
            color: var(--accent-purple);
            border-color: var(--accent-purple);
        }

        /* FOOTER */

        .footer-text {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 40px;
        }

        @media (max-width: 991px) {

            .sidebar {
                margin-bottom: 30px;
            }

            .custom-table {
                min-width: 600px;
            }

            .table-container {
                overflow-x: auto;
            }

        }
    </style>

</head>

<body>

    <div class="dashboard-container container-fluid">

        <div class="row">

            <!-- SIDEBAR -->

            <div class="col-lg-2 pe-lg-4">

                <div class="text-center mb-4">

                    <img src="/images/logo.png" alt="IM" style="width: 60px;">

                </div>

                <div class="sidebar">

                    <nav class="nav flex-column">

                        <a class="nav-link" href="/admin/dashboard">
                            <i class="bi bi-pie-chart"></i>
                            Dashboard
                        </a>

                        <a class="nav-link" href="/admin/products">
                            <i class="bi bi-grid"></i>
                            Products
                        </a>

                        <a class="nav-link" href="/admin/users">
                            <i class="bi bi-person"></i>
                            Customers
                        </a>

                        <a class="nav-link" href="/admin/orders">
                            <i class="bi bi-cart"></i>
                            Orders
                        </a>

                        <a class="nav-link" href="/admin/coupons">
                            <i class="bi bi-ticket-perforated"></i>
                            Coupons
                        </a>

                        <a class="nav-link" href="/admin/category">
                            <i class="bi bi-app-indicator"></i>
                            Category
                        </a>

                        <a class="nav-link" href="/admin/brand">
                            <i class="bi bi-bag"></i>
                            Brand
                        </a>

                        <a class="nav-link" href="/admin/offers">
                            <i class="bi bi-percent"></i>
                            Offers
                        </a>

                        <a class="nav-link" href="/admin/banner">
                            <i class="bi bi-image"></i>
                            Banner
                        </a>

                        <a class="nav-link" href="/admin/sales-report">
                            <i class="bi bi-bar-chart"></i>
                            Sales Report
                        </a>

                        <a class="nav-link" href="/admin/best-selling-products">
                            <i class="bi bi-trophy"></i>
                            Best Selling Products
                        </a>

                        <a class="nav-link active" href="/admin/best-selling-categories">
                            <i class="bi bi-diagram-3"></i>
                            Best Selling Categories
                        </a>

                        <a class="nav-link mt-4" href="/admin/logout">
                            <i class="bi bi-power"></i>
                            Logout
                        </a>

                    </nav>

                </div>

            </div>


            <!-- MAIN CONTENT -->

            <div class="col-lg-10">

                <div class="d-flex justify-content-between align-items-center mb-2">

                    <h2 class="section-title">
                        Best Selling Categories
                    </h2>

                    <a href="/admin/dashboard" class="back-btn">
                        Back to Dashboard
                    </a>

                </div>


                <!-- CATEGORIES CARD -->

                <div class="table-container">

                    <div class="table-header">

                        <div class="table-title">
                            Top Selling Categories
                        </div>

                        <div class="top-ten">
                            Best Selling Categories
                        </div>

                    </div>


                    <% if (categories && categories.length> 0) { %>

                        <div style="overflow-x: auto;">

                            <table class="custom-table">

                                <thead>

                                    <tr>

                                        <th>
                                            Rank
                                        </th>

                                        <th>
                                            Category
                                        </th>

                                        <th>
                                            Quantity Sold
                                        </th>

                                        <th>
                                            Revenue
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    <% categories.forEach((category, index)=> { %>

                                        <tr>

                                            <td class="rank">
                                                #<%= (currentPage - 1) * 10 + index + 1 %>
                                            </td>

                                            <td class="category-name">
                                                <%= category.categoryName %>
                                            </td>

                                            <td class="quantity">
                                                <%= Number(category.totalQuantitySold || 0).toLocaleString('en-IN') %>
                                            </td>

                                            <td class="revenue">
                                                ₹<%= Number(category.totalRevenue || 0).toLocaleString('en-IN', {
                                                    minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                                            </td>

                                        </tr>

                                        <% }) %>

                                </tbody>

                            </table>

                        </div>


                        <% if (totalPages> 1) { %>

                            <div class="pagination-container">

                                <!-- Previous -->

                                <% if (currentPage> 1) { %>

                                    <a href="/admin/best-selling-categories?page=<%= currentPage - 1 %>"
                                        class="pagination-btn">
                                        Previous
                                    </a>

                                    <% } else { %>

                                        <span class="pagination-btn disabled">
                                            Previous
                                        </span>

                                        <% } %>


                                            <!-- Page Numbers -->

                                            <% for (let i=1; i <=totalPages; i++) { %>

                                                <a href="/admin/best-selling-categories?page=<%= i %>"
                                                    class="pagination-btn <%= currentPage === i ? 'active' : '' %>">
                                                    <%= i %>
                                                </a>

                                                <% } %>


                                                    <!-- Next -->

                                                    <% if (currentPage < totalPages) { %>

                                                        <a href="/admin/best-selling-categories?page=<%= currentPage + 1 %>"
                                                            class="pagination-btn">
                                                            Next
                                                        </a>

                                                        <% } else { %>

                                                            <span class="pagination-btn disabled">
                                                                Next
                                                            </span>

                                                            <% } %>

                            </div>

                            <% } %>


                                <% } else { %>

                                    <div class="empty-message">

                                        <i class="bi bi-bar-chart" style="font-size: 30px;"></i>

                                        <br><br>

                                        No sales data available.

                                    </div>

                                    <% } %>

                </div>

            </div>

        </div>


        <!-- FOOTER -->

        <div class="footer-text">

            © 2026 onemore. All Rights Reserved.

        </div>

    </div>

</body>

</html>