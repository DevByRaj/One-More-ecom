<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - Add Variant</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #000000;
            --card-bg: #0d0d0d;
            --accent-purple: #8a7df0;
            --btn-save: #66ff00;
            /* Bright neon green */
            --input-border: #444444;
            --error-red: #ff4d4d;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 20px;
        }

        .dashboard-container {
            padding: 30px;
            min-height: 95vh;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 20px 10px;
            height: fit-content;
        }

        .nav-link {
            color: #ffffff;
            font-size: 13px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: 0.3s;
        }

        .nav-link i {
            font-size: 18px;
        }

        .nav-link:hover {
            color: var(--accent-purple);
        }

        .nav-link.active {
            color: var(--accent-purple);
            font-weight: 600;
        }

        /* --- FORM PANELS --- */
        .header-panel {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 15px;
            padding: 12px 25px;
            margin-bottom: 20px;
        }

        .form-panel {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 50px 80px;
            position: relative;
        }

        /* --- INPUT STYLES --- */
        .form-group-custom {
            margin-bottom: 25px;
            width: 100%;
            max-width: 400px;
        }

        label {
            font-size: 15px;
            margin-bottom: 8px;
            display: block;
            color: #ffffff;
        }

        .form-control {
            background-color: transparent !important;
            border: 1px solid var(--input-border);
            border-radius: 12px;
            color: white !important;
            padding: 10px 15px;
        }

        .form-control:focus {
            border-color: var(--accent-purple);
            box-shadow: none;
        }

        /* --- IMAGE PLACEHOLDERS --- */
        .image-upload-wrapper {
            display: flex;
            gap: 20px;
            margin-top: 15px;
        }

        .img-placeholder {
            width: 140px;
            height: 140px;
            background-color: #f0f0f0;
            /* Light gray from design */
            border-radius: 15px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            overflow: hidden;
        }

        .img-placeholder i {
            font-size: 50px;
            color: #ccc;
        }

        .img-placeholder img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* --- BUTTONS --- */
        .save-btn {
            background-color: var(--btn-save);
            color: #000;
            border-radius: 15px;
            padding: 8px 60px;
            font-weight: 700;
            font-size: 14px;
            border: none;
            position: absolute;
            top: 50px;
            right: 80px;
            transition: 0.3s;
        }

        .save-btn:hover {
            background-color: #55d400;
            transform: scale(1.05);
        }

        /* --- VALIDATION --- */
        .error-message {
            color: var(--error-red);
            font-size: 11px;
            margin-top: 4px;
            display: none;
        }

        .is-invalid {
            border-color: var(--error-red) !important;
        }

        .footer-text {
            text-align: center;
            font-size: 12px;
            color: #888;
            margin-top: 40px;
        }
    </style>
</head>

<body>
    <div class="dashboard-container container-fluid">
        <div class="row">
            <div class="col-lg-2 pe-lg-4">
                <div class="text-center mb-4">
                    <img src="/images/logo.png" alt="im" style="width: 70px;">
                </div>
                <div class="sidebar">
                    <nav class="nav flex-column">
                        <a class="nav-link" href="/admin/dashboard"><i class="bi bi-pie-chart"></i> Dashboard</a>
                        <a class="nav-link active" href="/admin/products"><i class="bi bi-grid"></i> Products</a>
                        <a class="nav-link" href="/admin/users"><i class="bi bi-person"></i> Customers</a>
                        <a class="nav-link" href="/admin/orders"><i class="bi bi-cart"></i> Orders</a>
                        <a class="nav-link" href="/admin/coupons"><i class="bi bi-ticket-perforated"></i> Coupons</a>
                        <a class="nav-link" href="/admin/category"><i class="bi bi-app-indicator"></i> Category</a>
                        <a class="nav-link" href="/admin/brand"><i class="bi bi-bag"></i> Brand</a>
                        <a class="nav-link" href="/admin/offers"><i class="bi bi-percent"></i> Offers</a>
                        <a class="nav-link" href="/admin/banner"><i class="bi bi-image"></i> Banner</a>
                        <a class="nav-link" href="/admin/sales-report"><i class="bi bi-bar-chart"></i> Sales Report</a>
                        <a class="nav-link mt-4" href="/admin/logout" style="color: #ff4d4d;"><i
                                class="bi bi-power"></i> Logout</a>
                    </nav>
                </div>
            </div>

            <div class="col-lg-10">
                <div class="header-panel">
                    <h5 class="mb-0">Add Variant</h5>
                </div>

                <div class="form-panel">
                    <form id="variantForm" action="/admin/add-variant" method="POST" enctype="multipart/form-data"
                        novalidate>
                        <button type="submit" class="save-btn">SAVE</button>

                        <div class="form-group-custom">
                        
                            <label>Product Name</label>
                        
                            <select name="productId" class="form-control">
                        
                                <option value="">
                                    Select Product
                                </option>
                        
                                <% products.forEach(product=> { %>
                        
                                    <option value="<%= product._id %>">
                        
                                        <%= product.productName %>
                        
                                    </option>
                        
                                    <% }) %>
                        
                            </select>
                        
                        </div>

                        <div class="form-group-custom">
                            <label for="color">Color</label>
                            <input type="text" id="color" name="color" class="form-control"
                                placeholder="e.g. Midnight Blue">
                            <div id="colorError" class="error-message">Please enter a valid color.</div>
                        </div>

                        <div class="form-group-custom">
                            <label for="stock">Stock</label>
                            <input type="number" id="stock" name="stock" class="form-control" placeholder="0">
                            <div id="stockError" class="error-message">Stock cannot be negative.</div>
                        </div>

                        <div class="form-group-custom">
                            <label for="price">Price</label>
                            <input type="number" id="price" name="price" class="form-control" placeholder="0.00">
                            <div id="priceError" class="error-message">Price must be a positive number.</div>
                        </div>

                        <div class="mt-4">
                            <label>variant Image</label>
                            <div class="image-upload-wrapper">
                                <% for(let i=1; i<=3; i++) { %>
                                    <div class="img-placeholder" onclick="triggerInput(<%= i %>)">
                                        <input type="file" id="fileInput<%= i %>" name="variantImage" class="d-none"
                                            accept="image/*" onchange="previewImg(this, <%= i %>)">
                                        <div id="placeholderText<%= i %>">
                                            <i class="bi bi-image"></i>
                                        </div>
                                        <img id="preview<%= i %>" class="d-none" alt="Preview">
                                    </div>
                                    <% } %>
                            </div>
                            <div id="imageError" class="error-message">Please upload at least one image.</div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="footer-text">
            © 2026 onemore. All Rights Reserved.
        </div>
    </div>

    <script>
        function triggerInput(id) {
            document.getElementById('fileInput' + id).click();
        }

        function previewImg(input, id) {
            const preview = document.getElementById('preview' + id);
            const placeholder = document.getElementById('placeholderText' + id);
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.classList.remove('d-none');
                    placeholder.classList.add('d-none');
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Field-wise Validation
        document.getElementById('variantForm').addEventListener('submit', function (e) {
            let isValid = true;

            const color = document.getElementById('color');
            const stock = document.getElementById('stock');
            const price = document.getElementById('price');
            const files = document.querySelectorAll('input[type="file"]');

            // Color check
            if (!color.value.trim()) {
                color.classList.add('is-invalid');
                document.getElementById('colorError').style.display = 'block';
                isValid = false;
            } else {
                color.classList.remove('is-invalid');
                document.getElementById('colorError').style.display = 'none';
            }

            // Stock check
            if (stock.value === '' || stock.value < 0) {
                stock.classList.add('is-invalid');
                document.getElementById('stockError').style.display = 'block';
                isValid = false;
            } else {
                stock.classList.remove('is-invalid');
                document.getElementById('stockError').style.display = 'none';
            }

            // Price check
            if (price.value === '' || price.value <= 0) {
                price.classList.add('is-invalid');
                document.getElementById('priceError').style.display = 'block';
                isValid = false;
            } else {
                price.classList.remove('is-invalid');
                document.getElementById('priceError').style.display = 'none';
            }

            // Image check
            let hasImage = Array.from(files).some(f => f.files.length > 0);
            if (!hasImage) {
                document.getElementById('imageError').style.display = 'block';
                isValid = false;
            } else {
                document.getElementById('imageError').style.display = 'none';
            }

            if (!isValid) e.preventDefault();
        });
    </script>
</body>

</html>