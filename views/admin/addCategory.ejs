<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Admin -
        <%= category ? 'Edit Category' : 'Add Category' %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --bg-dark: #000000;
            --card-bg: #0d0d0d;
            --accent-purple: #8a7df0;
            --text-muted: #888888;
            --input-bg: #1a1a1a;
            --error-red: #ff4d4d;
        }

        body {
            background-color: var(--bg-dark);
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 20px;
        }

        .dashboard-container {
            padding: 30px;
            min-height: 90vh;
        }

        /* --- SIDEBAR --- */
        .sidebar {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 20px 10px;
            height: fit-content;
        }

        .nav-link {
            color: #ffffff;
            font-size: 13px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 15px;
            transition: 0.3s;
        }

        .nav-link i {
            font-size: 18px;
        }

        .nav-link:hover {
            color: var(--accent-purple);
        }

        .nav-link.active {
            color: var(--accent-purple);
            font-weight: 600;
        }

        /* --- TOP HEADER (Matching Category Page) --- */
        .search-container {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 20px;
            padding: 14px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        /* --- FORM CONTAINER --- */
        .form-container {
            background-color: var(--card-bg);
            border: 2px solid var(--accent-purple);
            border-radius: 25px;
            padding: 20px;
            min-height: 400px;
        }

        .form-body {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
        }

        /* --- INPUTS & BUTTONS --- */
        .custom-label {
            font-size: 0.9rem;
            margin-bottom: 12px;
            color: var(--text-muted);
        }

        .custom-input {
            background-color: var(--input-bg);
            border: 1px solid #333;
            border-radius: 12px;
            color: white;
            padding: 12px 20px;
            width: 100%;
            max-width: 400px;
            outline: none;
            transition: 0.3s;
        }

        .custom-input:focus {
            border-color: var(--accent-purple);
            box-shadow: 0 0 10px rgba(138, 125, 240, 0.2);
        }

        .custom-input.is-invalid {
            border-color: var(--error-red);
        }

        .btn-submit {
            border: 1px solid white;
            background: transparent;
            color: white;
            padding: 8px 60px;
            border-radius: 12px;
            margin-top: 35px;
            font-weight: 600;
            transition: 0.3s;
            font-size: 14px;
        }

        .btn-submit:hover {
            background: white;
            color: black;
        }

        .error-message {
            color: var(--error-red);
            font-size: 0.75rem;
            margin-top: 8px;
            display: none;
        }

        .category-server-error {
    color: #ff6b6b;
    background: rgba(255, 107, 107, 0.08);
    border: 1px solid #ff6b6b;
    border-radius: 8px;
    padding: 8px 20px;
    font-size: 0.8rem;
    font-weight: 500;
    text-align: center;
    margin-bottom: 20px;
}

        .footer-text {
            text-align: center;
            font-size: 12px;
            color: var(--text-muted);
            margin-top: 40px;
        }
    </style>
</head>

<body>
    <div class="dashboard-container container-fluid">
        <div class="row">
            <div class="col-lg-2 pe-lg-4">
                <div class="text-center mb-4">
                    <img src="/images/logo.png" alt="Logo" style="width: 60px;">
                </div>
                <div class="sidebar">
                    <nav class="nav flex-column">
                        <a class="nav-link" href="/admin/dashboard"><i class="bi bi-pie-chart"></i> Dashboard</a>
                        <a class="nav-link" href="/admin/products"><i class="bi bi-grid"></i> Products</a>
                        <a class="nav-link" href="/admin/users"><i class="bi bi-person"></i> Customers</a>
                        <a class="nav-link" href="/admin/orders"><i class="bi bi-cart"></i> Orders</a>
                        <a class="nav-link" href="/admin/coupons"><i class="bi bi-ticket-perforated"></i> Coupons</a>
                        <a class="nav-link active" href="/admin/category"><i class="bi bi-app-indicator"></i>
                            Category</a>
                        <a class="nav-link" href="/admin/brand"><i class="bi bi-bag"></i> Brand</a>
                        <a class="nav-link" href="/admin/offers"><i class="bi bi-percent"></i> Offers</a>
                        <a class="nav-link" href="/admin/banner"><i class="bi bi-image"></i> Banner</a>
                        <a class="nav-link" href="/admin/sales-report"><i class="bi bi-bar-chart"></i> Sales Report</a>
                        <a class="nav-link mt-4" href="/admin/logout"><i class="bi bi-power"></i> Logout</a>
                    </nav>
                </div>
            </div>

            <div class="col-lg-10">
                <div class="search-container">
                    <h4 class="mb-0" style="font-weight: 400; letter-spacing: 1px;">
                    
                        <%= category ? 'Edit Category' : 'Add Category' %>
                    
                    </h4>
                    <div>
                        <a href="/admin/category"
                            style="color: var(--accent-purple); text-decoration: none; font-size: 13px;">
                            <i class="bi bi-arrow-left"></i> Back to Categories
                        </a>
                    </div>
                </div>

                <div class="form-container">
                    <form id="categoryForm" action="<%= category
    ? '/admin/editCategory?id=' + category._id
    : '/admin/addCategory'
%>" method="POST" class="form-body" novalidate>

                        <% if (error) { %>
                            <div class="category-server-error">
                                <%= error %>
                            </div>
                            <% } %>

                                <div class="w-100 d-flex flex-column align-items-center">
                                    <label for="categoryName" class="custom-label">Category Name</label>
                                    <input type="text" name="name" id="categoryName" class="custom-input" placeholder="Enter category name"
                                        value="<%= category ? category.name : '' %>">
                                    <div id="nameError" class="error-message">Please enter a valid category name.</div>

                                    <button type="submit" class="btn-submit">
                                    
                                        <%= category ? 'Update' : 'Submit' %>
                                    
                                    </button>
                                </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="footer-text">
            © 2026 onemore. All Rights Reserved.
        </div>
    </div>
<script>
    const categoryForm = document.getElementById('categoryForm');
    const categoryInput = document.getElementById('categoryName');
    const errorDiv = document.getElementById('nameError');

    categoryForm.addEventListener('submit', function (event) {

        const nameValue = categoryInput.value.trim();

        // Clear previous error
        categoryInput.classList.remove('is-invalid');
        errorDiv.style.display = 'none';

        if (nameValue === '') {
            showError('Category name cannot be empty.');
            event.preventDefault();
            return;
        }

        if (nameValue.length < 3) {
            showError('Category name must be at least 3 characters long.');
            event.preventDefault();
            return;
        }

        if (nameValue.length > 30) {
            showError('Category name cannot exceed 30 characters.');
            event.preventDefault();
            return;
        }

        if (!/^[A-Za-z]+(?: [A-Za-z]+)*$/.test(nameValue)) {
            showError('Category name should contain only letters and single spaces.');
            event.preventDefault();
            return;
        }
    });


    function showError(message) {

        categoryInput.classList.add('is-invalid');

        errorDiv.textContent = message;
        errorDiv.style.display = 'block';

        Swal.fire({
            icon: 'error',
            title: 'Validation Error',
            text: message,
            background: '#111',
            color: '#fff',
            confirmButtonColor: '#8a7df0'
        });
    }


    categoryInput.addEventListener('input', function () {

        categoryInput.classList.remove('is-invalid');

        errorDiv.textContent = '';
        errorDiv.style.display = 'none';

    });
</script>
</body>

</html>