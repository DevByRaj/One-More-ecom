<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        <%= isEdit ? "Edit Referral Offer" : "Add Referral Offer" %>
    </title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0b0b0b;
            color: #ffffff;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .app-container {
            display: flex;
            width: 100%;
            max-width: 1200px;
            gap: 30px;
        }

        /* SIDEBAR */

        .sidebar-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            width: 220px;
        }

        .logo-box {
            margin-bottom: 25px;
            font-size: 32px;
            font-weight: 800;
            letter-spacing: 2px;
        }

        .sidebar {
            width: 100%;
            background-color: #121212;
            border: 1.5px solid #6c38cc;
            border-radius: 16px;
            padding: 20px 0;
            display: flex;
            flex-direction: column;
            gap: 15px;
            box-shadow: 0 0 15px rgba(108, 56, 204, 0.15);
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 24px;
            color: #a0a0a0;
            text-decoration: none;
            font-size: 13px;
            transition: all 0.2s;
        }

        .nav-item:hover,
        .nav-item.active {
            color: #ffffff;
        }

        .nav-item i {
            width: 18px;
            text-align: center;
            font-size: 14px;
        }

        /* MAIN */

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .page-title-card {
            border: 1.5px solid #6c38cc;
            border-radius: 12px;
            padding: 14px 24px;
            font-size: 18px;
            font-weight: 600;
            background-color: #121212;
            box-shadow: 0 0 15px rgba(108, 56, 204, 0.1);
        }

        .form-container {
            border: 1.5px solid #6c38cc;
            border-radius: 16px;
            padding: 35px;
            background-color: #121212;
            box-shadow: 0 0 15px rgba(108, 56, 204, 0.1);
        }

        /* FORM */

        .offer-form {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 25px 40px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group.full-width {
            grid-column: span 2;
        }

        label {
            font-size: 12px;
            color: #cccccc;
        }

        input {
            background-color: #262626;
            border: 1px solid #333333;
            border-radius: 20px;
            padding: 10px 16px;
            color: #ffffff;
            font-size: 13px;
            outline: none;
            transition: border 0.2s;
        }

        input:focus {
            border-color: #6c38cc;
        }

        input[type="date"] {
            color-scheme: dark;
        }

        input[type="number"] {
            appearance: textfield;
        }

        .submit-btn-wrapper {
            grid-column: 2;
            display: flex;
            justify-content: flex-end;
            align-items: flex-end;
            margin-top: 10px;
        }

        .btn-submit {
            background-color: #ffffff;
            color: #000000;
            border: none;
            padding: 10px 36px;
            border-radius: 20px;
            font-weight: 600;
            font-size: 13px;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn-submit:hover {
            background-color: #e0e0e0;
        }

        /* ERROR */

        .error-message {
            background: #ff4d4f;
            color: white;
            padding: 12px 16px;
            border-radius: 8px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        /* ACTIVE */

        .active-group {
            flex-direction: row !important;
            align-items: center;
            gap: 10px;
        }

        .active-group input {
            width: auto;
            cursor: pointer;
        }

        .active-group label {
            cursor: pointer;
            margin: 0;
        }

        /* FOOTER */

        .footer-text {
            text-align: center;
            color: #666666;
            font-size: 11px;
            margin-top: 25px;
        }

        @media (max-width: 800px) {

            .app-container {
                flex-direction: column;
            }

            .sidebar-wrapper {
                width: 100%;
            }

            .offer-form {
                grid-template-columns: 1fr;
            }

            .form-group.full-width {
                grid-column: span 1;
            }

            .submit-btn-wrapper {
                grid-column: span 1;
            }
        }
    </style>

</head>

<body>

    <div class="app-container">

        <!-- SIDEBAR -->

        <div class="sidebar-wrapper">

            <div class="logo-box">
                iM
            </div>

            <aside class="sidebar">

                <a href="/admin/dashboard" class="nav-item">
                    <i class="fa-solid fa-chart-pie"></i>
                    Dashboard
                </a>

                <a href="/admin/products" class="nav-item">
                    <i class="fa-solid fa-border-all"></i>
                    Products
                </a>

                <a href="/admin/users" class="nav-item">
                    <i class="fa-solid fa-user-group"></i>
                    Customers
                </a>

                <a href="/admin/orders" class="nav-item">
                    <i class="fa-solid fa-cart-shopping"></i>
                    Orders
                </a>

                <a href="/admin/coupons" class="nav-item">
                    <i class="fa-solid fa-ticket"></i>
                    Coupons
                </a>

                <a href="/admin/category" class="nav-item">
                    <i class="fa-solid fa-shapes"></i>
                    Category
                </a>

                <a href="/admin/brand" class="nav-item">
                    <i class="fa-solid fa-box"></i>
                    Brand
                </a>

                <a href="/admin/offers" class="nav-item">
                    <i class="fa-solid fa-percent"></i>
                    Offers
                </a>

                <a href="/admin/referral-offers" class="nav-item active">
                    <i class="fa-solid fa-user-plus"></i>
                    Referral Offers
                </a>

                <a href="/admin/banner" class="nav-item">
                    <i class="fa-solid fa-mobile-screen"></i>
                    Banner
                </a>

                <a href="/admin/sales-report" class="nav-item">
                    <i class="fa-solid fa-chart-line"></i>
                    Sales Report
                </a>

                <a href="/admin/logout" class="nav-item">
                    <i class="fa-solid fa-power-off"></i>
                    Logout
                </a>

            </aside>

        </div>


        <!-- MAIN CONTENT -->

        <main class="main-content">

            <div class="page-title-card">
                <%= isEdit ? "Edit Referral Offer" : "Add Referral Offer" %>
            </div>

            <div class="form-container">

                <% if (error) { %>

                    <div class="error-message">
                        <%= error %>
                    </div>

                    <% } %>


                    <form action="<%= isEdit
                            ? '/admin/referral-offers/edit/' + offer._id
                            : '/admin/referral-offers/add'
                        %>" method="POST" class="offer-form">
                            <!-- OFFER NAME -->

                            <div class="form-group">

                                <label for="offerName">
                                    Offer Name
                                </label>

                                <input type="text" id="offerName" name="offerName"
                                    placeholder="Enter referral offer name" value="<%= offer?.offerName || '' %>"
                                    required>

                            </div>


                            <!-- REFERRER REWARD -->

                            <div class="form-group">

                                <label for="referrerReward">
                                    Referrer Reward (₹)
                                </label>

                                <input type="number" id="referrerReward" name="referrerReward" min="1" step="0.01"
                                    placeholder="Example: 100" value="<%= offer?.referrerReward || '' %>" required>

                            </div>


                            <!-- REFERRED USER REWARD -->

                            <div class="form-group">

                                <label for="referredUserReward">
                                    New User Reward (₹)
                                </label>

                                <input type="number" id="referredUserReward" name="referredUserReward" min="1"
                                    step="0.01" placeholder="Example: 50"
                                    value="<%= offer?.referredUserReward || '' %>" required>

                            </div>


                            <!-- START DATE -->

                            <div class="form-group">

                                <label for="startDate">
                                    Start Date
                                </label>

                                <input type="date" id="startDate" name="startDate"
                                    min="<%= new Date().toISOString().split('T')[0] %>"
                                    value="<%= offer?.startDate ? new Date(offer.startDate).toISOString().split('T')[0] : '' %>" required>

                            </div>


                            <!-- END DATE -->

                            <div class="form-group">

                                <label for="endDate">
                                    End Date
                                </label>

                                <input type="date" id="endDate" name="endDate"
                                    min="<%= new Date().toISOString().split('T')[0] %>"
                                    value="<%= offer?.endDate ? new Date(offer.endDate).toISOString().split('T')[0] : '' %>" required>

                            </div>


                            <!-- ACTIVE -->

                            <div class="form-group full-width active-group">

                                <input type="checkbox" id="isActive" name="isActive" <%=offer?.isActive !==false ? "checked" : "" %>
                                >

                                <label for="isActive">
                                    Active
                                </label>

                            </div>


                            <!-- SUBMIT -->

                            <div class="submit-btn-wrapper">

                                <button type="submit" class="btn-submit">
                                    <%= isEdit ? "Update Referral Offer" : "Create Referral Offer" %>
                                </button>

                            </div>

                        </form>

            </div>


            <div class="footer-text">
                © 2026 onemore. All Rights Reserved.
            </div>

        </main>

    </div>

</body>

</html>