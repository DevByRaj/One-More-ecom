<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= product.productName %> | OneMore
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f5f5f5;
            color: #111;
            margin: 0;
            padding: 0;
        }

        a {
            text-decoration: none;
        }

        /* NAVBAR */
        .navbar {
            background-color: #000 !important;
            padding: 22px 40px;
            position: sticky;
            top: 0;
            z-index: 9999;
            width: 100%;
            margin: 0;
            border: none;
        }

        .navbar-brand img {
            height: 55px;
        }

        .navbar-nav {
            gap: 18px;
        }

        .navbar-nav .nav-link {
            color: #fff !important;
            font-size: 15px;
            font-weight: 500;
            transition: 0.2s ease;
        }

        .navbar-nav .nav-link:hover {
            color: #8a7df0 !important;
        }

        .nav-icons {
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .nav-icons a {
            color: #fff !important;
            font-size: 22px;
            text-decoration: none;
            transition: 0.2s ease;
        }

        .nav-icons a:hover {
            color: #8a7df0 !important;
        }

        .navbar-toggler {
            border: none;
        }

        .navbar-toggler:focus {
            box-shadow: none;
        }

        .navbar-toggler-icon {
            filter: invert(1)
        }

        /* BREADCRUMBS */
        .breadcrumb-container {
            font-size: 14px;
            margin: 25px 40px;
            color: #777;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .breadcrumb-container a {
            color: #555;
            text-decoration: none;
            transition: 0.2s;
        }

        .breadcrumb-container a:hover {
            color: #000;
        }

        .active-breadcrumb {
            color: #111;
            font-weight: 600;
        }

        /* THUMBNAILS */
        .thumbnail-container {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .thumb-img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 4px;
            cursor: pointer;
            border: 2px solid transparent;
            transition: 0.2s;
        }

        .thumb-img.active {
            border-color: #7b68ee;
        }

        /* PREMIUM INNER ZOOM CONTROLS */
        /* PREMIUM INNER ZOOM CONTROLS */
        .main-image-wrapper {
            position: relative;
            width: 100%;
            height: 500px;
            /* Change background from solid white to transparent/match the image flow */
            background: #fdfdfd;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            border-radius: 10px;
            /* Remove or soften the hard border that outlines the image */
            border: none;
            cursor: zoom-in;
        }

        .main-product-img {
            width: 100%;
            height: 100%;
            /* Changing object-fit to cover eliminates the letterbox gap borders */
            object-fit: cover;
            transform-origin: center center;
            transition: transform 0.1s ease-out;
            pointer-events: none;
        }

        /* PRODUCT DETAILS */
        .product-main-container {
            padding-top: 20px;
        }

        .product-title {
            font-size: 38px;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .price-section {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
        }

        .current-price {
            font-size: 28px;
            font-weight: 700;
        }

        .original-price {
            text-decoration: line-through;
            color: #999;
            font-size: 16px;
        }

        .discount-badge {
            color: #36b44a;
            font-weight: 600;
            font-size: 15px;
        }

        .rating-container {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            color: #666;
            font-size: 13px;
        }

        .rating-container i {
            color: #f1c40f;
        }

        .section-title {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .product-desc {
            font-size: 13px;
            color: #555;
            line-height: 1.8;
            max-width: 450px;
        }

        /* VARIANTS */
        .variant-color-btn {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            border: 2px solid #fff;
            outline: 1px solid #999;
            cursor: pointer;
            transition: 0.2s ease;
        }

        .variant-color-btn.active-variant {
            transform: scale(1.15);
            outline: 2px solid #000;
        }

        /* BUTTONS */
        .wishlist-btn {
            background: #ff7d7d;
            border: none;
            color: #fff;
            padding: 12px 35px;
            border-radius: 30px;
            font-size: 14px;
            margin-bottom: 18px;
            font-weight: 500;
            transition: 0.2s ease;
        }

        .wishlist-btn:hover {
            background: #ff5252;
        }

        .action-btns {
            display: flex;
            gap: 15px;
        }

        .action-btns button {
            border: none;
            background: #000;
            color: #fff;
            padding: 12px 35px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 500;
            transition: 0.2s ease;
        }

        .action-btns button:hover {
            background: #222;
        }

        /* SIMILAR PRODUCTS */
        .similar-title {
            font-size: 30px;
            font-weight: 600;
            margin-top: 60px;
            margin-bottom: 30px;
        }

        .product-card {
            position: relative;
            background: #fff;
            padding: 15px;
            border-radius: 12px;
            transition: 0.3s ease;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
        }

        .product-card img {
            width: 100%;
            height: 220px;
            object-fit: contain;
            border-radius: 10px;
            background: #fff;
        }

        .product-name {
            font-size: 14px;
            font-weight: 500;
            margin-top: 12px;
            color: #111;
        }

        .card-price {
            font-size: 13px;
            font-weight: 600;
            margin-top: 4px;
        }

        .card-rating {
            color: #f1c40f;
            font-size: 11px;
            margin-top: 5px;
        }

        /* FOOTER */
        footer {
            background: #111;
            color: #fff;
            margin-top: 80px;
            padding: 60px 0 20px;
        }

        .footer-logo {
            width: 80px;
            margin-bottom: 20px;
        }

        footer h6 {
            font-size: 14px;
            margin-bottom: 18px;
            font-weight: 600;
        }

        footer a {
            display: block;
            color: #ddd;
            font-size: 12px;
            margin-bottom: 10px;
        }

        .copyright {
            border-top: 1px solid #333;
            margin-top: 40px;
            padding-top: 20px;
            font-size: 12px;
            color: #aaa;
        }

        .wishlist-btn:disabled,
        .action-btns button:disabled {
            background: #bdbdbd;
            color: #fff;
            cursor: not-allowed;
            opacity: 0.6;
        }

        /* COUNT BADGES */

        .count-badge {
            position: absolute;
            top: -10px;
            right: -12px;
            background: red;
            color: white;
            font-size: 10px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        .show-badge {
            display: flex;
        }

        .hide-badge {
            display: none;
        }

        /*TOAST NOTIFICATION */
        .custom-toast {
            position: fixed;
            top: 30px;
            right: 30px;
            min-width: 320px;
            max-width: 380px;

            background: #ffffff;
            color: #222;

            padding: 16px 20px;
            border-radius: 14px;

            display: flex;
            align-items: center;
            gap: 14px;

            font-size: 14px;
            font-weight: 500;

            z-index: 99999;

            opacity: 0;
            transform: translateX(120%);

            transition: all 0.35s ease;

            box-shadow:
                0 12px 35px rgba(0, 0, 0, 0.18);

            border-left: 5px solid #ff3b30;

            overflow: hidden;
        }

        .custom-toast.show {
            opacity: 1;
            transform: translateX(0);
        }

        /* ERROR ICON */
        /* TOAST ICON */
        .custom-toast::before {
            content: "!";

            width: 32px;
            height: 32px;
            min-width: 32px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            font-size: 18px;
            font-weight: 700;
        }

        /* SUCCESS */
        .custom-toast.success {
            border-left-color: #22c55e;
        }

        .custom-toast.success::before {
            content: "✓";
            background: #e8f8ee;
            color: #22c55e;
        }

        .custom-toast.success::after {
            background: #22c55e;
        }

        /* ERROR */
        .custom-toast.error {
            border-left-color: #ff3b30;
        }

        .custom-toast.error::before {
            content: "!";
            background: #ffe8e6;
            color: #ff3b30;
        }

        .custom-toast.error::after {
            background: #ff3b30;
        }

        /* WARNING */
        .custom-toast.warning {
            border-left-color: #f59e0b;
        }

        .custom-toast.warning::before {
            content: "!";
            background: #fff4d6;
            color: #f59e0b;
        }

        .custom-toast.warning::after {
            background: #f59e0b;
        }

        /* TOAST MESSAGE */
        .custom-toast-message {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .custom-toast-title {
            font-size: 14px;
            font-weight: 700;
            color: #111;
        }

        .custom-toast-text {
            font-size: 13px;
            color: #666;
        }

        /* PROGRESS BAR */
        .custom-toast::after {
            content: "";

            position: absolute;
            bottom: 0;
            left: 0;

            height: 3px;
            width: 100%;

            background: #ff3b30;

            transform-origin: left;
            animation: toastProgress 2.5s linear forwards;
        }

        .product-status-banner {
            display: flex;
            align-items: flex-start;
            gap: 16px;
            padding: 16px 20px;
            margin-bottom: 24px;
            border-radius: 14px;
            background: #ffffff;
            border: 1px solid #fee2e2;
            box-shadow: 0 4px 12px -2px rgba(239, 68, 68, 0.08),
                0 2px 4px -1px rgba(0, 0, 0, 0.02);
            position: relative;
            overflow: hidden;
        }

        /* Subtle red accent strip on the left border */
        .product-status-banner::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            bottom: 0;
            width: 4px;
            background: #ef4444;
            border-radius: 14px 0 0 14px;
        }

        .status-icon-wrapper {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: #fef2f2;
            color: #ef4444;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            margin-top: 2px;
        }

        .status-content {
            flex: 1;
            min-width: 0;
        }

        .status-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 4px;
            flex-wrap: wrap;
        }

        .status-title {
            margin: 0;
            color: #111827;
            font-size: 15px;
            font-weight: 600;
            letter-spacing: -0.01em;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 2px 8px;
            border-radius: 9999px;
            background: #fef2f2;
            color: #991b1b;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .status-description {
            margin: 0;
            color: #4b5563;
            font-size: 13.5px;
            line-height: 1.5;
        }

        /* Responsive adjustments for mobile devices */
        @media (max-width: 576px) {
            .product-status-banner {
                padding: 14px 16px;
                gap: 12px;
            }
        }

        @keyframes toastProgress {
            from {
                transform: scaleX(1);
            }

            to {
                transform: scaleX(0);
            }
        }

        @media(max-width: 600px) {

            .custom-toast {
                top: 20px;
                right: 15px;
                left: 15px;

                min-width: auto;
                max-width: none;
            }
        }
    </style>
</head>

<body>
    <% const defaultVariant=variants.find(v=> v.stock > 0) || variants[0] %>
        <!-- HEADER NAVBAR -->
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">
                    <img src="/images/logo.png" alt="logo">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                        <li class="nav-item"><a class="nav-link" href="/shop">Shop</a></li>
                        <li class="nav-item"><a class="nav-link" href="/contact">Contact Us</a></li>
                        <li class="nav-item"><a class="nav-link" href="/about">About Us</a></li>
                    </ul>
                    <div class="nav-icons">
                        <a href="/profile"><i class="bi bi-person"></i></a>
                        <a href="/wishlist">
                            <div style="position:relative;">
                                <i class="bi bi-heart"></i>
                                <span id="wishlistCountBadge"
                                    class="count-badge <%= wishlistCount > 0 ? 'show-badge' : 'hide-badge' %>">
                                    <%= wishlistCount || 0 %>
                                </span>
                            </div>
                        </a>
                        <a href="/cart">
                            <div style="position:relative;">
                                <i class="bi bi-bag" style="font-size: 22px;"></i>

                                <span id="cartCountBadge"
                                    class="count-badge <%= cartCount > 0 ? 'show-badge' : 'hide-badge' %>">
                                    <%= cartCount || 0 %>
                                </span>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </nav>

        <!-- BREADCRUMBS -->
        <div class="breadcrumb-container">
            <a href="/">Home</a>
            <span>/</span>
            <a href="/shop">Shop</a>
            <span>/</span>
            <a href="/shop?category=<%= product.category._id %>">
                <%= product.category.name %>
            </a>
            <span>/</span>
            <span class="active-breadcrumb">
                <%= product.productName %>
            </span>
        </div>

        <!-- MAIN INTERFACE ARCHITECTURE -->
        <div class="container product-main-container">
            <div class="product-wrapper">
                <div class="row g-4">

                    <!-- THUMBNAILS DISPLAY COMPONENT -->
                    <div class="col-md-1 col-2">
                        <div class="thumbnail-container">
                            <% if(defaultVariant?.variantImage?.length> 0){ %>
                                <% defaultVariant.variantImage.forEach((img, idx)=> { %>
                                    <img src="<%= img %>" class="thumb-img <%= idx === 0 ? 'active' : '' %>"
                                        onclick="changeMainImage(this.src, this)">
                                    <% }) %>
                                        <% } else { %>
                                            <% product.productImage.forEach((img, idx)=> { %>
                                                <img src="<%= img %>" class="thumb-img <%= idx === 0 ? 'active' : '' %>"
                                                    onclick="changeMainImage(this.src, this)">
                                                <% }) %>
                                                    <% } %>
                        </div>
                    </div>

                    <!-- MAIN DISPLAY (Inner Zoom Container) -->
                    <div class="col-md-5 col-10">
                        <div class="main-image-wrapper" id="zoomContainer">
                            <img id="mainProductImage"
                                src="<%= defaultVariant?.variantImage[0] || product.productImage[0] %>"
                                class="main-product-img" alt="<%= product.productName %>">
                        </div>
                    </div>

                    <!-- RIGHT CONTENT BLOCK DETAILS -->
                    <div class="col-md-6">

                        <% if (unavailable) { %>
                            <div class="product-status-banner unavailable" role="alert" aria-live="polite">
                                <div class="status-icon-wrapper">
                                    <svg class="status-icon" width="20" height="20" viewBox="0 0 24 24" fill="none"
                                        stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                        stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <line x1="12" y1="8" x2="12" y2="12"></line>
                                        <line x1="12" y1="16" x2="12.01" y2="16"></line>
                                    </svg>
                                </div>

                                <div class="status-content">
                                    <div class="status-header">
                                        <h5 class="status-title">Product Unavailable</h5>
                                        <span class="status-badge">Temporarily Unavailable</span>
                                    </div>
                                    <p class="status-description">
                                        This item is currently unavailable and cannot be added to your cart.
                                    </p>
                                </div>
                            </div>
                            <% } %>

                                <h1 class="product-title">
                                    <%= product.productName %>
                                </h1>

                                <div class="price-section">

                                    <% if(defaultVariant?.offer?.appliedOffer){ %>

                                        <span class="current-price" id="salePrice">
                                            ₹<%= defaultVariant.offer.finalPrice.toFixed(2) %>
                                        </span>

                                        <span class="original-price" id="regularPrice">
                                            ₹<%= defaultVariant.offer.originalPrice.toFixed(2) %>
                                        </span>

                                        <span class="discount-badge" id="discountBadge">

                                            <%= defaultVariant.offer.appliedOffer.offerName %>

                                                -

                                                <% if(defaultVariant.offer.appliedOffer.offerType==="PERCENTAGE" ){ %>

                                                    <%= defaultVariant.offer.appliedOffer.discountValue %>% OFF

                                                        <% }else{ %>

                                                            ₹<%= defaultVariant.offer.appliedOffer.discountValue %> OFF

                                                                <% } %>

                                        </span>

                                        <% } else { %>

                                            <span class="current-price" id="salePrice">
                                                ₹<%= variants[0].salePrice %>
                                            </span>

                                            <% if(variants[0].regularPrice> variants[0].salePrice){ %>

                                                <span class="original-price" id="regularPrice">
                                                    ₹<%= variants[0].regularPrice %>
                                                </span>

                                                <% } %>

                                                    <% } %>

                                </div>

                                <div class="fw-semibold mb-3 <%= defaultVariant?.stock > 0 ? 'text-success' : 'text-danger' %>"
                                    id="stockStatus">
                                    <%= defaultVariant?.stock> 0 ? 'In Stock' : 'Out of Stock' %>
                                </div>

                                <div class="rating-container">
                                    <i class="bi bi-star-fill"></i>
                                    <span>4.6</span>
                                    <span>|</span>
                                    <span>486 reviews</span>
                                </div>

                                <div class="section-title">Product Details</div>
                                <p class="product-desc">
                                    <%= product.description %>
                                </p>

                                <div class="section-title mt-4 mb-2">Color</div>
                                <div class="d-flex align-items-center gap-2 mb-4">
                                    <% variants.forEach((variant, index)=> { %>
                                        <button type="button"
                                            class="variant-color-btn <%= variant._id.toString() === defaultVariant._id.toString() ? 'active-variant' : '' %>"
                                            data-variant-id="<%= variant._id %>" data-stock="<%= variant.stock %>"
                                            title="<%= variant.variantName %>" onclick='changeVariant(
                                this,
                                `<%- JSON.stringify(variant.variantImage).replace(/"/g, "&quot;" ) %>`,
                                    `<%- JSON.stringify(variant.offer).replace(/"/g, "&quot;" ) %>`,
                                        `<%= variant.stock %>`
                                            )' style="background: <%= variant.variantName.toLowerCase() %>;">
                                        </button>
                                        <% }) %>
                                </div>

                                <button class="wishlist-btn" id="wishlistBtn" <%=unavailable ? 'disabled' : '' %>
                                    data-product-id="<%= product._id %>"
                                        data-variant-id="<%= defaultVariant?._id || '' %>">
                                            Wishlist <i class="bi bi-heart"></i>
                                </button>

                                <div class="action-btns">
                                    <button type="button" id="buyNowBtn" <%=unavailable ? 'disabled' : '' %>
                                        data-product-id="<%= product._id %>"
                                            data-variant-id="<%= defaultVariant?._id || '' %>">
                                                Buy Now
                                    </button>

                                    <button type="button" id="addToCartBtn" <%=unavailable ? 'disabled' : '' %>
                                        data-product-id="<%= product._id %>"
                                            data-variant-id="<%= defaultVariant?._id || '' %>" class="btn btn-dark">
                                                Add To Cart
                                    </button>
                                </div>
                    </div>

                    <!-- SPECIFICATIONS SECTION GRID -->
                    <div class="container my-5 pt-4" style="border-top: 1px solid #eee;">
                        <h2 class="mb-5" style="font-size: 32px; font-weight: 400; color: #000000;">
                            Product <span style="font-weight: 700;">Specifications</span>
                        </h2>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <div class="mb-4">
                                    <label
                                        style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Name</label>
                                    <p style="font-weight: 700; color: #000000; font-size: 15px;">
                                        <%= product.productName %>
                                    </p>
                                </div>
                                <div class="mb-4">
                                    <label
                                        style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Brand</label>
                                    <p style="font-weight: 700; color: #000000; font-size: 15px;">
                                        <%= product.brand ? product.brand.name : 'Premium' %>
                                    </p>
                                </div>
                                <div class="mb-4">
                                    <label
                                        style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Net
                                        Quantity</label>
                                    <p style="font-weight: 700; color: #000000; font-size: 15px;">1 Unit</p>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="mb-4">
                                    <label
                                        style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Category</label>
                                    <p style="font-weight: 700; color: #000000; font-size: 15px;">
                                        <%= product.category ? product.category.name : 'Audio' %>
                                    </p>
                                </div>
                                <% if (product.playtime) { %>
                                    <div class="mb-4">
                                        <label
                                            style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Playtime</label>
                                        <p style="font-weight: 700; color: #000000; font-size: 15px;">Up to <%=
                                                product.playtime %> Hours</p>
                                    </div>
                                    <% } %>
                                        <div class="mb-4">
                                            <label
                                                style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Country
                                                Of Origin</label>
                                            <p style="font-weight: 700; color: #000000; font-size: 15px;">India</p>
                                        </div>
                            </div>

                            <div class="col-md-4">
                                <div class="mb-4">
                                    <label
                                        style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Warranty
                                        Status</label>
                                    <p style="font-weight: 700; color: #000000; font-size: 15px;">1 Year Brand Warranty
                                    </p>
                                </div>
                                <div class="mb-4">
                                    <label
                                        style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Connectivity</label>
                                    <p style="font-weight: 700; color: #000000; font-size: 15px;">Bluetooth v5.2</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- SIMILAR COLLECTION GRID -->
                <h2 class="similar-title">Similar Collection</h2>
                <div class="row">
                    <% if(similarProducts && similarProducts.length> 0){ %>
                        <% similarProducts.forEach(item=> { %>
                            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                                <div class="product-card">
                                    <a href="/productDetails?id=<%= item._id %>">
                                        <img src="<%= item.productImage[0] %>" alt="<%= item.productName %>">
                                    </a>
                                    <div class="product-name">
                                        <%= item.productName %>
                                    </div>
                                    <div class="card-price">₹<%= item.salePrice || 0 %>
                                    </div>
                                    <div class="card-rating">
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                        <i class="bi bi-star-fill"></i>
                                    </div>
                                </div>
                            </div>
                            <% }) %>
                                <% } %>
                </div>
            </div>
        </div>

        <!-- FOOTER ARCHITECTURE -->
        <footer>
            <div class="container">
                <div class="row">
                    <div class="col-md-3 mb-4">
                        <img src="/images/logo.png" class="footer-logo" alt="logo">
                    </div>
                    <div class="col-md-3 mb-4">
                        <h6>SUPPORT</h6>
                        <a href="#">Order Status</a>
                        <a href="#">Product Support</a>
                        <a href="#">Shipping & Return Policy</a>
                    </div>
                    <div class="col-md-3 mb-4">
                        <h6>About Us</h6>
                        <a href="#">Contact Us</a>
                        <a href="#">Privacy Policy</a>
                        <a href="#">Terms of use</a>
                    </div>
                    <div class="col-md-3 mb-4">
                        <h6>Connect with us</h6>
                        <a href="#" class="me-2"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="me-2"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>
                <div class="copyright text-center">
                    © 2026 OneMore. All Rights Reserved.
                </div>
            </div>
        </footer>

        <!-- LOGIC SCRIPTS ENGINE -->
        <script>
            document.addEventListener("DOMContentLoaded", () => {
                const addToCartBtn = document.getElementById("addToCartBtn");
                const wishlistBtn = document.getElementById("wishlistBtn");
                const buyNowBtn = document.getElementById("buyNowBtn");
                const container = document.getElementById("zoomContainer");
                const image = document.getElementById("mainProductImage");

                // ── PREMIUM INNER ZOOM ENGINE (No blocking text anymore) ──
                container.addEventListener("mousemove", (e) => {
                    const rect = container.getBoundingClientRect();

                    // Get cursor tracking coordinates relative to the photo box frame
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;

                    // Turn inputs into percentages to calculate clean mapping origin vectors
                    const xPercent = (x / rect.width) * 100;
                    const yPercent = (y / rect.height) * 100;

                    // Shift scale origin dynamically and scale image up smoothly inline
                    image.style.transformOrigin = `${xPercent}% ${yPercent}%`;
                    image.style.transform = "scale(2.2)"; // Adjust zoom strength here (2.2x zoom)
                });

                container.addEventListener("mouseleave", () => {
                    // Instantly snap image tracking scale back to normal on exit
                    image.style.transformOrigin = "center center";
                    image.style.transform = "scale(1)";
                });

                // ADD TO CART NETWORK PIPELINE
                addToCartBtn.addEventListener("click", async () => {
                    try {
                        const productId = addToCartBtn.dataset.productId;
                        const variantId = addToCartBtn.dataset.variantId;

                        const response = await fetch("/cart/add", {
                            method: "POST",
                            credentials: "same-origin",
                            headers: {
                                "Content-Type": "application/json",
                                "Accept": "application/json"
                            },
                            body: JSON.stringify({ productId, variantId })
                        });

                        const data = await response.json();
                        showToast(
                            data.message,
                            data.success ? "Added to Cart" : "Unable to Add",
                            data.success ? "success" : "error"
                        );

                        if (data.success) {

                            const cartCountBadge = document.getElementById("cartCountBadge");

                            if (cartCountBadge) {
                                cartCountBadge.textContent = data.cartCount;
                                cartCountBadge.style.display =
                                    data.cartCount > 0 ? "flex" : "none";
                            }

                            const wishlistBadge = document.getElementById("wishlistCountBadge");

                            if (wishlistBadge) {
                                wishlistBadge.textContent = data.wishlistCount;
                                wishlistBadge.style.display =
                                    data.wishlistCount > 0 ? "flex" : "none";
                            }
                        }
                    } catch (error) {
                        console.error(error);
                        showToast(
                            "Failed adding product to cart.",
                            "Something Went Wrong",
                            "error"
                        );
                    }
                });

                // BUY NOW
                buyNowBtn.addEventListener("click", () => {

                    const productId = buyNowBtn.dataset.productId;
                    const variantId = buyNowBtn.dataset.variantId;

                    if (!productId || !variantId) {
                        showToast(
                            "Please select a product variant.",
                            "Unable to Continue",
                            "error"
                        );
                        return;
                    }

                    window.location.href =
                        `/buy-now?productId=${productId}&variantId=${variantId}`;
                });

                // WISHLIST OPERATIONS PIPELINE
                wishlistBtn.addEventListener("click", async () => {
                    const productId = wishlistBtn.dataset.productId;
                    const variantId = wishlistBtn.dataset.variantId;

                    try {
                        const response = await fetch("/wishlist/add", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({ productId, variantId })
                        });

                        const data = await response.json();
                        showToast(
                            data.message,
                            data.success ? "Added to Wishlist" : "Unable to Add",
                            data.success ? "success" : "error"
                        );

                        if (data.success) {

                            const wishlistBadge = document.getElementById("wishlistCountBadge");

                            if (wishlistBadge) {
                                wishlistBadge.textContent = data.wishlistCount;
                                wishlistBadge.style.display =
                                    data.wishlistCount > 0 ? "flex" : "none";
                            }
                        }
                    } catch (error) {
                        console.error(error);
                    }
                });
            });

            // IMAGE CAROUSEL SWITCHER
            function changeMainImage(src, thumbElement) {
                document.getElementById('mainProductImage').src = src;
                document.querySelectorAll('.thumb-img').forEach(thumb => {
                    thumb.classList.remove('active');
                });
                thumbElement.classList.add('active');
            }

            // VARIANT SELECTION CONFIGURATOR
            function changeVariant(button, images, offer, stock) {
                console.log("SELECTED VARIANT:", button.dataset.variantId);
                console.log("SELECTED STOCK:", stock);
                document.querySelectorAll(".variant-color-btn").forEach(btn => {
                    btn.classList.remove("active-variant");
                });
                button.classList.add("active-variant");

                const parsedImages = JSON.parse(images);

                const offerData = JSON.parse(offer);

                document.getElementById("mainProductImage").src = parsedImages[0];
                document.getElementById("salePrice").innerText =
                    "₹" + offerData.finalPrice.toFixed(2);

                const regPriceElem = document.getElementById("regularPrice");
                const discountBadge = document.getElementById("discountBadge");

                if (regPriceElem) {
                    regPriceElem.innerText =
                        "₹" + offerData.originalPrice.toFixed(2);

                    regPriceElem.style.display = "inline";
                }

                if (offerData.appliedOffer && discountBadge) {

                    if (offerData.appliedOffer.offerType === "PERCENTAGE") {

                        discountBadge.innerText =
                            `${offerData.appliedOffer.offerName} - ${offerData.appliedOffer.discountValue}% OFF`;

                    } else {

                        discountBadge.innerText =
                            `${offerData.appliedOffer.offerName} - ₹${offerData.appliedOffer.discountValue} OFF`;

                    }

                    discountBadge.style.display = "inline";

                } else if (discountBadge) {

                    discountBadge.style.display = "none";

                }
                const vId = button.dataset.variantId;
                document.getElementById("wishlistBtn").dataset.variantId = vId;
                document.getElementById("addToCartBtn").dataset.variantId = vId;
                document.getElementById("buyNowBtn").dataset.variantId = vId;

                const stockStatus = document.getElementById("stockStatus");
                stockStatus.innerText = Number(stock) > 0 ? "In Stock" : "Out of Stock";
                stockStatus.className = Number(stock) > 0 ? "fw-semibold mb-3 text-success" : "fw-semibold mb-3 text-danger";

                console.log("STOCK STATUS DISPLAY:", stockStatus.innerText);

                const thumbnailContainer = document.querySelector(".thumbnail-container");
                thumbnailContainer.innerHTML = "";
                parsedImages.forEach((img, index) => {
                    thumbnailContainer.innerHTML += `<img src="${img}" class="thumb-img ${index === 0 ? 'active' : ''}" onclick="changeMainImage('${img}', this)">`;
                });
            }

            // GLOBAL DYNAMIC TOAST COMPONENT

            function showToast(message, title = "Notice", type = "error") {

                const existingToast = document.querySelector(".custom-toast");

                if (existingToast) {
                    existingToast.remove();
                }

                const toast = document.createElement("div");

                toast.className = `custom-toast ${type}`;

                toast.innerHTML = `
        <div class="custom-toast-message">
            <div class="custom-toast-title">
                ${title}
            </div>

            <div class="custom-toast-text">
                ${message}
            </div>
        </div>
    `;

                document.body.appendChild(toast);

                setTimeout(() => {
                    toast.classList.add("show");
                }, 50);

                setTimeout(() => {

                    toast.classList.remove("show");

                    setTimeout(() => {
                        toast.remove();
                    }, 350);

                }, 2500);
            }

        </script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>