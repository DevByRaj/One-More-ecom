<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= product.productName %> | OneMore
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f5f5f5;
            color: #111;
            margin: 0;
            padding: 0;
        }

        a {
            text-decoration: none;
        }

        /* NAVBAR */
        .navbar {
            background-color: #000 !important;
            padding: 22px 40px;
            position: sticky;
            top: 0;
            z-index: 9999;
            width: 100%;
            margin: 0;
            border: none;
        }

        .navbar-brand img {
            height: 55px;
        }

        .navbar-nav {
            gap: 18px;
        }

        .navbar-nav .nav-link {
            color: #fff !important;
            font-size: 15px;
            font-weight: 500;
            transition: 0.2s ease;
        }

        .navbar-nav .nav-link:hover {
            color: #8a7df0 !important;
        }

        .nav-icons {
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .nav-icons a {
            color: #fff !important;
            font-size: 22px;
            text-decoration: none;
            transition: 0.2s ease;
        }

        .nav-icons a:hover {
            color: #8a7df0 !important;
        }

        .navbar-toggler {
            border: none;
        }

        .navbar-toggler:focus {
            box-shadow: none;
        }

        .navbar-toggler-icon {
            filter: invert(1)
        }

        /* BREADCRUMBS */
        .breadcrumb-container {
            font-size: 14px;
            margin: 25px 40px;
            color: #777;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .breadcrumb-container a {
            color: #555;
            text-decoration: none;
            transition: 0.2s;
        }

        .breadcrumb-container a:hover {
            color: #000;
        }

        .active-breadcrumb {
            color: #111;
            font-weight: 600;
        }

        /* THUMBNAILS */
        .thumbnail-container {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .thumb-img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 4px;
            cursor: pointer;
            border: 2px solid transparent;
            transition: 0.2s;
        }

        .thumb-img.active {
            border-color: #7b68ee;
        }

        /* PREMIUM INNER ZOOM CONTROLS */
        /* PREMIUM INNER ZOOM CONTROLS */
        .main-image-wrapper {
            position: relative;
            width: 100%;
            height: 500px;
            /* Change background from solid white to transparent/match the image flow */
            background: #fdfdfd;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            border-radius: 10px;
            /* Remove or soften the hard border that outlines the image */
            border: none;
            cursor: zoom-in;
        }

        .main-product-img {
            width: 100%;
            height: 100%;
            /* Changing object-fit to cover eliminates the letterbox gap borders */
            object-fit: cover;
            transform-origin: center center;
            transition: transform 0.1s ease-out;
            pointer-events: none;
        }

        /* PRODUCT DETAILS */
        .product-main-container {
            padding-top: 20px;
        }

        .product-title {
            font-size: 38px;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .price-section {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
        }

        .current-price {
            font-size: 28px;
            font-weight: 700;
        }

        .original-price {
            text-decoration: line-through;
            color: #999;
            font-size: 16px;
        }

        .discount-badge {
            color: #36b44a;
            font-weight: 600;
            font-size: 15px;
        }

        .rating-container {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            color: #666;
            font-size: 13px;
        }

        .rating-container i {
            color: #f1c40f;
        }

        .section-title {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .product-desc {
            font-size: 13px;
            color: #555;
            line-height: 1.8;
            max-width: 450px;
        }

        /* VARIANTS */
        .variant-color-btn {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            border: 2px solid #fff;
            outline: 1px solid #999;
            cursor: pointer;
            transition: 0.2s ease;
        }

        .variant-color-btn.active-variant {
            transform: scale(1.15);
            outline: 2px solid #000;
        }

        /* BUTTONS */
        .wishlist-btn {
            background: #ff7d7d;
            border: none;
            color: #fff;
            padding: 12px 35px;
            border-radius: 30px;
            font-size: 14px;
            margin-bottom: 18px;
            font-weight: 500;
            transition: 0.2s ease;
        }

        .wishlist-btn:hover {
            background: #ff5252;
        }

        .action-btns {
            display: flex;
            gap: 15px;
        }

        .action-btns button {
            border: none;
            background: #000;
            color: #fff;
            padding: 12px 35px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 500;
            transition: 0.2s ease;
        }

        .action-btns button:hover {
            background: #222;
        }

        /* SIMILAR PRODUCTS */
        .similar-title {
            font-size: 30px;
            font-weight: 600;
            margin-top: 60px;
            margin-bottom: 30px;
        }

        .product-card {
            position: relative;
            background: #fff;
            padding: 15px;
            border-radius: 12px;
            transition: 0.3s ease;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.05);
        }

        .product-card img {
            width: 100%;
            height: 220px;
            object-fit: contain;
            border-radius: 10px;
            background: #fff;
        }

        .product-name {
            font-size: 14px;
            font-weight: 500;
            margin-top: 12px;
            color: #111;
        }

        .card-price {
            font-size: 13px;
            font-weight: 600;
            margin-top: 4px;
        }

        .card-rating {
            color: #f1c40f;
            font-size: 11px;
            margin-top: 5px;
        }

        /* FOOTER */
        footer {
            background: #111;
            color: #fff;
            margin-top: 80px;
            padding: 60px 0 20px;
        }

        .footer-logo {
            width: 80px;
            margin-bottom: 20px;
        }

        footer h6 {
            font-size: 14px;
            margin-bottom: 18px;
            font-weight: 600;
        }

        footer a {
            display: block;
            color: #ddd;
            font-size: 12px;
            margin-bottom: 10px;
        }

        .copyright {
            border-top: 1px solid #333;
            margin-top: 40px;
            padding-top: 20px;
            font-size: 12px;
            color: #aaa;
        }

        /* TOAST NOTIFICATION */
        .custom-toast {
            position: fixed;
            top: 30px;
            right: 30px;
            background: #111;
            color: white;
            padding: 14px 22px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            z-index: 9999;
            opacity: 0;
            transform: translateY(-20px);
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        }

        .custom-toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        @media(max-width:768px) {
            .main-image-wrapper {
                height: 350px;
            }

            .product-title {
                font-size: 28px;
                margin-top: 25px;
            }

            .action-btns {
                flex-direction: column;
            }

            .action-btns button {
                width: 100%;
            }

            .breadcrumb-container {
                margin: 15px 20px;
            }
        }
    </style>
</head>

<body>
    <!-- HEADER NAVBAR -->
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <img src="/images/logo.png" alt="logo">
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/shop">Shop</a></li>
                    <li class="nav-item"><a class="nav-link" href="/contact">Contact Us</a></li>
                    <li class="nav-item"><a class="nav-link" href="/about">About Us</a></li>
                </ul>
                <div class="nav-icons">
                    <a href="/profile"><i class="bi bi-person"></i></a>
                    <a href="/wishlist">
                        <div style="position:relative;">
                            <i class="bi bi-heart"></i>
                            <span id="wishlistCountBadge"
                                style="position:absolute; top:-10px; right:-12px; background:red; color:white; font-size:10px; width:18px; height:18px; border-radius:50%; display:<%= wishlistCount > 0 ? 'flex' : 'none' %>; align-items:center; justify-content:center; font-weight:600;">
                                <%= wishlistCount || 0 %>
                            </span>
                        </div>
                    </a>
                    <a href="/cart">
                        <div style="position:relative;">
                            <i class="bi bi-bag" style="font-size: 22px;"></i>
                            <% if(typeof cartCount !=='undefined' && cartCount> 0){ %>
                                <span id="cartCountBadge" style="
                                        position:absolute;
                                        top:-10px;
                                        right:-12px;
                                        background:red;
                                        color:white;
                                        font-size:10px;
                                        width:18px;
                                        height:18px;
                                        border-radius:50%;
                                        display:<%= cartCount > 0 ? 'flex' : 'none' %>;
                                        align-items:center;
                                        justify-content:center;
                                        font-weight:600;">
                                    <%= cartCount || 0 %>
                                </span>
                                <% } %>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- BREADCRUMBS -->
    <div class="breadcrumb-container">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/shop">Shop</a>
        <span>/</span>
        <a href="/shop?category=<%= product.category._id %>">
            <%= product.category.name %>
        </a>
        <span>/</span>
        <span class="active-breadcrumb">
            <%= product.productName %>
        </span>
    </div>

    <!-- MAIN INTERFACE ARCHITECTURE -->
    <div class="container product-main-container">
        <div class="product-wrapper">
            <div class="row g-4">

                <!-- THUMBNAILS DISPLAY COMPONENT -->
                <div class="col-md-1 col-2">
                    <div class="thumbnail-container">
                        <% if(variants[0]?.variantImage?.length> 0){ %>
                            <% variants[0].variantImage.forEach((img, idx)=> { %>
                                <img src="<%= img %>" class="thumb-img <%= idx === 0 ? 'active' : '' %>"
                                    onclick="changeMainImage(this.src, this)">
                                <% }) %>
                                    <% } else { %>
                                        <% product.productImage.forEach((img, idx)=> { %>
                                            <img src="<%= img %>" class="thumb-img <%= idx === 0 ? 'active' : '' %>"
                                                onclick="changeMainImage(this.src, this)">
                                            <% }) %>
                                                <% } %>
                    </div>
                </div>

                <!-- MAIN DISPLAY (Inner Zoom Container) -->
                <div class="col-md-5 col-10">
                    <div class="main-image-wrapper" id="zoomContainer">
                        <img id="mainProductImage" src="<%= variants[0]?.variantImage[0] || product.productImage[0] %>"
                            class="main-product-img" alt="<%= product.productName %>">
                    </div>
                </div>

                <!-- RIGHT CONTENT BLOCK DETAILS -->
                <div class="col-md-6">
                    <h1 class="product-title">
                        <%= product.productName %>
                    </h1>

                    <div class="price-section">
                        <span class="current-price" id="salePrice">₹<%= variants[0]?.salePrice %></span>
                        <% if(variants[0]?.regularPrice> variants[0]?.salePrice){ %>
                            <span class="original-price" id="regularPrice">₹<%= variants[0]?.regularPrice %></span>
                            <span class="discount-badge" id="discountBadge">
                                <%= Math.round( ((variants[0].regularPrice - variants[0].salePrice) /
                                    variants[0].regularPrice) * 100 ) %>% off
                            </span>
                            <% } %>
                    </div>

                    <div class="fw-semibold mb-3 <%= variants[0]?.stock > 0 ? 'text-success' : 'text-danger' %>"
                        id="stockStatus">
                        <%= variants[0]?.stock> 0 ? 'In Stock' : 'Out of Stock' %>
                    </div>

                    <div class="rating-container">
                        <i class="bi bi-star-fill"></i>
                        <span>4.6</span>
                        <span>|</span>
                        <span>486 reviews</span>
                    </div>

                    <div class="section-title">Product Details</div>
                    <p class="product-desc">
                        <%= product.description %>
                    </p>

                    <div class="section-title mt-4 mb-2">Color</div>
                    <div class="d-flex align-items-center gap-2 mb-4">
                        <% variants.forEach((variant, index)=> { %>
                            <button type="button" class="variant-color-btn <%= index === 0 ? 'active-variant' : '' %>"
                                data-variant-id="<%= variant._id %>" data-stock="<%= variant.stock %>"
                                title="<%= variant.variantName %>"
                                onclick='changeVariant(this, `<%- JSON.stringify(variant.variantImage).replace(/"/g, "&quot;") %>`, `<%= variant.salePrice %>`, `<%= variant.regularPrice %>`, `<%= variant.stock %>`)'
                                style="background: <%= variant.variantName.toLowerCase() %>;">
                            </button>
                            <% }) %>
                    </div>

                    <button class="wishlist-btn" id="wishlistBtn" data-product-id="<%= product._id %>"
                        data-variant-id="<%= variants?.[0]?._id || '' %>">
                        Wishlist <i class="bi bi-heart"></i>
                    </button>

                    <div class="action-btns">
                        <button type="button">Buy Now</button>
                        <button type="button" id="addToCartBtn" data-product-id="<%= product._id %>"
                            data-variant-id="<%= variants?.[0]?._id || '' %>" class="btn btn-dark">
                            Add To Cart
                        </button>
                    </div>
                </div>

                <!-- SPECIFICATIONS SECTION GRID -->
                <div class="container my-5 pt-4" style="border-top: 1px solid #eee;">
                    <h2 class="mb-5" style="font-size: 32px; font-weight: 400; color: #000000;">
                        Product <span style="font-weight: 700;">Specifications</span>
                    </h2>
                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="mb-4">
                                <label
                                    style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Name</label>
                                <p style="font-weight: 700; color: #000000; font-size: 15px;">
                                    <%= product.productName %>
                                </p>
                            </div>
                            <div class="mb-4">
                                <label
                                    style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Brand</label>
                                <p style="font-weight: 700; color: #000000; font-size: 15px;">
                                    <%= product.brand ? product.brand.name : 'Premium' %>
                                </p>
                            </div>
                            <div class="mb-4">
                                <label
                                    style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Net
                                    Quantity</label>
                                <p style="font-weight: 700; color: #000000; font-size: 15px;">1 Unit</p>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="mb-4">
                                <label
                                    style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Category</label>
                                <p style="font-weight: 700; color: #000000; font-size: 15px;">
                                    <%= product.category ? product.category.name : 'Audio' %>
                                </p>
                            </div>
                            <% if (product.playtime) { %>
                                <div class="mb-4">
                                    <label
                                        style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Playtime</label>
                                    <p style="font-weight: 700; color: #000000; font-size: 15px;">Up to <%=
                                            product.playtime %> Hours</p>
                                </div>
                                <% } %>
                                    <div class="mb-4">
                                        <label
                                            style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Country
                                            Of Origin</label>
                                        <p style="font-weight: 700; color: #000000; font-size: 15px;">India</p>
                                    </div>
                        </div>

                        <div class="col-md-4">
                            <div class="mb-4">
                                <label
                                    style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Warranty
                                    Status</label>
                                <p style="font-weight: 700; color: #000000; font-size: 15px;">1 Year Brand Warranty</p>
                            </div>
                            <div class="mb-4">
                                <label
                                    style="color: #888888; font-size: 13px; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 3px;">Connectivity</label>
                                <p style="font-weight: 700; color: #000000; font-size: 15px;">Bluetooth v5.2</p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- SIMILAR COLLECTION GRID -->
            <h2 class="similar-title">Similar Collection</h2>
            <div class="row">
                <% if(similarProducts && similarProducts.length> 0){ %>
                    <% similarProducts.forEach(item=> { %>
                        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                            <div class="product-card">
                                <a href="/productDetails?id=<%= item._id %>">
                                    <img src="<%= item.productImage[0] %>" alt="<%= item.productName %>">
                                </a>
                                <div class="product-name">
                                    <%= item.productName %>
                                </div>
                                <div class="card-price">₹<%= item.salePrice || 0 %>
                                </div>
                                <div class="card-rating">
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                            <% } %>
            </div>
        </div>
    </div>

    <!-- FOOTER ARCHITECTURE -->
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-md-3 mb-4">
                    <img src="/images/logo.png" class="footer-logo" alt="logo">
                </div>
                <div class="col-md-3 mb-4">
                    <h6>SUPPORT</h6>
                    <a href="#">Order Status</a>
                    <a href="#">Product Support</a>
                    <a href="#">Shipping & Return Policy</a>
                </div>
                <div class="col-md-3 mb-4">
                    <h6>About Us</h6>
                    <a href="#">Contact Us</a>
                    <a href="#">Privacy Policy</a>
                    <a href="#">Terms of use</a>
                </div>
                <div class="col-md-3 mb-4">
                    <h6>Connect with us</h6>
                    <a href="#" class="me-2"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="me-2"><i class="bi bi-facebook"></i></a>
                    <a href="#"><i class="bi bi-twitter-x"></i></a>
                </div>
            </div>
            <div class="copyright text-center">
                © 2026 OneMore. All Rights Reserved.
            </div>
        </div>
    </footer>

    <!-- LOGIC SCRIPTS ENGINE -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const addToCartBtn = document.getElementById("addToCartBtn");
            const wishlistBtn = document.getElementById("wishlistBtn");
            const container = document.getElementById("zoomContainer");
            const image = document.getElementById("mainProductImage");

            // ── PREMIUM INNER ZOOM ENGINE (No blocking text anymore) ──
            container.addEventListener("mousemove", (e) => {
                const rect = container.getBoundingClientRect();

                // Get cursor tracking coordinates relative to the photo box frame
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                // Turn inputs into percentages to calculate clean mapping origin vectors
                const xPercent = (x / rect.width) * 100;
                const yPercent = (y / rect.height) * 100;

                // Shift scale origin dynamically and scale image up smoothly inline
                image.style.transformOrigin = `${xPercent}% ${yPercent}%`;
                image.style.transform = "scale(2.2)"; // Adjust zoom strength here (2.2x zoom)
            });

            container.addEventListener("mouseleave", () => {
                // Instantly snap image tracking scale back to normal on exit
                image.style.transformOrigin = "center center";
                image.style.transform = "scale(1)";
            });

            // ADD TO CART NETWORK PIPELINE
            addToCartBtn.addEventListener("click", async () => {
                try {
                    const productId = addToCartBtn.dataset.productId;
                    const variantId = addToCartBtn.dataset.variantId;

                    const response = await fetch("/cart/add", {
                        method: "POST",
                        credentials: "same-origin",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ productId, variantId })
                    });

                    const data = await response.json();
                    showToast(data.message);

                    if (data.success) {

                        const cartCountBadge = document.getElementById("cartCountBadge");

                        if (cartCountBadge) {
                            cartCountBadge.textContent = data.cartCount;
                            cartCountBadge.style.display =
                                data.cartCount > 0 ? "flex" : "none";
                        }

                        const wishlistBadge = document.getElementById("wishlistCountBadge");

                        if (wishlistBadge) {
                            wishlistBadge.textContent = data.wishlistCount;
                            wishlistBadge.style.display =
                                data.wishlistCount > 0 ? "flex" : "none";
                        }
                    }
                } catch (error) {
                    console.error(error);
                    showToast("Failed adding product to cart.");
                }
            });

            // WISHLIST OPERATIONS PIPELINE
            wishlistBtn.addEventListener("click", async () => {
                const productId = wishlistBtn.dataset.productId;
                const variantId = wishlistBtn.dataset.variantId;

                try {
                    const response = await fetch("/wishlist/add", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ productId, variantId })
                    });

                    const data = await response.json();
                    showToast(data.message);

                    if (data.success) {

                        const wishlistBadge = document.getElementById("wishlistCountBadge");

                        if (wishlistBadge) {
                            wishlistBadge.textContent = data.wishlistCount;
                            wishlistBadge.style.display =
                                data.wishlistCount > 0 ? "flex" : "none";
                        }
                    }
                } catch (error) {
                    console.error(error);
                }
            });
        });

        // IMAGE CAROUSEL SWITCHER
        function changeMainImage(src, thumbElement) {
            document.getElementById('mainProductImage').src = src;
            document.querySelectorAll('.thumb-img').forEach(thumb => {
                thumb.classList.remove('active');
            });
            thumbElement.classList.add('active');
        }

        // VARIANT SELECTION CONFIGURATOR
        function changeVariant(button, images, salePrice, regularPrice, stock) {
            document.querySelectorAll(".variant-color-btn").forEach(btn => {
                btn.classList.remove("active-variant");
            });
            button.classList.add("active-variant");

            const parsedImages = JSON.parse(images);

            document.getElementById("mainProductImage").src = parsedImages[0];
            document.getElementById("salePrice").innerText = "₹" + salePrice;

            const regPriceElem = document.getElementById("regularPrice");
            const discountBadge = document.getElementById("discountBadge");

            if (regPriceElem && Number(regularPrice) > Number(salePrice)) {
                regPriceElem.innerText = "₹" + regularPrice;
                regPriceElem.style.display = "inline";
                if (discountBadge) {
                    const pct = Math.round(((Number(regularPrice) - Number(salePrice)) / Number(regularPrice)) * 100);
                    discountBadge.innerText = pct + "% off";
                    discountBadge.style.display = "inline";
                }
            } else if (regPriceElem) {
                regPriceElem.style.display = "none";
                if (discountBadge) discountBadge.style.display = "none";
            }

            const vId = button.dataset.variantId;
            document.getElementById("wishlistBtn").dataset.variantId = vId;
            document.getElementById("addToCartBtn").dataset.variantId = vId;

            const stockStatus = document.getElementById("stockStatus");
            stockStatus.innerText = Number(stock) > 0 ? "In Stock" : "Out of Stock";
            stockStatus.className = Number(stock) > 0 ? "fw-semibold mb-3 text-success" : "fw-semibold mb-3 text-danger";

            const thumbnailContainer = document.querySelector(".thumbnail-container");
            thumbnailContainer.innerHTML = "";
            parsedImages.forEach((img, index) => {
                thumbnailContainer.innerHTML += `<img src="${img}" class="thumb-img ${index === 0 ? 'active' : ''}" onclick="changeMainImage('${img}', this)">`;
            });
        }

        // GLOBAL DYNAMIC TOAST COMPONENT
        function showToast(message) {
            const existingToast = document.querySelector(".custom-toast");
            if (existingToast) { existingToast.remove(); }

            const toast = document.createElement("div");
            toast.className = "custom-toast";
            toast.innerText = message;
            document.body.appendChild(toast);

            setTimeout(() => { toast.classList.add("show"); }, 100);
            setTimeout(() => {
                toast.classList.remove("show");
                setTimeout(() => { toast.remove(); }, 300);
            }, 2500);
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>