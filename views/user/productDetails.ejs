<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= product.productName %> | OneMore
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f5f5f5;
            color: #111;
            margin: 0;
            padding: 0;
        }

        a {
            text-decoration: none;
        }

        /* NAVBAR */


        .navbar {
            background-color: #000 !important;
            padding: 22px 40px;
            position: sticky;
            top: 0;
            z-index: 9999;
            width: 100%;
            margin: 0;
            border: none;
        }

        .navbar-brand img {
            height: 55px;
        }

        .navbar-nav {
            gap: 18px;
        }

        .navbar-nav .nav-link {
            color: #fff !important;
            font-size: 15px;
            font-weight: 500;
            transition: 0.2s ease;
        }

        .navbar-nav .nav-link:hover {
            color: #8a7df0 !important;
        }

        .nav-icons {
            display: flex;
            align-items: center;
            gap: 22px;
        }

        .nav-icons a {
            color: #fff !important;
            font-size: 22px;
            text-decoration: none;
            transition: 0.2s ease;
        }

        .nav-icons a:hover {
            color: #8a7df0 !important;
        }

        .navbar-toggler {
            border: none;
        }

        .navbar-toggler:focus {
            box-shadow: none;
        }

        .navbar-toggler-icon {
            filter: invert(1)
        }

        /* THUMBNAILS */

        .thumbnail-container {
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .thumb-img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 4px;
            cursor: pointer;
            border: 2px solid transparent;
            transition: 0.2s;
        }

        .thumb-img.active {
            border-color: #7b68ee;
        }

        /* MAIN IMAGE */

        .main-image-wrapper {
            position: relative;
            width: 100%;
            height: 500px;
            background: #ece9ff;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }

        .col-md-5 {
            position: relative;
        }

        #zoomResult {
            position: absolute;
            top: 0;
            left: 102%;
            width: 700px;
            height: 700px;
            border: 1px solid #ddd;
            background-repeat: no-repeat;
            display: none;
            z-index: 999;
            background-color: #fff;
            border-radius: 10px;
        }

        .main-product-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        /* PRODUCT DETAILS */

        .product-title {
            font-size: 38px;
            font-weight: 600;
            margin-bottom: 15px;
        }

        .price-section {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
        }

        .current-price {
            font-size: 28px;
            font-weight: 700;
        }

        .original-price {
            text-decoration: line-through;
            color: #999;
            font-size: 16px;
        }

        .discount-badge {
            color: #36b44a;
            font-weight: 600;
            font-size: 15px;
        }

        .rating-container {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            color: #666;
            font-size: 13px;
        }

        .rating-container i {
            color: #f1c40f;
        }

        .section-title {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .product-desc {
            font-size: 13px;
            color: #555;
            line-height: 1.8;
            max-width: 450px;
        }

        /* VARIANTS */

        .variant-wrapper {
            display: flex;
            gap: 10px;
            margin-top: 15px;
            margin-bottom: 35px;
        }

        .variant-btn {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: none;
            cursor: pointer;
        }

        .variant-color-btn {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            border: none;
            outline: 1px solid #999;
            cursor: pointer;
            transition: 0.2s ease;
        }

        .variant-color-btn.active-variant {
            transform: scale(1.25);
            outline: 2px solid #000;
        }

        /* BUTTONS */

        .wishlist-btn {
            background: #ff7d7d;
            border: none;
            color: #fff;
            padding: 12px 35px;
            border-radius: 30px;
            font-size: 14px;
            margin-bottom: 18px;
        }

        .action-btns {
            display: flex;
            gap: 15px;
        }

        .action-btns button {
            border: none;
            background: #000;
            color: #fff;
            padding: 12px 40px;
            border-radius: 30px;
            font-size: 14px;
            font-weight: 500;
        }

        /* SIMILAR PRODUCTS */

        .similar-title {
            font-size: 30px;
            font-weight: 600;
            margin-top: 60px;
            margin-bottom: 30px;
        }

        .product-main-container {
            padding-top: 90px;
        }

        .product-card {
            position: relative;
        }

        .product-card img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            border-radius: 10px;
            background: #f5f5f5;
        }

        #zoomResult {
            position: absolute;
            top: 0;
            left: 105%;
            width: 500px;
            height: 500px;
            border: 1px solid #ddd;
            background-repeat: no-repeat;
            display: none;
            z-index: 999;
            background-color: #fff;
        }

        .product-name {
            font-size: 14px;
            font-weight: 500;
            margin-top: 12px;
            color: #111;
        }

        .card-price {
            font-size: 13px;
            font-weight: 600;
        }

        .old-price {
            color: #999;
            text-decoration: line-through;
            margin-left: 6px;
            font-size: 11px;
        }

        .card-rating {
            color: #f1c40f;
            font-size: 11px;
            margin-top: 5px;
        }

        /* FOOTER */

        footer {
            background: #111;
            color: #fff;
            margin-top: 80px;
            padding: 60px 0 20px;
        }

        .footer-logo {
            width: 80px;
            margin-bottom: 20px;
        }

        footer h6 {
            font-size: 14px;
            margin-bottom: 18px;
            font-weight: 600;
        }

        footer a {
            display: block;
            color: #ddd;
            font-size: 12px;
            margin-bottom: 10px;
        }

        .copyright {
            border-top: 1px solid #333;
            margin-top: 40px;
            padding-top: 20px;
            font-size: 12px;
            color: #aaa;
        }

        @media(max-width:768px) {

            .main-img-wrapper {
                height: 350px;
            }

            .product-title {
                font-size: 28px;
                margin-top: 25px;
            }

            .action-btns {
                flex-direction: column;
            }

            .action-btns button {
                width: 100%;
            }
        }
    </style>

</head>

<body>
    <nav class="navbar navbar-expand-lg">

        <div class="container-fluid">

            <a class="navbar-brand" href="/">
                <img src="/images/logo.png" alt="logo">
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-center" id="navbarNav">

                <ul class="navbar-nav mx-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/shop">Shop</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/contact">Contact Us</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/about">About Us</a>
                    </li>

                </ul>

                <div class="nav-icons">

                    <a href="/profile">
                        <i class="bi bi-person"></i>
                    </a>

                    <a href="/wishlist">
                        <i class="bi bi-heart"></i>
                    </a>

                    <a href="/cart">
                        <i class="bi bi-bag"></i>
                    </a>

                </div>

            </div>

        </div>

    </nav>

    <div class="container product-main-container">

        <div class="product-wrapper">

            <div class="row g-4">

                <!-- THUMBNAILS -->

                <div class="col-md-1 col-2">

                    <div class="thumbnail-container">

                        <% if(variants[0]?.variantImage?.length> 0){ %>

                            <% variants[0].variantImage.forEach((img, idx)=> { %>

                                <img src="<%= img %>" class="thumb-img <%= idx === 0 ? 'active' : '' %>"
                                    onclick="changeMainImage(this.src, this)">

                                <% }) %>

                                    <% } else { %>

                                        <% product.productImage.forEach((img, idx)=> { %>

                                            <img src="<%= img %>" class="thumb-img <%= idx === 0 ? 'active' : '' %>"
                                                onclick="changeMainImage(this.src, this)">

                                            <% }) %>

                                                <% } %>

                    </div>

                </div>

                <!-- MAIN IMAGE -->

                <div class="col-md-5 col-10">

                    <div class="main-image-wrapper" id="zoomContainer">

                        <img id="mainProductImage" src="<%= variants[0]?.variantImage[0] || product.productImage[0] %>"
                            class="main-product-img" alt="<%= product.productName %>">

                    </div>
                    <div id="zoomResult"></div>

                </div>

                <!-- DETAILS -->

                <div class="col-md-6">

                    <h1 class="product-title">
                        <%= product.productName %>
                    </h1>

                    <div class="price-section">

                        <span class="current-price" id="salePrice">
                            ₹<%= variants[0]?.salePrice %>
                        </span>

                        <% if(variants[0]?.regularPrice> variants[0]?.salePrice){ %>

                            <span class="original-price" id="regularPrice">
                                ₹<%= variants[0]?.regularPrice %>
                            </span>

                            <span class="discount-badge">

                                <%= Math.round( ((variants[0].regularPrice - variants[0].salePrice) /
                                    variants[0].regularPrice) * 100 ) %>% off

                            </span>

                            <% } %>

                    </div>

                    <div class="fw-semibold mb-3 <%= variants[0]?.stock > 0 ? 'text-success' : 'text-danger' %>"
                        id="stockStatus">
                        <%= variants[0]?.stock> 0 ? 'In Stock' : 'Out of Stock' %>
                    </div>

                    <div class="rating-container">
                        <i class="bi bi-star-fill"></i>
                        <span>4.6</span>
                        <span>|</span>
                        <span>486 reviews</span>
                    </div>

                    <div class="section-title">Product Details</div>

                    <p class="product-desc">
                        <%= product.description %>
                    </p>

                    <div class="section-title mt-4 mb-2">
                        Color
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-4">

                        <% variants.forEach((variant, index)=> { %>

                            <button type="button" class="variant-color-btn <%= index === 0 ? 'active-variant' : '' %>"
                                title="<%= variant.variantName %>" onclick='changeVariant(
                                    this,
                                    `<%- JSON.stringify(variant.variantImage).replace(/"/g, "&quot;") %>`,
                                    `<%= variant.salePrice %>`,
                                    `<%= variant.regularPrice %>`,
                                    `<%= variant.stock %>`
                                )' style="
                                    background:<%= variant.variantName.toLowerCase() %>;
                                "></button>

                            <% }) %>

                    </div>

                    <button class="wishlist-btn">
                        Wishlist
                        <i class="bi bi-heart"></i>
                    </button>

                    <div class="action-btns">
                        <button>Buy Now</button>
                        <button>Add To Cart</button>
                    </div>

                </div>

            </div>

            <!-- SIMILAR -->

            <h2 class="similar-title">Similar Collection</h2>

            <div class="row">

                <% if(similarProducts && similarProducts.length> 0){ %>

                    <% similarProducts.forEach(item=> { %>

                        <div class="col-lg-3 col-md-4 col-sm-6 mb-4">

                            <div class="product-card">

                                <a href="/productDetails?id=<%= item._id %>">

                                    <img src="<%= item.productImage[0] %>" alt="<%= item.productName %>">

                                </a>

                                <div class="product-name">
                                    <%= item.productName %>
                                </div>

                                <div class="card-price">

                                    ₹<%= item.salePrice || 0 %>

                                </div>

                                <div class="card-rating">
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                </div>

                            </div>

                        </div>

                        <% }) %>

                            <% } %>

            </div>

        </div>

    </div>

    <footer>

        <div class="container">

            <div class="row">

                <div class="col-md-3 mb-4">
                    <img src="/images/logo.png" class="footer-logo">
                </div>

                <div class="col-md-3 mb-4">
                    <h6>SUPPORT</h6>
                    <a href="#">Order Status</a>
                    <a href="#">Product Support</a>
                    <a href="#">Shipping & Return Policy</a>
                </div>

                <div class="col-md-3 mb-4">
                    <h6>About Us</h6>
                    <a href="#">Contact Us</a>
                    <a href="#">Privacy Policy</a>
                    <a href="#">Terms of use</a>
                </div>

                <div class="col-md-3 mb-4">
                    <h6>Connect with us</h6>
                    <a href="#"><i class="bi bi-instagram"></i></a>
                    <a href="#"><i class="bi bi-facebook"></i></a>
                    <a href="#"><i class="bi bi-twitter-x"></i></a>
                </div>

            </div>

            <div class="copyright text-center">
                © 2025 OneMore. All Rights Reserved.
            </div>

        </div>

    </footer>

    <<script>

        function changeMainImage(src, thumbElement) {

        document.getElementById('mainProductImage').src = src;

        document.querySelectorAll('.thumb-img').forEach(thumb => {
        thumb.classList.remove('active');
        });

        thumbElement.classList.add('active');
        }

        function changeVariant(
        button,
        images,
        salePrice,
        regularPrice,
        stock
        ) {

        // ACTIVE VARIANT

        document
        .querySelectorAll(".variant-color-btn")
        .forEach(btn => {
        btn.classList.remove("active-variant")
        })

        button.classList.add("active-variant")

        images = JSON.parse(images)

        // MAIN IMAGE

        document.getElementById("mainProductImage").src =
        images[0]

        // PRICE

        document.getElementById("salePrice").innerText =
        "₹" + salePrice

        // REGULAR PRICE

        if(document.getElementById("regularPrice")) {

        document.getElementById("regularPrice").innerText =
        "₹" + regularPrice
        }

        // STOCK

        const stockStatus =
        document.getElementById("stockStatus")

        stockStatus.innerText =
        stock > 0 ? "In Stock" : "Out of Stock"

        stockStatus.className =
        stock > 0
        ? "fw-semibold mb-3 text-success"
        : "fw-semibold mb-3 text-danger"

        // THUMBNAILS UPDATE

        const thumbnailContainer =
        document.querySelector(".thumbnail-container")

        thumbnailContainer.innerHTML = ""

        images.forEach((img, index) => {

        thumbnailContainer.innerHTML += `

        <img src="${img}" class="thumb-img ${index === 0 ? 'active' : ''}" onclick="changeMainImage('${img}', this)">

        `
        })
        }

        const image =
        document.getElementById("mainProductImage")

        const result =
        document.getElementById("zoomResult")

        const container =
        document.getElementById("zoomContainer")

        container.addEventListener("mousemove", zoomImage)

        container.addEventListener("mouseleave", () => {

        result.style.display = "none"
        })

        function zoomImage(e){

        result.style.display = "block"

        const rect =
        image.getBoundingClientRect()

        const x =
        e.clientX - rect.left

        const y =
        e.clientY - rect.top

        const xPercent =
        (x / rect.width) * 100

        const yPercent =
        (y / rect.height) * 100

        result.style.backgroundImage =
        `url(${image.src})`

        result.style.backgroundSize =
        `${rect.width * 3}px ${rect.height * 3}px`

        result.style.backgroundPosition =
        `${xPercent}% ${yPercent}%`
        }


        </script>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>