        <div class="prod-img-wrap pi-2">
          <div class="big-label" style="color:rgba(255,255,255,0.18);">35</div>
          <div class="hrs-badge">HRS</div>
          <svg class="hp-sm" viewBox="0 0 80 80" fill="none">
