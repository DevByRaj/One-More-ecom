            <circle cx="51" cy="31" r="2" fill="#555"/>
            <rect x="26" y="48" width="28" height="18" rx="6" fill="#1a1a1a" stroke="#444" stroke-width="0.8"/>
          </svg>
        </div>
        <div class="prod-info">
          <div class="prod-name">Work Formal Black</div>
          <div class="prod-price">₹₹₹₹</div>
        </div>
      </div>
 
      <!-- 3: Casual White Spirit -->
      <div class="prod-card">
        <div class="prod-img-wrap pi-3" style="background:linear-gradient(135deg,#111,#1a1a1a);">
          <svg class="hp-sm" viewBox="0 0 80 80" fill="none">
            <!-- hand holding earbud -->
            <path d="M25 55 Q23 40 30 32 Q37 24 40 26 Q43 24 50 32 Q57 40 55 55" stroke="#444" stroke-width="1.5" fill="#1a1a1a"/>
            <ellipse cx="40" cy="28" rx="10" ry="14" fill="#282828" stroke="#555" stroke-width="0.8"/>
            <circle cx="40" cy="26" r="6" fill="#222" stroke="#666" stroke-width="0.8"/>
            <circle cx="40" cy="26" r="2.5" fill="#555"/>
          </svg>
        </div>
        <div class="prod-info">
          <div class="prod-name">Casual White Spirit</div>
          <div class="prod-price">₹₹₹₹</div>
        </div>
      </div>
 
      <!-- 4: California Blue (red+blue) -->
      <div class="prod-card">
        <div class="prod-img-wrap pi-4">
          <svg class="hp-sm" viewBox="0 0 80 80" fill="none">
            <path d="M18 42 C18 26 27 18 40 18 C53 18 62 26 62 42" stroke="#222" stroke-width="7" fill="none" stroke-linecap="round"/>
            <rect x="11" y="39" width="13" height="20" rx="5" fill="#1a1a1a" stroke="#e04040" stroke-width="1.5"/>
            <rect x="56" y="39" width="13" height="20" rx="5" fill="#1a1a1a" stroke="#4040e0" stroke-width="1.5"/>
            <circle cx="17.5" cy="49" r="4" fill="#e04040" opacity="0.8"/>
            <circle cx="62.5" cy="49" r="4" fill="#4040e0" opacity="0.8"/>
          </svg>
        </div>
        <div class="prod-info">
          <div class="prod-name">California Blue</div>
          <div class="prod-price">₹₹₹₹</div>
        </div>
      </div>
 
    </div>
 
    <!-- Row 2 -->
    <div class="prod-grid">
 
      <!-- 5: Work Formal Blue (light) -->
      <div class="prod-card">
        <div class="prod-img-wrap pi-5">
