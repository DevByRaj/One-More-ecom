            <path d="M40 40 Q40 30 50 28 Q60 30 60 40" stroke="rgba(150,180,255,0.3)" stroke-width="1.5" fill="none"/>
          </svg>
        </div>
        <div class="cat-label">
          <div class="cat-name">TWS</div>
          <div class="cat-sub">Free Pro</div>
          <div class="cat-price">₹₹₹</div>
        </div>
      </div>
 
    </div>
  </div>
 
  <!-- TOP PICKS FOR YOU -->
  <div class="top-picks">
    <div class="section-title">Top Picks For You</div>
 
    <!-- Row 1 -->
    <div class="prod-grid">
 
      <!-- 1: Work Formal Blue (light, 50hrs badge) -->
      <div class="prod-card">
        <div class="prod-img-wrap pi-1">
          <div class="big-label dark">50</div>
          <div class="hrs-badge" style="background:rgba(0,0,0,0.5);color:#fff;">HRS</div>
