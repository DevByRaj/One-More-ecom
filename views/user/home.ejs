<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Audio Collection | Premium Sound</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    :root {
      --bg-dark: #101010;
      --text-muted: #a5a5a5;
      --accent: #f5c542;
      --card-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background: #fff;
      color: #202020;
      overflow-x: hidden;
    }

    a {
      -webkit-tap-highlight-color: transparent;
    }

    /* Navbar */
    .navbar {
      background: rgba(16, 16, 16, 0.98);
      padding: 12px 5.2%;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 5px 24px rgba(0, 0, 0, 0.12);
    }

    .navbar .container-fluid {
      gap: 18px;
    }

    .logo-img {
      height: 54px;
      width: auto;
      max-width: 190px;
      object-fit: contain;
    }

    .navbar .navbar-toggler {
      border: 1px solid rgba(255, 255, 255, .35);
      border-radius: 8px;
      padding: 7px 10px;
    }

    .navbar .navbar-toggler:focus {
      box-shadow: 0 0 0 .18rem rgba(245, 197, 66, .22);
    }

    .navbar .navbar-toggler-icon {
      filter: invert(1);
    }

    .nav-link {
      position: relative;
      color: #fff !important;
      font-size: .76rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 1.35px;
      padding: 10px 13px !important;
      margin: 0 5px;
      transition: color .25s ease;
    }

    .nav-link::after {
      content: '';
      position: absolute;
      left: 13px;
      right: 13px;
      bottom: 2px;
      height: 2px;
      background: var(--accent);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform .25s ease;
    }

    .nav-link:hover {
      color: var(--accent) !important;
    }

    .nav-link:hover::after {
      transform: scaleX(1);
    }

    .nav-icons {
      gap: 20px;
    }

    .nav-icons a {
      color: #fff;
      margin: 0 !important;
      font-size: 1.05rem;
      text-decoration: none;
      transition: color .2s ease, transform .2s ease;
    }

    .nav-icons a:hover {
      color: var(--accent);
      transform: translateY(-2px);
    }

    .nav-icons i {
      font-size: 1.12rem;
    }

    /* Hero */
    .hero-section {
      background: var(--bg-dark);
      padding: 22px 5.2% 58px;
    }

    .hero-banner {
      min-height: 490px;
      height: clamp(360px, 42vw, 540px);
      padding: 30px;
      border-radius: 22px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      color: #fff;
      text-align: center;
      background:
        linear-gradient(90deg, rgba(0, 0, 0, .68), rgba(0, 0, 0, .25), rgba(0, 0, 0, .62)),
        url('https://images.unsplash.com/photo-1484704849700-f032a568e944?q=80&w=2070&auto=format&fit=crop') center/cover no-repeat;
      isolation: isolate;
    }

    .hero-banner::after {
      content: '';
      position: absolute;
      inset: 18px;
      border: 1px solid rgba(255, 255, 255, .24);
      border-radius: 15px;
      pointer-events: none;
      z-index: -1;
    }

    .hero-text {
      max-width: 900px;
      animation: heroFade .8s ease both;
    }

    .hero-text h1 {
      margin: 0;
      font-size: clamp(2rem, 4.2vw, 3.7rem);
      line-height: 1.25;
      font-weight: 700;
      letter-spacing: clamp(1px, .35vw, 5px);
      text-shadow: 0 4px 25px rgba(0, 0, 0, .3);
    }

    .hero-text h1 span {
      color: var(--accent);
    }

    .hero-text p {
      margin: 20px 0 0;
      font-size: .82rem;
      letter-spacing: 3px;
      line-height: 1.8;
      text-transform: uppercase;
      color: rgba(255, 255, 255, .88);
    }

    @keyframes heroFade {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Main sections */
    .container-custom {
      padding: 76px 6.2%;
    }

    .section-title {
      position: relative;
      margin: 0 0 34px;
      padding-bottom: 15px;
      font-size: clamp(1.45rem, 2.4vw, 2rem);
      font-weight: 700;
      letter-spacing: -.6px;
      color: #171717;
    }

    .section-title::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 48px;
      height: 3px;
      border-radius: 3px;
      background: var(--accent);
    }

    /* Category cards */
    .category-card {
      height: 100%;
      border: 1px solid #eeeeee;
      border-radius: 16px;
      overflow: hidden;
      background: #fff;
      box-shadow: 0 6px 22px rgba(0, 0, 0, .035);
      transition: transform .3s ease, box-shadow .3s ease;
    }

    .category-card:hover {
      transform: translateY(-7px);
      box-shadow: var(--card-shadow);
    }

    .category-card img {
      display: block;
      width: 100%;
      height: 330px;
      object-fit: cover;
      transition: transform .5s ease;
    }

    .category-card:hover img {
      transform: scale(1.035);
    }

    .category-info {
      padding: 20px 14px 22px;
      text-align: center;
    }

    .category-info h5 {
      margin: 0 0 8px;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: .4px;
      color: #181818;
    }

    .category-info p {
      margin: 0;
      color: #777 !important;
      font-size: .8rem;
    }

    /* Product cards */
    .product-card {
      height: calc(100% - 26px);
      margin-bottom: 26px;
      padding: 10px 10px 17px;
      border: 1px solid #eeeeee;
      border-radius: 15px;
      overflow: hidden;
      background: #fff;
      transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    }

    .product-card:hover {
      transform: translateY(-6px);
      border-color: #e2e2e2;
      box-shadow: var(--card-shadow);
    }

    .product-card>a {
      display: block;
      overflow: hidden;
      border-radius: 10px;
    }

    .product-card img {
      display: block;
      width: 100%;
      height: 250px;
      object-fit: contain;
      border-radius: 10px;
      background: #f7f7f7;
      transition: transform .4s ease;
    }

    .product-card:hover img {
      transform: scale(1.045);
    }

    .product-details {
      margin-top: 15px;
      padding: 0 5px;
      text-align: left;
    }

    .product-details h6 {
      min-height: 2.5em;
      margin: 0 0 8px;
      color: #202020;
      font-size: .9rem;
      font-weight: 600;
      line-height: 1.5;
      overflow-wrap: anywhere;
    }

    .price {
      color: #111;
      font-size: .92rem;
      font-weight: 700;
    }

    .old-price {
      margin-right: 7px;
      color: #929292;
      font-size: .82rem;
      font-weight: 400;
      text-decoration: line-through;
    }

    /* Footer */
    footer {
      padding: 62px 6.2% 25px;
      background: #101010;
      color: #fff;
    }

    .footer-logo-container {
      margin-bottom: 48px;
    }

    .footer-heading {
      margin-bottom: 22px;
      color: var(--accent);
      font-size: .82rem;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .footer-links li {
      margin-bottom: 12px;
    }

    .footer-links a {
      color: #aaa;
      text-decoration: none;
      font-size: .82rem;
      transition: color .2s ease, padding-left .2s ease;
    }

    .footer-links a:hover {
      color: #fff;
      padding-left: 3px;
    }

    .footer-text {
      color: #dedede;
    }

    footer .small {
      color: #c8c8c8 !important;
      overflow-wrap: anywhere;
    }

    .social-icons {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .social-icons i {
      color: #aaa;
      font-size: 1.2rem;
      transition: color .2s ease, transform .2s ease;
    }

    .social-icons a:hover i {
      color: var(--accent);
      transform: translateY(-3px);
    }

    .copyright {
      margin-top: 45px;
      padding-top: 22px;
      border-top: 1px solid #2b2b2b;
      color: #858585;
      font-size: .72rem;
      line-height: 1.7;
    }

    /* Responsive layout */
    @media (max-width: 991.98px) {
      .navbar {
        padding: 12px 24px;
      }

      .navbar>.container-fluid {
        flex-wrap: wrap;
      }

      .navbar .navbar-collapse {
        flex-basis: 100%;
      }

      .navbar .navbar-nav {
        align-items: center;
        padding-top: 12px;
      }

      .navbar .nav-link {
        margin: 4px 0;
        padding: 8px 12px !important;
      }

      .navbar .nav-icons {
        justify-content: center;
        padding: 12px 0 4px;
      }

      .hero-section {
        padding: 18px 24px 40px;
      }

      .hero-banner {
        min-height: 370px;
      }

      .container-custom {
        padding: 58px 32px;
      }

      footer {
        padding: 55px 32px 25px;
      }

      .category-card img {
        height: 285px;
      }

      .product-card img {
        height: 220px;
      }

      .footer-logo-container {
        margin-bottom: 36px;
      }
    }

    @media (max-width: 767.98px) {
      .navbar {
        padding: 10px 16px;
      }

      .logo-img {
        height: 43px;
        max-width: 160px;
      }

      .navbar .container-fluid {
        padding-left: 0;
        padding-right: 0;
      }

      .navbar .navbar-brand {
        margin-right: 0;
      }

      .navbar .navbar-collapse,
      .navbar .navbar-nav {
        width: 100%;
      }

      .navbar .nav-link {
        font-size: .76rem;
        letter-spacing: 1px;
      }

      .navbar .nav-icons {
        gap: 24px;
      }

      .hero-section {
        padding: 14px 14px 28px;
      }

      .hero-banner {
        height: 300px;
        min-height: 260px;
        padding: 20px 15px;
        border-radius: 14px;
      }

      .hero-banner::after {
        inset: 10px;
        border-radius: 9px;
      }

      .hero-text h1 {
        font-size: clamp(1.25rem, 5.5vw, 1.8rem);
        letter-spacing: 1px;
        line-height: 1.5;
        overflow-wrap: anywhere;
      }

      .hero-text p {
        margin-top: 12px;
        font-size: .68rem;
        letter-spacing: 1.1px;
        line-height: 1.8;
      }

      .container-custom {
        padding: 42px 16px;
      }

      .section-title {
        margin-bottom: 24px;
        padding-bottom: 12px;
        font-size: 1.35rem;
      }

      .category-card img {
        height: 220px;
      }

      .category-info {
        padding: 15px 8px 17px;
      }

      .category-info h5 {
        font-size: .9rem;
        overflow-wrap: anywhere;
      }

      .category-info p {
        font-size: .72rem;
      }

      .product-card {
        margin-bottom: 16px;
        padding: 7px 7px 12px;
        border-radius: 11px;
      }

      .product-card img {
        height: clamp(135px, 42vw, 205px);
        border-radius: 8px;
      }

      .product-details {
        margin-top: 10px;
        padding: 0 2px;
      }

      .product-details h6 {
        min-height: 2.6em;
        font-size: .78rem;
        line-height: 1.45;
      }

      .price {
        font-size: .78rem;
        line-height: 1.6;
        overflow-wrap: anywhere;
      }

      .old-price {
        margin-right: 3px;
        font-size: .7rem;
      }

      footer {
        padding: 40px 20px 20px;
      }

      .footer-logo-container {
        margin-bottom: 28px;
      }

      .footer-heading {
        margin-bottom: 13px;
        font-size: .82rem;
      }

      .footer-links li {
        margin-bottom: 8px;
      }

      .footer-links a,
      .footer-text {
        font-size: .78rem;
        overflow-wrap: anywhere;
      }

      footer .row {
        --bs-gutter-x: 1rem;
      }

      .social-icons {
        gap: 15px;
      }

      .social-icons i {
        font-size: 1.1rem;
      }

      .copyright {
        margin-top: 28px;
        padding-top: 18px;
        font-size: .67rem;
      }
    }

    @media (max-width: 380px) {
      .hero-banner {
        height: 255px;
      }

      .hero-text h1 {
        font-size: 1.16rem;
        letter-spacing: .5px;
      }

      .hero-text p {
        font-size: .62rem;
        letter-spacing: .6px;
      }

      .container-custom {
        padding-left: 12px;
        padding-right: 12px;
      }

      .section-title {
        font-size: 1.18rem;
      }

      .category-card img {
        height: 190px;
      }

      .product-card img {
        height: 130px;
      }

      .product-details h6 {
        font-size: .72rem;
      }

      .price {
        font-size: .72rem;
      }

      footer {
        padding-left: 16px;
        padding-right: 16px;
      }
    }

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>

  <!-- ==================== NAVBAR ==================== -->

  <nav class="navbar navbar-expand-lg">
    <div class="container-fluid">

      <a class="navbar-brand" href="/">
        <img src="/images/logo.png" class="logo-img" alt="OneMore Logo">
      </a>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
        aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse justify-content-center" id="navbarNav">

        <ul class="navbar-nav mx-auto">

          <li class="nav-item">
            <a class="nav-link" href="/">Home</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/shop">Shop</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/contact">Contact Us</a>
          </li>

          <li class="nav-item">
            <a class="nav-link" href="/about">About Us</a>
          </li>

        </ul>

        <div class="nav-icons d-flex align-items-center">

          <a href="/profile" class="text-white me-3">
            <i class="fa-regular fa-user"></i>
          </a>

          <a href="/wishlist" class="text-white me-3">
            <div style="position:relative;">

              <i class="fa-regular fa-heart"></i>

              <% if (wishlistCount> 0) { %>

                <span style="
                  position:absolute;
                  top:-10px;
                  right:-12px;
                  background:red;
                  color:white;
                  font-size:10px;
                  width:18px;
                  height:18px;
                  border-radius:50%;
                  display:flex;
                  align-items:center;
                  justify-content:center;
                  font-weight:600;
                ">
                  <%= wishlistCount %>
                </span>

                <% } %>

            </div>
          </a>

          <a href="/cart" class="text-white">

            <div style="position:relative;">

              <i class="fa-solid fa-bag-shopping"></i>

              <% if (cartCount> 0) { %>

                <span style="
                  position:absolute;
                  top:-10px;
                  right:-12px;
                  background:red;
                  color:white;
                  font-size:10px;
                  width:18px;
                  height:18px;
                  border-radius:50%;
                  display:flex;
                  align-items:center;
                  justify-content:center;
                  font-weight:600;
                ">
                  <%= cartCount %>
                </span>

                <% } %>

            </div>

          </a>

        </div>

      </div>

    </div>
  </nav>


  <!-- ==================== HERO ==================== -->

  <div class="hero-section">

    <div class="hero-banner">

      <div class="hero-text">

        <h1>
          RHYTHM |
          <span style="font-weight: 300;">UNWIND</span>
          | RESONATE
        </h1>

        <p>
          Shop Our Exclusive Audio Collection
        </p>

      </div>

    </div>

  </div>


  <!-- ==================== CATEGORIES ==================== -->

  <div class="container-custom">

    <h2 class="section-title">
      Explore by Category
    </h2>

    <div class="row g-4">

      <% if (categories && categories.length> 0) { %>

        <% categories.slice(0, 3).forEach((category, index)=> { %>

          <% const
            categoryImages=[ "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?q=80&w=1000&auto=format&fit=crop"
            , "https://images.unsplash.com/photo-1546435770-a3e426bf472b?q=80&w=1000&auto=format&fit=crop"
            , "https://images.unsplash.com/photo-1590658268037-6bf12165a8df?q=80&w=1000&auto=format&fit=crop" ]; const
            categoryDescriptions=[ "Premium Noise Cancellation" , "Immersive Surround Sound" , "Truly Wireless Freedom"
            ]; %>

            <div class="col-md-4">

              <a href="/shop?category=<%= category._id %>" style="text-decoration:none; color:inherit;">

                <div class="category-card">

                  <img src="<%= categoryImages[index] %>" alt="<%= category.name %>">

                  <div class="category-info">

                    <h5>
                      <%= category.name %>
                    </h5>

                    <p class="text-muted small">
                      <%= categoryDescriptions[index] %>
                    </p>

                  </div>

                </div>

              </a>

            </div>

            <% }) %>

              <% } else { %>

                <div class="col-12 text-center">
                  <p class="text-muted">
                    No categories available.
                  </p>
                </div>

                <% } %>

    </div>

  </div>


  <!-- ==================== TOP PRODUCTS ==================== -->

  <div class="container-custom pt-0">

    <h2 class="section-title">
      Top Picks For You
    </h2>

    <div class="row g-4">

      <% if (products && products.length> 0) { %>

        <% products.slice(0, 8).forEach(product=> { %>

          <% const variant=product.variant || product.defaultVariant; const productImage=variant?.variantImage?.[0] ||
            product.productImage?.[0] || "/images/product-placeholder.png" ; const
            regularPrice=Number(variant?.regularPrice ?? product.regularPrice ?? 0); const
            salePrice=Number(variant?.salePrice ?? product.salePrice ?? 0); %>

            <div class="col-6 col-md-3">

              <div class="product-card">

                <a href="/productDetails?id=<%= product._id %>" style="text-decoration:none;">

                  <img src="<%= productImage %>" alt="<%= product.productName %>">

                </a>

                <div class="product-details">

                  <h6>
                    <%= product.productName %>
                  </h6>

                  <div class="price">

                    <% if (regularPrice> salePrice && salePrice > 0) { %>

                      <span class="old-price">
                        ₹<%= regularPrice %>
                      </span>

                      ₹<%= salePrice %>

                        <% } else { %>

                          ₹<%= salePrice || regularPrice %>

                            <% } %>

                  </div>

                </div>

              </div>

            </div>

            <% }) %>

              <% } else { %>

                <div class="col-12 text-center">

                  <p class="text-muted">
                    No products available.
                  </p>

                </div>

                <% } %>

    </div>

  </div>


  <!-- ==================== FOOTER ==================== -->

  <footer>

    <div class="row text-center footer-logo-container">

      <div class="col-12">

        <img src="/images/logo.png" class="logo-img" alt="OneMore Footer Logo">

      </div>

    </div>


    <div class="row g-4">

      <div class="col-md-3">

        <h6 class="footer-heading">
          Support
        </h6>

        <ul class="list-unstyled footer-links">

          <li>
            <a href="#">
              Order Status
            </a>
          </li>

          <li>
            <a href="#">
              Product Support
            </a>
          </li>

          <li>
            <a href="#">
              Shipping & Return Policy
            </a>
          </li>

          <li>
            <a href="#">
              Complaint Registration
            </a>
          </li>

        </ul>

      </div>


      <div class="col-md-3">

        <h6 class="footer-heading">
          About Us
        </h6>

        <ul class="list-unstyled footer-links">

          <li>
            <a href="#">
              Contact Us
            </a>
          </li>

          <li>
            <a href="#">
              Privacy Policy
            </a>
          </li>

          <li>
            <a href="#">
              Terms of Use
            </a>
          </li>

        </ul>

      </div>


      <div class="col-md-3">

        <h6 class="footer-heading">
          Contact
        </h6>

        <p class="small text-white mb-2">
          <i class="fa-regular fa-envelope me-2"></i>
          onemore@gmail.com
        </p>

        <p class="small text-white">
          <i class="fa-solid fa-phone me-2"></i>
          +91 8888888888
        </p>

      </div>


      <div class="col-md-3">

        <h6 class="footer-heading">
          Connect with us
        </h6>

        <div class="social-icons">

          <a href="#">
            <i class="fa-brands fa-instagram"></i>
          </a>

          <a href="#">
            <i class="fa-brands fa-facebook"></i>
          </a>

          <a href="#">
            <i class="fa-brands fa-x-twitter"></i>
          </a>

        </div>

      </div>

    </div>


    <div class="text-center copyright">

      © 2024 OneMore Audio. All Rights Reserved.

    </div>

  </footer>


  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>