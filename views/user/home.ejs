<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Audio Collection | Premium Sound</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Google Fonts: Poppins -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <!-- Font Awesome for Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    :root {
      --bg-dark: #121212;
      --text-muted: #aaaaaa;
      --card-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    body {
      font-family: 'Poppins', sans-serif;
      background-color: #ffffff;
      color: #333;
    }

    /* --- Navbar --- */
    .navbar {
      background-color: var(--bg-dark);
      padding: 15px 50px;

      position: sticky;
      top: 0;
      z-index: 1000;
    }

    /* Logo Sizing Updated */
    .logo-img {
      height: 60px;
      /* Increased from 40px */
      width: auto;
      object-fit: contain;
    }

    .nav-link {
      color: #fff !important;
      font-size: 0.85rem;
      margin: 0 15px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .nav-icons a {
      color: #fff;
      margin-left: 20px;
      font-size: 1.1rem;
    }
    
    .nav-link {
    font-weight: 400;
    font-size: 0.85rem;
    color: #ffffff !important;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    padding: 0 15px !important;
    transition: opacity 0.3s ease;
}

.nav-link:hover {
    opacity: 0.7; /* Subtle hover effect */
}

.nav-icons i {
    font-size: 1.1rem;
    transition: transform 0.2s;
}

.nav-icons i:hover {
    transform: scale(1.1);
}

    /* --- Hero Section --- */
    .hero-section {
      background-color: var(--bg-dark);
      padding: 20px 50px 60px;
    }

    .hero-banner {
      background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('https://images.unsplash.com/photo-1484704849700-f032a568e944?q=80&w=2070&auto=format&fit=crop');
      background-size: cover;
      background-position: center;
      height: 500px;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      text-align: center;
      position: relative;
    }

    .hero-text h1 {
      font-weight: 700;
      letter-spacing: 4px;
      font-size: 3rem;
    }

    .hero-text p {
      font-size: 1rem;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-top: 15px;
      opacity: 0.9;
    }

    /* --- Sections --- */
    .section-title {
      font-weight: 700;
      margin-bottom: 40px;
      font-size: 1.8rem;
      position: relative;
    }

    .container-custom {
      padding: 80px 80px;
    }

    /* --- Category Cards --- */
    .category-card {
      border: none;
      border-radius: 15px;
      overflow: hidden;
      transition: transform 0.4s ease;
      background: #f8f8f8;
    }

    .category-card:hover {
      transform: translateY(-10px);
    }

    .category-card img {
      height: 400px;
      width: 100%;
      object-fit: cover;
    }

    .category-info {
      text-align: center;
      padding: 20px 10px;
    }

    .category-info h5 {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 5px;
      letter-spacing: 1px;
    }

    /* --- Product Cards --- */
    .product-card {
      border: none;
      margin-bottom: 40px;
      transition: opacity 0.3s;
    }

    .product-card:hover {
      opacity: 0.8;
    }

    .product-card img {
      width: 100%;
      height: 300px;
      object-fit: cover;
      border-radius: 12px;
      background-color: #f1f1f1;
    }

    .product-details {
      margin-top: 15px;
      text-align: left;
    }

    .product-details h6 {
      font-size: 0.95rem;
      font-weight: 600;
      margin-bottom: 5px;
      color: #111;
    }

    .price {
      font-size: 0.9rem;
      font-weight: 700;
      color: #121212;
    }

    .old-price {
      text-decoration: line-through;
      color: #999;
      margin-right: 8px;
      font-weight: 400;
    }

    /* --- Footer --- */
    footer {
      background-color: var(--bg-dark);
      color: #fff;
      padding: 80px 80px 30px;
    }

    .footer-logo-container {
      margin-bottom: 50px;
    }

    .footer-heading {
      font-size: 0.85rem;
      font-weight: 700;
      margin-bottom: 25px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #fff;
    }

    .footer-links li {
      margin-bottom: 12px;
    }

    .footer-links a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.85rem;
      transition: color 0.2s;
    }

    .footer-text {
  color: #e0e0e0;
}
    
    .footer-links a:hover {
      color: #fff;
    }

    .social-icons i {
      font-size: 1.3rem;
      margin-right: 20px;
      color: var(--text-muted);
      transition: color 0.3s;
    }

    .social-icons i:hover {
      color: #fff;
    }

    .copyright {
      border-top: 1px solid #2a2a2a;
      margin-top: 60px;
      padding-top: 30px;
      font-size: 0.75rem;
      color: #555;
    }

    /* --- Mobile Optimization --- */
    @media (max-width: 768px) {
      .container-custom {
        padding: 50px 20px;
      }

      .navbar {
        padding: 15px 20px;
      }

      .nav-links {
        display: none;
      }

      .hero-banner {
        height: 350px;
      }

      .hero-text h1 {
        font-size: 1.8rem;
      }

      .logo-img {
        height: 45px;
      }
    }
  </style>
</head>

