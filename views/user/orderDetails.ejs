<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details | OneMore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-dark: #121212;
            --text-muted: #666666;
            --border-gray: #cccccc;
            --accent-yellow: #ffdc60;
            --btn-red: #e61f26;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            color: #000000;
        }

        /* ── NAVBAR STYLE ── */
        .navbar {
            background-color: var(--bg-dark);
            padding: 15px 50px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo-img {
            height: 60px;
            width: auto;
            object-fit: contain;
        }

        .nav-link {
            color: #ffffff !important;
            font-size: 0.85rem;
            font-weight: 400;
            margin: 0 15px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            padding: 0 15px !important;
            transition: opacity 0.3s ease;
        }

        .nav-icons a {
            color: #fff;
            margin-left: 20px;
            font-size: 1.1rem;
        }

        /* ── DETAILS PANEL LAYOUT ── */
        .details-container {
            max-width: 1300px;
            margin: 50px auto 100px;
            padding: 0 30px;
        }

        .main-details-box {
            border: 1px solid #111111;
            border-radius: 20px;
            background-color: #ffffff;
            overflow: hidden;
            display: flex;
        }

        /* Left Side Info Panel */
        .details-sidebar {
            width: 28%;
            border-right: 1px solid var(--border-gray);
            padding: 40px 30px;
            font-size: 0.85rem;
        }

        .info-section {
            margin-bottom: 25px;
            line-height: 1.6;
        }

        .info-section h6 {
            font-size: 0.9rem;
            font-weight: 700;
            margin-bottom: 12px;
            color: #000000;
        }

        .info-section p {
            color: #333333;
            margin-bottom: 0;
        }

        .status-badge-inline {
            font-weight: 600;
            color: #2ec4b6;
        }

        .status-badge-inline.cancelled-text {
            color: var(--btn-red);
        }

        /* Order Summary Alignment Wrap */
        .summary-row {
            display: flex;
            justify-content: space-between;
            font-size: 0.85rem;
            margin-bottom: 6px;
            color: #333333;
        }

        /* Right Side Items Panel */
        .details-main {
            width: 72%;
            padding: 40px;
            display: flex;
            flex-direction: column;
        }

        .panel-title {
            font-size: 1.4rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-align: center;
            margin-bottom: 30px;
        }

        .items-divider {
            border-top: 1px solid #111111;
            margin: 0 0 25px 0;
            opacity: 1;
        }

        .order-item-row {
            display: grid;
            grid-template-columns: 100px 2.5fr 1fr 1.5fr 2.5fr;
            align-items: center;
            gap: 20px;
            padding-bottom: 25px;
            margin-bottom: 25px;
            border-bottom: 1px solid var(--border-gray);
        }

        .main-details-box .order-item-row:last-of-type {
            border-bottom: none;
            margin-bottom: 0;
        }

        .item-img-wrapper {
            width: 90px;
            height: 90px;
            border-radius: 8px;
            overflow: hidden;
            background-color: #f7f7f7;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .item-img-wrapper img {
            max-width: 100%;
            max-height: 100%;
            object-fit: cover;
        }

        .item-details-text-block {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .item-name-txt {
            font-weight: 600;
            font-size: 0.95rem;
            margin: 0;
        }

        .item-meta-txt {
            color: #555555;
            font-size: 0.9rem;
            margin: 0;
        }

        .item-price-txt {
            font-weight: 500;
            font-size: 0.95rem;
            line-height: 1.4;
        }

        /* Status & Button Context */
        .item-status-block {
            text-align: right;
        }

        .status-header-line {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 8px;
            font-weight: 600;
            font-size: 0.85rem;
            margin-bottom: 6px;
        }

        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
        }

        .dot-active {
            background-color: #2ec4b6;
        }

        .dot-danger {
            background-color: var(--btn-red);
        }

        .status-desc {
            font-size: 0.8rem;
            color: #333333;
            margin-bottom: 12px;
        }

        .cancel-item-btn {
            background-color: var(--btn-red);
            color: #ffffff;
            border: none;
            border-radius: 20px;
            padding: 6px 30px;
            font-size: 0.8rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 10px rgba(230, 31, 38, 0.2);
            transition: opacity 0.2s;
        }

        .cancel-item-btn:hover {
            opacity: 0.9;
            color: #ffffff;
        }

        /* ── PAGINATION STYLE ── */
        .pagination-wrapper {
            margin-top: auto;
            padding-top: 20px;
            display: flex;
            justify-content: center;
        }

        .custom-pagination {
            display: flex;
            gap: 12px;
            align-items: center;
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .page-btn-nav {
            border: 1px solid #111111;
            background-color: #ffffff;
            color: #000000;
            padding: 5px 16px;
            font-size: 0.8rem;
            font-weight: 500;
            border-radius: 6px;
            text-decoration: none;
        }

        .page-num-circle {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background-color: #000000;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.8rem;
            font-weight: 500;
            text-decoration: none;
        }

        .page-num-circle.inactive-page {
            background-color: transparent;
            color: #000000;
        }

        /* ── FOOTER STYLE ── */
        footer {
            background-color: var(--bg-dark);
            color: #fff;
            padding: 80px 80px 30px;
            border-top: 1px solid #222;
        }

        .footer-logo-container {
            margin-bottom: 45px;
        }

        .footer-logo-container img {
            height: 65px;
            width: auto;
        }

        .footer-heading {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--accent-yellow);
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: #ffffff;
            opacity: 0.8;
            text-decoration: none;
            font-size: 13px;
        }

        .footer-contact-text {
            font-size: 13px;
            color: #ffffff;
            margin-bottom: 10px;
        }

        .social-icons a {
            color: #fff;
            font-size: 1.3rem;
            margin-right: 20px;
        }

        .copyright {
            border-top: 1px solid #222;
            margin-top: 60px;
            padding-top: 30px;
            font-size: 12px;
            color: #777;
        }

        /* Responsive UI Optimization */
        @media (max-width: 992px) {
            .main-details-box {
                flex-direction: column;
            }

            .details-sidebar {
                width: 100%;
                border-right: none;
                border-bottom: 1px solid var(--border-gray);
                padding: 30px;
            }

            .details-main {
                width: 100%;
                padding: 30px;
            }

            .order-item-row {
                grid-template-columns: 90px 1fr 1fr;
                gap: 15px;
            }

            .item-status-block {
                grid-column: span 3;
                text-align: left;
                margin-top: 10px;
                border-top: 1px dashed #eee;
                padding-top: 15px;
            }

            .status-header-line {
                justify-content: flex-start;
            }
        }

        @media (max-width: 768px) {
            .details-container {
                padding: 0 15px;
                margin-top: 20px;
            }

            footer {
                padding: 60px 20px 30px;
                text-align: center;
            }

            .footer-heading {
                text-align: center;
            }

            .social-icons {
                display: flex;
                justify-content: center;
                margin-top: 15px;
            }
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <img src="/images/logo.png" class="logo-img" alt="OneMore Logo">
            </a>
            <button class="navbar-toggler navbar-dark border-0" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto text-center mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/shop">Shop</a></li>
                    <li class="nav-item"><a class="nav-link" href="/contact">Contact Us</a></li>
                    <li class="nav-item"><a class="nav-link" href="/about">About Us</a></li>
                </ul>

                <div class="nav-icons d-flex align-items-center justify-content-center mt-3 mt-lg-0">
                    <a href="/profile"><i class="fa-regular fa-user"></i></a>
                    <a href="/wishlist"><i class="fa-regular fa-heart"></i></a>
                    <a href="/cart"><i class="fa-solid fa-bag-shopping"></i></a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Order Details Component Box -->
    <div class="details-container">
        <div class="main-details-box">

            <!-- Left Metadata Side Panel Column -->
            <div class="details-sidebar">
                <div class="info-section">
                    <p>Order: <strong>#<%= order.orderId %></strong></p>
                    <p>Date: <%= new Date(order.createdAt).toLocaleDateString("en-IN") %>
                    </p>
                    <p>Status : <span
                            class="status-badge-inline <%= order.orderStatus === 'Cancelled' ? 'cancelled-text' : '' %>">
                            <%= order.orderStatus %>
                        </span></p>
                </div>

                <div class="info-section">
                    <h6>Shipping Address</h6>
                    <p>
                        <%= order.address.name %><br>
                            <%= order.address.houseName %>, <%= order.address.street %><br>
                                    <%= order.address.city %>, <%= order.address.state %>
                                            <%= order.address.pincode %><br>
                                                <%= order.address.country %>
                    </p>
                </div>

                <div class="info-section">
                    <h6>Payment Method</h6>
                    <p>
                        <%= order.paymentMethod %>
                    </p>
                </div>

                <div class="info-section">
                    <h6>Order Summary</h6>
                    <div class="summary-row">
                        <span>Subtotal :</span>
                        <span>₹ <%= order.subtotal %></span>
                    </div>

                    <div class="summary-row">
                        <span>Shipping :</span>
                        <span>
                            <%= order.shipping===0 ? 'Free' : '₹ ' + order.shipping %>
                        </span>
                    </div>

                    <div class="summary-row">
                        <span>Discount :</span>
                        <span>- ₹ <%= order.discount %></span>
                    </div>

                    <div class="summary-row fw-bold mt-2 pt-2 border-top">
                        <span>Total :</span>
                        <span>₹ <%= order.grandTotal %></span>
                    </div>
                </div>
            </div>

            <!-- Right Tracked Items List Column -->
            <div class="details-main">
                <h2 class="panel-title">Order Details</h2>
                <hr class="items-divider">

                <!-- Dynamic Itemized Loop Block -->
                <% if(order.items && order.items.length> 0) { %>
                    <% items.forEach(item=> { %>
                        <div class="order-item-row">
                            <div class="item-img-wrapper">
                                <img src="<%= item.productImage %>" alt="<%= item.productName %>">
                            </div>

                            <div class="item-details-text-block">
                                <div class="item-name-txt">
                                    <%= item.productName %>
                                </div>
                                <div class="item-meta-txt">
                                    Variant: <%= item.variantName %>
                                </div>
                            </div>

                            <div class="item-meta-txt">
                                Qty: <%= item.quantity %>
                            </div>

                            <div class="item-price-txt">
                                <span class="text-muted small">₹<%= item.salePrice %> × <%= item.quantity %></span><br>
                                <strong>₹<%= item.totalPrice %></strong>
                            </div>

                            <div class="item-status-block">
                                <div class="status-header-line">
                                    <% if(item.status==='Cancelled' ) { %>
                                        <span class="status-dot dot-danger"></span> Cancelled on <%= new
                                            Date(order.createdAt).toLocaleDateString("en-IN") %>
                                            <% } else if(item.status==='Delivered' ) { %>
                                                <span class="status-dot dot-active"></span> Delivered on <%= new
                                                    Date(order.createdAt).toLocaleDateString("en-IN") %>
                                                    <% } else { %>
                                                        <span class="status-dot dot-active"></span> Order placed on <%=
                                                            new Date(order.createdAt).toLocaleDateString("en-IN") %>
                                                            <% } %>
                                </div>
                                <div class="status-desc">
                                    <% if(item.status==='Cancelled' ) { %>
                                        Your order has been cancelled
                                        <% } else if(item.status==='Delivered' ) { %>
                                            Your order has been delivered
                                            <% } else { %>
                                                Your order is being processed.
                                                <% } %>
                                </div>

                                <!-- Display Cancel Action Only for Active/Processing Items -->
                                <% if(item.status !=='Cancelled' && item.status !=='Delivered' ) { %>
                                <form action="/orders/cancel-item" method="POST" class="cancelOrderForm">
                                        <input type="hidden" name="orderId" value="<%= order._id %>">
                                        <input type="hidden" name="itemId" value="<%= item._id %>">
                                        <input type="hidden" name="page" value="<%= currentPage %>">
                                        <button type="submit" class="btn cancel-item-btn">Cancel</button>
                                        <input
    type="hidden"
    name="page"
    value="<%= currentPage %>"
>
                                    </form>
                                    <% } %>
                            </div>
                        </div>
                        <% }) %>
                            <% } %>

                                <!-- Pagination Footer Navigation Block -->
                                <% if(totalPages> 1){ %>
                                    <div class="pagination-wrapper">
                                        <ul class="custom-pagination">
                                            <% if(currentPage> 1){ %>
                                                <li>
                                                    <a href="?page=<%= currentPage-1 %>" class="page-btn-nav">
                                                        Previous
                                                    </a>
                                                </li>
                                                <% } %>

                                                    <% for(let i=1; i <=totalPages; i++){ %>
                                                        <li>
                                                            <a href="?page=<%= i %>"
                                                                class="page-num-circle <%= currentPage === i ? '' : 'inactive-page' %>">
                                                                <%= i %>
                                                            </a>
                                                        </li>
                                                        <% } %>

                                                            <% if(currentPage < totalPages){ %>
                                                                <li>
                                                                    <a href="?page=<%= currentPage+1 %>"
                                                                        class="page-btn-nav">
                                                                        Next
                                                                    </a>
                                                                </li>
                                                                <% } %>
                                        </ul>
                                    </div>
                                    <% } %>

            </div>
        </div>
    </div>

    <!-- Footer Component -->
    <footer>
        <div class="row text-center footer-logo-container">
            <div class="col-12">
                <img src="/images/logo.png" alt="OneMore Footer Logo">
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-3">
                <h6 class="footer-heading">Support</h6>
                <ul class="list-unstyled footer-links">
                    <li><a href="#">Order Status</a></li>
                    <li><a href="#">Product Support</a></li>
                    <li><a href="#">Shipping & Return Policy</a></li>
                    <li><a href="#">Complaint Registration</a></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h6 class="footer-heading">About Us</h6>
                <ul class="list-unstyled footer-links">
                    <li><a href="/contact">Contact Us</a></li>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Terms of use</a></li>
                    <li><a href="#">FAQ</a></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h6 class="footer-heading">Contact</h6>
                <div class="footer-contact-text">Email: onemore@gmail.com</div>
                <div class="footer-contact-text">Phone: +91 8888888888</div>
            </div>
            <div class="col-md-3 text-md-end">
                <h6 class="footer-heading text-md-end">Connect with us</h6>
                <div class="social-icons">
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-x-twitter"></i></a>
                </div>
            </div>
        </div>
        <div class="text-center copyright">
            © 2026 onemore. All Rights Reserved.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

    document.querySelectorAll(".cancelOrderForm").forEach(form => {

        form.addEventListener("submit", function (e) {

            e.preventDefault()

            Swal.fire({

                title: "Cancel Product?",

                text: "This product will be cancelled and cannot be processed further.",

                icon: "warning",

                showCancelButton: true,

                confirmButtonColor: "#e61f26",

                cancelButtonColor: "#6c757d",

                confirmButtonText: "Yes, Cancel",

                cancelButtonText: "Keep Product"

            }).then((result) => {

                if (result.isConfirmed) {

                    form.submit()

                }

            })

        })

    })

</script>

</html>