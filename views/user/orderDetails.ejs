<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details | OneMore</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --dark: #242422;
            --dark-soft: #30302d;
            --lime: #d7f36b;
            --lime-hover: #c6e451;
            --page: #f4f4ee;
            --white: #ffffff;
            --text: #242422;
            --muted: #77776e;
            --border: #e8e8df;
            --danger: #c73d35;
            --btn-red: #c73d35;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            font-family: 'Poppins', sans-serif;
            color: var(--text);
            background: var(--page);
        }

        a {
            text-decoration: none;
        }

        button,
        input,
        select,
        textarea {
            font-family: inherit;
        }

        /* Styling is scoped to this page; shared navbar partial is unchanged. */
        .profile-page-navbar {
            position: relative;
            z-index: 1000;
            background: var(--dark);
        }

        .profile-page-navbar nav,
        .profile-page-navbar .navbar {
            background-color: var(--dark) !important;
        }

        .profile-page-navbar .navbar a,
        .profile-page-navbar .navbar .nav-link,
        .profile-page-navbar .navbar i,
        .profile-page-navbar .navbar svg {
            color: #fff !important;
        }

        .profile-page-navbar .navbar a:hover,
        .profile-page-navbar .navbar .nav-link:hover {
            color: var(--lime) !important;
        }

        .profile-page-navbar img {
            object-fit: contain;
        }

        .details-container {
            width: 100%;
            max-width: 1170px;
            margin: 32px auto 58px;
            padding: 0 24px;
            flex: 1;
        }

        .main-details-box {
            display: flex;
            align-items: stretch;
            overflow: hidden;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--white);
            box-shadow: 0 5px 22px rgba(30, 30, 20, .035);
        }

        .details-sidebar {
            width: 30%;
            min-width: 0;
            padding: 30px 24px;
            border-right: 1px solid var(--border);
            font-size: 13px;
        }

        .info-section {
            margin-bottom: 25px;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

        .info-section:last-child {
            margin-bottom: 0;
        }

        .info-section h6 {
            margin-bottom: 10px;
            color: var(--text);
            font-size: 13px;
            font-weight: 600;
        }

        .info-section p {
            margin-bottom: 0;
            color: #626259;
            font-size: 12px;
            line-height: 1.8;
            overflow-wrap: anywhere;
        }

        .status-badge-inline {
            color: #258f84;
            font-weight: 600;
        }

        .status-badge-inline.cancelled-text {
            color: var(--danger);
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 8px;
            color: #626259;
            font-size: 12px;
        }

        .summary-row span:last-child {
            text-align: right;
            overflow-wrap: anywhere;
        }

        .details-main {
            display: flex;
            flex: 1;
            flex-direction: column;
            width: 70%;
            min-width: 0;
            padding: 30px;
        }

        .panel-title {
            margin: 0 0 22px;
            color: var(--text);
            font-size: 19px;
            font-weight: 600;
            letter-spacing: -.3px;
            text-align: left;
        }

        .items-divider {
            margin: 0 0 22px;
            border-top: 1px solid var(--border);
            opacity: 1;
        }

        .order-item-row {
            display: grid;
            grid-template-columns: 76px minmax(0, 1.6fr) minmax(45px, .5fr) minmax(85px, .8fr) minmax(150px, 1.5fr);
            align-items: center;
            gap: 14px;
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border);
        }

        .main-details-box .order-item-row:last-of-type {
            margin-bottom: 0;
            border-bottom: none;
        }

        .item-img-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 76px;
            height: 76px;
            overflow: hidden;
            border-radius: 8px;
            background: #f4f4ee;
        }

        .item-img-wrapper img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .item-details-text-block {
            display: flex;
            flex-direction: column;
            gap: 5px;
            min-width: 0;
        }

        .item-name-txt {
            margin: 0;
            color: var(--text);
            font-size: 13px;
            font-weight: 600;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .item-meta-txt {
            margin: 0;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .item-price-txt {
            color: var(--text);
            font-size: 12px;
            font-weight: 500;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

        .item-price-txt .small {
            font-size: 11px !important;
        }

        .item-status-block {
            min-width: 0;
            text-align: left;
        }

        .status-header-line {
            display: flex;
            align-items: flex-start;
            justify-content: flex-start;
            gap: 7px;
            margin-bottom: 6px;
            color: var(--text);
            font-size: 11px;
            font-weight: 600;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .status-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            flex: 0 0 8px;
            margin-top: 5px;
            border-radius: 50%;
        }

        .dot-active {
            background: #2aa99c;
        }

        .dot-danger {
            background: var(--danger);
        }

        .status-desc {
            margin-bottom: 10px;
            color: var(--muted);
            font-size: 11px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .cancel-item-btn {
            padding: 7px 14px;
            border: 1px solid var(--danger) !important;
            border-radius: 6px;
            background: var(--danger) !important;
            color: #fff !important;
            font-size: 11px;
            font-weight: 500;
            box-shadow: none;
            transition: background .18s ease, opacity .18s ease;
        }

        .cancel-item-btn:hover {
            background: #a92f2a !important;
            color: #fff !important;
        }

        .returnOrderForm .btn-outline-danger {
            padding: 7px 14px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 500;
        }

        .returnOrderForm .btn-outline-danger:hover {
            background: var(--danger);
            color: #fff;
        }

        .details-sidebar .btn-dark {
            padding: 10px 12px;
            border: 1px solid var(--dark);
            border-radius: 6px;
            background: var(--dark);
            color: #fff;
            font-size: 12px;
            font-weight: 500;
        }

        .details-sidebar .btn-dark:hover {
            border-color: var(--lime-hover);
            background: var(--lime);
            color: var(--dark);
        }

        .pagination-wrapper {
            display: flex;
            justify-content: center;
            margin-top: auto;
            padding-top: 20px;
        }

        .custom-pagination {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            gap: 7px;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .page-btn-nav {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 34px;
            padding: 7px 12px;
            border: 1px solid var(--border);
            border-radius: 7px;
            background: #fff;
            color: var(--text);
            font-size: 11px;
            font-weight: 500;
        }

        .page-btn-nav:hover {
            border-color: var(--lime-hover);
            background: var(--lime);
            color: var(--dark);
        }

        .page-num-circle {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border: 1px solid var(--dark);
            border-radius: 7px;
            background: var(--dark);
            color: #fff;
            font-size: 11px;
            font-weight: 500;
        }

        .page-num-circle.inactive-page {
            border-color: var(--border);
            background: #fff;
            color: var(--text);
        }

        .page-num-circle.inactive-page:hover {
            border-color: var(--lime-hover);
            background: #f0f5dc;
        }

        footer {
            margin-top: auto;
            padding: 38px 24px 18px;
            border-top: 1px solid #353530;
            background: var(--dark);
            color: #fff;
        }

        footer>.row,
        footer>.text-center {
            max-width: 1180px;
            margin-right: auto;
            margin-left: auto;
        }

        .footer-logo-container {
            margin-bottom: 28px;
        }

        .footer-logo-container img {
            width: 68px;
            max-width: 100%;
            height: auto;
            object-fit: contain;
        }

        .footer-heading {
            margin-bottom: 13px;
            color: var(--lime);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .footer-links li {
            margin-bottom: 8px;
        }

        .footer-links a {
            color: #aaa99f;
            font-size: 11px;
            line-height: 1.6;
            text-decoration: none;
            transition: color .18s ease;
        }

        .footer-links a:hover {
            color: var(--lime);
        }

        .footer-contact-text {
            margin-bottom: 9px;
            color: #aaa99f;
            font-size: 11px;
            overflow-wrap: anywhere;
        }

        .social-icons a {
            margin-right: 13px;
            color: #c8c8bf;
            font-size: 16px;
            transition: color .18s ease;
        }

        .social-icons a:hover {
            color: var(--lime);
        }

        .copyright {
            margin-top: 25px;
            padding-top: 17px;
            border-top: 1px solid rgba(255, 255, 255, .12);
            color: #88887e;
            font-size: 10px;
        }

        @media (max-width: 1100px) {
            .details-sidebar {
                width: 32%;
                padding: 25px 20px;
            }

            .details-main {
                width: 68%;
                padding: 25px 22px;
            }

            .order-item-row {
                grid-template-columns: 70px minmax(0, 1.5fr) minmax(40px, .5fr) minmax(75px, .8fr);
                gap: 12px;
            }

            .item-status-block {
                grid-column: 2 / -1;
                padding-top: 12px;
                border-top: 1px solid #f0f0e9;
            }
        }

        @media (max-width: 767.98px) {
            .details-container {
                max-width: 620px;
                margin: 22px auto 38px;
                padding: 0 16px;
            }

            .main-details-box {
                flex-direction: column;
                border-radius: 11px;
            }

            .details-sidebar {
                width: 100%;
                padding: 22px 20px;
                border-right: none;
                border-bottom: 1px solid var(--border);
            }

            .info-section {
                margin-bottom: 20px;
            }

            .info-section h6 {
                font-size: 13px;
            }

            .info-section p,
            .summary-row {
                font-size: 12px;
            }

            .details-main {
                width: 100%;
                padding: 22px 20px;
            }

            .panel-title {
                margin-bottom: 18px;
                font-size: 18px;
            }

            .order-item-row {
                grid-template-columns: 72px minmax(0, 1fr) minmax(60px, .5fr);
                gap: 12px;
                padding-bottom: 17px;
                margin-bottom: 17px;
            }

            .item-img-wrapper {
                width: 72px;
                height: 72px;
            }

            .item-details-text-block {
                grid-column: span 2;
            }

            .item-price-txt {
                grid-column: 2;
            }

            .item-status-block {
                grid-column: 1 / -1;
                padding-top: 13px;
                border-top: 1px solid #f0f0e9;
            }

            footer {
                padding: 30px 18px 17px;
            }

            .footer-logo-container {
                margin-bottom: 24px;
            }

            .footer-heading {
                font-size: 9px;
            }

            .footer-links a,
            .footer-contact-text {
                font-size: 10px;
            }

            .social-icons {
                display: flex;
                justify-content: flex-start;
                margin-top: 12px;
            }

            .copyright {
                margin-top: 22px;
            }
        }

        @media (max-width: 480px) {
            .details-container {
                margin-top: 16px;
                padding: 0 12px;
            }

            .details-sidebar {
                padding: 19px 15px;
            }

            .details-main {
                padding: 19px 14px;
            }

            .panel-title {
                font-size: 17px;
            }

            .info-section h6 {
                font-size: 12px;
            }

            .info-section p,
            .summary-row {
                font-size: 12px;
            }

            .order-item-row {
                grid-template-columns: 62px minmax(0, 1fr);
                gap: 10px;
            }

            .item-img-wrapper {
                width: 62px;
                height: 62px;
            }

            .item-details-text-block {
                grid-column: 2;
            }

            .order-item-row>.item-meta-txt {
                grid-column: 2;
            }

            .item-price-txt {
                grid-column: 2;
            }

            .item-status-block {
                grid-column: 1 / -1;
            }

            .item-name-txt {
                font-size: 13px;
            }

            .item-meta-txt,
            .item-price-txt {
                font-size: 12px;
            }

            .status-header-line,
            .status-desc {
                font-size: 11px;
            }

            .cancel-item-btn,
            .returnOrderForm .btn-outline-danger {
                width: 100%;
            }

            .custom-pagination {
                gap: 5px;
            }

            .page-btn-nav {
                padding: 7px 9px;
                font-size: 10px;
            }

            footer {
                padding-right: 14px;
                padding-left: 14px;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                animation-duration: .01ms !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <div class="profile-page-navbar">
        <%- include("../partials/navbar") %>
    </div>

    <!-- Main Order Details Component Box -->
    <div class="details-container">
        <div class="main-details-box">

            <!-- Left Metadata Side Panel Column -->
            <div class="details-sidebar">
                <div class="info-section">
                    <p>Order: <strong>#<%= order.orderId %></strong></p>
                    <p>Date: <%= new Date(order.createdAt).toLocaleDateString("en-IN") %>
                    </p>
                    <p>Status : <span
                            class="status-badge-inline <%= order.orderStatus === 'Cancelled' ? 'cancelled-text' : '' %>">
                            <%= order.orderStatus %>
                        </span></p>
                </div>

                <div class="info-section">
                    <h6>Shipping Address</h6>
                    <p>
                        <%= order.address.name %><br>
                            <%= order.address.houseName %>, <%= order.address.street %><br>
                                    <%= order.address.city %>, <%= order.address.state %>
                                            <%= order.address.pincode %><br>
                                                <%= order.address.country %>
                    </p>
                </div>

                <div class="info-section">
                    <h6>Payment Method</h6>
                    <p>
                        <%= order.paymentMethod %>
                    </p>
                </div>

                <div class="info-section">
                    <h6>Order Summary</h6>
                    <div class="summary-row">
                        <span>Subtotal :</span>
                        <span>₹ <%= order.subTotal %></span>
                    </div>

                    <div class="summary-row">
                        <span>Shipping :</span>
                        <span>
                            <%= order.shipping===0 ? 'Free' : '₹ ' + order.shipping %>
                        </span>
                    </div>

                    <div class="summary-row">
                        <span>Discount :</span>
                        <span>- ₹ <%= order.discount %></span>
                    </div>

                    <div class="summary-row fw-bold mt-2 pt-2 border-top">
                        <span>Total :</span>
                        <span>₹ <%= order.grandTotal %></span>
                    </div>
                </div>

                <% if ( order.paymentMethod==="RAZORPAY" && ["Pending", "Failed" ].includes(order.paymentStatus) &&
                    !["Cancelled", "Returned" ].includes(order.orderStatus) ) { %>
                    <div class="info-section text-center mt-4">
                        <a href="/payment-failed/<%= order._id %>" class="btn btn-dark w-100">
                            <i class="fa-solid fa-rotate-right me-2"></i>
                            Retry Payment
                        </a>
                    </div>
                    <% } %>

                        <% const hasDeliveredItems=order.items.some( item=> item.status === "Delivered"
                            ); %>


                            <div class="info-section text-center mt-4">

                                <% if(hasDeliveredItems){ %>

                                    <a href="/orders/<%= order._id %>/invoice" class="btn btn-dark w-100">

                                        <i class="fa-solid fa-file-pdf me-2"></i>

                                        Download Invoice

                                    </a>

                                    <% } %>

                            </div>
            </div>

            <!-- Right Tracked Items List Column -->
            <div class="details-main">
                <h2 class="panel-title">Order Details</h2>
                <hr class="items-divider">

                <!-- Dynamic Itemized Loop Block -->
                <% if(items && items.length> 0) { %>
                    <% items.forEach(item=> { %>
                        <div class="order-item-row">
                            <div class="item-img-wrapper">
                                <img src="<%= item.productImage %>" alt="<%= item.productName %>">
                            </div>

                            <div class="item-details-text-block">
                                <div class="item-name-txt">
                                    <%= item.productName %>
                                </div>
                                <div class="item-meta-txt">
                                    Variant: <%= item.variantName %>
                                </div>
                            </div>

                            <div class="item-meta-txt">
                                Qty: <%= item.quantity %>
                            </div>

                            <div class="item-price-txt">
                                <span class="text-muted small">₹<%= item.salePrice %> × <%= item.quantity %></span><br>
                                <strong>₹<%= item.totalPrice %></strong>
                            </div>

                            <div class="item-status-block">
                                <div class="status-header-line">
                                    <% if(item.status==='Cancelled' ) { %>
                                        <span class="status-dot dot-danger"></span> Cancelled on
                                        <%= new Date(item.cancelledAt).toLocaleDateString("en-IN") %>
                                            <% } else if(item.status==='Delivered' ) { %>
                                                <span class="status-dot dot-active"></span> Delivered on <%= new
                                                    Date(order.createdAt).toLocaleDateString("en-IN") %>
                                                    <% } else { %>
                                                        <span class="status-dot dot-active"></span> Order placed on <%=
                                                            new Date(order.createdAt).toLocaleDateString("en-IN") %>
                                                            <% } %>
                                </div>
                                <div class="status-desc">

                                    <% if(item.status==="Pending" ){ %>
                                        Waiting for confirmation.

                                        <% } else if(item.status==="Processing" ){ %>
                                            Your order is being prepared.

                                            <% } else if(item.status==="Shipped" ){ %>
                                                Your package has been shipped.

                                                <% } else if(item.status==="Out For Delivery" ){ %>
                                                    Your package is out for delivery.

                                                    <% } else if(item.status==="Delivered" ){ %>
                                                        Delivered successfully.

                                                        <% } else if(item.status==="Cancelled" ){ %>
                                                            Product cancelled.

                                                            <% } else if(item.status==="Return Requested" ){ %>
                                                                Return request submitted.

                                                                <% } else if(item.status==="Returned" ){ %>
                                                                    Product returned successfully.

                                                                    <% } %>

                                </div>
                                <% if(item.status==="Cancelled" && item.cancelReason){ %>

                                    <div class="text-danger small mt-2">

                                        <strong>Reason :</strong>

                                        <%= item.cancelReason %>

                                    </div>

                                    <% } %>

                                        <!-- Display Cancel Action Only for Active/Processing Items -->
                                        <!-- Pending Products -->
                                        <% if(["Pending", "Processing" ].includes(item.status)){ %>

                                            <form action="/orders/cancel-item" method="POST" class="cancelOrderForm">

                                                <input type="hidden" name="orderId" value="<%= order._id %>">
                                                <input type="hidden" name="itemId" value="<%= item._id %>">
                                                <input type="hidden" name="page" value="<%= currentPage %>">

                                                <button class="btn cancel-item-btn">
                                                    Cancel Product
                                                </button>

                                            </form>

                                            <% } %>

                                                <!-- Delivered Products -->
                                                <% if(item.status==="Delivered" ){ %>

                                                    <form action="/orders/return-item" method="POST"
                                                        class="returnOrderForm">

                                                        <input type="hidden" name="orderId" value="<%= order._id %>">

                                                        <input type="hidden" name="itemId" value="<%= item._id %>">

                                                        <input type="hidden" name="page" value="<%= currentPage %>">

                                                        <button type="submit" class="btn btn-outline-danger">

                                                            Return Product

                                                        </button>

                                                    </form>

                                                    <% } %>
                            </div>
                        </div>
                        <% }) %>
                            <% } %>

                                <!-- Pagination Footer Navigation Block -->
                                <% if(totalPages> 1){ %>
                                    <div class="pagination-wrapper">
                                        <ul class="custom-pagination">

                                            <% if(currentPage> 1){ %>
                                                <li>
                                                    <a href="?page=<%= currentPage - 1 %>" class="page-btn-nav">
                                                        Previous
                                                    </a>
                                                </li>
                                                <% } %>

                                                    <% for(let i=1; i <=totalPages; i++){ %>
                                                        <li>
                                                            <a href="?page=<%= i %>"
                                                                class="page-num-circle <%= currentPage === i ? '' : 'inactive-page' %>">
                                                                <%= i %>
                                                            </a>
                                                        </li>
                                                        <% } %>

                                                            <% if(currentPage < totalPages){ %>
                                                                <li>
                                                                    <a href="?page=<%= currentPage + 1 %>"
                                                                        class="page-btn-nav">
                                                                        Next
                                                                    </a>
                                                                </li>
                                                                <% } %>

                                        </ul>
                                    </div>
                                    <% } %>

            </div>
        </div>
    </div>

    <!-- Footer Component -->
    <footer>
        <div class="row text-center footer-logo-container">
            <div class="col-12">
                <img src="/images/logo.png" alt="OneMore Footer Logo">
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-3">
                <h6 class="footer-heading">Support</h6>
                <ul class="list-unstyled footer-links">
                    <li><a href="#">Order Status</a></li>
