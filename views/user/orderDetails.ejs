<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>

    document.querySelectorAll(".cancelOrderForm").forEach(form => {

        form.addEventListener("submit", function (e) {

            e.preventDefault()

            Swal.fire({

                title: "Cancel Product?",

                text: "Please provide a reason for cancelling this product:",

                icon: "warning",

                input: "select",

                inputOptions: {
                    "Ordered by mistake": "Ordered by mistake",
                    "Found a better price": "Found a better price",
                    "Delivery is taking too long": "Delivery is taking too long",
                    "Want to change variant": "Want to change variant",
                    "Other": "Other"
                },

                inputPlaceholder: "Select a cancellation reason",

                inputAttributes: {

                    'aria-label': 'Type your cancellation reason here'

                },

                showCancelButton: true,

                confirmButtonColor: "#e61f26",

                cancelButtonColor: "#6c757d",

                confirmButtonText: "Yes, Cancel",

                cancelButtonText: "Keep Product",

                ppreConfirm: (reason) => {

                    if (!reason) {

                        Swal.showValidationMessage(
                            "Please select a cancellation reason."
                        );

                    }

                    return reason;

                }

            }).then(async (result) => {

                if (!result.isConfirmed) return;

                let reason = result.value;

                if (reason === "Other") {

                    const otherReason = await Swal.fire({

                        title: "Please specify",

                        input: "textarea",

                        inputPlaceholder: "Enter your cancellation reason...",

                        inputAttributes: {
                            "aria-label": "Enter cancellation reason"
                        },

                        showCancelButton: true,

                        confirmButtonText: "Submit",

                        cancelButtonText: "Back",

                        confirmButtonColor: "#e61f26",

                        preConfirm: (value) => {

                            if (!value || value.trim() === "") {

                                Swal.showValidationMessage(
                                    "Please enter a reason."
                                );

                            }

                            return value;

                        }

                    });

                    if (!otherReason.isConfirmed) return;

                    reason = otherReason.value;

                }

                const reasonInput = document.createElement("input");

                reasonInput.type = "hidden";

                reasonInput.name = "cancelReason";

                reasonInput.value = reason;

                form.appendChild(reasonInput);

                form.submit();

            });

        })

    })


    document.querySelectorAll(".returnOrderForm").forEach(form => {

        form.addEventListener("submit", function (e) {

            e.preventDefault()

            Swal.fire({

                title: "Return Product?",

                text: "Please provide a reason for returning this product:",

                icon: "question",

                input: "textarea",

                inputPlaceholder: "Type your return reason here...",

                inputAttributes: {
                    'aria-label': 'Type your return reason here'
                },

                showCancelButton: true,

                confirmButtonColor: "#e61f26",

                cancelButtonColor: "#6c757d",

                confirmButtonText: "Request Return",

                cancelButtonText: "Keep Product",

                preConfirm: (reason) => {

                    if (!reason || reason.trim() === "") {
                        Swal.showValidationMessage(
                            "A return reason is required."
                        )
                    }

                    return reason
                }

            }).then((result) => {

                if (result.isConfirmed) {

                    const reasonInput = document.createElement("input")

                    reasonInput.type = "hidden"

                    reasonInput.name = "returnReason"

                    reasonInput.value = result.value

                    form.appendChild(reasonInput)

                    form.submit()

                }

            })

        })

    })


</script>

</html>