<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders | OneMore</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --dark: #242422;
            --dark-soft: #30302d;
            --lime: #d7f36b;
            --lime-hover: #c6e451;
            --page: #f4f4ee;
            --white: #ffffff;
            --text: #242422;
            --muted: #77776e;
            --border: #e8e8df;
            --danger: #c73d35;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            font-family: 'Poppins', sans-serif;
            color: var(--text);
            background: var(--page);
        }

        a {
            text-decoration: none;
        }

        button {
            font-family: inherit;
        }

        /* Page-local navbar styles; the shared navbar partial is unchanged. */
        .profile-page-navbar {
            position: relative;
            z-index: 1000;
            background: var(--dark);
        }

        .profile-page-navbar nav,
        .profile-page-navbar .navbar {
            background-color: var(--dark) !important;
        }

        .profile-page-navbar .navbar a,
        .profile-page-navbar .navbar .nav-link,
        .profile-page-navbar .navbar i,
        .profile-page-navbar .navbar svg {
            color: #fff !important;
        }

        .profile-page-navbar .navbar a:hover,
        .profile-page-navbar .navbar .nav-link:hover {
            color: var(--lime) !important;
        }

        .profile-page-navbar img {
            object-fit: contain;
        }

        .breadcrumb {
            margin-bottom: 0;
            font-size: 11px;
        }

        .breadcrumb-item a {
            color: var(--muted) !important;
            transition: color .18s ease;
        }

        .breadcrumb-item a:hover {
            color: var(--dark) !important;
        }

        .breadcrumb-item.active {
            color: var(--text);
            font-weight: 500;
        }

        .container.mt-4 {
            width: 100%;
            max-width: 1170px;
            padding-right: 24px;
            padding-left: 24px;
            margin-top: 25px !important;
        }

        .account-container {
            width: 100%;
            max-width: 1120px;
            margin: 24px auto 58px;
            padding: 0 24px;
            flex: 1;
        }

        .account-container>.row {
            --bs-gutter-x: 24px;
            --bs-gutter-y: 20px;
        }

        .account-sidebar {
            height: fit-content;
            overflow: hidden;
            padding-bottom: 12px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--white);
            box-shadow: 0 5px 22px rgba(30, 30, 20, .035);
        }

        .sidebar-header {
            padding: 20px 20px 17px;
            border-bottom: 1px solid var(--border);
            color: #88887d;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-align: left;
            text-transform: uppercase;
        }

        .sidebar-menu {
            list-style: none;
            margin: 0;
            padding: 11px;
        }

        .sidebar-item a {
            display: flex;
            align-items: center;
            min-height: 42px;
            padding: 10px 12px;
            border-radius: 7px;
            color: #626259;
            font-size: 11px;
            font-weight: 400;
            line-height: 1.45;
            transition: background .18s ease, color .18s ease;
        }

        .sidebar-item i {
            width: 16px;
            flex: 0 0 16px;
            margin-right: 11px;
            color: #8b8b80;
            font-size: 13px;
            text-align: center;
        }

        .sidebar-item.active a {
            background: #f0f5dc;
            color: var(--dark);
            font-weight: 600;
        }

        .sidebar-item.active i {
            color: var(--dark);
        }

        .sidebar-item a:hover {
            background: #f5f6ef;
            color: var(--dark);
        }

        .sidebar-item a:hover i {
            color: var(--dark);
        }

        .orders-panel {
            min-width: 0;
            overflow: visible;
            padding: 25px 0 10px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--white);
            box-shadow: 0 5px 22px rgba(30, 30, 20, .035);
        }

        .orders-panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 0 24px 20px;
        }

        .panel-title {
            flex: 1;
            margin: 0;
            color: var(--text);
            font-size: 17px;
            font-weight: 600;
            letter-spacing: -.3px;
            text-align: left;
        }

        .filter-dropdown-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            min-height: 38px;
            padding: 8px 13px;
            border: 1px solid var(--border);
            border-radius: 7px;
            background: #fff;
            color: #4e4e46;
            font-size: 11px;
            font-weight: 500;
            white-space: nowrap;
        }

        .filter-dropdown-btn:hover,
        .filter-dropdown-btn:focus {
            border-color: #d5d9c5;
            background: #f7f8f1;
            color: var(--dark);
        }

        .dropdown-menu {
            min-width: 155px;
            padding: 6px;
            border: 1px solid var(--border);
            border-radius: 8px;
            box-shadow: 0 10px 28px rgba(0, 0, 0, .09);
        }

        .dropdown-menu-item {
            border-radius: 5px;
            font-family: 'Poppins', sans-serif;
            font-size: 11px !important;
        }

        .dropdown-menu-item:hover {
            background: #f5f6ef;
        }

        .orders-table-header {
            display: grid;
            grid-template-columns: 1.2fr .7fr 1.1fr 2fr;
            align-items: center;
            gap: 12px;
            padding: 13px 24px;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
            background: #fcfcf9;
            color: #77776e;
            font-size: 9px;
            font-weight: 600;
            letter-spacing: .8px;
            text-align: left;
            text-transform: uppercase;
        }

        .orders-table-header div:nth-child(2),
        .orders-table-header div:nth-child(3) {
            text-align: center;
        }

        .order-row {
            display: grid;
            grid-template-columns: 1.2fr .7fr 1.1fr 2fr;
            align-items: center;
            gap: 12px;
            padding: 22px 24px;
            border-bottom: 1px solid var(--border);
            color: #55554d;
            font-size: 11px;
        }

        .orders-panel .order-row:last-of-type {
            border-bottom: none;
        }

        .order-row>div:nth-child(2),
        .order-row>div:nth-child(3) {
            text-align: center;
        }

        .order-id-txt {
            color: var(--text);
            font-size: 11px;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

        .order-amount-txt {
            color: var(--text);
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .status-container {
            min-width: 0;
            padding-left: 5px;
            text-align: left;
        }

        .status-indicator-line {
            display: flex;
            align-items: flex-start;
            gap: 7px;
            margin-bottom: 6px;
            color: var(--text);
            font-size: 10px;
            font-weight: 600;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .status-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            flex: 0 0 8px;
            margin-top: 4px;
            border-radius: 50%;
        }

        .dot-expected,
        .dot-delivered {
            background: #2aa99c;
        }

        .dot-cancelled {
            background: #d94a52;
        }

        .status-subtitle {
            margin-bottom: 10px;
            color: var(--muted);
            font-size: 10px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        .view-order-pill {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 32px;
            margin: 3px 5px 3px 0;
            padding: 7px 13px;
            border: 1px solid var(--dark);
            border-radius: 6px;
            background: var(--dark);
            color: #fff;
            font-size: 10px;
            font-weight: 500;
            white-space: nowrap;
            transition: background .18s ease, color .18s ease, border-color .18s ease;
        }

        .view-order-pill:hover {
            border-color: var(--lime-hover);
            background: var(--lime);
            color: var(--dark);
        }

        .pagination {
            flex-wrap: wrap;
            gap: 3px;
        }

        .pagination .page-link {
            min-width: 34px;
            padding: 7px 10px;
            border: 1px solid var(--border);
            border-radius: 7px;
            background: #fff;
            color: var(--text);
            font-size: 11px;
            text-align: center;
        }

        .pagination .page-item.active .page-link {
            border-color: var(--dark);
            background: var(--dark);
            color: #fff;
        }

        .pagination .page-link:hover {
            border-color: #d5d9c5;
            background: #f0f5dc;
            color: var(--dark);
        }

        .pagination .page-item.disabled .page-link {
            color: #aaa99f;
            background: #f8f8f5;
        }

        .empty-orders {
            padding: 42px 20px;
            color: var(--muted);
            font-size: 12px;
            text-align: center;
        }

        footer {
            margin-top: auto;
            padding: 38px 24px 18px;
            border-top: 1px solid #353530;
            background: var(--dark);
            color: #fff;
        }

        footer>.row,
        footer>.text-center {
            max-width: 1180px;
            margin-right: auto;
            margin-left: auto;
        }

        .footer-logo-container {
            margin-bottom: 28px;
        }

        .footer-logo-container img {
            width: 68px;
            max-width: 100%;
            height: auto;
            object-fit: contain;
        }

        .footer-heading {
            margin-bottom: 13px;
            color: #fff;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .footer-links li {
            margin-bottom: 8px;
        }

        .footer-links a {
            color: #aaa99f;
            font-size: 10px;
            line-height: 1.6;
            text-decoration: none;
            transition: color .18s ease;
        }

        .footer-links a:hover {
            color: var(--lime);
        }

        .footer-contact-text {
            margin-bottom: 9px;
            color: #aaa99f;
            font-size: 10px;
            overflow-wrap: anywhere;
        }

        .social-icons a {
            margin-right: 13px;
            color: #c8c8bf;
            font-size: 16px;
            transition: color .18s ease;
        }

        .social-icons a:hover {
            color: var(--lime);
        }

        .copyright {
            margin-top: 25px;
            padding-top: 17px;
            border-top: 1px solid rgba(255, 255, 255, .12);
            color: #88887e;
            font-size: 10px;
        }

        @media (max-width: 991.98px) {
            .account-container {
                max-width: 820px;
            }

            .account-container>.row {
                --bs-gutter-x: 18px;
            }

            .orders-panel-header {
                padding-right: 20px;
                padding-left: 20px;
            }

            .orders-table-header {
                display: none;
            }

            .order-row {
                grid-template-columns: minmax(0, 1fr) minmax(0, .5fr);
                gap: 12px 16px;
                margin: 0 16px 12px;
                padding: 17px;
                border: 1px solid var(--border);
                border-radius: 9px;
            }

            .order-row>div:nth-child(2),
            .order-row>div:nth-child(3) {
                text-align: left;
            }

            .order-row>div:nth-child(2)::before {
                content: "Items";
                display: block;
                margin-bottom: 4px;
                color: var(--muted);
                font-size: 9px;
            }

            .order-row>div:nth-child(3)::before {
                content: "Total Amount";
                display: block;
                margin-bottom: 4px;
                color: var(--muted);
                font-size: 9px;
            }

            .status-container {
                grid-column: 1 / -1;
                padding: 11px 0 0;
                border-top: 1px solid #f0f0e9;
            }

            .status-indicator-line,
            .status-subtitle {
                font-size: 11px;
            }
        }

        @media (max-width: 767.98px) {
            .container.mt-4 {
                margin-top: 18px !important;
                padding-right: 16px;
                padding-left: 16px;
            }

            .account-container {
                max-width: 600px;
                margin: 18px auto 38px;
                padding: 0 16px;
            }

            .account-sidebar {
                margin-bottom: 0;
            }

            .sidebar-header {
                padding: 16px 17px 13px;
            }

            .sidebar-menu {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 5px;
                padding: 10px;
            }

            .sidebar-item a {
                min-height: 40px;
                padding: 9px 10px;
            }

            .sidebar-item i {
                margin-right: 8px;
            }

            footer {
                padding: 30px 18px 17px;
                text-align: left;
            }

            .footer-logo-container {
                margin-bottom: 24px;
            }

            .footer-heading {
                font-size: 9px;
            }

            .footer-links a,
            .footer-contact-text {
                font-size: 10px;
            }

            .social-icons {
                display: flex;
                justify-content: flex-start;
                margin-top: 12px;
            }

            .copyright {
                margin-top: 22px;
            }
        }

        @media (max-width: 480px) {
            .container.mt-4 {
                padding-right: 12px;
                padding-left: 12px;
            }

            .account-container {
                padding: 0 12px;
            }

            .orders-panel {
                padding-top: 19px;
            }

            .orders-panel-header {
                align-items: flex-start;
                flex-wrap: wrap;
                gap: 12px;
                padding: 0 15px 17px;
            }

            .panel-title {
                font-size: 16px;
            }

            .filter-dropdown-btn {
                min-height: 35px;
                padding: 7px 10px;
                font-size: 10px;
            }

            .order-row {
                grid-template-columns: minmax(0, 1fr) minmax(0, .65fr);
                margin-right: 10px;
                margin-left: 10px;
                padding: 14px;
            }

            .view-order-pill {
                padding: 7px 10px;
                font-size: 9px;
            }

            .sidebar-menu {
                grid-template-columns: minmax(0, 1fr);
            }

            .sidebar-item a {
                font-size: 12px;
            }

            footer {
                padding-right: 14px;
                padding-left: 14px;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                animation-duration: .01ms !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>

<body>

    <div class="profile-page-navbar">
        <%- include("../partials/navbar") %>
    </div>

    <div class="container mt-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item">
                    <a href="/" class="text-decoration-none text-dark">Home</a>
                </li>
                <li class="breadcrumb-item">
                    <a href="/profile" class="text-decoration-none text-dark">My Account</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                    My Orders
                </li>
            </ol>
        </nav>
    </div>

    <!-- Main Account/Orders Layout Grid -->
    <div class="account-container">
        <div class="row g-4">

            <!-- Left Grid: Account Menu Side Panel -->
            <div class="col-md-4 col-lg-3">
                <div class="account-sidebar">
                    <div class="sidebar-header">My Account</div>
                    <ul class="sidebar-menu">
                    <li class="sidebar-item">
                        <a href="/profile">
                            <i class="fa-regular fa-user"></i>
                            Personal Information
                        </a>
                    </li>
                        <li class="sidebar-item"><a href="/address"><i class="fa-regular fa-address-book"></i>
                                Address</a></li>
                        <li class="sidebar-item active"><a href="/orders"><i class="fa-solid fa-box-archive"></i>
                                Order</a></li>
                        <li class="sidebar-item"><a href="/wallet"><i class="fa-regular fa-credit-card"></i>
                                Wallet</a></li>
                        <li class="sidebar-item"><a href="/coupons"><i class="fa-solid fa-ticket"></i>
                                Coupon</a></li>
                        <li class="sidebar-item">
                            <a href="/change-password">
                                <i class="fa-solid fa-user-gear"></i>
                                Password Change
                            </a>
                        </li>
                        <li class="sidebar-item"><a href="/logout"><i class="fa-solid fa-power-off"></i> Logout</a>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Right Grid: Orders Data Container -->
            <div class="col-md-8 col-lg-9">
                <div class="orders-panel">
                    <div class="orders-panel-header">
                        <h2 class="panel-title">My Orders</h2>

                        <div class="dropdown">
                            <button class="filter-dropdown-btn dropdown-toggle" type="button" id="timeframeFilter"
                                data-bs-toggle="dropdown" aria-expanded="false">
                                Last 6 months
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="timeframeFilter">
                                <li><a class="dropdown-menu-item px-3 py-1 text-dark text-decoration-none d-block small"
                                        href="?filter=3months">Last 3 months</a></li>
                                <li><a class="dropdown-menu-item px-3 py-1 text-dark text-decoration-none d-block small"
                                        href="?filter=6months">Last 6 months</a></li>
                                <li><a class="dropdown-menu-item px-3 py-1 text-dark text-decoration-none d-block small"
                                        href="?filter=2026">Year 2026</a></li>
                            </ul>
                        </div>
                    </div>

                    <!-- Column Headers -->
                    <div class="orders-table-header">
                        <div>Order ID</div>
                        <div>Items</div>
                        <div>Total Amount</div>
                        <div>Order Status</div>
                    </div>

                    <!-- Dynamic EJS Rows Loop Component -->
                    <% if(typeof orders !=='undefined' && orders.length> 0) { %>
                        <% orders.forEach(order=> { %>
                            <div class="order-row">
                                <div class="order-id-txt">
                                    <%= order.orderId %>
                                </div>
                                <div>
                                    <%= order.items.length %>
                                </div>
                                <div class="order-amount-txt">₹ <%= order.grandTotal %>
                                </div>
                                <div class="status-container">

                                    <div class="status-indicator-line">

                                        <span class="status-dot dot-<%= order.statusInfo.dot %>"></span>

                                        <%= order.statusInfo.title %>

                                            on

                                            <%= new Date(order.statusInfo.date).toLocaleDateString("en-IN") %>

                                    </div>

                                    <div class="status-subtitle">

                                        <%= order.statusInfo.message %>

                                    </div>

                                    <a href="/orders/<%= order._id %>" class="btn view-order-pill">
                                        View Details
                                    </a>

                                    <% if ( order.paymentMethod==="RAZORPAY" && ["Pending", "Failed"
                                        ].includes(order.paymentStatus) && !["Cancelled", "Returned"
                                        ].includes(order.orderStatus) ) { %>
                                        <a href="/payment-failed/<%= order._id %>" class="btn view-order-pill">
                                            Retry Payment
                                        </a>
                                        <% } %>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <!-- Fallback Placeholder matching layout aesthetics -->
                                    <div class="empty-orders">
                                        <i class="fa-solid fa-box-open fa-2x mb-3 opacity-50"></i>
                                        <p class="mb-0">You haven't placed any orders within this period.</p>
                                    </div>
                                    <% } %>

                                        <% if (totalPages> 1) { %>

                                            <div class="d-flex justify-content-center my-4">

                                                <nav>
                                                    <ul class="pagination">

                                                        <!-- Previous -->

                                                        <li
                                                            class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">

                                                            <a class="page-link"
                                                                href="/orders?page=<%= currentPage - 1 %>">

                                                                <i class="fa-solid fa-angle-left"></i>

                                                            </a>

                                                        </li>

                                                        <!-- Page Numbers -->

                                                        <% for(let i=1; i <=totalPages; i++) { %>

                                                            <li
                                                                class="page-item <%= currentPage === i ? 'active' : '' %>">

                                                                <a class="page-link" href="/orders?page=<%= i %>">

                                                                    <%= i %>

                                                                </a>

                                                            </li>

                                                            <% } %>

                                                                <!-- Next -->

                                                                <li
                                                                    class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">

                                                                    <a class="page-link"
                                                                        href="/orders?page=<%= currentPage + 1 %>">

                                                                        <i class="fa-solid fa-angle-right"></i>

                                                                    </a>

                                                                </li>

                                                    </ul>
                                                </nav>

                                            </div>

                                            <% } %>

                </div>
            </div>

        </div>
    </div>

    <!-- Footer Component -->
    <footer>
        <div class="row text-center footer-logo-container">
            <div class="col-12">
                <img src="/images/logo.png" alt="OneMore Footer Logo">
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-3">
                <h6 class="footer-heading">Support</h6>
                <ul class="list-unstyled footer-links">
                    <li><a href="#">Order Status</a></li>
                    <li><a href="#">Product Support</a></li>
                    <li><a href="#">Shipping & Return Policy</a></li>
                    <li><a href="#">Complaint Registration</a></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h6 class="footer-heading">About Us</h6>
                <ul class="list-unstyled footer-links">
                    <li><a href="/contact">Contact Us</a></li>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Terms of use</a></li>
                    <li><a href="#">FAQ</a></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h6 class="footer-heading">Contact</h6>
                <div class="footer-contact-text">Email: onemore@gmail.com</div>
                <div class="footer-contact-text">Phone: +91 8888888888</div>
            </div>
            <div class="col-md-3 text-md-end">
                <h6 class="footer-heading text-md-end">Connect with us</h6>
                <div class="social-icons">
