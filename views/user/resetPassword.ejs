<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Reset Password</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <!-- Font -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #0f0f0f;
      color: #fff;
      font-family: 'Poppins', sans-serif;
    }

    /* NAVBAR */
    .navbar {
      background: #0f0f0f;
      padding: 28px 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo-img {
      width: 60px;
    }

    .nav-links {
      display: flex;
      gap: 40px;
    }

    .nav-links a {
      color: #cfcfcf;
      text-decoration: none;
      font-size: 14px;
    }

    .icons {
      display: flex;
      gap: 25px;
    }

    .icons i {
      font-size: 18px;
      color: #ccc;
      cursor: pointer;
    }

    /* MAIN */
    .main {
      background: #dcdcdc;
      min-height: 70vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* CARD */
    .card {
      background: #efefef;
      border-radius: 20px;
      padding: 40px 30px;
      width: 360px;
      text-align: center;
      color: #000;
    }

    .card h2 {
      margin-bottom: 25px;
      font-weight: 500;
    }

    /* INPUT */
    .input-group {
      position: relative;
      margin-bottom: 10px;
    }

    .card input {
      width: 100%;
      padding: 12px;
      padding-right: 35px;
      border-radius: 10px;
      border: none;
      background: #cfcfcf;
      outline: none;
    }

    .toggle-eye {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      color: #555;
      font-size: 14px;
    }

    .toggle-eye:hover {
      color: #000;
    }

    /* BUTTON */
    .btn {
      margin-top: 10px;
      padding: 10px;
      width: 100%;
      background: #000;
      color: #fff;
      border-radius: 10px;
      border: none;
    }

    .error-msg {
      color: red;
      font-size: 12px;
      margin-bottom: 8px;
      text-align: left;
    }

    /* FOOTER */
    footer {
      background: #0f0f0f;
      padding: 50px 80px;
    }

    .footer-logo {
      display: flex;
      justify-content: center;
      margin-bottom: 30px;
    }

    .footer-logo img {
      width: 80px;
    }

    .footer-container {
      display: flex;
      justify-content: space-between;
    }

    .footer-section h4 {
      color: #fff;
      font-size: 14px;
      margin-bottom: 10px;
    }

    .footer-section p {
      font-size: 13px;
      color: #aaa;
    }

    .bottom {
      margin-top: 30px;
      font-size: 12px;
      color: #777;
    }
  </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar">
  <img src="/images/logo.png" class="logo-img">

  <div class="nav-links">
    <a href="/">Home</a>
    <a href="#">Shop</a>
    <a href="#">Contact Us</a>
    <a href="#">About Us</a>
  </div>

  <div class="icons">
    <a href="/login"><i class="fa-regular fa-user"></i></a>
    <i class="fa-regular fa-heart"></i>
    <i class="fa-solid fa-cart-shopping"></i>
  </div>
</nav>

<!-- MAIN -->
<div class="main">
  <div class="card">

    <h2>Reset Password</h2>

    <form id="resetForm" action="/reset-password" method="POST">

      <!-- PASSWORD -->
      <div class="input-group">
        <input type="password" id="password" name="password" placeholder="New Password">
        <i class="fa-solid fa-eye toggle-eye" onclick="togglePassword('password', this)"></i>
      </div>
      <div id="passError" class="error-msg"></div>

      <!-- CONFIRM PASSWORD -->
      <div class="input-group">
        <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password">
        <i class="fa-solid fa-eye toggle-eye" onclick="togglePassword('confirmPassword', this)"></i>
      </div>
      <div id="confirmError" class="error-msg"></div>

      <button type="submit" class="btn">Submit</button>

    </form>

  </div>
</div>

<!-- FOOTER -->
<footer>

  <div class="footer-logo">
    <img src="/images/logo.png">
  </div>

  <div class="footer-container">

    <div class="footer-section">
      <h4>SUPPORT</h4>
      <p>Order Status</p>
      <p>Product Support</p>
      <p>Shipping & Return Policy</p>
      <p>Complaint Registration</p>
    </div>

    <div class="footer-section">
      <h4>About Us</h4>
      <p>Contact Us</p>
      <p>Privacy Policy</p>
      <p>Terms of use</p>
      <p>FAQ</p>
    </div>

    <div class="footer-section">
      <h4>Contact</h4>
      <p>Email : onemore@gmail.com</p>
      <p>Phone : +91 8888888888</p>
    </div>

    <div class="footer-section">
      <h4>Connect with us</h4>
      <p>Instagram</p>
      <p>Facebook</p>
      <p>X</p>
    </div>

  </div>

  <div class="bottom">
    © 2025 onemore. All Rights Reserved.
  </div>

</footer>

<!-- JS -->
<script>
  const form = document.getElementById("resetForm");
  const password = document.getElementById("password");
  const confirmPassword = document.getElementById("confirmPassword");

  const passError = document.getElementById("passError");
  const confirmError = document.getElementById("confirmError");

  form.addEventListener("submit", function (e) {
    let valid = true;

    passError.textContent = "";
    confirmError.textContent = "";

    if (password.value.trim() === "") {
      passError.textContent = "Password is required";
      valid = false;
    }

    if (confirmPassword.value.trim() === "") {
      confirmError.textContent = "Confirm your password";
      valid = false;
    }

    if (password.value !== confirmPassword.value) {
      confirmError.textContent = "Passwords do not match";
      valid = false;
    }

    if (!valid) e.preventDefault();
  });

  function togglePassword(inputId, icon) {
    const input = document.getElementById(inputId);

    if (input.type === "password") {
      input.type = "text";
      icon.classList.replace("fa-eye", "fa-eye-slash");
    } else {
      input.type = "password";
      icon.classList.replace("fa-eye-slash", "fa-eye");
    }
  }
</script>

</body>
</html>