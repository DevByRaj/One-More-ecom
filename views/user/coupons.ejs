<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coupons | OneMore</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --dark: #242422;
            --dark-soft: #30302d;
            --lime: #d7f36b;
            --lime-hover: #c6e451;
            --page: #f4f4ee;
            --white: #ffffff;
            --text: #242422;
            --muted: #77776e;
            --border: #e8e8df;
            --danger: #c73d35;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            font-family: 'Poppins', sans-serif;
            color: var(--text);
            background: var(--page);
            font-size: 14px;
        }

        a {
            text-decoration: none;
        }

        button {
            font-family: inherit;
        }

        .profile-page-navbar {
            position: relative;
            z-index: 1000;
            background: var(--dark);
        }

        .profile-page-navbar nav,
        .profile-page-navbar .navbar {
            background-color: var(--dark) !important;
        }

        .profile-page-navbar .navbar a,
        .profile-page-navbar .navbar .nav-link,
        .profile-page-navbar .navbar i,
        .profile-page-navbar .navbar svg {
            color: #fff !important;
        }

        .profile-page-navbar .navbar a:hover,
        .profile-page-navbar .navbar .nav-link:hover {
            color: var(--lime) !important;
        }

        .container.mt-4 {
            width: 100%;
            max-width: 1170px;
            padding-right: 24px;
            padding-left: 24px;
            margin-top: 25px !important;
        }

        .breadcrumb {
            margin-bottom: 0;
            font-size: 12px;
        }

        .breadcrumb-item a {
            color: var(--muted);
            transition: color .18s ease;
        }

        .breadcrumb-item a:hover {
            color: var(--dark);
        }

        .breadcrumb-item.active {
            color: var(--text);
            font-weight: 500;
        }

        .account-container {
            width: 100%;
            max-width: 1120px;
            margin: 30px auto 58px;
            padding: 0 24px;
            flex: 1;
        }

        .account-container>.row {
            --bs-gutter-x: 24px;
            --bs-gutter-y: 20px;
        }

        .account-sidebar {
            height: fit-content;
            overflow: hidden;
            padding-bottom: 12px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--white);
            box-shadow: 0 5px 22px rgba(30, 30, 20, .035);
        }

        .sidebar-header {
            padding: 20px 20px 17px;
            border-bottom: 1px solid var(--border);
            color: #88887d;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-align: left;
            text-transform: uppercase;
        }

        .sidebar-menu {
            list-style: none;
            margin: 0;
            padding: 11px;
        }

        .sidebar-item a {
            display: flex;
            align-items: center;
            min-height: 44px;
            padding: 10px 12px;
            border-radius: 7px;
            color: #626259;
            font-size: 13px;
            font-weight: 400;
            line-height: 1.45;
            transition: background .18s ease, color .18s ease;
        }

        .sidebar-item i {
            width: 16px;
            flex: 0 0 16px;
            margin-right: 11px;
            color: #8b8b80;
            font-size: 14px;
            text-align: center;
        }

        .sidebar-item.active a {
            background: #f0f5dc;
            color: var(--dark);
            font-weight: 600;
        }

        .sidebar-item.active i,
        .sidebar-item a:hover i {
            color: var(--dark);
        }

        .sidebar-item a:hover {
            background: #f5f6ef;
            color: var(--dark);
        }

        .sidebar-item.logout a,
        .sidebar-item.logout i {
            color: var(--danger);
        }

        .coupon-container {
            min-width: 0;
            padding: 25px 24px 30px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--white);
            box-shadow: 0 5px 22px rgba(30, 30, 20, .035);
        }

        .coupon-title {
            margin: 0 0 20px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--border);
            color: var(--text);
            font-size: 21px;
            line-height: 1.4;
            font-weight: 600;
            letter-spacing: -.3px;
            text-align: left;
        }

        .coupon-list {
            width: 100%;
            margin: 0;
            border: 1px solid var(--border);
            border-radius: 9px;
            overflow: hidden;
            background: #fff;
        }

        .coupon-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 18px;
            padding: 18px;
            border-bottom: 1px solid var(--border);
            min-height: 100px;
        }

        .coupon-card:last-child {
            border-bottom: none;
        }

        .coupon-info {
            flex: 1 1 auto;
            min-width: 0;
        }

        .coupon-description {
            font-size: 13px;
            line-height: 1.6;
            color: #56564f;
            font-weight: 400;
            margin: 0;
            overflow-wrap: anywhere;
        }

        .coupon-validity {
            flex: 0 0 140px;
            min-width: 0;
            text-align: right;
            font-size: 12px;
            line-height: 1.5;
            color: var(--muted);
            font-weight: 500;
        }

        .coupon-code {
            display: inline-block;
            max-width: 100%;
            color: var(--dark);
            background: #fcfcf9;
            border: 1px dashed #b8b9aa;
            padding: 5px 11px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 8px;
            overflow-wrap: anywhere;
        }

        .coupon-discount {
            color: #248447;
            font-size: 14px;
            line-height: 1.5;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .coupon-minimum {
            font-size: 12px;
            line-height: 1.5;
            color: #686960;
            margin: 5px 0 0;
        }

        .copy-wrapper {
            position: relative;
            display: flex;
            align-items: center;
            flex: 0 0 auto;
        }

        .copy-btn {
            border: 1px solid var(--dark);
            background: var(--lime);
            color: var(--dark);
            padding: 10px 16px;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            cursor: pointer;
            transition: all .2s ease;
        }

        .copy-btn:hover {
            background: var(--lime-hover);
            transform: translateY(-1px);
        }

        .copy-btn.copied {
            background: #2563eb;
            border-color: #2563eb;
            color: #fff;
        }

        .copy-message {
            position: absolute;
            right: 100%;
            top: 50%;
            transform: translateY(-50%);
            margin-right: 10px;
            background: var(--dark);
            color: #fff;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 12px;
            white-space: nowrap;
            z-index: 9999;
        }

        .no-coupons {
            text-align: center;
            padding: 45px 20px;
            color: var(--muted);
        }

        .no-coupons i {
            display: block;
            font-size: 36px;
            margin-bottom: 14px;
            color: #b6b7aa;
        }

        .no-coupons p {
            font-size: 16px;
            font-weight: 600;
            color: var(--dark);
        }

        .no-coupons small {
            font-size: 13px;
        }

        footer {
            margin-top: auto;
            padding: 38px 24px 18px;
            border-top: 1px solid #353530;
            background: var(--dark);
            color: #fff;
        }

        footer>.row,
        footer>.text-center {
            max-width: 1180px;
            margin-right: auto;
            margin-left: auto;
        }

        .footer-logo-container {
            margin-bottom: 28px;
        }

        .footer-logo-container img {
            width: 68px;
            max-width: 100%;
            height: auto;
            object-fit: contain;
        }

        .footer-heading {
            margin-bottom: 13px;
            color: #fff;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .footer-links li {
            margin-bottom: 8px;
        }

        .footer-links a {
            color: #aaa99f;
            font-size: 11px;
            line-height: 1.6;
            transition: color .18s ease;
        }

        .footer-links a:hover {
            color: var(--lime);
        }

        .footer-contact-text {
            margin-bottom: 9px;
            color: #aaa99f;
            font-size: 11px;
            overflow-wrap: anywhere;
        }

        .social-icons a {
            margin-right: 13px;
            color: #c8c8bf;
            font-size: 17px;
            transition: color .18s ease;
        }

        .social-icons a:hover {
            color: var(--lime);
        }

        .copyright {
            margin-top: 25px;
            padding-top: 17px;
            border-top: 1px solid rgba(255, 255, 255, .12);
            color: #88887e;
            font-size: 11px;
        }

        @media (max-width: 991.98px) {
            .account-container {
                max-width: 820px;
            }

            .account-container>.row {
                --bs-gutter-x: 18px;
            }

            .coupon-container {
                padding: 22px;
            }

            .coupon-card {
                gap: 14px;
                padding: 16px;
            }

            .coupon-validity {
                flex-basis: 120px;
            }

            .copy-btn {
                padding: 9px 12px;
            }
        }

        @media (max-width: 767.98px) {
            .container.mt-4 {
                margin-top: 18px !important;
                padding-right: 16px;
                padding-left: 16px;
            }

            .account-container {
                max-width: 600px;
                margin: 24px auto 38px;
                padding: 0 16px;
            }

            .sidebar-header {
                padding: 16px 17px 13px;
            }

            .sidebar-menu {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 5px;
                padding: 10px;
            }

            .sidebar-item a {
                min-height: 42px;
                padding: 9px 10px;
            }

            .sidebar-item i {
                margin-right: 8px;
            }

            .coupon-container {
                padding: 22px 18px 24px;
            }

            .coupon-title {
                font-size: 20px;
                margin-bottom: 18px;
                padding-bottom: 14px;
            }

            .coupon-card {
                display: grid;
                grid-template-columns: minmax(0, 1fr) auto;
                align-items: start;
                gap: 12px;
                padding: 16px;
            }

            .coupon-info {
                grid-column: 1 / -1;
                width: 100%;
            }

            .coupon-validity {
                grid-column: 1;
                grid-row: 2;
                text-align: left;
                align-self: center;
                font-size: 12px;
                flex-basis: auto;
            }

            .copy-wrapper {
                grid-column: 2;
                grid-row: 2;
                justify-self: end;
                align-self: center;
            }

            .copy-message {
                right: auto;
                left: 50%;
                top: auto;
                bottom: calc(100% + 8px);
                transform: translateX(-50%);
                margin-right: 0;
                font-size: 11px;
            }

            footer {
                padding: 30px 18px 17px;
            }

            .footer-logo-container {
                margin-bottom: 24px;
            }

            .footer-heading {
                font-size: 10px;
            }

            .footer-links a,
            .footer-contact-text {
                font-size: 11px;
            }

            .social-icons {
                display: flex;
                justify-content: flex-start;
                margin-top: 12px;
            }
        }

        @media (max-width: 480px) {
            .container.mt-4 {
                padding-right: 12px;
                padding-left: 12px;
            }

            .account-container {
                padding: 0 12px;
            }

            .coupon-container {
                padding: 18px 13px 20px;
            }

            .coupon-title {
                font-size: 19px;
            }

            .coupon-card {
                padding: 14px 12px;
                gap: 10px;
            }

            .coupon-code {
                font-size: 13px;
            }

            .coupon-discount {
                font-size: 13px;
            }

            .coupon-description {
                font-size: 12px;
            }

            .coupon-minimum {
                font-size: 11px;
            }

            .coupon-validity {
                font-size: 11px;
            }

            .copy-btn {
                padding: 9px 10px;
                font-size: 11px;
            }

            .sidebar-menu {
                grid-template-columns: minmax(0, 1fr);
            }

            .sidebar-item a {
                font-size: 13px;
            }

            footer {
                padding-right: 14px;
                padding-left: 14px;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                animation-duration: .01ms !important;
                transition-duration: .01ms !important;
            }
        }
    </style>
</head>

<body>
    <div class="profile-page-navbar">
        <%- include("../partials/navbar") %>
    </div>

    <div class="container mt-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                <li class="breadcrumb-item"><a href="/profile">My Account</a></li>
                <li class="breadcrumb-item active" aria-current="page">Coupons</li>
            </ol>
        </nav>
    </div>

    <div class="account-container">
        <div class="row">
            <div class="col-md-4 col-lg-3">
                <div class="account-sidebar">
                    <div class="sidebar-header">My Account</div>
                    <ul class="sidebar-menu">
                        <li class="sidebar-item"><a href="/profile"><i class="fa-regular fa-user"></i>Personal
                                Information</a></li>
                        <li class="sidebar-item"><a href="/address"><i
                                    class="fa-regular fa-address-book"></i>Address</a></li>
                        <li class="sidebar-item"><a href="/orders"><i class="fa-solid fa-box-archive"></i>Order</a></li>
                        <li class="sidebar-item"><a href="/wallet"><i class="fa-regular fa-credit-card"></i>Wallet</a>
                        </li>
                        <li class="sidebar-item active"><a href="/coupons"><i class="fa-solid fa-ticket"></i>Coupon</a>
                        </li>
                        <li class="sidebar-item"><a href="/change-password"><i
                                    class="fa-solid fa-user-gear"></i>Password Change</a></li>
                        <li class="sidebar-item logout"><a href="/logout"><i
                                    class="fa-solid fa-power-off"></i>Logout</a></li>
                    </ul>
                </div>
            </div>
            <div class="col-md-8 col-lg-9">
                <div class="coupon-container">
                    <h2 class="coupon-title">Available Coupons</h2>
                    <div class="coupon-list">
                        <% if (coupons && coupons.length> 0) { %>

                            <% coupons.forEach(coupon=> { %>

                                <div class="coupon-card">

                                    <!-- Coupon information -->

                                    <div class="coupon-info">

                                        <div class="coupon-code">
                                            <%= coupon.couponCode %>
                                        </div>

                                        <div class="coupon-discount">
                                            Grab upto
                                            <%= coupon.discountType==="PERCENTAGE" ? coupon.discountValue + "%" : "₹" +
                                                coupon.discountValue %>
                                                off
                                        </div>

                                        <p class="coupon-description">
                                            <%= coupon.description || "Save more on your purchase with this coupon." %>
                                        </p>

                                        <p class="coupon-minimum">
                                            Min. purchase ₹<%= coupon.minimumPurchase %>
                                        </p>

                                        <% if (coupon.discountType==="PERCENTAGE" && coupon.maximumDiscount) { %>
                                            <p class="coupon-minimum">
                                                Max discount ₹<%= coupon.maximumDiscount %>
                                            </p>
                                            <% } %>

                                    </div>


                                    <!-- Validity -->

                                    <div class="coupon-validity">

                                        Valid till
                                        <%= new Date(coupon.endDate).toLocaleDateString('en-GB', { day: '2-digit' ,
                                            month: 'short' , year: 'numeric' }) %>

                                    </div>


                                    <!-- Copy button -->

                                    <div class="copy-wrapper">

                                        <button type="button" class="copy-btn" data-code="<%= coupon.couponCode %>"
                                            onclick="copyCoupon(this)">

                                            COPY CODE

                                        </button>

                                    </div>

                                </div>

                                <% }) %>


                                    <% } else { %>

                                        <div class="no-coupons">

                                            <i class="fa-solid fa-ticket"></i>

                                            <p class="mb-1">
                                                No coupons available
                                            </p>

                                            <small>
                                                Check back later for new offers.
                                            </small>

                                        </div>

                                        <% } %>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer>
        <div class="row text-center footer-logo-container">
            <div class="col-12"><img src="/images/logo.png" alt="OneMore Footer Logo"></div>
        </div>
        <div class="row g-4">
            <div class="col-md-3">
                <h6 class="footer-heading">Support</h6>
                <ul class="list-unstyled footer-links">
                    <li><a href="/order-status">Order Status</a></li>
                    <li><a href="/product-support">Product Support</a></li>
                    <li><a href="/shipping-policy">Shipping &amp; Return Policy</a></li>
                    <li><a href="/complaints">Complaint Registration</a></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h6 class="footer-heading">About Us</h6>
                <ul class="list-unstyled footer-links">
                    <li><a href="/contact">Contact Us</a></li>
                    <li><a href="/privacy">Privacy Policy</a></li>
                    <li><a href="/terms">Terms of use</a></li>
                    <li><a href="/faq">FAQ</a></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h6 class="footer-heading">Contact</h6>
                <div class="footer-contact-text">Email: onemore@gmail.com</div>
                <div class="footer-contact-text">Phone: +91 8888888888</div>
            </div>
            <div class="col-md-3 text-md-end">
                <h6 class="footer-heading text-md-end">Connect with us</h6>
                <div class="social-icons">
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-x-twitter"></i></a>
                </div>
            </div>
        </div>
        <div class="text-center copyright">© 2026 OneMore. All Rights Reserved.</div>
    </footer>

    <script>

        function copyCoupon(button) {

            const couponCode = button.dataset.code;

            navigator.clipboard.writeText(couponCode)
                .then(() => {

                    const originalText = button.innerText;

                    button.innerText = "COPIED!";
                    button.classList.add("copied");

                    const message = document.createElement("div");

                    message.className = "copy-message";
                    message.textContent = `Coupon ${couponCode} copied!`;

                    button.parentElement.appendChild(message);

                    setTimeout(() => {
                        message.remove();
                    }, 2000);

                    setTimeout(() => {
                        button.innerText = originalText;
                        button.classList.remove("copied");
                    }, 1500);
                })
                .catch(error => {

                    console.error("Failed to copy coupon:", error);

                });

        }

    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>