<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>address</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style>
  body {
    font-family: 'Poppins', sans-serif;
    background: #1a1a1a;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── NAVBAR ── */
nav {
  background: #1a1a1a;
  border-bottom: 1px solid rgba(255,255,255,0.06);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-inner {
  display: flex;
  height: 90px;
  align-items: center;
  justify-content: space-between;
  padding: 14px 32px;
}

.logo-img {
  width: 80px;
}

.nav-links {
  display: flex;
  gap: 36px;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.nav-links a {
  font-size: 14px;
  color: #ccc;
  text-decoration: none;
}

.nav-links a:hover {
  color: #fff;
}

.nav-icons {
  display: flex;
  gap: 18px;
}

.nav-icons svg {
  width: 22px;
  height: 22px;
  stroke: #ccc;
  fill: none;
}
   .logo-img {
   width: 80px;     /* adjust size */
   height: auto;
   object-fit: contain;
  }

  /* ── MAIN ── */
  main {
    flex: 1;
    background: #f0f0eb;
    padding: 28px 32px;
  }

  /* ── LAYOUT ── */
  .page-layout {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 20px;
    max-width: 820px;
    margin: 0 auto;
  }

  /* ── SIDEBAR ── */
  .sidebar {
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 10px;
    padding: 18px 0 14px;
    height: fit-content;
  }
  .sidebar-title {
    font-size: 12px; font-weight: 600;
    color: #1a1a1a; padding: 0 18px 14px;
    border-bottom: 1px solid #eee;
    letter-spacing: 0.3px;
  }
  .menu-item {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 18px;
    font-size: 12px; font-weight: 400; color: #444;
    cursor: pointer; transition: background 0.15s, color 0.15s;
  }
  .menu-item:hover { background: #f5f5f5; color: #1a1a1a; }
  .menu-item.active { color: #1a1a1a; font-weight: 500; }
  .menu-item svg {
    width: 14px; height: 14px;
    stroke: #888; fill: none; stroke-width: 1.6; flex-shrink: 0;
  }
  .menu-item.active svg, .menu-item:hover svg { stroke: #1a1a1a; }
  .menu-item.logout { color: #c0392b; }
  .menu-item.logout svg { stroke: #c0392b; }
  .menu-item.logout:hover { background: #fff5f5; }

  /* ── PANEL ── */
  .panel {
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 10px;
    padding: 22px 24px 28px;
  }
  .panel-title {
    font-size: 14px; font-weight: 500;
    color: #1a1a1a; text-align: center;
    margin-bottom: 18px;
  }

  /* ── ADD NEW ADDRESS BUTTON ── */
  .add-btn {
    background: #3a8c4a;
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: 11px; font-weight: 500;
    border: none; border-radius: 5px;
    padding: 7px 14px;
    cursor: pointer;
    display: inline-flex; align-items: center; gap: 5px;
    margin-bottom: 16px;
    transition: background 0.2s;
  }
  .add-btn:hover { background: #2e7a3e; }
  .add-btn span { font-size: 14px; line-height: 1; }

  /* ── ADDRESS CARDS ── */
  .address-card {
    background: #f5f5f2;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 14px 16px;
    margin-bottom: 12px;
    position: relative;
    transition: border-color 0.2s;
  }
  .address-card:hover { border-color: #bbb; }
  .address-card:last-child { margin-bottom: 0; }

  .addr-header {
    display: flex; align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .addr-name {
    font-size: 12px; font-weight: 600;
    color: #1a1a1a; margin-right: 10px;
  }
  .addr-phone {
    font-size: 12px; font-weight: 400; color: #444;
  }

  .addr-body {
    font-size: 11px; font-weight: 300;
    color: #555; line-height: 1.6;
  }

  /* three-dot menu */
  .addr-menu-btn {
    background: none; border: none;
    cursor: pointer; padding: 2px 6px;
    border-radius: 4px; color: #888;
    font-size: 16px; line-height: 1;
    transition: background 0.15s;
    position: relative;
  }
  .addr-menu-btn:hover { background: #eee; color: #333; }

  .addr-dropdown {
    position: absolute; top: 32px; right: 0;
    background: #fff; border: 1px solid #ddd;
    border-radius: 6px; box-shadow: 0 4px 16px rgba(0,0,0,0.10);
    min-width: 120px; z-index: 50;
    display: none; overflow: hidden;
  }
  .addr-dropdown.open { display: block; }
  .addr-dropdown a {
    display: block; padding: 9px 14px;
    font-size: 12px; color: #333;
    text-decoration: none; cursor: pointer;
    transition: background 0.15s;
  }
  .addr-dropdown a:hover { background: #f5f5f5; }
  .addr-dropdown a.del { color: #c0392b; }
  .addr-dropdown a.del:hover { background: #fff5f5; }

  .error-text {
  color: red;
  font-size: 11px;
  margin-top: 3px;
  display: block;
}

.input-error {
  border-color: red !important;
}

  /* ── MODAL ── */
  .modal-content {
    border-radius: 12px; border: 1px solid #ddd;
    font-family: 'Poppins', sans-serif;
  }
  .modal-title { font-size: 14px; font-weight: 600; }
  .modal-body label {
    font-size: 11px; font-weight: 500;
    color: #555; margin-bottom: 4px;
    text-transform: capitalize; letter-spacing: 0.2px;
  }
  .modal-body input,
  .modal-body select {
    font-family: 'Poppins', sans-serif;
    font-size: 12px; border-radius: 6px;
    border: 1.5px solid #d0d0cc;
    padding: 9px 12px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .modal-body input:focus,
  .modal-body select:focus {
    border-color: #888;
    box-shadow: 0 0 0 3px rgba(0,0,0,0.06);
    outline: none;
  }
  .btn-save {
    background: #1a1a1a; color: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: 13px; font-weight: 500;
    border: none; border-radius: 6px;
    padding: 10px 32px;
    transition: background 0.2s;
  }
  .btn-save:hover { background: #333; color: #fff; }

  /* ── EMPTY STATE ── */
  .empty-state {
    text-align: center; padding: 40px 0;
    color: #aaa; font-size: 13px;
  }

  /* ── FOOTER ── */
  footer { background: #1a1a1a; color: #fff; }
  .footer-logo svg { width: 64px; height: 52px; }
  .footer-col-title {
    font-size: 11px; font-weight: 700;
    letter-spacing: 0.4px; text-transform: uppercase;
    margin-bottom: 12px;
  }
  .footer-col a {
    display: block; font-size: 11px;
    font-weight: 300; color: #aaa;
    text-decoration: none; margin-bottom: 6px;
    transition: color 0.2s;
  }
  .footer-col a:hover { color: #fff; }
  .contact-label { font-size: 11px; color: #fff; font-weight: 500; }
  .contact-val   { font-size: 11px; color: #aaa; margin-left: 3px; }
  .social-icon {
    width: 18px; height: 18px; fill: #ccc;
    cursor: pointer; transition: fill 0.2s;
  }
  .social-icon:hover { fill: #fff; }
  .footer-divider { border-color: rgba(255,255,255,0.07); }
  .footer-copy { font-size: 10.5px; color: #555; font-weight: 300; }

  /* ── TOAST ── */
  #toast {
    position: fixed; bottom: 24px; right: 24px;
    background: #1a1a1a; color: #fff;
    font-size: 12px; padding: 11px 20px;
    border-radius: 6px; display: none;
    border: 1px solid #444; z-index: 9999;
    font-family: 'Poppins', sans-serif;
    animation: fadeUp 0.25s ease;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>
</head>
<body>

<div id="toast"></div>

<!-- ── NAVBAR ── -->
<nav>
  <div class="nav-inner">

    <!-- LOGO -->
    <div class="nav-logo">
      <img src="/images/logo.png" class="logo-img">
    </div>

    <!-- CENTER LINKS -->
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/shop">Shop</a>
      <a href="/contact">Contact Us</a>
      <a href="/about">About Us</a>
    </div>

    <!-- RIGHT ICONS -->
    <div class="nav-icons">
      <a href="/profile">
        <svg viewBox="0 0 24 24">
          <circle cx="12" cy="7" r="4"/>
          <path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>
        </svg>
      </a>
      
      <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      
    </div>

  </div>
</nav>

<!-- ── MAIN ── -->
<main>
  <div class="page-layout">

    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-title">My Account</div>

      <a href="/profile" style="text-decoration:none;">
  <div class="menu-item">
    <svg viewBox="0 0 24 24">
      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
      <polyline points="9 22 9 12 15 12 15 22"/>
    </svg>
    Personal Information
  </div>
</a>
      
      <div class="menu-item active" onclick="setActive(this)">
        <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Address
      </div>
      <div class="menu-item" onclick="setActive(this)">
        <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3H8a2 2 0 0 0-2 2v2h12V5a2 2 0 0 0-2-2z"/></svg>
        Order
      </div>
      <div class="menu-item" onclick="setActive(this)">
        <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
        Wallet
      </div>
      <div class="menu-item" onclick="setActive(this)">
        <svg viewBox="0 0 24 24"><path d="M7 7h10l1 10H6L7 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
        Coupon
      </div>
      <div class="menu-item" onclick="setActive(this)">
        <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        Password Change
      </div>
      <a href="/logout" class="menu-item logout">
  <svg viewBox="0 0 24 24">
    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
    <polyline points="16 17 21 12 16 7"/>
    <line x1="21" y1="12" x2="9" y2="12"/>
  </svg>
  Logout
</a>
    </aside>

    <!-- ADDRESS PANEL -->
    <div class="panel">
      <div class="panel-title">Address</div>

      <!-- Add New Address -->
      <button class="add-btn"
  <% if(addresses.length >= 3){ %> disabled <% } %>
  data-bs-toggle="modal" data-bs-target="#addAddressModal">
        <span>+</span> Add New Address
      </button>
      <% if(error === "limit"){ %>
  <div class="alert alert-danger py-2">
    Only 3 addresses allowed
  </div>
<% } %>

<% if(error === "empty"){ %>
  <div class="alert alert-danger py-2">
    All fields are required
  </div>
<% } %>

      <!-- Address List -->
      <div id="address-list">

<% if(addresses.length === 0){ %>
  <div class="empty-state">No addresses saved yet.</div>
<% } %>

<% addresses.forEach((addr, i) => { %>

  <div class="address-card">
    <div class="addr-header">
      <div>
        <span class="addr-name"><%= addr.name || "No Name" %>
        <% if(addr.isDefault){ %>
    <span style="color:green; font-size:10px;">(Default)</span>
  <% } %>
        </span>
        <span class="addr-phone"><%= addr.phone || "" %></span>
      </div>

      <div class="position-relative">
        <button class="addr-menu-btn" onclick="toggleMenu('menu-<%= i %>')">⋮</button>

        <div class="addr-dropdown" id="menu-<%= i %>">
          <a onclick="editAddress('<%= addr._id %>')">Edit</a>
          <a onclick="setDefault('<%= addr._id %>')">Set Default</a>
          <a class="del" onclick="openDeleteModal('<%= addr._id %>')">Delete</a>
        </div>
      </div>
    </div>

    <div class="addr-body">
      <%= addr.houseName %>, <%= addr.street %>,<br>
      <%= addr.city %>, <%= addr.state %> – <%= addr.pincode %>
    </div>
  </div>

<% }) %>



</div>
    </div>

  </div>
</main>

<!-- ── ADD / EDIT ADDRESS MODAL ── -->
<div class="modal fade" id="addAddressModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0">
        <h6 class="modal-title" id="modalLabel">Add New Address</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <form id="addressForm" action="/address/add" method="POST" novalidate>
        <input type="hidden" name="addressId" id="addressId">
        <input type="text" name="fakeusernameremembered" style="display:none">
        <input type="password" name="fakepasswordremembered" style="display:none">
      <div class="modal-body pt-3">
        <input type="hidden" id="edit-index" value="">
        <div class="row g-3">
          <div class="col-6">
            <label>First Name</label>
            <input type="text" class="form-control" id="a-fname" name="fname" placeholder="First name" required autocomplete="new-password">
            <small class="error-text" id="err-fname"></small>
          </div>
          <div class="col-6">
            <label>Last Name</label>
            <input type="text" class="form-control" id="a-lname" name="lname" placeholder="Last name" required autocomplete="new-password">
            <small class="error-text" id="err-lname"></small>
          </div>
          <div class="col-12">
  <label>Phone</label>
  <input type="tel" class="form-control" id="a-phone" name="phone" maxlength="10">
  <small class="error-text" id="err-phone"></small>
</div>
          <div class="col-12">
            <label>House / Flat / Building</label>
            <input type="text" class="form-control" id="a-house" name="house" placeholder="House no., Building name" required autocomplete="new-password">
            <small class="error-text" id="err-house"></small>
          </div>
          <div class="col-12">
            <label>Street / Area</label>
            <input type="text" class="form-control" id="a-street" name="street" placeholder="Street, locality, area" required autocomplete="new-password">
            <small class="error-text" id="err-street"></small>
          </div>
          <div class="col-6">
            <label>City</label>
            <input type="text" class="form-control" id="a-city" name="city" placeholder="City" required autocomplete="new-password">
            <small class="error-text" id="err-city"></small>
          </div>
          <div class="col-6">
            <label>State</label>
            <input type="text" class="form-control" id="a-state" name="state" placeholder="State" required autocomplete="new-password">
          <small class="error-text" id="err-state"></small>
          </div>
          <div class="col-6">
            <label>PIN Code</label>
            <input type="text" id="a-pin" name="pin"
            inputmode="numeric"
            pattern="[0-9]{6}" maxlength="6"
            placeholder="6-digit PIN"
            required autocomplete="new-password">
            <small class="error-text" id="err-pin"></small>
          </div>
          <div class="col-6">
            <label>Address Type</label>
            <select class="form-select" id="a-type" name="type">
              <option value="Home">Home</option>
              <option value="Work">Work</option>
              <option value="Other">Other</option>
            </select>
          </div>
        </div>
      </div>
      <div class="modal-footer border-0 pt-1">
  <button type="submit" class="btn-save btn">Save Address</button>
</div>
</form>
    </div>
  </div>
</div>

<div class="modal fade" id="deleteModal">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content p-3">
      <h6>Delete Address?</h6>
      <p>Are you sure delete this address</p>

      <form id="deleteForm" method="POST">
        <button class="btn btn-danger w-100">Delete</button>
      </form>
    </div>
  </div>
</div>

<!-- ── FOOTER ── -->
<footer class="pt-4 pb-3">
  <div class="container-fluid px-5">
    <div class="d-flex justify-content-center mb-4 footer-logo">
      <!-- FOOTER LOGO — replace SVG to change logo -->
       <div class="footer-logo">
  <img src="/images/logo.png" class="logo-img">
</div>
    </div>
    <div class="row mb-4">
      <div class="col-12 col-md-3 footer-col">
        <div class="footer-col-title">SUPPORT</div>
        <a href="#">Order Status</a>
        <a href="#">Product Support</a>
        <a href="#">Shipping &amp; Return Policy</a>
        <a href="#">Complaint Registration</a>
      </div>
      <div class="col-12 col-md-3 footer-col">
        <div class="footer-col-title">About Us</div>
        <a href="#">Contact Us</a>
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of use</a>
        <a href="#">FAQ</a>
      </div>
      <div class="col-12 col-md-3 footer-col">
        <div class="footer-col-title">Contact</div>
        <div class="mb-1">
          <span class="contact-label">Email :</span>
          <span class="contact-val">onemore@gmail.com</span>
        </div>
        <div>
          <span class="contact-label">Phone :</span>
          <span class="contact-val">+91 8888888888</span>
        </div>
      </div>
      <div class="col-12 col-md-3 footer-col">
        <div class="footer-col-title">Connect with us</div>
        <div class="d-flex gap-3 mt-1">
          <svg class="social-icon" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          <svg class="social-icon" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          <svg class="social-icon" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </div>
      </div>
    </div>
    <hr class="footer-divider">
    <p class="footer-copy mb-0">© 2025 onemore . All Rights Reserved.</p>
  </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>


  /* ── TOGGLE DROPDOWN MENU ── */
  function toggleMenu(id) {
    document.querySelectorAll('.addr-dropdown').forEach(d => {
      if (d.id !== id) d.classList.remove('open');
    });
    document.getElementById(id).classList.toggle('open');
  }
  document.addEventListener('click', e => {
    if (!e.target.closest('.addr-menu-btn')) {
      document.querySelectorAll('.addr-dropdown').forEach(d => d.classList.remove('open'));
    }
  });


  /* ── CLEAR FORM ── */
  function clearForm() {
    ['a-fname','a-lname','a-phone','a-house','a-street','a-city','a-state','a-pin']
      .forEach(id => document.getElementById(id).value = '');
    document.getElementById('a-type').value = 'Home';
    document.getElementById('edit-index').value = '';
    document.getElementById('modalLabel').textContent = 'Add New Address';
  }

  /* reset form when modal closes */
  document.getElementById('addAddressModal').addEventListener('hidden.bs.modal', clearForm);

  /* ── SIDEBAR ACTIVE ── */
  function setActive(el) {
    document.querySelectorAll('.menu-item:not(.logout)').forEach(i => i.classList.remove('active'));
    el.classList.add('active');
  }

  /* ── TOAST ── */
  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.style.display = 'block';
    clearTimeout(t._tid);
    t._tid = setTimeout(() => t.style.display = 'none', 2500);
  }

  document.getElementById("addressForm").addEventListener("keydown", function(e) {
  if (e.key === "Enter") e.preventDefault();
});

const form = document.getElementById("addressForm");

form.addEventListener("submit", function(e) {
  e.preventDefault();

  let isValid = true;

  // CLEAR OLD ERRORS
  document.querySelectorAll(".error-text").forEach(el => el.textContent = "");
  document.querySelectorAll(".form-control").forEach(el => el.classList.remove("input-error"));

  const fname = form.fname.value.trim();
  const lname = form.lname.value.trim();
  const phone = form.phone.value.trim();
  const house = form.house.value.trim();
  const street = form.street.value.trim();
  const city = form.city.value.trim();
  const state = form.state.value.trim();
  const pin = form.pin.value.trim();

  // FIRST NAME
  if (!fname) {
    showError("a-fname", "First name required");
    isValid = false;
  }

  // LAST NAME
  if (!lname) {
    showError("a-lname", "Last name required");
    isValid = false;
  }

  // PHONE
  if (!/^\d{10}$/.test(phone)) {
    showError("a-phone", "Enter valid 10 digit number");
    isValid = false;
  }

  // HOUSE
  if (!house) {
    showError("a-house", "House required");
    isValid = false;
  }

  // STREET
  if (!street) {
    showError("a-street", "Street required");
    isValid = false;
  }

  // CITY
  if (!city) {
    showError("a-city", "City required");
    isValid = false;
  }

  // STATE
  if (!state) {
    showError("a-state", "State required");
    isValid = false;
  }

  // PIN
  if (!/^\d{6}$/.test(pin)) {
    showError("a-pin", "Enter valid 6 digit pincode");
    isValid = false;
  }

  // FINAL SUBMIT
  if (isValid) {
    form.submit();
  }
});

function showError(inputId, message) {
  const input = document.getElementById(inputId);
  const error = document.getElementById("err-" + inputId.split("-")[1]);

  input.classList.add("input-error");
  if (error) error.textContent = message;
}

setTimeout(() => {
  document.querySelectorAll('input').forEach(input => {
    input.setAttribute('autocomplete', 'off');
    input.setAttribute('readonly', true);

    setTimeout(() => {
      input.removeAttribute('readonly');
    }, 100);
  });
}, 100);

function editAddress(id){
  fetch(`/address/${id}`)
  .then(res =>res.json())
  .then(data =>{

    document.getElementById("addressId").value = data._id

    const names = data.name.split(" ")
    document.getElementById("a-fname").value = names[0] || "";
document.getElementById("a-lname").value = names.slice(1).join(" ") || "";

    document.getElementById("a-phone").value = data.phone;
    document.getElementById("a-house").value = data.houseName;
    document.getElementById("a-street").value = data.street;
    document.getElementById("a-city").value = data.city;
    document.getElementById("a-state").value = data.state;
    document.getElementById("a-pin").value = data.pincode;
    document.getElementById("a-type").value = data.type;

    document.getElementById("modalLabel").textContent = "Edit Address";

      new bootstrap.Modal(document.getElementById('addAddressModal')).show();
  })
}

function openDeleteModal(id) {
  document.getElementById("deleteForm").action = "/address/delete/" + id;
  new bootstrap.Modal(document.getElementById('deleteModal')).show();
}

function setDefault(id) {
  window.location.href = "/address/default/" + id;
}

</script>
</body>
</html>