<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>address</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
  <style>
    :root {
      --dark: #242422;
      --dark-soft: #30302d;
      --lime: #d7f36b;
      --lime-hover: #c6e451;
      --page: #f4f4ee;
      --white: #ffffff;
      --text: #242422;
      --muted: #77776e;
      --border: #e8e8df;
      --danger: #c73d35;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      font-family: 'Poppins', sans-serif;
      color: var(--text);
      background: var(--page);
    }

    a {
      text-decoration: none;
    }

    button,
    input,
    select {
      font-family: inherit;
    }

    /* This wrapper keeps navbar styling limited to this page. */
    .profile-page-navbar {
      position: relative;
      z-index: 1000;
      background: var(--dark);
    }

    .profile-page-navbar nav,
    .profile-page-navbar .navbar {
      background-color: var(--dark) !important;
    }

    .profile-page-navbar .navbar a,
    .profile-page-navbar .navbar .nav-link,
    .profile-page-navbar .navbar i,
    .profile-page-navbar .navbar svg {
      color: #fff !important;
    }

    .profile-page-navbar .navbar a:hover,
    .profile-page-navbar .navbar .nav-link:hover {
      color: var(--lime) !important;
    }

    .profile-page-navbar img {
      object-fit: contain;
    }

    .address-breadcrumb {
    max-width: 1170px;
    padding: 0 24px;
    margin-top: 25px !important;
}

.address-breadcrumb .breadcrumb {
    font-size: 11px;
}

.address-breadcrumb .breadcrumb-item a {
    color: #77776e;
    text-decoration: none;
    transition: color .18s ease;
}

.address-breadcrumb .breadcrumb-item a:hover {
    color: #242422;
}

.address-breadcrumb .breadcrumb-item.active {
    color: #242422;
    font-weight: 500;
}

@media (max-width: 480px) {
    .address-breadcrumb {
        padding-right: 12px;
        padding-left: 12px;
        margin-top: 18px !important;
    }
}

    main {
      flex: 1;
      padding: 45px 24px 65px;
      background:
        radial-gradient(ellipse at 8% 0%, rgba(215, 243, 107, 0.18), transparent 30%),
        var(--page);
    }

    .account-heading {
      max-width: 1120px;
      margin: 0 auto 30px;
    }

    .account-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      margin-bottom: 10px;
      color: #737367;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .account-eyebrow::before {
      content: "";
      display: inline-block;
      width: 23px;
      height: 3px;
      background: var(--lime-hover);
    }

    .account-heading h1 {
      margin: 0;
      font-size: clamp(25px, 3vw, 34px);
      font-weight: 600;
      letter-spacing: -1.2px;
      color: var(--text);
    }

    .account-heading p {
      margin: 9px 0 0;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.7;
    }

    .page-layout {
      display: grid;
      grid-template-columns: 245px minmax(0, 1fr);
      align-items: start;
      gap: 25px;
      max-width: 1120px;
      margin: 0 auto;
      width: 100%;
    }

    .sidebar {
      overflow: hidden;
      height: fit-content;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 5px 22px rgba(30, 30, 20, 0.035);
    }

    .sidebar-title {
      margin: 0;
      padding: 22px 20px 18px;
      border-bottom: 1px solid var(--border);
      color: #88887d;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1.5px;
      text-transform: uppercase;
    }

    .sidebar-menu {
      display: flex;
      flex-direction: column;
      gap: 4px;
      padding: 12px;
    }

    .menu-item {
      display: flex;
      align-items: center;
      gap: 11px;
      min-width: 0;
      padding: 12px 13px;
      border-radius: 7px;
      color: #626259;
      font-size: 12px;
      font-weight: 400;
      line-height: 1.45;
      cursor: pointer;
      transition: background .18s ease, color .18s ease;
    }

    .menu-item:hover {
      background: #f5f6ef;
      color: var(--dark);
    }

    .menu-item.active {
      background: #f0f5dc;
      color: var(--dark);
      font-weight: 600;
    }

    .menu-item svg {
      width: 16px;
      height: 16px;
      flex: 0 0 16px;
      fill: none;
      stroke: #8b8b80;
      stroke-width: 1.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .menu-item.active svg,
    .menu-item:hover svg {
      stroke: var(--dark);
    }

    .menu-item.logout {
      color: var(--danger);
    }

    .menu-item.logout svg {
      stroke: var(--danger);
    }

    .menu-item.logout:hover {
      background: #fff1ef;
    }

    .panel {
      min-width: 0;
      padding: 27px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 5px 22px rgba(30, 30, 20, 0.035);
    }

    .panel-title {
      margin: 0 0 22px;
      padding-bottom: 17px;
      border-bottom: 1px solid var(--border);
      color: var(--text);
      font-size: 17px;
      font-weight: 600;
      letter-spacing: -.3px;
    }

    .add-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: 41px;
      margin-bottom: 20px;
      padding: 10px 16px;
      border: 1px solid var(--dark);
      border-radius: 7px;
      background: var(--dark);
      color: #fff;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      transition: background .18s ease, color .18s ease, border-color .18s ease;
    }

    .add-btn:hover:not(:disabled) {
      border-color: var(--lime-hover);
      background: var(--lime);
      color: var(--dark);
    }

    .add-btn:disabled {
      opacity: .45;
      cursor: not-allowed;
    }

    .add-btn span {
      font-size: 17px;
      line-height: 1;
    }

    .address-card {
      position: relative;
      margin-bottom: 14px;
      padding: 18px;
      border: 1px solid var(--border);
      border-radius: 9px;
      background: #fff;
      transition: border-color .18s ease, box-shadow .18s ease;
    }

    .address-card:hover {
      border-color: #d5d9c5;
      box-shadow: 0 5px 18px rgba(30, 30, 20, .045);
    }

    .address-card:last-child {
      margin-bottom: 0;
    }

    .addr-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 14px;
      margin-bottom: 9px;
    }

    .addr-header>div:first-child {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 7px 10px;
      min-width: 0;
    }

    .addr-name {
      color: var(--text);
      font-size: 13px;
      font-weight: 600;
      overflow-wrap: anywhere;
    }

    .addr-phone {
      color: var(--muted);
      font-size: 12px;
      overflow-wrap: anywhere;
    }

    .addr-body {
      color: #68685f;
      font-size: 12px;
      font-weight: 400;
      line-height: 1.8;
      overflow-wrap: anywhere;
    }

    .addr-menu-btn {
      position: relative;
      padding: 2px 8px;
      border: 0;
      border-radius: 5px;
      background: transparent;
      color: #77776e;
      font-size: 21px;
      line-height: 1;
      cursor: pointer;
    }

    .addr-menu-btn:hover {
      background: #f2f3eb;
      color: var(--dark);
    }

    .addr-dropdown {
      position: absolute;
      top: 32px;
      right: 0;
      z-index: 50;
      display: none;
      min-width: 145px;
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 8px;
      background: #fff;
      box-shadow: 0 10px 28px rgba(0, 0, 0, .10);
    }

    .addr-dropdown.open {
      display: block;
    }

    .addr-dropdown a {
      display: block;
      padding: 11px 14px;
      color: #44443e;
      font-size: 12px;
      cursor: pointer;
      transition: background .15s ease;
    }

    .addr-dropdown a:hover {
      background: #f5f6ef;
    }

    .addr-dropdown a.del {
      color: var(--danger);
    }

    .addr-dropdown a.del:hover {
      background: #fff1ef;
    }

    .error-text {
      display: block;
      margin-top: 4px;
      color: var(--danger);
      font-size: 11px;
      line-height: 1.4;
    }

    .input-error {
      border-color: var(--danger) !important;
    }

    .alert {
      border-radius: 7px;
      font-size: 12px;
    }

    .empty-state {
      padding: 38px 16px;
      border: 1px dashed #d9dacd;
      border-radius: 9px;
      color: var(--muted);
      font-size: 13px;
      text-align: center;
      background: #fcfcf9;
    }

    .modal-content {
      overflow: hidden;
      border: 1px solid var(--border);
      border-radius: 12px;
      box-shadow: 0 18px 60px rgba(0, 0, 0, .12);
      font-family: 'Poppins', sans-serif;
    }

    .modal-header,
    .modal-footer {
      padding-right: 22px;
      padding-left: 22px;
    }

    .modal-title {
      color: var(--text);
      font-size: 15px;
      font-weight: 600;
    }

    .modal-body {
      padding-right: 22px;
      padding-left: 22px;
    }

    .modal-body label {
      display: block;
      margin-bottom: 7px;
      color: #626259;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: .2px;
      text-transform: capitalize;
    }

    .modal-body input,
    .modal-body select {
      width: 100%;
      min-height: 42px;
      padding: 9px 12px;
      border: 1px solid #deded4;
      border-radius: 7px;
      background-color: #fff;
      color: var(--text);
      font-size: 12px;
      transition: border-color .18s ease, box-shadow .18s ease;
    }

    .modal-body input:focus,
    .modal-body select:focus {
      border-color: #aab86d;
      box-shadow: 0 0 0 3px rgba(215, 243, 107, .25);
      outline: none;
    }

    .btn-save {
      min-height: 42px;
      padding: 10px 24px;
      border: 1px solid var(--dark);
      border-radius: 7px;
      background: var(--dark);
      color: #fff;
      font-size: 12px;
      font-weight: 500;
      transition: background .18s ease, color .18s ease;
    }

    .btn-save:hover {
      border-color: var(--lime-hover);
      background: var(--lime);
      color: var(--dark);
    }

    #deleteModal .modal-content {
      padding: 22px !important;
    }

    #deleteModal h6 {
      margin-bottom: 9px;
      font-size: 15px;
      font-weight: 600;
    }

    #deleteModal p {
      color: var(--muted);
      font-size: 12px;
    }

    footer {
      padding: 38px 24px 18px;
      background: var(--dark);
      color: #fff;
    }

    footer .container-fluid {
      max-width: 1240px;
      margin: 0 auto;
    }

    .footer-logo {
      display: flex;
      justify-content: center;
      margin-bottom: 28px;
    }

    .footer-logo .logo-img {
      width: 68px;
      max-width: 100%;
      height: auto;
      object-fit: contain;
    }

    .footer-col {
      margin-bottom: 12px;
    }

    .footer-col-title {
      margin-bottom: 13px;
      color: #fff;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 1.2px;
      text-transform: uppercase;
    }

    .footer-col a {
      display: block;
      width: fit-content;
      margin-bottom: 8px;
      color: #aaa99f;
      font-size: 11px;
      font-weight: 300;
      line-height: 1.6;
      transition: color .18s ease;
    }

    .footer-col a:hover {
      color: var(--lime);
    }

    .contact-label {
      color: #fff;
      font-size: 11px;
      font-weight: 500;
    }

    .contact-val {
      margin-left: 3px;
      color: #aaa99f;
      font-size: 11px;
      overflow-wrap: anywhere;
    }

    .social-icon {
      width: 18px;
      height: 18px;
      fill: #c8c8bf;
      cursor: pointer;
      transition: fill .18s ease;
    }

    .social-icon:hover {
      fill: var(--lime);
    }

    .footer-divider {
      margin: 10px 0 15px;
      border-color: rgba(255, 255, 255, .13);
    }

    .footer-copy {
      margin: 0;
      color: #88887e;
      font-size: 10px;
      font-weight: 300;
    }

    #toast {
      position: fixed;
      right: 22px;
      bottom: 22px;
      z-index: 9999;
      display: none;
      max-width: calc(100vw - 32px);
      padding: 12px 18px;
      border: 1px solid #41413c;
      border-radius: 8px;
      background: var(--dark);
      color: #fff;
      font-size: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, .15);
      animation: fadeUp .25s ease;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(8px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 900px) {
      main {
        padding: 35px 20px 48px;
      }

      .page-layout {
        grid-template-columns: 220px minmax(0, 1fr);
        gap: 18px;
      }

      .panel {
        padding: 22px;
      }

      .sidebar-title {
        padding: 19px 16px 15px;
      }

      .sidebar-menu {
        padding: 9px;
      }

      .menu-item {
        padding: 11px 10px;
        font-size: 11px;
      }
    }

    @media (max-width: 700px) {
      main {
        padding: 30px 16px 42px;
      }

      .account-heading {
        margin-bottom: 22px;
      }

      .account-heading p {
        font-size: 12px;
      }

      .page-layout {
        grid-template-columns: minmax(0, 1fr);
        gap: 16px;
      }

      .sidebar {
        width: 100%;
      }

      .sidebar-title {
        padding: 16px 17px 13px;
      }

      .sidebar-menu {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 5px;
        padding: 10px;
      }

      .menu-item {
        min-height: 42px;
        padding: 10px;
        font-size: 11px;
      }

      .panel {
        padding: 21px 18px;
      }

      .panel-title {
        margin-bottom: 18px;
        font-size: 16px;
      }

      .address-card {
        padding: 15px;
      }

      .modal-dialog {
        margin: 12px;
      }

      .modal-body {
        padding-right: 17px;
        padding-left: 17px;
      }

      .modal-header,
      .modal-footer {
        padding-right: 17px;
        padding-left: 17px;
      }

      footer {
        padding: 30px 18px 17px;
      }

      .footer-logo {
        margin-bottom: 24px;
      }

      footer .container-fluid {
        padding-right: 0 !important;
        padding-left: 0 !important;
      }

      .footer-col-title {
        font-size: 9px;
      }

      .footer-col a,
      .contact-label,
      .contact-val {
        font-size: 10px;
      }
    }

    @media (max-width: 480px) {
      main {
        padding: 25px 12px 34px;
      }

      .account-eyebrow {
        font-size: 9px;
        letter-spacing: 1.5px;
      }

      .account-heading h1 {
        font-size: 27px;
      }

      .account-heading p {
        line-height: 1.65;
      }

      .sidebar-menu {
        grid-template-columns: minmax(0, 1fr);
      }

      .menu-item {
        font-size: 12px;
      }

      .panel {
        padding: 18px 14px;
      }

      .add-btn {
        width: 100%;
        margin-bottom: 17px;
      }

      .addr-header {
        gap: 7px;
      }

      .addr-header>div:first-child {
        gap: 5px 8px;
      }

      .addr-name {
        font-size: 12px;
      }

      .addr-phone,
      .addr-body {
        font-size: 11px;
      }

      .addr-dropdown {
        min-width: 135px;
      }

      .modal-body .row {
        --bs-gutter-x: .7rem;
        --bs-gutter-y: .8rem;
      }

      .modal-body input,
      .modal-body select {
        font-size: 12px;
      }

      .btn-save {
        width: 100%;
      }

      #toast {
        right: 12px;
        bottom: 12px;
      }

      footer {
        padding-right: 14px;
        padding-left: 14px;
      }
    }

    @media (max-width: 360px) {
      .modal-body .col-6 {
        width: 100%;
      }

      .addr-header {
        align-items: flex-start;
      }
    }

    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        scroll-behavior: auto !important;
        animation-duration: .01ms !important;
        transition-duration: .01ms !important;
      }
    }
  </style>
</head>

<body>

  <div id="toast"></div>

  <div class="profile-page-navbar">
    <%- include("../partials/navbar") %>
  </div>
  <!-- Breadcrumb -->
  <div class="container mt-4 address-breadcrumb">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item">
          <a href="/">Home</a>
        </li>
        <li class="breadcrumb-item">
          <a href="/profile">My Account</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
          Address
        </li>
      </ol>
    </nav>
  </div>

  <main>
    <div class="page-layout">

      <aside class="sidebar">
        <div class="sidebar-title">My Account</div>
        <div class="sidebar-menu">

          <a href="/profile" style="text-decoration:none;">
            <div class="menu-item">
              <svg viewBox="0 0 24 24">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
              </svg>
              Personal Information
            </div>
          </a>

          <a href="/address" style="text-decoration:none;">
            <div class="menu-item active" aria-current="page">
              <svg viewBox="0 0 24 24">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
              </svg>
              Address
            </div>
          </a>

          <a href="/orders" style="text-decoration:none;">
            <div class="menu-item">
              <svg viewBox="0 0 24 24">
                <rect x="2" y="7" width="20" height="14" rx="2" />
                <path d="M16 3H8a2 2 0 0 0-2 2v2h12V5a2 2 0 0 0-2-2z" />
              </svg>
              Order
            </div>
          </a>

          <a href="/wallet" style="text-decoration:none;">
            <div class="menu-item">
              <svg viewBox="0 0 24 24">
                <rect x="2" y="5" width="20" height="14" rx="2" />
                <line x1="2" y1="10" x2="22" y2="10" />
              </svg>
              Wallet
            </div>
          </a>

          <a href="/coupons" style="text-decoration:none;">
            <div class="menu-item">
              <svg viewBox="0 0 24 24">
                <path d="M7 7h10l1 10H6L7 7z" />
                <path d="M9 7V5a3 3 0 0 1 6 0v2" />
              </svg>
              Coupon
            </div>
          </a>

          <a href="/change-password" style="text-decoration:none;">
            <div class="menu-item">
              <svg viewBox="0 0 24 24">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
              </svg>
              Change Password
            </div>
          </a>

          <a href="/logout" class="menu-item logout">
            <svg viewBox="0 0 24 24">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <polyline points="16 17 21 12 16 7" />
              <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
            Logout
          </a>


        </div>
      </aside>

      <div class="panel">
        <div class="panel-title">Address</div>

        <button class="add-btn" <% if(addresses.length>= 3){ %> disabled <% } %>
            data-bs-toggle="modal" data-bs-target="#addAddressModal">
            <span>+</span> Add New Address
        </button>
        <% if(error==="limit" ){ %>
          <div class="alert alert-danger py-2">
            Only 3 addresses allowed
          </div>
          <% } %>

            <% if(error==="empty" ){ %>
              <div class="alert alert-danger py-2">
                All fields are required
              </div>
              <% } %>

                <div id="address-list">

                  <% if(addresses.length===0){ %>
                    <div class="empty-state">No addresses saved yet.</div>
                    <% } %>

                      <% addresses.forEach((addr, i)=> { %>

                        <div class="address-card">
                          <div class="addr-header">
                            <div>
                              <span class="addr-name">
                                <%= addr.name || "No Name" %>
                                  <% if(addr.isDefault){ %>
                                    <span style="color:green; font-size:10px;">(Default)</span>
                                    <% } %>
                              </span>
                              <span class="addr-phone">
                                <%= addr.phone || "" %>
                              </span>
                            </div>

                            <div class="position-relative">
                              <button class="addr-menu-btn" onclick="toggleMenu('menu-<%= i %>')">⋮</button>

                              <div class="addr-dropdown" id="menu-<%= i %>">
                                <a onclick="editAddress('<%= addr._id %>')">Edit</a>
                                <a onclick="setDefault('<%= addr._id %>')">Set Default</a>
                                <a class="del" onclick="openDeleteModal('<%= addr._id %>')">Delete</a>
                              </div>
                            </div>
                          </div>

                          <div class="addr-body">
                            <%= addr.houseName %>, <%= addr.street %>,<br>
                                <%= addr.city %>, <%= addr.state %> – <%= addr.pincode %>
                          </div>
                        </div>

                        <% }) %>



                </div>
      </div>

    </div>
  </main>

  <div class="modal fade" id="addAddressModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header border-0 pb-0">
          <h6 class="modal-title" id="modalLabel">Add New Address</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <form id="addressForm" action="/address/add" method="POST" novalidate>
          <input type="hidden" name="addressId" id="addressId">
          <input type="text" name="fakeusernameremembered" style="display:none">
          <input type="password" name="fakepasswordremembered" style="display:none">
          <div class="modal-body pt-3">
            <input type="hidden" id="edit-index" value="">
            <div class="row g-3">
              <div class="col-6">
                <label>First Name</label>
                <input type="text" class="form-control" id="a-fname" name="fname" placeholder="First name" required
                  autocomplete="new-password">
                <small class="error-text" id="err-fname"></small>
              </div>
              <div class="col-6">
                <label>Last Name</label>
                <input type="text" class="form-control" id="a-lname" name="lname" placeholder="Last name" required
                  autocomplete="new-password">
                <small class="error-text" id="err-lname"></small>
              </div>
              <div class="col-12">
                <label>Phone</label>
                <input type="tel" class="form-control" id="a-phone" name="phone" maxlength="10"
                  placeholder="10-digit number">
                <small class="error-text" id="err-phone"></small>
              </div>
              <div class="col-12">
                <label>House / Flat / Building</label>
                <input type="text" class="form-control" id="a-house" name="house" placeholder="House no., Building name"
                  required autocomplete="new-password">
                <small class="error-text" id="err-house"></small>
              </div>
              <div class="col-12">
                <label>Street / Area</label>
                <input type="text" class="form-control" id="a-street" name="street" placeholder="Street, locality, area"
                  required autocomplete="new-password">
                <small class="error-text" id="err-street"></small>
              </div>
              <div class="col-6">
                <label>City</label>
                <input type="text" class="form-control" id="a-city" name="city" placeholder="City" required
                  autocomplete="new-password">
                <small class="error-text" id="err-city"></small>
              </div>
              <div class="col-6">
                <label>State</label>
                <input type="text" class="form-control" id="a-state" name="state" placeholder="State" required
                  autocomplete="new-password">
                <small class="error-text" id="err-state"></small>
              </div>
              <div class="col-6">
                <label>PIN Code</label>
                <input type="text" class="form-control" id="a-pin" name="pin" inputmode="numeric" pattern="[0-9]{6}"
                  maxlength="6" placeholder="6-digit PIN" required autocomplete="new-password">
                <small class="error-text" id="err-pin"></small>
              </div>
              <div class="col-6">
                <label>Address Type</label>
                <select class="form-select" id="a-type" name="type">
                  <option value="Home">Home</option>
                  <option value="Work">Work</option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>
          </div>
          <div class="modal-footer border-0 pt-1">
            <button type="submit" class="btn-save btn">Save Address</button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <div class="modal fade" id="deleteModal">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content p-3">
        <h6>Delete Address?</h6>
        <p>Are you sure delete this address</p>

        <form id="deleteForm" method="POST">
          <button class="btn btn-danger w-100">Delete</button>
        </form>
      </div>
    </div>
  </div>

