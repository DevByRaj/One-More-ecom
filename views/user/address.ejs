  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>


    /* ── TOGGLE DROPDOWN MENU ── */
    function toggleMenu(id) {
      document.querySelectorAll('.addr-dropdown').forEach(d => {
        if (d.id !== id) d.classList.remove('open');
      });
      document.getElementById(id).classList.toggle('open');
    }
    document.addEventListener('click', e => {
      if (!e.target.closest('.addr-menu-btn')) {
        document.querySelectorAll('.addr-dropdown').forEach(d => d.classList.remove('open'));
      }
    });


    /* ── CLEAR FORM ── */
    function clearForm() {
      ['a-fname', 'a-lname', 'a-phone', 'a-house', 'a-street', 'a-city', 'a-state', 'a-pin']
        .forEach(id => document.getElementById(id).value = '');
      document.getElementById('a-type').value = 'Home';
      document.getElementById('edit-index').value = '';
      document.getElementById('modalLabel').textContent = 'Add New Address';
    }

    /* reset form when modal closes */
    document.getElementById('addAddressModal').addEventListener('hidden.bs.modal', clearForm);

    /* ── SIDEBAR ACTIVE ── */
    function setActive(el) {
      document.querySelectorAll('.menu-item:not(.logout)').forEach(i => i.classList.remove('active'));
      el.classList.add('active');
    }

    /* ── TOAST ── */
    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.style.display = 'block';
      clearTimeout(t._tid);
      t._tid = setTimeout(() => t.style.display = 'none', 2500);
    }

    document.getElementById("addressForm").addEventListener("keydown", function (e) {
      if (e.key === "Enter") e.preventDefault();
    });

    const form = document.getElementById("addressForm");

    form.addEventListener("submit", function (e) {

      e.preventDefault();

      let isValid = true;

      // CLEAR OLD ERRORS
      document.querySelectorAll(".error-text").forEach(el => {
        el.textContent = "";
      });

      document.querySelectorAll(".form-control").forEach(el => {
        el.classList.remove("input-error");
      });

      // GET VALUES
      const fname = form.fname.value.trim();
      const lname = form.lname.value.trim();
      const phone = form.phone.value.trim();
      const house = form.house.value.trim();
      const street = form.street.value.trim();
      const city = form.city.value.trim();
      const state = form.state.value.trim();
      const pin = form.pin.value.trim();


      // REGEX
      const namePattern = /^[A-Za-z]+(?:[ '-][A-Za-z]+)*$/;
      const phonePattern = /^[6-9]\d{9}$/;
      const cityStatePattern = /^[A-Za-z]+(?:[ '-][A-Za-z]+)*$/;


      // FIRST NAME
      if (!fname) {

        showError("a-fname", "First name is required");
        isValid = false;

      } else if (fname.length < 2) {

        showError("a-fname", "First name must be at least 2 characters");
        isValid = false;

      } else if (fname.length > 30) {

        showError("a-fname", "First name must not exceed 30 characters");
        isValid = false;

      } else if (!namePattern.test(fname)) {

        showError("a-fname", "Please enter a valid first name");
        isValid = false;
      }


      // LAST NAME
      if (!lname) {

        showError("a-lname", "Last name is required");
        isValid = false;

      } else if (lname.length < 2) {

        showError("a-lname", "Last name must be at least 2 characters");
        isValid = false;

      } else if (lname.length > 30) {

        showError("a-lname", "Last name must not exceed 30 characters");
        isValid = false;

      } else if (!namePattern.test(lname)) {

        showError("a-lname", "Please enter a valid last name");
        isValid = false;
      }


      // PHONE
      if (!phone) {

        showError("a-phone", "Phone number is required");
        isValid = false;

      } else if (!phonePattern.test(phone)) {

        showError("a-phone", "Enter a valid 10-digit phone number");
        isValid = false;
      }


      // HOUSE
      if (!house) {

        showError("a-house", "House / building is required");
        isValid = false;

      } else if (house.length < 2) {

        showError("a-house", "House / building must be at least 2 characters");
        isValid = false;

      } else if (house.length > 100) {

        showError("a-house", "House / building must not exceed 100 characters");
        isValid = false;
      }


      // STREET
      if (!street) {

        showError("a-street", "Street / area is required");
        isValid = false;

      } else if (street.length < 2) {

        showError("a-street", "Street / area must be at least 2 characters");
        isValid = false;

      } else if (street.length > 100) {

        showError("a-street", "Street / area must not exceed 100 characters");
        isValid = false;
      }


      // CITY
      if (!city) {

        showError("a-city", "City is required");
        isValid = false;

      } else if (city.length < 2) {

        showError("a-city", "City must be at least 2 characters");
        isValid = false;

      } else if (city.length > 50) {

        showError("a-city", "City must not exceed 50 characters");
        isValid = false;

      } else if (!cityStatePattern.test(city)) {

        showError("a-city", "Please enter a valid city");
        isValid = false;
      }


      // STATE
      if (!state) {

        showError("a-state", "State is required");
        isValid = false;

      } else if (state.length < 2) {

        showError("a-state", "State must be at least 2 characters");
        isValid = false;

      } else if (state.length > 50) {

        showError("a-state", "State must not exceed 50 characters");
        isValid = false;

      } else if (!cityStatePattern.test(state)) {

        showError("a-state", "Please enter a valid state");
        isValid = false;
      }

      if (!/^\d{6}$/.test(pin)) {

        showError("a-pin", "Enter valid 6 digit pincode");
        isValid = false;
      }

      if (isValid) {
        form.submit();
      }
    })

    function showError(inputId, message) {
      const input = document.getElementById(inputId);
      const error = document.getElementById("err-" + inputId.split("-")[1]);

      input.classList.add("input-error");
      if (error) error.textContent = message;
    }

    setTimeout(() => {
      document.querySelectorAll('input').forEach(input => {
        input.setAttribute('autocomplete', 'off');
        input.setAttribute('readonly', true);

        setTimeout(() => {
          input.removeAttribute('readonly');
        }, 100);
      });
    }, 100);

    function editAddress(id) {
      fetch(`/address/${id}`)
        .then(res => res.json())
        .then(data => {

          document.getElementById("addressId").value = data._id

          const names = data.name.split(" ")
          document.getElementById("a-fname").value = names[0] || "";
          document.getElementById("a-lname").value = names.slice(1).join(" ") || "";

          document.getElementById("a-phone").value = data.phone;
          document.getElementById("a-house").value = data.houseName;
          document.getElementById("a-street").value = data.street;
          document.getElementById("a-city").value = data.city;
          document.getElementById("a-state").value = data.state;
          document.getElementById("a-pin").value = data.pincode;
          document.getElementById("a-type").value = data.type;

          document.getElementById("modalLabel").textContent = "Edit Address";

          new bootstrap.Modal(document.getElementById('addAddressModal')).show();
        })
    }

    function openDeleteModal(id) {
      document.getElementById("deleteForm").action = "/address/delete/" + id;
      new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    function setDefault(id) {
      window.location.href = "/address/default/" + id;
    }

  </script>
</body>

