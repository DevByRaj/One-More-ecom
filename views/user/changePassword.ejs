<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Change</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    body {
      font-family: 'Poppins', sans-serif;
      background: #1a1a1a;
    }

    /* NAVBAR */
    nav {
      background: #1a1a1a;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .nav-inner {
      display: flex;
      height: 90px;
      align-items: center;
      justify-content: space-between;
      padding: 14px 32px;
    }

    .logo-img {
      width: 80px;
    }

    .nav-links {
      display: flex;
      gap: 36px;
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }

    .nav-links a {
      font-size: 14px;
      color: #ccc;
      text-decoration: none;
    }

    .nav-links a:hover {
      color: #fff;
    }

    .nav-icons {
      display: flex;
      gap: 18px;
    }

    .nav-icons svg {
      width: 22px;
      height: 22px;
      stroke: #ccc;
    }

    .nav-icons svg:hover {
      stroke: #fff;
    }

    /* MAIN */
    .main {
      background: #f0f0eb;
      padding: 60px 40px;
    }

    .page-layout {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 24px;
      max-width: 900px;
      margin: 0 auto;
    }

    /* SIDEBAR */
    .sidebar {
      background: #fff;
      border-radius: 10px;
      border: 1px solid #ddd;
      padding: 20px 0;
      height: fit-content;
    }

    .sidebar-title {
      font-size: 13px;
      font-weight: 600;
      padding: 0 20px 16px;
      border-bottom: 1px solid #eee;
    }

    .menu-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 20px;
      font-size: 13px;
      color: #444;
      cursor: pointer;
      transition: 0.2s;
    }

    .menu-item svg {
      width: 16px;
      height: 16px;
      stroke: #888;
      fill: none;
    }

    .menu-item:hover {
      background: #f5f5f5;
      color: #000;
    }

    .menu-item.active {
      background: #f0f0eb;
      font-weight: 600;
    }

    .menu-item.logout {
      color: #c0392b;
    }

    /* CARD */
    .card-box {
      background: #fff;
      border-radius: 10px;
      border: 1px solid #ddd;
      padding: 35px;
      text-align: center;
    }

    .card-title {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 25px;
    }

    /* INPUT */
    .input-box {
      width: 100%;
      max-width: 420px;
      margin: 0 auto 5px;
      position: relative;
    }

    .input-box input {
      width: 100%;
      padding: 10px 40px 10px 15px;
      border-radius: 20px;
      border: 1px solid #ccc;
      background: #f7f7f7;
      outline: none;
    }

    .toggle-eye {
      position: absolute;
      right: 15px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      color: #555;
    }

    .error-msg {
      color: #d93025;
      font-size: 11px;
      text-align: left;
      max-width: 420px;
      margin: 0 auto 15px;
      height: 14px;
      /* Space holder */
    }

    .btn-dark {
      padding: 8px 30px;
      border-radius: 10px;
    }

    /* ── FOOTER ── */

    footer {
      background: #1a1a1a;
      padding: 40px 48px 20px;
      color: #fff;
    }

    .footer-logo {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      margin-bottom: 40px;
    }

    .footer-logo .logo-img {
      width: 80px;
      height: auto;
      display: block;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1fr 1fr;
      gap: 20px;
      margin-bottom: 28px;
    }

    .footer-col-title {
      font-size: 12px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 12px;
      letter-spacing: 0.3px;
      text-transform: uppercase;
    }

    .footer-col a {
      display: block;
      font-size: 11px;
      font-weight: 300;
      color: #aaa;
      text-decoration: none;
      margin-bottom: 7px;
      cursor: pointer;
      transition: color 0.2s;
    }

    .footer-col a:hover {
      color: #fff;
    }

    .footer-contact-label {
      font-size: 11px;
      color: #fff;
      font-weight: 500;
    }

    .footer-contact-val {
      font-size: 11px;
      color: #aaa;
      margin-left: 4px;
    }

    .footer-social {
      display: flex;
      gap: 14px;
      margin-top: 6px;
    }

    .footer-social svg {
      width: 18px;
      height: 18px;
      fill: #ccc;
      cursor: pointer;
      transition: fill 0.2s;
    }

    .footer-social svg:hover {
      fill: #fff;
    }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      padding-top: 16px;
      font-size: 11px;
      color: #555;
      font-weight: 300;
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <nav>
    <div class="nav-inner">
      <img src="/images/logo.png" class="logo-img">
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="#">Shop</a>
        <a href="#">Contact Us</a>
        <a href="#">About Us</a>
      </div>
      <div class="nav-icons">
        <a href="/profile">
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="7" r="4" />
            <path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" />
          </svg>
        </a>
        <svg viewBox="0 0 24 24">
          <path
            d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
        </svg>
        <svg viewBox="0 0 24 24">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
          <line x1="3" y1="6" x2="21" y2="6" />
          <path d="M16 10a4 4 0 0 1-8 0" />
        </svg>
      </div>
    </div>
  </nav>

  <!-- MAIN -->
  <div class="main">
    <div class="page-layout">

      <!-- SIDEBAR -->
      <aside class="sidebar">
        <div class="sidebar-title">My Account</div>
        <div class="sidebar-menu">
          <a href="/profile" style="text-decoration:none;">
            <div class="menu-item">
              <svg viewBox="0 0 24 24">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
              </svg>
              Personal Information
            </div>
          </a>
          <a href="/address" style="text-decoration:none;">
            <div class="menu-item">
              <svg viewBox="0 0 24 24">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
              </svg>
              Address
            </div>
          </a>
          <div class="menu-item"><svg viewBox="0 0 24 24">
              <rect x="2" y="7" width="20" height="14" rx="2" />
              <path d="M16 3H8a2 2 0 0 0-2 2v2h12V5a2 2 0 0 0-2-2z" />
            </svg>Order</div>
          <div class="menu-item"><svg viewBox="0 0 24 24">
              <rect x="2" y="5" width="20" height="14" rx="2" />
              <line x1="2" y1="10" x2="22" y2="10" />
            </svg>Wallet</div>
          <div class="menu-item"><svg viewBox="0 0 24 24">
              <path d="M7 7h10l1 10H6L7 7z" />
              <path d="M9 7V5a3 3 0 0 1 6 0v2" />
            </svg>Coupon</div>
          <a href="/change-password" style="text-decoration:none;">
            <div class="menu-item active">
              <svg viewBox="0 0 24 24">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                <polyline points="9 22 9 12 15 12 15 22" />
              </svg>
              Change Password
            </div>
          </a>
          <a href="/logout" class="menu-item logout">
            <svg viewBox="0 0 24 24">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
              <polyline points="16 17 21 12 16 7" />
              <line x1="21" y1="12" x2="9" y2="12" />
            </svg>
            Logout
          </a>
        </div>
      </aside>

      <!-- CARD -->
      <div class="card-box">
        <div class="card-title">Password Change</div>

        <form id="passwordForm" action="/change-password" method="POST" novalidate>
        
          <% if (user && user.authType==="google" ) { %>
        
            <div style="
              background: #f7f7f7;
              border: 1px solid #ddd;
              border-radius: 10px;
              padding: 18px;
              margin-bottom: 25px;
              text-align: center;
            ">
        
              <div style="
                font-size: 14px;
                font-weight: 600;
                color: #333;
                margin-bottom: 6px;
              ">
                Password Change Unavailable
              </div>
        
              <div style="
                font-size: 12px;
                color: #777;
                line-height: 1.5;
              ">
                You signed in using Google.
                Your password is managed through your Google account.
              </div>
        
            </div>
        
            <% } %>
        
        
              <div class="input-box">
        
                <input type="password" id="currentPassword" name="currentPassword" placeholder="Current Password" <%=user &&
                  user.authType==="google" ? "disabled" : "" %>
                >
        
                <i class="fa-solid fa-eye toggle-eye" style="<%= user && user.authType === 'google'
                ? 'opacity:0.4; cursor:not-allowed;'
                : '' %>" onclick="<%= user && user.authType === 'google'
                ? ''
                : " togglePassword('currentPassword', this)" %>"
                  ></i>
        
              </div>
        
              <div id="currentError" class="error-msg"></div>
        
        
              <div class="input-box">
        
                <input type="password" id="newPassword" name="newPassword" placeholder="New Password" <%=user &&
                  user.authType==="google" ? "disabled" : "" %>
                >
        
                <i class="fa-solid fa-eye toggle-eye" style="<%= user && user.authType === 'google'
                ? 'opacity:0.4; cursor:not-allowed;'
                : '' %>" onclick="<%= user && user.authType === 'google'
                ? ''
                : " togglePassword('newPassword', this)" %>"
                  ></i>
        
              </div>
        
              <div id="newError" class="error-msg"></div>
        
        
              <div class="input-box">
        
                <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password" <%=user &&
                  user.authType==="google" ? "disabled" : "" %>
                >
        
                <i class="fa-solid fa-eye toggle-eye" style="<%= user && user.authType === 'google'
                ? 'opacity:0.4; cursor:not-allowed;'
                : '' %>" onclick="<%= user && user.authType === 'google'
                ? ''
                : " togglePassword('confirmPassword', this)" %>"
                  ></i>
        
              </div>
        
              <div id="confirmError" class="error-msg"></div>
        
        
              <button type="submit" class="btn btn-dark mt-3" <%=user && user.authType==="google" ? "disabled" : "" %>
                style="<%= user && user.authType==='google' ? 'opacity:0.5; cursor:not-allowed;' : '' %>"
                  >
                  Change Password
              </button>
        
        </form>

      </div>

    </div>
  </div>

  <!-- FOOTER -->
  <footer>
    <div class="footer-logo"><img src="/images/logo.png" class="logo-img"></div>
    <div class="footer-grid">
      <div class="footer-col">
        <div class="footer-col-title">SUPPORT</div>
        <a>Order Status</a><a>Product Support</a><a>Shipping &amp; Return Policy</a><a>Complaint Registration</a>
      </div>
      <div class="footer-col">
        <div class="footer-col-title">About Us</div>
        <a>Contact Us</a><a>Privacy Policy</a><a>Terms of use</a><a>FAQ</a>
      </div>
      <div class="footer-col">
        <div class="footer-col-title">Contact</div>
        <div><span class="footer-contact-label">Email :</span><span class="footer-contact-val">onemore@gmail.com</span>
        </div>
        <div><span class="footer-contact-label">Phone :</span><span class="footer-contact-val">+91 8888888888</span>
        </div>
      </div>
      <div class="footer-col">
        <div class="footer-col-title">Connect with us</div>
        <div class="footer-social">
          <svg viewBox="0 0 24 24">
            <path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
          </svg>
          <svg viewBox="0 0 24 24">
            <path
              d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
          </svg>
          <svg viewBox="0 0 24 24">
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
          </svg>
        </div>
      </div>
    </div>
    <div class="footer-bottom">© 2025 onemore . All Rights Reserved.</div>
  </footer>

  <script>
    const form = document.getElementById("passwordForm");

    form.addEventListener("submit", function (e) {
      let valid = true;

      const current = document.getElementById("currentPassword");
      const newPass = document.getElementById("newPassword");
      const confirm = document.getElementById("confirmPassword");

      const currentError = document.getElementById("currentError");
      const newError = document.getElementById("newError");
      const confirmError = document.getElementById("confirmError");

      // Reset errors
      currentError.textContent = "";
      newError.textContent = "";
      confirmError.textContent = "";
      current.style.borderColor = "#ccc";
      newPass.style.borderColor = "#ccc";
      confirm.style.borderColor = "#ccc";

      // Pattern: at least 6 chars, 1 uppercase, 1 lowercase, 1 number, 1 special char
      const pattern = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&]).{6,}$/;

      if (current.value.trim() === "") {
        currentError.textContent = "Current password is required";
        current.style.borderColor = "#d93025";
        valid = false;
      }

      if (!pattern.test(newPass.value)) {
        newError.textContent = "Password must be 6+ chars with uppercase, number, and symbol";
        newPass.style.borderColor = "#d93025";
        valid = false;
      }

      if (confirm.value === "") {
        confirmError.textContent = "Please confirm your password";
        confirm.style.borderColor = "#d93025";
        valid = false;
      } else if (confirm.value !== newPass.value) {
        confirmError.textContent = "Passwords do not match";
        confirm.style.borderColor = "#d93025";
        valid = false;
      }

      if (!valid) e.preventDefault();
    });

    function togglePassword(id, icon) {
      const input = document.getElementById(id);
      if (input.type === "password") {
        input.type = "text";
        icon.classList.replace("fa-eye", "fa-eye-slash");
      } else {
        input.type = "password";
        icon.classList.replace("fa-eye-slash", "fa-eye");
      }
    }
  </script>

</body>

</html>