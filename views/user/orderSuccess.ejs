<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Success | OneMore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-dark: #121212;
            --text-muted: #aaaaaa;
            --border-gray: #cccccc;
            --accent-yellow: #ffdc60;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            color: #333;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ── NAVBAR STYLE ── */
        .navbar {
            background-color: var(--bg-dark);
            padding: 15px 50px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo-img {
            height: 60px;
            width: auto;
            object-fit: contain;
        }

        .nav-link {
            color: #ffffff !important;
            font-size: 0.85rem;
            font-weight: 400;
            margin: 0 15px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            padding: 0 15px !important;
            transition: opacity 0.3s ease;
        }

        .nav-link:hover {
            opacity: 0.7;
        }

        .nav-icons a {
            color: #fff;
            margin-left: 20px;
            font-size: 1.1rem;
            transition: transform 0.2s;
            position: relative;
            display: inline-block;
        }

        .nav-icons a:hover {
            transform: scale(1.1);
        }

        /* ── MAIN CONTENT CONTAINER ── */
        .success-container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
        }

        /* ── FIGMA SPECIFIC SUCCESS CARD ── */
        .figma-success-card {
            border: 3px solid #000000;
            border-radius: 32px;
            max-width: 650px;
            width: 100%;
            padding: 60px 40px;
            text-align: center;
            background-color: #ffffff;
        }

        .success-title {
            font-size: 28px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #000000;
            margin-bottom: 35px;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 16px;
            font-weight: 500;
            color: #000000;
            margin-bottom: 15px;
        }

        .status-badge i {
            color: #10b981;
            /* Premium Emerald/Success Green */
            font-size: 20px;
        }

        .success-message {
            font-size: 14px;
            color: #555555;
            margin-bottom: 20px;
        }

        .order-number-text {
            font-size: 16px;
            font-weight: 500;
            color: #8b1e1e;
            /* Dark red style from Figma */
            margin-bottom: 40px;
        }

        /* ── FIGMA BUTTON CORES ── */
        .button-group-row {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .figma-pill-btn {
            background-color: #000000;
            color: #ffffff;
            border: none;
            padding: 10px 30px;
            font-size: 13px;
            font-weight: 500;
            border-radius: 25px;
            text-decoration: none;
            transition: opacity 0.2s ease;
        }

        .figma-pill-btn:hover {
            color: #ffffff;
            opacity: 0.85;
        }

        /* ── FOOTER STYLE ── */
        footer {
            background-color: var(--bg-dark);
            color: #fff;
            padding: 80px 80px 30px;
            border-top: 1px solid #222;
        }

        .footer-logo-container {
            margin-bottom: 45px;
        }

        .footer-logo-container img {
            height: 65px;
            width: auto;
        }

        .footer-heading {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--accent-yellow);
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: #ffffff;
            opacity: 0.8;
            text-decoration: none;
            font-size: 13px;
            transition: opacity 0.2s;
        }

        .footer-links a:hover {
            opacity: 1;
        }

        .footer-contact-text {
            font-size: 13px;
            color: #ffffff;
            margin-bottom: 10px;
        }

        .social-icons a {
            color: #fff;
            font-size: 1.3rem;
            margin-right: 20px;
            transition: opacity 0.2s;
        }

        .social-icons a:hover {
            opacity: 0.7;
        }

        .copyright {
            border-top: 1px solid #222;
            margin-top: 60px;
            padding-top: 30px;
            font-size: 12px;
            color: #777;
        }

        @media (max-width: 768px) {
            .navbar {
                padding: 15px 20px;
            }

            .figma-success-card {
                padding: 40px 20px;
                border-radius: 20px;
            }

            .success-title {
                font-size: 22px;
            }

            footer {
                padding: 60px 20px 30px;
                text-align: center;
            }

            .social-icons a {
                margin: 0 10px;
            }
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <img src="/images/logo.png" class="logo-img" alt="OneMore Logo">
            </a>
            <button class="navbar-toggler navbar-dark border-0" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto text-center mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/shop">Shop</a></li>
                    <li class="nav-item"><a class="nav-link" href="/contact">Contact Us</a></li>
                    <li class="nav-item"><a class="nav-link" href="/about">About Us</a></li>
                </ul>

                <div class="nav-icons d-flex align-items-center justify-content-center mt-3 mt-lg-0">
                    <a href="/profile"><i class="fa-regular fa-user"></i></a>
                    <a href="/wishlist"><i class="fa-regular fa-heart"></i></a>
                    <a href="/cart"><i class="fa-solid fa-bag-shopping"></i></a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Success View Content Block -->
    <div class="success-container">
        <div class="figma-success-card">

            <h1 class="success-title">Thank you for your order!</h1>

            <div class="status-badge">
                <i class="fa-solid fa-circle-check"></i>
                <span>Payment will be collected upon delivery.</span>
            </div>

            <p class="success-message">Your order has been successfully placed.</p>

            <div class="order-number-text">
                Order Number: #<%= orderId %>
                <p class="success-message">
                    Order Date:
                    <%= new Date().toLocaleDateString("en-IN") %>
                </p>
            </div>

            <div class="button-group-row">
                <a href="/orders" class="figma-pill-btn">My orders</a>
                <a href="/shop" class="figma-pill-btn">Continue shopping</a>
            </div>

        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="row text-center footer-logo-container">
            <div class="col-12">
                <img src="/images/logo.png" alt="OneMore Footer Logo">
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-3">
                <h6 class="footer-heading">Support</h6>
                <ul class="list-unstyled footer-links">
                    <li><a href="#">Order Status</a></li>
                    <li><a href="#">Product Support</a></li>
                    <li><a href="#">Shipping & Return Policy</a></li>
                    <li><a href="#">Complaint Registration</a></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h6 class="footer-heading">About Us</h6>
                <ul class="list-unstyled footer-links">
                    <li><a href="/contact">Contact Us</a></li>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Terms of use</a></li>
                    <li><a href="#">FAQ</a></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h6 class="footer-heading">Contact</h6>
                <div class="footer-contact-text">Email: onemore@gmail.com</div>
                <div class="footer-contact-text">Phone: +91 8888888888</div>
            </div>
            <div class="col-md-3 text-md-end social-column">
                <h6 class="footer-heading text-md-end">Connect with us</h6>
                <div class="social-icons">
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-x-twitter"></i></a>
                </div>
            </div>
        </div>
        <div class="text-center copyright">
            © 2026 onemore. All Rights Reserved.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>