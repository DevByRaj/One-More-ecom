<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Success | OneMore</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-dark: #121212;
            --text-muted: #aaaaaa;
            --border-gray: #cccccc;
            --accent-yellow: #ffdc60;
            --success-green: #10b981;
            --paper: #f0f0eb;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            color: #333;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ── NAVBAR STYLE ── */
        .navbar {
            background-color: var(--bg-dark);
            padding: 15px 50px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo-img {
            height: 60px;
            width: auto;
            object-fit: contain;
        }

        .nav-link {
            color: #ffffff !important;
            font-size: 0.85rem;
            font-weight: 400;
            margin: 0 15px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            padding: 0 15px !important;
            transition: opacity 0.3s ease;
        }

        .nav-link:hover {
            opacity: 0.7;
        }

        .nav-icons a {
            color: #fff;
            margin-left: 20px;
            font-size: 1.1rem;
            transition: transform 0.2s;
            position: relative;
            display: inline-block;
        }

        .nav-icons a:hover {
            transform: scale(1.1);
        }

        /* ── MAIN CONTENT CONTAINER ── */
        .success-container {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 60px 20px;
            background: var(--paper);
        }

        /* ── SUCCESS CARD ── */
        .figma-success-card {
            background: var(--bg-dark);
            color: #ffffff;
            border: 1px solid #2a2a2a;
            border-radius: 22px;
            max-width: 600px;
            width: 100%;
            padding: 3rem 2.2rem 2.8rem;
            text-align: center;
            box-shadow: 0 30px 60px -25px rgba(0, 0, 0, 0.5);
            animation: cardAppear 0.5s ease;
        }

        @keyframes cardAppear {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ── CASSETTE: intact and playing ── */
        .cassette {
            position: relative;
            width: 260px;
            height: 170px;
            margin: 0 auto 1.4rem;
            background: var(--paper);
            border-radius: 14px;
            box-shadow: 0 18px 30px -12px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(255, 255, 255, 0.08) inset;
        }

        /* corner screws */
        .cassette::before {
            content: "";
            position: absolute;
            inset: 8px;
            border-radius: 8px;
            background:
                radial-gradient(circle at 4px 4px, #9a9a92 0 2.5px, transparent 3px),
                radial-gradient(circle at calc(100% - 4px) 4px, #9a9a92 0 2.5px, transparent 3px),
                radial-gradient(circle at 4px calc(100% - 4px), #9a9a92 0 2.5px, transparent 3px),
                radial-gradient(circle at calc(100% - 4px) calc(100% - 4px), #9a9a92 0 2.5px, transparent 3px);
            pointer-events: none;
        }

        .cassette-label {
            position: absolute;
            top: 16px;
            left: 22px;
            right: 22px;
            height: 70px;
            background: #fff;
            border-radius: 6px;
            border-top: 7px solid var(--success-green);
            padding: 6px 12px 0;
            text-align: left;
        }

        .cassette-label small {
            display: block;
            font-size: 0.68rem;
            color: #777;
        }

        .cassette-label .confirmed {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-top: 4px;
            color: #0b7a57;
            font-weight: 600;
            font-size: 1rem;
        }

        .cassette-window {
            position: absolute;
            left: 50%;
            bottom: 32px;
            width: 150px;
            height: 44px;
            margin-left: -75px;
            border-radius: 22px;
            background: #181818;
        }

        /* tape running between the reels */
        .cassette-window::before {
            content: "";
            position: absolute;
            left: 24px;
            right: 24px;
            bottom: 7px;
            height: 2px;
            background: #8a5a34;
        }

        .reel {
            position: absolute;
            top: 50%;
            width: 32px;
            height: 32px;
            margin-top: -16px;
            border-radius: 50%;
            background: repeating-conic-gradient(var(--paper) 0 30deg, #4a4a4a 30deg 60deg);
            animation: spin 3.2s linear infinite;
        }

        .reel::after {
            content: "";
            position: absolute;
            inset: 10px;
            border-radius: 50%;
            background: #181818;
        }

        .reel.left {
            left: 6px;
        }

        .reel.right {
            right: 6px;
        }

        .cassette-foot {
            position: absolute;
            left: 44px;
            right: 44px;
            bottom: 0;
            height: 20px;
            border-radius: 6px 6px 14px 14px;
            background: #cfcfc8;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        /* ── EQUALIZER: rises once on load ── */
        .eq {
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
            margin-bottom: 1.8rem;
        }

        .eq span {
            display: block;
            width: 4px;
            border-radius: 4px;
            background: var(--accent-yellow);
            transform-origin: center;
            animation: rise 0.6s cubic-bezier(.2, .8, .2, 1) both;
        }

        @keyframes rise {
            from {
                transform: scaleY(0.05);
            }
        }

        /* ── TEXT ── */
        .success-title {
            font-size: 26px;
            font-weight: 600;
            letter-spacing: 0;
            color: #ffffff;
            margin-bottom: 1.3rem;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-size: 15px;
            font-weight: 500;
            color: #ffffff;
            margin-bottom: 10px;
        }

        .status-badge i {
            color: var(--success-green);
            font-size: 20px;
        }

        .success-message {
            font-size: 14px;
            font-weight: 300;
            color: var(--text-muted);
            margin-bottom: 1.4rem;
        }

        .order-number-text {
            font-size: 15px;
            font-weight: 400;
            color: #ffffff;
            margin-bottom: 2rem;
            word-break: break-all;
        }

        .order-number-text strong {
            color: var(--accent-yellow);
            font-weight: 600;
        }

        .order-number-text .success-message {
            margin: 6px 0 0;
            font-size: 13px;
        }

        /* ── BUTTONS ── */
        .button-group-row {
            display: flex;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .figma-pill-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 170px;
            height: 46px;
            padding: 0 28px;
            background-color: var(--accent-yellow);
            color: #121212;
            border: 1px solid var(--accent-yellow);
            font-size: 14px;
            font-weight: 600;
            border-radius: 30px;
            text-decoration: none;
            transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, color 0.2s ease;
        }

        .figma-pill-btn:hover {
            color: #121212;
            background: #ffe58a;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(255, 220, 96, 0.22);
        }

        .figma-pill-btn.outline {
            background: transparent;
            color: #ffffff;
            border-color: #555;
            font-weight: 500;
        }

        .figma-pill-btn.outline:hover {
            background: #ffffff;
            color: #121212;
            border-color: #ffffff;
            box-shadow: none;
        }

        .figma-pill-btn:focus-visible {
            outline: 3px solid #ffffff;
            outline-offset: 3px;
        }

        /* ── FOOTER STYLE ── */
        footer {
            background-color: var(--bg-dark);
            color: #fff;
            padding: 80px 80px 30px;
            border-top: 1px solid #222;
        }

        .footer-logo-container {
            margin-bottom: 45px;
        }

        .footer-logo-container img {
            height: 65px;
            width: auto;
        }

        .footer-heading {
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--accent-yellow);
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: #ffffff;
            opacity: 0.8;
            text-decoration: none;
            font-size: 13px;
            transition: opacity 0.2s;
        }

        .footer-links a:hover {
            opacity: 1;
        }

        .footer-contact-text {
            font-size: 13px;
            color: #ffffff;
            margin-bottom: 10px;
        }

        .social-icons a {
            color: #fff;
            font-size: 1.3rem;
            margin-right: 20px;
            transition: opacity 0.2s;
        }

        .social-icons a:hover {
            opacity: 0.7;
        }

        .copyright {
            border-top: 1px solid #222;
            margin-top: 60px;
            padding-top: 30px;
            font-size: 12px;
            color: #777;
        }

        @media (max-width: 768px) {
            .navbar {
                padding: 15px 20px;
            }

            .figma-success-card {
                padding: 2.2rem 1.3rem 2.2rem;
                border-radius: 16px;
            }

            .cassette {
                transform: scale(0.9);
                transform-origin: top center;
                margin-bottom: 0;
            }

            .eq {
                margin-top: -8px;
                margin-bottom: 1.4rem;
            }

            .success-title {
                font-size: 22px;
            }

            .eq span {
                width: 3px;
            }

            .eq {
                gap: 3px;
            }

            .figma-pill-btn {
                width: 100%;
                max-width: 260px;
            }

            footer {
                padding: 60px 20px 30px;
                text-align: center;
            }

            .social-icons a {
                margin: 0 10px;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            .figma-success-card,
            .reel,
            .eq span {
                animation: none;
            }
        }
    </style>
</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <img src="/images/logo.png" class="logo-img" alt="OneMore Logo">
            </a>
            <button class="navbar-toggler navbar-dark border-0" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto text-center mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/shop">Shop</a></li>
                    <li class="nav-item"><a class="nav-link" href="/contact">Contact Us</a></li>
                    <li class="nav-item"><a class="nav-link" href="/about">About Us</a></li>
                </ul>

                <div class="nav-icons d-flex align-items-center justify-content-center mt-3 mt-lg-0">
                    <a href="/profile"><i class="fa-regular fa-user"></i></a>
                    <a href="/wishlist"><i class="fa-regular fa-heart"></i></a>
                    <a href="/cart"><i class="fa-solid fa-bag-shopping"></i></a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Success View Content Block -->
    <div class="success-container">
        <div class="figma-success-card">

            <!-- Cassette: whole, reels turning -->
            <div class="cassette" aria-hidden="true">
                <div class="cassette-label">
                    <small>Checkout, side A</small>
                    <span class="confirmed"><i class="fa-solid fa-circle-check"></i> Order confirmed</span>
                </div>
                <div class="cassette-window">
                    <div class="reel left"></div>
                    <div class="reel right"></div>
                </div>
                <div class="cassette-foot"></div>
            </div>

            <!-- Equalizer: full signal -->
            <div class="eq" aria-hidden="true">
                <% for (let i=0; i < 28; i++) { const h=8 + Math.round(30 * Math.abs(Math.sin(i * 0.9)) * (0.6 + 0.4 *
                    Math.abs(Math.cos(i * 0.37)))); %>
                    <span style="height: <%= h %>px; animation-delay: <%= (0.25 + i * 0.03).toFixed(2) %>s"></span>
                    <% } %>
            </div>

            <h1 class="success-title">Thank you for your order!</h1>

            <div class="status-badge">
                <i class="fa-solid fa-circle-check"></i>
                <span>Payment will be collected upon delivery.</span>
            </div>

            <p class="success-message">Your order has been successfully placed.</p>

            <div class="order-number-text">
                Order Number: <strong>#<%= orderId %></strong>
                <p class="success-message">
                    Order Date:
                    <%= new Date().toLocaleDateString("en-IN") %>
                </p>
            </div>

            <div class="button-group-row">
                <a href="/orders" class="figma-pill-btn">My orders</a>
                <a href="/shop" class="figma-pill-btn outline">Continue shopping</a>
            </div>

        </div>
    </div>

    <!-- Footer -->
    <footer>
        <div class="row text-center footer-logo-container">
            <div class="col-12">
                <img src="/images/logo.png" alt="OneMore Footer Logo">
            </div>
        </div>
        <div class="row g-4">
            <div class="col-md-3">
                <h6 class="footer-heading">Support</h6>
                <ul class="list-unstyled footer-links">
                    <li><a href="#">Order Status</a></li>
                    <li><a href="#">Product Support</a></li>
                    <li><a href="#">Shipping & Return Policy</a></li>
                    <li><a href="#">Complaint Registration</a></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h6 class="footer-heading">About Us</h6>
                <ul class="list-unstyled footer-links">
                    <li><a href="/contact">Contact Us</a></li>
                    <li><a href="#">Privacy Policy</a></li>
                    <li><a href="#">Terms of use</a></li>
                    <li><a href="#">FAQ</a></li>
                </ul>
            </div>
            <div class="col-md-3">
                <h6 class="footer-heading">Contact</h6>
                <div class="footer-contact-text">Email: onemore@gmail.com</div>
                <div class="footer-contact-text">Phone: +91 8888888888</div>
            </div>
            <div class="col-md-3 text-md-end social-column">
                <h6 class="footer-heading text-md-end">Connect with us</h6>
                <div class="social-icons">
                    <a href="#"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#"><i class="fa-brands fa-facebook"></i></a>
                    <a href="#"><i class="fa-brands fa-x-twitter"></i></a>
                </div>
            </div>
        </div>
        <div class="text-center copyright">
            © 2026 onemore. All Rights Reserved.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>