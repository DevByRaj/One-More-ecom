<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Profile | Onemore</title>
  
  <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  
  <style>
    :root { --bg-dark: #1a1a1a; --bg-light: #f0f0eb; --border-color: #ddd; --accent: #1a1a1a; }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    
    body { font-family: 'Poppins', sans-serif; background: var(--bg-dark); color: #1a1a1a; min-height: 100vh; display: flex; flex-direction: column; }

    /* ── NAVBAR ── */
    nav { background: var(--bg-dark); border-bottom: 1px solid rgba(255,255,255,0.06); position: sticky; top: 0; z-index: 100; }
    .nav-inner { display: flex; height: 90px; align-items: center; justify-content: space-between; padding: 0 32px; }
    .logo-img { width: 80px; height: auto; }
    .nav-links { display: flex; gap: 36px; position: absolute; left: 50%; transform: translateX(-50%); }
    .nav-links a { font-size: 14px; color: #ccc; text-decoration: none; transition: color 0.2s; }
    .nav-links a:hover { color: #fff; }
    .nav-icons { display: flex; gap: 18px; }
    .nav-icons svg { width: 22px; height: 22px; stroke: #ccc; fill: none; stroke-width: 1.6; cursor: pointer; }

    /* ── MAIN CONTENT ── */
    main { flex: 1; background: var(--bg-light); padding: 60px 20px; display: flex; justify-content: center; align-items: flex-start; }
    .edit-card { background: #fff; border: 1px solid var(--border-color); border-radius: 12px; width: 100%; max-width: 480px; padding: 40px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
    .card-header { text-align: center; margin-bottom: 30px; }
    .card-header h1 { font-size: 18px; font-weight: 600; letter-spacing: 0.5px; }

    /* ── AVATAR UPLOAD ── */
    .avatar-section { display: flex; justify-content: center; margin-bottom: 30px; }
    .avatar-box { 
      width: 110px; height: 110px; border-radius: 50%; border: 2px solid #eee; 
      position: relative; overflow: hidden; cursor: pointer; background: #fafafa;
    }
    .avatar-box img { width: 100%; height: 100%; object-fit: cover; }
    .upload-hint { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(255,255,255,0.8); opacity: 0; transition: 0.3s; }
    .avatar-box:hover .upload-hint { opacity: 1; }
    .upload-hint svg { width: 24px; fill: #555; margin-bottom: 4px; }
    .upload-hint span { font-size: 10px; font-weight: 600; color: #555; text-transform: uppercase; }
    #fileInput { display: none; }

    /* ── FORM ── */
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; font-size: 11px; font-weight: 600; color: #888; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 8px; }
    .form-group input { width: 100%; border: none; border-bottom: 1px solid #eee; padding: 10px 0; font-size: 14px; font-family: inherit; outline: none; transition: 0.3s; }
    .form-group input:focus { border-bottom-color: var(--accent); }
    .save-btn { width: 100%; background: var(--accent); color: #fff; padding: 14px; border: none; border-radius: 8px; font-weight: 500; font-size: 14px; cursor: pointer; margin-top: 20px; transition: 0.3s; }
    .save-btn:hover { background: #333; transform: translateY(-1px); }

    /* ── CROP MODAL ── */
    .crop-modal { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.85); z-index: 1000; align-items: center; justify-content: center; padding: 20px; }
    .modal-content { background: #fff; width: 100%; max-width: 450px; border-radius: 12px; padding: 24px; }
    .crop-wrapper { width: 100%; height: 320px; background: #f0f0f0; margin: 20px 0; overflow: hidden; }
    .modal-actions { display: flex; gap: 12px; }
    .m-btn { flex: 1; padding: 12px; border-radius: 6px; border: none; font-family: inherit; font-size: 13px; font-weight: 500; cursor: pointer; }
    .m-btn-cancel { background: #eee; color: #444; }
    .m-btn-confirm { background: var(--accent); color: #fff; }

    /* ── FOOTER ── */
    footer { background: var(--bg-dark); padding: 40px 32px 20px; color: #fff; }
    .footer-logo { display: flex; justify-content: center; margin-bottom: 30px; }
    .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 30px; border-bottom: 1px solid rgba(255,255,255,0.06); padding-bottom: 30px; }
    .footer-col-title { font-size: 12px; font-weight: 700; margin-bottom: 15px; color: #fff; }
    .footer-col a { display: block; font-size: 11px; color: #aaa; text-decoration: none; margin-bottom: 8px; }
    .footer-bottom { padding-top: 20px; font-size: 11px; color: #555; text-align: center; }

    #toast { position: fixed; bottom: 30px; right: 30px; background: #333; color: #fff; padding: 12px 24px; border-radius: 8px; font-size: 13px; display: none; z-index: 2000; }

    .error {
  color: red;
  font-size: 12px;
  margin-top: 5px;
}

  </style>
</head>
<body>

<div id="toast"></div>

<div class="crop-modal" id="cropModal">
  <div class="modal-content">
    <h2 style="font-size: 16px; font-weight: 600;">Crop Profile Picture</h2>
    <div class="crop-wrapper">
      <img id="imageToCrop">
    </div>
    <div class="modal-actions">
      <button class="m-btn m-btn-cancel" onclick="closeCropModal()">Cancel</button>
      <button class="m-btn m-btn-confirm" id="confirmCrop">Apply Crop</button>
    </div>
  </div>
</div>

<nav>
  <div class="nav-inner">
    <img src="/images/logo.png" class="logo-img">
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="#">Shop</a>
      <a href="#">Contact Us</a>
      <a href="#">About Us</a>
    </div>
    <div class="nav-icons">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
      <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
    </div>
  </div>
</nav>

<main>
  <div class="edit-card">
    <div class="card-header">
      <h1>Edit Personal Information</h1>
    </div>

  <form id="profileForm" action="/profile/edit" method="POST" enctype="multipart/form-data" novalidate>
      
      <div class="avatar-section">
        <div class="avatar-box" onclick="document.getElementById('fileInput').click()">
          <img id="avatar-preview" src="<%= user.profileImage || '/images/default-user.png' %>">
          <div class="upload-hint">
            <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
            <span>Change</span>
          </div>
          <input type="file" id="fileInput" accept="image/*">
        </div>
      </div>

      
    <div class="form-group">
      <label>First Name</label>
    
      <input type="text" name="fname" value="<%= locals.oldData?.fname || user.name.split(' ')[0] || '' %>"
        style="<%= locals.errors?.fname ? 'border-bottom-color: #c0392b;' : '' %>">
    
      <% if (locals.errors?.fname) { %>
        <div class="error-msg" style="color: #c0392b; font-size: 11px; margin-top: 5px;">
          <%= errors.fname %>
        </div>
        <% } %>
    </div>

    <div class="form-group">
      <label>Last Name</label>
    
      <input type="text" name="lname" value="<%= locals.oldData?.lname || user.name.split(' ')[1] || '' %>"
        style="<%= locals.errors?.lname ? 'border-bottom-color: #c0392b;' : '' %>">
    
      <% if (locals.errors?.lname) { %>
        <div class="error-msg" style="color: #c0392b; font-size: 11px; margin-top: 5px;">
          <%= errors.lname %>
        </div>
        <% } %>
    </div>

<div class="form-group">

  <label>Email Address</label>

  <input type="email" name="email" value="<%= locals.oldData?.email || user.email || '' %>" required
    <%=user.authType==="google" ? "readonly" : "" %>
  style="<%= locals.errors?.email ? 'border-bottom-color: #c0392b;' : '' %>
    <%= user.authType==='google' ? 'background: #f5f5f5; color: #777; cursor: not-allowed;' : '' %>"
      >

      <% if (user.authType==="google" ) { %>

        <div style="color: #777; font-size: 11px; margin-top: 5px;">
          Email cannot be changed for Google login accounts.
        </div>

        <% } %>

          <% if (locals.errors && errors.email) { %>

            <div class="error-msg" style="color: #c0392b; font-size: 11px; margin-top: 5px;">

              <%= errors.email %>

            </div>

            <% } %>

</div>

<div class="form-group">
  <label>Phone Number</label>
  <input type="text" name="phone" 
         value="<%= locals.oldData?.phone || user.phone || '' %>"
         style="<%= locals.errors?.phone ? 'border-bottom-color: #c0392b;' : '' %>">
  <% if (locals.errors && errors.phone) { %>
    <div class="error-msg" style="color: #c0392b; font-size: 11px; margin-top: 5px;"><%= errors.phone %></div>
  <% } %>
</div>

      <button type="submit" class="save-btn">Update Profile</button>
    </form>
  </div>
</main>

<footer>
  <div class="footer-logo"><img src="/images/logo.png" class="logo-img"></div>
  <div class="footer-grid">
    <div class="footer-col"><div class="footer-col-title">SUPPORT</div><a>Order Status</a><a>Shipping & Returns</a></div>
    <div class="footer-col"><div class="footer-col-title">COMPANY</div><a>About Us</a><a>Privacy Policy</a></div>
    <div class="footer-col"><div class="footer-col-title">CONTACT</div><a>onemore@gmail.com</a><a>+91 8888888888</a></div>
    <div class="footer-col"><div class="footer-col-title">SOCIAL</div><a>Instagram</a><a>Facebook</a></div>
  </div>
  <div class="footer-bottom">© 2025 onemore. All Rights Reserved.</div>
</footer>

<script>
  let cropper;
  let croppedBlob = null;
  const fileInput = document.getElementById('fileInput');
  const imageToCrop = document.getElementById('imageToCrop');
  const cropModal = document.getElementById('cropModal');
  const avatarPreview = document.getElementById('avatar-preview');

  // Handle File Pick
  fileInput.addEventListener('change', function(e) {
    const file = e.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (event) => {
        imageToCrop.src = event.target.result;
        cropModal.style.display = 'flex';
        if (cropper) cropper.destroy();
        setTimeout(() => {
          cropper = new Cropper(imageToCrop, {
            aspectRatio: 1,
            viewMode: 1,
            autoCropArea: 1,
            checkOrientation: false
          });
        }, 200);
      };
      reader.readAsDataURL(file);
    }
  });

  // Confirm Crop
  document.getElementById('confirmCrop').addEventListener('click', () => {
    if (!cropper) return;
    const canvas = cropper.getCroppedCanvas({ width: 400, height: 400 });
    canvas.toBlob((blob) => {
      croppedBlob = blob;
      avatarPreview.src = URL.createObjectURL(blob);
      closeCropModal();
    }, 'image/jpeg');
  });

  function closeCropModal() {
    cropModal.style.display = 'none';
    if (cropper) cropper.destroy();
    fileInput.value = "";
  }

  // Handle Submit
  document.getElementById('profileForm').addEventListener('submit', async function(e) {
    if (croppedBlob) {
      e.preventDefault();
      const formData = new FormData(this);
      formData.append('profileImage', croppedBlob, 'user-profile.jpg');
      
      try {
        const response = await fetch(this.action, { method: 'POST', body: formData });
        if (response.redirected) window.location.href = response.url;
        else showToast("Profile updated!");
      } catch (err) { showToast("Error updating profile"); }
    }
  });

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg; t.style.display = 'block';
    setTimeout(() => t.style.display = 'none', 3000);
  }
</script>

</body>
</html>