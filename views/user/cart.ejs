<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Cart | OneMore</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-dark: #121212;
            --text-muted: #777;
            --border-gray: #eaeaea;
            --accent-color: #000;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #fff;
            color: #333;
        }

        /* ── NAVBAR STYLE ── */
      

        /* ── MAIN CONTENT LAYOUT ── */
        .cart-container {
            padding: 60px 50px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .page-title {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 35px;
            color: #111;
            letter-spacing: -0.5px;
        }

        /* ── CART GRID TABLE ── */
        .cart-table-wrapper {
            border: 1px solid var(--border-gray);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .cart-header {
            background-color: #f8f9fa;
            color: #555;
            font-weight: 600;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding: 18px 25px;
            display: grid;
            grid-template-columns: 3fr 1fr 1fr 1fr;
            align-items: center;
            border-bottom: 1px solid var(--border-gray);
        }

        .cart-header div:nth-child(2),
        .cart-header div:nth-child(3),
        .cart-header div:nth-child(4) {
            text-align: center;
        }

        .cart-item-row {
            padding: 25px;
            display: grid;
            grid-template-columns: 3fr 1fr 1fr 1fr;
            align-items: center;
            border-bottom: 1px solid var(--border-gray);
            background-color: #fff;
            transition: background-color 0.2s ease;
        }

        .cart-item-row:hover {
            background-color: #fcfcfc;
        }

        .cart-item-row:last-child {
            border-bottom: none;
        }

        /* Product Block Meta Info */
        .product-meta-block {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .product-link-wrapper {
            display: flex;
            align-items: center;
            gap: 20px;
            text-decoration: none;
            color: inherit;
        }

        .product-link-wrapper:hover .product-name {
            color: #555;
        }

        .cart-img-wrapper {
            width: 100px;
            height: 100px;
            background-color: #f5f5f5;
            border-radius: 8px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border: 1px solid #f0f0f0;
        }

        .cart-img-wrapper img {
            max-width: 100%;
            max-height: 100%;
            object-fit: cover;
        }

        .product-details {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .product-details .product-name {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 4px;
            color: #111;
            transition: color 0.2s;
        }

        .product-variant-info {
            font-size: 13px;
            color: #666;
            margin-bottom: 4px;
        }

        .action-button-group {
            display: flex;
            gap: 15px;
            margin-top: 8px;
        }

        .action-remove-btn,
        .action-save-btn {
            background: none;
            border: none;
            font-size: 13px;
            font-weight: 500;
            padding: 0;
            cursor: pointer;
            transition: color 0.2s;
        }

        .action-remove-btn {
            color: #999;
        }

        .action-remove-btn:hover {
            color: #dc3545;
        }

        .action-save-btn {
            color: #0066cc;
        }

        .action-save-btn:hover {
            color: #004499;
        }

        .item-price,
        .item-total-price {
            font-weight: 600;
            font-size: 16px;
            color: #111;
            text-align: center;
        }

        /* Column Quantity Wrapper Placement Alignment */
        .qty-column-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            width: 100%;
        }

        .qty-controls-container {
            display: inline-flex;
            align-items: center;
            border: 1px solid #ddd;
            border-radius: 25px;
            padding: 4px 8px;
            background-color: #fff;
        }

        .qty-display-box {
            font-size: 14px;
            font-weight: 600;
            padding: 0 10px;
            min-width: 45px;
            text-align: center;
        }

        .qty-btn-circle {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            border: none;
            background: transparent;
            color: #333;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s, color 0.2s;
        }

        .qty-btn-circle:hover {
            background-color: #111;
            color: #fff;
        }

        .qty-btn-circle:disabled {
            opacity: 0.3;
            cursor: not-allowed;
        }

        .qty-btn-circle:disabled:hover {
            background: transparent;
            color: #333;
        }

        /* ── SUMMARY SIDEBAR CONTAINER ── */
        .sticky-summary {
            position: sticky;
            top: 120px;
        }

        .summary-card {
            background-color: #fafdff;
            border-radius: 12px;
            padding: 35px 30px;
            border: 1px solid #eef2f5;
            box-shadow: 0 4px 24px rgba(0, 0, 0, 0.01);
        }

        .summary-title {
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 25px;
            letter-spacing: -0.2px;
            color: #111;
            border-bottom: 1px solid #eee;
            padding-bottom: 15px;
        }

        .summary-line {
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            color: #555;
            margin-bottom: 18px;
        }

        .summary-total-line {
            display: flex;
            justify-content: space-between;
            font-size: 18px;
            font-weight: 700;
            color: #000;
            border-top: 1px solid #eee;
            padding-top: 18px;
            margin-top: 18px;
            margin-bottom: 30px;
        }

        /* Coupon Row Element UI */
        .coupon-dropdown-header {
            border: 1px solid #e0e0e0;
            border-radius: 8px;
            padding: 12px 18px;
            font-size: 13px;
            font-weight: 500;
            background: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            margin-bottom: 25px;
            transition: border-color 0.2s;
        }

        .coupon-dropdown-header:hover {
            border-color: #111;
        }

        /* ── FIGMA SPECIFIC CHECKOUT BUTTON STYLING ── */
        .checkout-btn {
            background: #000;
            color: #fff;
            width: 100%;
            border: none;
            border-radius: 30px;
            padding: 16px;
            font-size: 14px;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: background-color 0.2s ease, transform 0.1s ease;
            display: block;
            text-align: center;
            text-decoration: none;
        }

        .checkout-btn:hover {
            background-color: #222;
            color: #fff;
        }

        .checkout-btn:active {
            transform: scale(0.99);
        }

        .checkout-btn.disabled {
            background: #ccc !important;
            cursor: not-allowed;
            pointer-events: none;
            box-shadow: none;
        }

        /* ── SAVED FOR LATER CONTAINER ── */
        .saved-later-section {
            margin-top: 60px;
        }

        .section-subtitle {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 20px;
            color: #111;
            letter-spacing: -0.3px;
        }

        .saved-header {
            background-color: #f8f9fa;
            color: #555;
            font-weight: 600;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            padding: 18px 25px;
            display: grid;
            grid-template-columns: 3fr 1fr;
            align-items: center;
            border-bottom: 1px solid var(--border-gray);
        }

        .saved-item-row {
            padding: 25px;
            display: grid;
            grid-template-columns: 3fr 1fr;
            align-items: center;
            border-bottom: 1px solid var(--border-gray);
            background-color: #fff;
        }

        .saved-header div:nth-child(2) {
            text-align: center;
        }

        /* ── FOOTER STYLE ── */
        footer {
            background: var(--bg-dark);
            color: #fff;
            padding: 60px 80px 20px;
            margin-top: 120px;
        }

        .footer-logo img {
            height: 65px;
            width: auto;
        }

        .footer-head {
            font-size: 15px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 22px;
            color: #ffdc60;
        }

        .footer-links a {
            color: #fff;
            text-decoration: none;
            font-size: 13px;
            display: block;
            margin-bottom: 12px;
            opacity: 0.8;
            transition: opacity 0.2s;
        }

        .footer-links a:hover {
            opacity: 1;
        }

        .social-icons i {
            font-size: 1.6rem;
            margin-right: 20px;
            cursor: pointer;
            opacity: 0.9;
        }

        /* ── RESPONSIVE COMPATIBILITY UI MEDIA OVERRIDES ── */
        @media (max-width: 992px) {
            nav.navbar {
                padding: 15px 25px;
            }

            .cart-container {
                padding: 40px 20px;
            }

            .cart-header,
            .saved-header {
                font-size: 13px;
                padding: 12px 15px;
            }

            .cart-item-row,
            .saved-item-row {
                padding: 20px 15px;
            }
        }

        @media (max-width: 768px) {

            .cart-header,
            .saved-header {
                display: none;
            }

            .cart-item-row {
                grid-template-columns: 1fr;
                gap: 20px;
                text-align: center;
                border: 1px solid var(--border-gray);
                border-radius: 12px;
                margin-bottom: 20px;
                padding: 25px;
            }

            .saved-item-row {
                grid-template-columns: 1fr;
                gap: 20px;
                text-align: center;
                border: 1px solid var(--border-gray);
                border-radius: 12px;
                margin-bottom: 20px;
                padding: 25px;
            }

            .product-meta-block {
                flex-direction: column;
                align-items: center;
            }

            .product-link-wrapper {
                flex-direction: column;
                text-align: center;
            }

            .product-details {
                align-items: center;
            }

            .item-price::before {
                content: "Price: ";
                font-weight: 500;
                color: #666;
            }

            .qty-controls-container {
                justify-content: center;
                margin: 0 auto;
            }

            .item-total-price::before {
                content: "Total: ";
                font-weight: 500;
                color: #666;
            }

            footer {
                padding: 40px 24px 20px;
            }
        }

        .navbar-toggler-icon {
            filter: invert(1);
        }

        .breadcrumb-wrapper {
            width: 100%;
            background: #fff;
            border-bottom: 1px solid #eee;
            padding: 14px 0;
        }

        .breadcrumb-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 50px;
            font-size: 14px;
            color: #777;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .breadcrumb-container a {
            color: #555;
            text-decoration: none;
            transition: 0.2s;
        }

        .breadcrumb-container a:hover {
            color: #000;
        }

        .active-breadcrumb {
            color: #111;
            font-weight: 600;
        }

        .custom-toast {
            position: fixed;
            top: 30px;
            right: 30px;
            background: #111;
            color: white;
            padding: 14px 22px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            z-index: 9999;
            opacity: 0;
            transform: translateY(-20px);
            transition: all 0.3s ease;
        }

        .custom-toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        /* ── FADE ONLY TEXT, PRICES, AND QUANTITY CONTROLS ── */
.out-of-stock-row .product-name,
.out-of-stock-row .product-variant-info,
.out-of-stock-row .item-price,
.out-of-stock-row .item-total-price,
.out-of-stock-row .qty-column-wrapper {
    opacity: 0.45;
}

/* Grayscale and dim the product image */
.out-of-stock-row .cart-img-wrapper img {
    filter: grayscale(100%);
    opacity: 0.5;
}

/* ── KEEP ACTION BUTTONS COMPLETELY SOLID AND CRISP ── */
.out-of-stock-row .action-button-group {
    opacity: 1 !important;
}

/* ── HIGH VISIBILITY SOLID BADGE ── */
.out-of-stock-badge {
    display: inline-block;
    margin-top: 8px;
    padding: 6px 14px;
    background-color: #e63946 !important; 
    color: #ffffff !important;           
    font-size: 11px;
    font-weight: 700;                    
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    opacity: 1 !important;               
    box-shadow: 0 2px 4px rgba(230, 57, 70, 0.2);
    -webkit-font-smoothing: antialiased; 
}
    </style>
</head>

<body>
<!-- Navbar -->
<%- include("../partials/navbar") %>

    <div class="breadcrumb-wrapper">
        <div class="breadcrumb-container">
            <a href="/">Home</a>
            <span>/</span>
            <span class="active-breadcrumb">Cart</span>
        </div>
    </div>

    <div class="cart-container">
        <h2 class="page-title">Shopping Cart</h2>

        

            <div class="row g-4">
                <div class="col-lg-8">

                    <% if(!cart || cart.items.length===0){ %>
                        <div class="text-center py-5 border rounded-3 mb-4 bg-light">
                            <i class="fa-solid fa-basket-shopping text-muted mb-3" style="font-size: 3.5rem;"></i>
                            <h4>Your active cart is empty</h4>
                            <a href="/shop" class="btn btn-dark mt-3 px-4 rounded-pill">Continue Shopping</a>
                        </div>
                        <% } else { %>
                            <div class="cart-table-wrapper mb-4">
                                <div class="cart-header">
                                    <div>Product</div>
                                    <div>Price</div>
                                    <div>Quantity</div>
                                    <div>Total</div>
                                </div>

                                <% cart.items.forEach(item=> { %>
                                    
                                        <div class="cart-item-row <%= item.variantId.stock === 0 ? 'out-of-stock-row' : '' %>"
                                            data-cart-row="<%= item._id %>">

                                            <div class="product-meta-block flex-column align-items-start gap-2">
                                                <a class="product-link-wrapper"
                                                    href="/productDetails?id=<%= item.productId._id %>&variant=<%= item.variantId._id %>">
                                                    <div class="cart-img-wrapper">
                                                        <img src="<%= item.variantId.variantImage[0] %>"
                                                            alt="<%= item.productId.productName %>">
                                                    </div>
                                                    <div class="product-details">
                                                        <div class="product-name">
                                                            <%= item.productId.productName %>
                                                        </div>
                                                        <div class="product-variant-info">
                                                            Color: <strong>
                                                                <%= item.variantId.variantName %>
                                                            </strong>
                                                        </div>
                                                        <% if(item.variantId.stock===0){ %>
                                                            <div class="out-of-stock-badge">Out of Stock</div>
                                                            <% } %>
                                                    </div>
                                                </a>

                                                <div class="action-button-group mt-2">
                                                    <button type="button" class="action-save-btn"
                                                        onclick="saveForLater(event, '<%= item._id %>')">
                                                        Save for Later
                                                    </button>
                                                    <button type="button" class="action-remove-btn"
                                                        onclick="removeCartItem(event, '<%= item._id %>')">
                                                        Remove
                                                    </button>
                                                </div>
                                            </div>

                                        <div class="item-price">
                                        
                                            <% if(item.offer && item.offer.appliedOffer){ %>
                                        
                                                <div class="fw-bold">
                                                    ₹<%= item.offer.finalPrice.toFixed(2) %>
                                                </div>
                                        
                                                <small class="text-muted text-decoration-line-through">
                                                    ₹<%= item.offer.originalPrice.toFixed(2) %>
                                                </small>
                                        
                                                <br>
                                        
                                                <small class="text-success fw-semibold">
                                        
                                                    <%= item.offer.appliedOffer.offerName %>
                                        
                                                        -
                                        
                                                        <% if(item.offer.appliedOffer.offerType==="PERCENTAGE" ){ %>
                                        
                                                            <%= item.offer.appliedOffer.discountValue %>% OFF
                                        
                                                                <% } else { %>
                                        
                                                                    ₹<%= item.offer.appliedOffer.discountValue %> OFF
                                        
                                                                        <% } %>
                                        
                                                </small>
                                        
                                                <% } else { %>
                                        
                                                    ₹<%= item.variantId.salePrice %>
                                        
                                                        <% } %>
                                        
                                        </div>
                                            <div class="qty-column-wrapper">
                                                <div class="qty-controls-container">
                                                    <button class="qty-btn-circle quantity-btn" data-action="decrease"
                                                        data-id="<%= item._id %>" <%=item.variantId.stock===0
                                                        ? "disabled" : "" %>>-</button>
                                                    <div class="qty-display-box quantity-value">
                                                        <%= item.quantity %>
                                                    </div>
                                                    <button class="qty-btn-circle quantity-btn" data-action="increase"
                                                        data-id="<%= item._id %>" <%=item.variantId.stock===0
                                                        ? "disabled" : "" %>>+</button>
                                                </div>
                                                <% if(item.quantity> item.variantId.stock && item.variantId.stock > 0){
                                                    %>
                                                    <p class="text-danger small mt-2 mb-0 text-center">Only <%=
                                                            item.variantId.stock %> available</p>
                                                    <% } %>
                                            </div>

                                            <div class="item-total-price">
                                            
                                                ₹<%= ( item.offer ? item.offer.finalPrice : item.variantId.salePrice ) * item.quantity %>
                                            
                                            </div>
                                        </div>
                                        <% }) %>
                            </div>
                            <% } %>

                                <div class="saved-later-section">
                                    <h3 class="section-subtitle">Saved for Later</h3>

                                    <% if (typeof savedItems==='undefined' || !savedItems || savedItems.length===0){ %>
                                        <div class="text-center py-4 border rounded-3 bg-light opacity-75">
                                            <p class="text-muted mb-0 small">No items saved for later yet.</p>
                                        </div>
                                        <% } else { %>
                                            <div class="cart-table-wrapper">
                                                <div class="saved-header">
                                                    <div>Product</div>
                                                    <div>Price</div>
                                                </div>

                                                <% savedItems.forEach(item=> { %>
                                                    <div class="saved-item-row" data-saved-row="<%= item._id %>">
                                                        <div class="product-meta-block">
                                                            <a class="product-link-wrapper"
                                                                href="/productDetails?id=<%= item.productId._id %>&variant=<%= item.variantId._id %>">
                                                                <div class="cart-img-wrapper">
                                                                    <img src="<%= item.variantId.variantImage[0] %>"
                                                                        alt="<%= item.productId.productName %>">
                                                                </div>
                                                                <div class="product-details">
                                                                    <div class="product-name">
                                                                        <%= item.productId.productName %>
                                                                    </div>
                                                                    <div class="product-variant-info">
                                                                        Color: <strong>
                                                                            <%= item.variantId.variantName %>
                                                                        </strong>
                                                                    </div>
                                                                </div>
                                                            </a>
                                                            <div class="action-button-group">
                                                                <button type="button"
                                                                    class="action-save-btn text-success"
                                                                    onclick="moveToCart(event, '<%= item._id %>')">
                                                                    Move to Cart
                                                                </button>
                                                                <button type="button" class="action-remove-btn"
                                                                    onclick="removeSavedItem(event, '<%= item._id %>')">
                                                                    Remove
                                                                </button>
                                                            </div>
                                                        </div>

                                                        <div class="item-price">
                                                        
                                                            <% if(item.offer && item.offer.appliedOffer){ %>
                                                        
                                                                <div class="fw-bold">
                                                                    ₹<%= item.offer.finalPrice.toFixed(2) %>
                                                                </div>
                                                        
                                                                <small class="text-muted text-decoration-line-through">
                                                                    ₹<%= item.offer.originalPrice.toFixed(2) %>
                                                                </small>
                                                        
                                                                <br>
                                                        
                                                                <small class="text-success fw-semibold">
                                                        
                                                                    <%= item.offer.appliedOffer.offerName %>
                                                        
                                                                        -
                                                        
                                                                        <% if(item.offer.appliedOffer.offerType==="PERCENTAGE" ){ %>
                                                        
                                                                            <%= item.offer.appliedOffer.discountValue %>% OFF
                                                        
                                                                                <% } else { %>
                                                        
                                                                                    ₹<%= item.offer.appliedOffer.discountValue %> OFF
                                                        
                                                                                        <% } %>
                                                        
                                                                </small>
                                                        
                                                                <% } else { %>
                                                        
                                                                    ₹<%= item.variantId.salePrice %>
                                                        
                                                                        <% } %>
                                                        
                                                        </div>
                                                    </div>
                                                    <% }) %>
                                            </div>
                                            <% } %>
                                </div>

                </div>

                <div class="col-lg-4">
                    <div class="sticky-summary">
                        <div class="summary-card">
                            <div class="summary-title">Order Summary</div>

                            <div class="summary-line">
                                <span>Subtotal</span>
                                <strong id="cartSubtotal">
                                    ₹<%= totals.subtotal %>
                                </strong>
                            </div>
                            <div class="summary-line">
                                <span>Shipping</span>
                            
                                <span id="shippingCharge">
                                    <% if(totals.shipping> 0){ %>
                                        ₹<%= totals.shipping %>
                                            <% } else { %>
                                                <span class="text-success fw-semibold">Free</span>
                                                <% } %>
                                </span>
                            </div>

                            <div id="freeShippingMessage" class="small text-muted mb-3">
                                <% if(totals.shipping> 0){ %>
                                    Spend only
                                    <strong>₹<%= freeShippingLimit - totals.subtotal %></strong>
                                    more to get
                                    <span class="text-success fw-semibold">FREE Shipping</span>.
                                    <% } %>
                            </div>

                            <div class="summary-total-line">
                                <span>Total</span>
                                <strong id="grandTotal">
                                    ₹<%= totals.grandTotal %>
                                </strong>
                            </div>

                            <div class="coupon-dropdown-header">
                                <span><i class="fa-solid fa-ticket me-2 opacity-75"></i> Apply Coupon</span>
                                <i class="fa-solid fa-chevron-down small"></i>
                            </div>

                            <% let holdsOverstock=cart && cart.items.some(item=> item.quantity > item.variantId.stock);
                                %>
                                <a href="/checkout"
                                    class="checkout-btn <%= (!cart || cart.items.length === 0 || holdsOverstock) ? 'disabled' : '' %>">
                                    Proceed to Checkout
                                </a>
                        </div>
                    </div>
                </div>
            </div>
    </div>

    
