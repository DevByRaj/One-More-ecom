    <script>
        const FREE_SHIPPING_LIMIT = <%= freeShippingLimit %>;
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        const quantityButtons = document.querySelectorAll(".quantity-btn");

        quantityButtons.forEach(button => {
            button.addEventListener("click", async () => {
                const cartItemId = button.dataset.id;
                const action = button.dataset.action;

                const quantityElement = button.parentElement.querySelector(".quantity-value");
                let currentQuantity = Number(quantityElement.innerText);

                if (action === "decrease" && currentQuantity <= 1) {
                    showToast("Quantity cannot be less than 1");
                    return;
                }

                try {
                    const response = await fetch("/cart/update-quantity", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ cartItemId, action })
                    });

                    const data = await response.json();

                    if (!data.success) {
                        showToast(data.message);
                        return;
                    }

                    if (action === "increase") {
                        currentQuantity += 1;
                    } else {
                        currentQuantity -= 1;
                    }
                    quantityElement.innerText = currentQuantity;

                    const cartRow = button.closest(".cart-item-row");
                    if (cartRow) {
                        const priceElement = cartRow.querySelector(".item-price");
                        const totalElement = cartRow.querySelector(".item-total-price");

                        if (priceElement && totalElement) {
                            let unitPrice = 0;

                            const finalPriceElement = priceElement.querySelector(".fw-bold");

                            if (finalPriceElement) {
                                unitPrice = parseFloat(
                                    finalPriceElement.innerText.replace(/[^\d.]/g, "")
                                );
                            } else {
                                unitPrice = parseFloat(
                                    priceElement.innerText.replace(/[^\d.]/g, "")
                                );
                            }

                            const newRowTotal = unitPrice * currentQuantity;

                            totalElement.innerText = `₹${newRowTotal.toFixed(2)}`;
                        }
                    }

                    updateCartTotals();

                } catch (error) {
                    console.error("Error updating quantity:", error);
                }
            });
        });

        function showToast(message) {
            const existingToast = document.querySelector(".custom-toast");
            if (existingToast) { existingToast.remove(); }

            const toast = document.createElement("div");
            toast.className = "custom-toast";
            toast.innerText = message;
            document.body.appendChild(toast);

            setTimeout(() => { toast.classList.add("show"); }, 100);

            setTimeout(() => {
                toast.classList.remove("show");
                setTimeout(() => { toast.remove(); }, 300);
            }, 2500);
        }

        function updateCartTotals() {

                let subtotal = 0;

                document.querySelectorAll(".cart-item-row .item-total-price").forEach(item => {
                    subtotal += Number(item.innerText.replace(/[^\d]/g, ""));
                });

                let shipping = 0;

                if (subtotal > 0 && subtotal < FREE_SHIPPING_LIMIT) {
                    shipping = 99;
                }

                const grandTotal = subtotal + shipping;

                document.getElementById("cartSubtotal").innerText = `₹${subtotal}`;
                document.getElementById("grandTotal").innerText = `₹${grandTotal}`;

                // Update Shipping
                const shippingElement = document.getElementById("shippingCharge");

                if (shipping === 0) {
                    shippingElement.innerHTML =
                        '<span class="text-success fw-semibold">Free</span>';
                } else {
                    shippingElement.innerHTML = `₹${shipping}`;
                }

                // Update Free Shipping Message
                const freeShippingMessage = document.getElementById("freeShippingMessage");

                if (shipping > 0) {
                    freeShippingMessage.innerHTML = `
            Spend only <strong>₹${FREE_SHIPPING_LIMIT - subtotal}</strong>
            more to get
            <span class="text-success fw-semibold">FREE Shipping</span>.
        `;
                } else {
                    freeShippingMessage.innerHTML = "";
                }
            }

        async function removeCartItem(event, cartItemId) {
            event.preventDefault();
            event.stopPropagation();

            const result = await Swal.fire({
                title: "Remove Product?",
                text: "Are you sure you want to remove this item from your cart?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Remove",
                cancelButtonText: "Cancel",
                confirmButtonColor: "#dc3545"
            });

            if (!result.isConfirmed) return;

            const response = await fetch("/cart/remove/" + cartItemId, {
                method: "POST"
            });

            if (response.ok) {
                await Swal.fire({
                    icon: "success",
                    title: "Removed",
                    text: "Product removed from cart",
                    timer: 1500,
                    showConfirmButton: false
                });
                location.reload();
            }
        }

        async function saveForLater(event, cartItemId) {
            event.preventDefault();
            event.stopPropagation();

            try {
                const response = await fetch(`/cart/save-for-later/${cartItemId}`, {
                    method: "POST"
                });
                const data = await response.json();

                if (data.success) {
                    showToast("Item saved for later successfully");
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast(data.message || "Failed to save item");
                }
            } catch (error) {
                console.error("Error saving for later:", error);
            }
        }

        async function moveToCart(event, savedItemId) {
            event.preventDefault();
            event.stopPropagation();

            try {
                const response = await fetch(`/cart/move-to-cart/${savedItemId}`, {
                    method: "POST"
                });
                const data = await response.json();

                if (data.success) {
                    showToast("Item moved back to cart");
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast(data.message || "Failed to move item");
                }
            } catch (error) {
                console.error("Error moving back to cart:", error);
            }
        }

        async function removeSavedItem(event, savedItemId) {
            event.preventDefault();
            event.stopPropagation();

            const result = await Swal.fire({
                title: "Delete Item?",
                text: "Remove this saved item permanently?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Delete",
                cancelButtonText: "Cancel",
                confirmButtonColor: "#dc3545"
            });

            if (!result.isConfirmed) return;

            try {
                const response = await fetch(`/cart/remove-saved/${savedItemId}`, {
                    method: "POST"
                });
                if (response.ok) {
                    showToast("Saved item deleted");
                    setTimeout(() => location.reload(), 800);
                }
            } catch (error) {
                console.error("Error deleting saved item:", error);
            }
        }
    </script>
</body>

</html>