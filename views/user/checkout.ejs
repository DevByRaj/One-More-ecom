        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

        <script>
            function selectCardWrapper(cardElement) {
                document.querySelectorAll('.address-select-card').forEach(card => {
                    card.classList.remove('selected-active');
                });

                cardElement.classList.add('selected-active');
                const radioInput = cardElement.querySelector('input[name="addressSelect"]');
                if (radioInput) radioInput.checked = true;
            }

            function useSelectedAddress() {
                const selected = document.querySelector('input[name="addressSelect"]:checked');
                if (!selected) return;

                document.getElementById("selectedAddressId").value = selected.value;
                document.getElementById("displayName").innerText = selected.dataset.name;
                document.getElementById("displayAddress").innerHTML = `
    ${selected.dataset.house},
    ${selected.dataset.street},
    ${selected.dataset.city},
    ${selected.dataset.state},
    ${selected.dataset.country} -
    ${selected.dataset.pincode}
`;
            
                document.getElementById("displayPhone").innerHTML = `Phone: ${selected.dataset.phone}`;

                const modalEl = document.getElementById("addressModal");
                bootstrap.Modal.getInstance(modalEl).hide();
            }
        </script>

        <script>

            const checkoutForm = document.getElementById("checkoutForm");

            checkoutForm.addEventListener("submit", async function (e) {

                const paymentMethod =
                    document.querySelector('input[name="paymentMethod"]:checked').value;

                if (paymentMethod === "COD") {
                    return;
                }

                e.preventDefault();

                try {

                   const addressId =
                        document.getElementById("selectedAddressId").value;

                    const response = await fetch("/payment/create-order", {

                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify({
                            addressId
                        })

                    });

                    const data = await response.json();

                    const pendingOrderId = data.pendingOrderId

                    if (!data.success) {
                        alert("Unable to create Razorpay Order");
                        return;
                    }

                    const options = {
                        key: data.key,
                        amount: data.order.amount,
                        currency: data.order.currency,
                        name: "OneMore",
                        description: "Order Payment",
                        order_id: data.order.id,

                        handler: async function (response) {

                            const addressId =
                                document.getElementById("selectedAddressId").value;

                            const verifyResponse = await fetch("/payment/verify", {

                                method: "POST",

                                headers: {
                                    "Content-Type": "application/json"
                                },

                                body: JSON.stringify({

                                    razorpay_order_id: response.razorpay_order_id,
                                    razorpay_payment_id: response.razorpay_payment_id,
                                    razorpay_signature: response.razorpay_signature,
                                    addressId

                                })

                            });

                            const verifyData = await verifyResponse.json();

                            if (verifyData.success) {

                                window.location.href =
                                    `/order-success/${verifyData.orderId}`;

                            } else {

                                alert("Payment verification failed");

                            }

                        },

                        modal: {
                            ondismiss: function () {

                                console.log("Razorpay popup dismissed");
                                console.log("Pending Order ID:", pendingOrderId);

                                window.location.href = `/payment-failed/${pendingOrderId}`;
                            }
                        },

                        theme: {
                            color: "#000000"
                        }
                    };

                    const rzp = new Razorpay(options);

                    rzp.on("payment.failed", function () {

                        console.log("Payment Failed Event");
                        console.log("Pending Order ID:", pendingOrderId);

                        window.location.href = `/payment-failed/${pendingOrderId}`;

                    });

                    rzp.open();

                } catch (err) {

                    console.log(err);

                }

            });

        </script>

        <script>

        async function applyCoupon(couponCode) {

                if (!couponCode || couponCode.trim() === "") {

                    showCouponMessage(
                        "Please enter a coupon code.",
                        false
                    );

                    return;
                }

                try {

                    const response = await fetch("/checkout/apply-coupon", {

                        method: "POST",

                        headers: {
                            "Content-Type": "application/json"
                        },

                        body: JSON.stringify({
                            couponCode: couponCode.trim()
                        })

                    });

                    const data = await response.json();

                    if (!data.success) {

                        showCouponMessage(
                            data.message,
                            false
                        );

                        return;
                    }

                    // Update discount immediately
                    document.getElementById("checkoutDiscount").textContent =
                        Number(data.discount).toFixed(2);

                    // Get current subtotal
                    const subtotal =
                        Number(document.getElementById("checkoutSubtotal").textContent);

                    // Get shipping
                    const shippingElement =
                        document.getElementById("checkoutShipping");

                    let shipping = 0;

                    if (shippingElement && !shippingElement.innerText.includes("Free")) {
                        shipping =
                            Number(shippingElement.textContent);
                    }

                    // Calculate new total
                    const grandTotal =
                        subtotal - Number(data.discount) + shipping;

                    // Update total immediately
                    document.getElementById("checkoutGrandTotal").textContent =
                        grandTotal.toFixed(2);

                       document.querySelectorAll(".coupon-card").forEach(card => {

                        const cardCode =
                            card.dataset.couponCode.toUpperCase();

                        const appliedCode =
                            data.couponCode.toUpperCase();

                        card.style.display =
                            cardCode === appliedCode
                                ? "none"
                                : "flex";
                    });

                    showCouponMessage(
                        `Coupon applied successfully. You saved ₹${Number(data.discount).toFixed(2)}`,
                        true
                    );

                    document.getElementById("removeCouponContainer").style.display = "block";

                } catch (error) {

                    console.log(error);

                    showCouponMessage(
                        "Unable to apply coupon.",
                        false
                    );
                }
            }


            function showCouponMessage(message, success) {

                const messageElement =
                    document.getElementById("couponMessage");

                messageElement.innerText = message;

                messageElement.className =
                    success
                        ? "small mt-2 text-success"
                        : "small mt-2 text-danger";
            }


            // Manual coupon
            document.getElementById("couponForm")
                ?.addEventListener("submit", function (event) {

                    event.preventDefault();

                    const couponCode =
                        document.getElementById("couponCode").value;

                    applyCoupon(couponCode);

                });


            // Available coupon buttons
            document.querySelectorAll(".apply-coupon-btn")
                .forEach(button => {

                    button.addEventListener("click", function () {

                        const couponCode =
                            this.dataset.code;

                        applyCoupon(couponCode);

                    });

                });

                document.getElementById("removeCouponBtn")
                        ?.addEventListener("click", async function () {

                            try {

                                const response = await fetch("/remove-coupon", {
                                    method: "POST"
                                });

                                const data = await response.json();

                                if (!data.success) {

                                    showCouponMessage(
                                        data.message,
                                        false
                                    );

                                    return;
                                }

                                // Reload checkout so totals and coupons are refreshed
                                window.location.reload();

                            } catch (error) {

                                console.log(error);

                                showCouponMessage(
                                    "Unable to remove coupon.",
                                    false
                                );
                            }

                        });

                        const addAddressForm = document.getElementById("addAddressForm");

                            if (addAddressForm) {

                                addAddressForm.addEventListener("submit", async function (e) {

                                    e.preventDefault();

                                    const errorElement =
                                        document.getElementById("addAddressError");

                                    errorElement.textContent = "";

                                    const formData = new FormData(addAddressForm);

                                    const data = Object.fromEntries(formData.entries());

                                    try {

                                        const response = await fetch("/checkout/address/add", {
                                            method: "POST",
                                            headers: {
                                                "Content-Type": "application/json"
                                            },
                                            body: JSON.stringify(data)
                                        });

                                        const result = await response.json();

                                        if (!result.success) {

                                            errorElement.textContent =
                                                result.message || "Unable to add address";

                                            return;
                                        }

                                        const address = result.address;

                                        // Update selected address
                                        document.getElementById("selectedAddressId").value =
                                            address._id;

                                        document.getElementById("displayName").innerText =
                                            address.name;

                                        document.getElementById("displayAddress").innerText =
                                            `${address.houseName}, ${address.street || ""}, ${address.city}, ${address.state}, ${address.country} - ${address.pincode}`;

                                        document.getElementById("displayPhone").innerText =
                                            `Phone: ${address.phone}`;

                                        // Close Add Address modal
                                        const addModal =
                                            bootstrap.Modal.getInstance(
                                                document.getElementById("addAddressModal")
                                            );

                                        if (addModal) {
                                            addModal.hide();
                                        }

                                        // Reset form
                                        addAddressForm.reset();

                                        // Show success toast if your checkout already has showToast()
                                        if (typeof showToast === "function") {
                                            showToast("Address added successfully", "success");
                                        }

                                    } catch (error) {

                                        console.error("Add address error:", error);

                                        errorElement.textContent =
                                            "Unable to add address. Please try again.";
                                    }

                                });

                            }

        </script>
        
</body>

</html>