<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Failed | OneMore</title>
    <link rel="icon" type="image/png" href="/images/logo.png">

    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <style>
        :root {
            --bg-dark: #181818;
            --text-gold: #e2d192;
            --text-red: #d32f2f;
            --text-white: #ffffff;
            --text-gray: #a0a0a0;
            --border-color: #000000;
            --paper: #f0f0eb;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            background-color: #ffffff;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* ================= HEADER ================= */
        header {
            background-color: var(--bg-dark);
            color: var(--text-white);
            padding: 1rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .logo span {
            display: inline-block;
            transform: translateY(-2px);
        }

        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }

        .nav-links a {
            color: var(--text-gold);
            font-size: 0.95rem;
            font-weight: 500;
            transition: opacity 0.2s;
        }

        .nav-links a:hover {
            opacity: 0.8;
        }

        .header-icons {
            display: flex;
            gap: 1.2rem;
            font-size: 1.2rem;
        }

        .header-icons a {
            color: var(--text-white);
        }

        /* ================= MAIN CONTENT ================= */
        main {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 3rem 1rem;
            background: var(--paper);
        }

        .card {
            background: var(--bg-dark);
            color: var(--text-white);
            border: 1px solid #2a2a2a;
            border-radius: 22px;
            padding: 3rem 2.2rem 2.8rem;
            width: 100%;
            max-width: 580px;
            text-align: center;
            box-shadow: 0 30px 60px -25px rgba(0, 0, 0, 0.5);
            animation: cardAppear 0.5s ease;
        }

        @keyframes cardAppear {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ---------- BROKEN CASSETTE: cracked in two, tape unspooled, reel knocked out ---------- */
        .tape-scene {
            position: relative;
            width: 260px;
            height: 250px;
            margin: 0 auto 0.6rem;
        }

        .shard {
            position: absolute;
            inset: 0 0 auto 0;
            height: 170px;
            filter: drop-shadow(0 14px 14px rgba(0, 0, 0, 0.55));
        }

        .shard.a {
            transform-origin: 0 100%;
            transform: translate(-8px, 2px) rotate(-4deg);
            animation: snapA 0.7s 0.25s cubic-bezier(.2, .8, .2, 1) both;
        }

        .shard.b {
            transform-origin: 100% 100%;
            transform: translate(10px, 8px) rotate(5deg);
            animation: snapB 0.7s 0.25s cubic-bezier(.2, .8, .2, 1) both;
        }

        /* Same jagged crack line on both halves so they fit together */
        .shard.a .clip {
            clip-path: polygon(0 0, 48% 0, 44% 14%, 52% 28%, 45% 44%, 56% 60%, 50% 78%, 57% 100%, 0 100%);
        }

        .shard.b .clip {
            clip-path: polygon(48% 0, 100% 0, 100% 100%, 57% 100%, 50% 78%, 56% 60%, 45% 44%, 52% 28%, 44% 14%);
        }

        @keyframes snapA {
            from {
                transform: none;
            }
        }

        @keyframes snapB {
            from {
                transform: none;
            }
        }

        .cassette {
            position: relative;
            width: 260px;
            height: 170px;
            background: var(--paper);
            border-radius: 14px;
        }

        /* corner screws */
        .cassette::before {
            content: "";
            position: absolute;
            inset: 8px;
            border-radius: 8px;
            background:
                radial-gradient(circle at 4px 4px, #9a9a92 0 2.5px, transparent 3px),
                radial-gradient(circle at calc(100% - 4px) 4px, #9a9a92 0 2.5px, transparent 3px),
                radial-gradient(circle at 4px calc(100% - 4px), #9a9a92 0 2.5px, transparent 3px),
                radial-gradient(circle at calc(100% - 4px) calc(100% - 4px), #9a9a92 0 2.5px, transparent 3px);
            pointer-events: none;
        }

        .cassette-label {
            position: absolute;
            top: 16px;
            left: 22px;
            right: 22px;
            height: 70px;
            background: #fff;
            border-radius: 6px;
            border-top: 7px solid var(--text-red);
            padding: 6px 12px 0;
            text-align: left;
        }

        .cassette-label small {
            display: block;
            font-size: 0.68rem;
            color: #777;
        }

        .cassette-label .order-number {
            display: block;
            color: var(--text-red);
            font-weight: 600;
            font-size: 0.95rem;
            line-height: 1.25;
            margin-top: 2px;
            word-break: break-all;
        }

        .cassette-window {
            position: absolute;
            left: 50%;
            bottom: 32px;
            width: 150px;
            height: 44px;
            margin-left: -75px;
            border-radius: 22px;
            background: #181818;
        }

        .reel {
            position: absolute;
            top: 50%;
            width: 32px;
            height: 32px;
            margin-top: -16px;
            border-radius: 50%;
            background: repeating-conic-gradient(var(--paper) 0 30deg, #4a4a4a 30deg 60deg);
        }

        .reel::after {
            content: "";
            position: absolute;
            inset: 10px;
            border-radius: 50%;
            background: #181818;
        }

        .reel.left {
            left: 6px;
        }

        /* the right reel is gone: only an empty socket remains */
        .reel.right {
            right: 6px;
            background: #2b2b2b;
        }

        .reel.right::after {
            inset: 9px;
            background: #0d0d0d;
        }

        .cassette-foot {
            position: absolute;
            left: 44px;
            right: 44px;
            bottom: 0;
            height: 20px;
            border-radius: 6px 6px 14px 14px;
            background: #cfcfc8;
        }

        /* the knocked-out reel, lying on the card */
        .loose-reel {
            position: absolute;
            left: 168px;
            top: 196px;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: repeating-conic-gradient(var(--paper) 0 30deg, #4a4a4a 30deg 60deg);
            transform: rotate(18deg);
            box-shadow: 0 8px 12px -4px rgba(0, 0, 0, 0.7);
        }

        .loose-reel::after {
            content: "";
            position: absolute;
            inset: 13px;
            border-radius: 50%;
            background: #181818;
        }

        /* loose tape (SVG overlay) */
        .tape {
            position: absolute;
            inset: 0;
            width: 260px;
            height: 250px;
            overflow: visible;
            pointer-events: none;
        }

        .tape path {
            fill: none;
            stroke: #8a5a34;
            stroke-width: 3;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* ---------- TEXT ---------- */
        .status-title {
            font-size: 1.75rem;
            font-weight: 700;
            color: var(--text-white);
            margin-bottom: 0.6rem;
        }

        .error-msg {
            color: var(--text-gray);
            font-size: 0.92rem;
            font-weight: 300;
            margin-bottom: 0.9rem;
        }

        .order-line {
            color: var(--text-gray);
            font-size: 0.85rem;
            margin-bottom: 2rem;
            word-break: break-all;
        }

        .order-line strong {
            color: #ff7a7a;
            font-weight: 600;
        }

        /* ---------- BUTTONS ---------- */
        .btn-group {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 14px;
        }

        .action-btn {
            width: 200px;
            height: 50px;

            display: inline-flex;
            justify-content: center;
            align-items: center;
            gap: 9px;

            background: var(--text-gold);
            color: #181818 !important;

            border: 1px solid var(--text-gold);
            border-radius: 30px;

            text-decoration: none;
            text-align: center;

            font-size: 15px;
            font-weight: 600;
            line-height: 1;

            cursor: pointer;

            padding: 0;
            margin: 0;

            box-sizing: border-box;

            transition: .3s ease;

            appearance: none;
            -webkit-appearance: none;
        }

        .action-btn:hover {
            background: #efe2ad;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(226, 209, 146, 0.25);
        }

        .action-btn.outline {
            background: transparent;
            color: #fff !important;
            border-color: #555;
            font-weight: 500;
        }

        .action-btn.outline:hover {
            background: #fff;
            color: #181818 !important;
            border-color: #fff;
            box-shadow: none;
        }

        .action-btn:focus-visible {
            outline: 3px solid #fff;
            outline-offset: 3px;
        }

        /* ================= FOOTER ================= */
        footer {
            background-color: var(--bg-dark);
            color: var(--text-white);
            padding: 3rem 5% 1.5rem 5%;
        }

        .footer-logo {
            text-align: center;
            font-size: 3rem;
            font-weight: 800;
            margin-bottom: 3rem;
        }

        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 2rem;
            max-width: 1200px;
            margin: 0 auto 3rem auto;
        }

        .footer-col h4 {
            color: var(--text-gold);
            font-size: 1.1rem;
            margin-bottom: 1.2rem;
            font-weight: 600;
        }

        .footer-col ul {
            list-style: none;
        }

        .footer-col ul li {
            margin-bottom: 0.6rem;
        }

        .footer-col ul li a {
            color: var(--text-white);
            font-size: 0.88rem;
            transition: color 0.2s;
        }

        .footer-col ul li a:hover {
            color: var(--text-gold);
        }

        .contact-info p {
            font-size: 0.88rem;
            margin-bottom: 0.6rem;
        }

        .contact-info strong {
            color: var(--text-white);
        }

        .social-icons {
            display: flex;
            gap: 1.2rem;
            font-size: 1.5rem;
        }

        .social-icons a {
            color: var(--text-white);
            transition: color 0.2s;
        }

        .social-icons a:hover {
            color: var(--text-gold);
        }

        .footer-bottom {
            border-top: 1px solid #2a2a2a;
            padding-top: 1.5rem;
            max-width: 1200px;
            margin: 0 auto;
            font-size: 0.8rem;
            color: var(--text-gray);
        }

        /* ================= RESPONSIVE DESIGN ================= */
        @media (max-width: 768px) {
            header {
                flex-direction: column;
                gap: 1rem;
            }

            .nav-links {
                gap: 1rem;
            }

            .card {
                padding: 2.2rem 1.3rem 2.2rem;
                border-radius: 16px;
            }

            .tape-scene {
                transform: scale(0.9);
                transform-origin: top center;
                margin-bottom: -0.6rem;
            }

            .status-title {
                font-size: 1.4rem;
            }

            .btn-group {
                flex-direction: column;
                width: 100%;
            }

            .action-btn {
                width: 100%;
                max-width: 260px;
            }
        }

        @media (prefers-reduced-motion: reduce) {

            .card,
            .shard {
                animation: none;
            }
        }
    </style>
</head>

<body>

    <!-- Header -->
    <%- include("../partials/navbar") %>

        <!-- Main Content -->
        <main>
            <div class="card">

                <!-- Broken cassette: two halves, empty reel socket, tape unspooled -->
                <div class="tape-scene" aria-hidden="true">
                    <% ['a', 'b' ].forEach(function (half) { %>
                        <div class="shard <%= half %>">
                            <div class="clip">
                                <div class="cassette">
                                    <div class="cassette-label">
                                        <small>Checkout, side A</small>
                                        <span class="order-number">
                                            <%= orderId %>
                                        </span>
                                    </div>
                                    <div class="cassette-window">
                                        <div class="reel left"></div>
                                        <div class="reel right"></div>
                                    </div>
                                    <div class="cassette-foot"></div>
                                </div>
                            </div>
                        </div>
                        <% }); %>

                            <div class="loose-reel"></div>

                            <svg class="tape" viewBox="0 0 260 250">
                                <!-- tape spilling from the left reel toward the fallen reel -->
                                <path d="M65 113 C58 150 100 150 96 178 S130 214 170 212"></path>
                                <path d="M65 113 C50 140 72 168 80 190" opacity="0.55"></path>
                                <!-- snapped, frayed strand from the empty socket -->
                                <path d="M198 118 C206 140 190 152 196 168"></path>
                                <path d="M196 168 l-5 6 M196 168 l1 8 M196 168 l6 5"></path>
                            </svg>
                </div>

                <h1 class="status-title">Payment didn't go through</h1>

                <p class="error-msg">
                    Payment failed. Please try again.
                </p>

                <p class="order-line">
                    Order Number: <strong>
                        <%= orderId %>
                    </strong>
                </p>

                <div class="btn-group">
                    <button id="retryPaymentBtn" class="action-btn">
                        <i class="fa-solid fa-backward"></i> Try Again
                    </button>

                    <a href="/shop" class="action-btn outline">
                        Continue shopping
                    </a>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer>
            <div class="footer-logo">1M</div>

            <div class="footer-grid">
                <div class="footer-col">
                    <h4>SUPPORT</h4>
                    <ul>
                        <li><a href="/order-status">Order Status</a></li>
                        <li><a href="/product-support">Product Support</a></li>
                        <li><a href="/shipping-policy">Shipping & Return Policy</a></li>
                        <li><a href="/complaints">Complaint Registration</a></li>
                    </ul>
                </div>

                <div class="footer-col">
                    <h4>About Us</h4>
                    <ul>
                        <li><a href="/contact">Contact Us</a></li>
                        <li><a href="/privacy-policy">Privacy Policy</a></li>
                        <li><a href="/terms">Terms of use</a></li>
                        <li><a href="/faq">FAQ</a></li>
                    </ul>
                </div>

                <div class="footer-col contact-info">
                    <h4>Contact</h4>
                    <p><strong>Email :</strong>
                        onemore@gmail.com
                    </p>
                    <p><strong>Phone :</strong>
                        +91 8888888888
                    </p>
                </div>

                <div class="footer-col">
                    <h4>Connect with us</h4>
                    <div class="social-icons">
                        <a href="#" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" aria-label="X (Twitter)"><i class="fa-brands fa-x-twitter"></i></a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>
                    © <%= new Date().getFullYear() %> OneMore. All Rights Reserved.
                </p>
            </div>
        </footer>

        <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

        <script>
            document.getElementById("retryPaymentBtn").addEventListener("click", async () => {

                const response = await fetch("<%= retryUrl %>");

                const data = await response.json();

                if (!data.success) {
                    return alert(data.message || "Unable to retry payment");
                }

                let isRetrySuccess = false;

                const options = {

                    key: data.key,

                    amount: data.order.amount,

                    currency: data.order.currency,

                    name: "OneMore",

                    description: "Retry Payment",

                    order_id: data.order.id,

                    handler: async function (response) {

                        isRetrySuccess = true;

                        const verifyResponse = await fetch("/payment/verify", {

                            method: "POST",

                            headers: {
                                "Content-Type": "application/json"
                            },

                            body: JSON.stringify({

                                razorpay_order_id: response.razorpay_order_id,
                                razorpay_payment_id: response.razorpay_payment_id,
                                razorpay_signature: response.razorpay_signature

                            })

                        });

                        const verifyData = await verifyResponse.json();

                        if (verifyData.success) {

                            window.location.href = `/order-success/${verifyData.orderId}`;

                        } else {

                            alert(verifyData.message || "Payment verification failed");

                        }

                    },

                    modal: {
                        ondismiss: function () {
                            if (!isRetrySuccess) {
                                window.location.href = `/payment-failed/<%= mongoOrderId %>`;
                            }
                        }
                    }

                };

                const rzp = new Razorpay(options);

                rzp.on("payment.failed", function (response) {
                    window.location.href = `/payment-failed/<%= mongoOrderId %>`;
                });

                rzp.open();

            });
        </script>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>