<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Contact Us | OneMore Audio</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-dark: #121212;
            --text-muted: #aaaaaa;
            --accent: #ffdc60;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            color: #333;
            margin: 0;
        }

        /* ==================== NAVBAR ==================== */

        .navbar {
            background-color: var(--bg-dark);
            padding: 15px 50px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo-img {
            height: 60px;
            width: auto;
            object-fit: contain;
        }

        .nav-link {
            font-weight: 400;
            font-size: 0.85rem;
            color: #ffffff !important;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            padding: 0 15px !important;
            transition: opacity 0.3s ease;
        }

        .nav-link:hover {
            opacity: 0.7;
        }

        .nav-icons a {
            color: #fff;
            margin-left: 20px;
            font-size: 1.1rem;
        }

        .nav-icons i {
            transition: transform 0.2s ease;
        }

        .nav-icons i:hover {
            transform: scale(1.1);
        }


        /* ==================== CONTACT HERO ==================== */

        .contact-hero {
            background-color: var(--bg-dark);
            color: #fff;
            padding: 90px 30px;
            text-align: center;
        }

        .contact-hero h1 {
            font-size: 2.8rem;
            font-weight: 700;
            letter-spacing: 3px;
            margin-bottom: 15px;
        }

        .contact-hero p {
            color: #cccccc;
            font-size: 0.95rem;
            letter-spacing: 1px;
            max-width: 650px;
            margin: auto;
        }


        /* ==================== CONTACT SECTION ==================== */

        .contact-section {
            padding: 80px;
        }

        .section-title {
            font-weight: 700;
            font-size: 1.8rem;
            margin-bottom: 15px;
        }

        .section-subtitle {
            color: #777;
            font-size: 0.9rem;
            margin-bottom: 35px;
        }


        /* ==================== CONTACT INFO ==================== */

        .contact-info {
            padding-right: 40px;
        }

        .contact-info h3 {
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 20px;
        }

        .contact-info>p {
            color: #777;
            font-size: 0.9rem;
            line-height: 1.8;
            margin-bottom: 30px;
        }

        .info-item {
            display: flex;
            align-items: flex-start;
            margin-bottom: 25px;
        }

        .info-icon {
            width: 45px;
            height: 45px;
            background: #f5f5f5;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 15px;
            flex-shrink: 0;
            transition: all 0.3s ease;
        }

        .info-icon i {
            font-size: 1rem;
            color: #121212;
        }

        .info-item:hover .info-icon {
            background: #121212;
        }

        .info-item:hover .info-icon i {
            color: #ffffff;
        }

        .info-item h6 {
            margin: 0 0 5px;
            font-size: 0.9rem;
            font-weight: 600;
        }

        .info-item p {
            margin: 0;
            color: #777;
            font-size: 0.85rem;
        }


        /* ==================== CONTACT FORM ==================== */

        .contact-form-card {
            background: #ffffff;
            border-radius: 18px;
            padding: 40px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.08);
        }

        .contact-form-card h3 {
            font-size: 1.4rem;
            font-weight: 600;
            margin-bottom: 25px;
        }

        .form-label {
            font-size: 0.8rem;
            font-weight: 500;
            margin-bottom: 8px;
            color: #333;
        }

        .form-control {
            border: 1px solid #e1e1e1;
            border-radius: 10px;
            padding: 12px 15px;
            font-size: 0.85rem;
            font-family: 'Poppins', sans-serif;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: #121212;
            box-shadow: 0 0 0 3px rgba(18, 18, 18, 0.08);
        }

        textarea.form-control {
            resize: none;
            min-height: 140px;
        }

        .submit-btn {
            background: #121212;
            color: #ffffff;
            border: none;
            padding: 13px 30px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-family: 'Poppins', sans-serif;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }

        .submit-btn:hover {
            background: #333;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
        }


        /* ==================== FOOTER ==================== */

        footer {
            background-color: var(--bg-dark);
            color: #fff;
            padding: 80px 80px 30px;
        }

        .footer-logo-container {
            margin-bottom: 65px;
        }

        .footer-heading {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--accent);
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            transition: color 0.2s;
        }

        .footer-links a:hover {
            color: #fff;
        }

        .social-icons i {
            font-size: 1.3rem;
            margin-right: 20px;
            color: var(--text-muted);
            transition: color 0.3s;
        }

        .social-icons i:hover {
            color: #fff;
        }

        .copyright {
            border-top: 1px solid #2a2a2a;
            margin-top: 60px;
            padding-top: 30px;
            font-size: 0.75rem;
            color: #555;
        }


        /* ==================== MOBILE ==================== */

        @media (max-width: 768px) {

            .navbar {
                padding: 15px 20px;
            }

            .logo-img {
                height: 45px;
            }

            .contact-hero {
                padding: 70px 20px;
            }

            .contact-hero h1 {
                font-size: 2rem;
            }

            .contact-section {
                padding: 50px 20px;
            }

            .contact-info {
                padding-right: 0;
                margin-bottom: 40px;
            }

            .contact-form-card {
                padding: 25px;
            }

            footer {
                padding: 60px 25px 25px;
            }
        }
    </style>
</head>


<body>


    <!-- ==================== NAVBAR ==================== -->

    <nav class="navbar navbar-expand-lg">

        <div class="container-fluid">

            <a class="navbar-brand" href="/">
                <img src="/images/logo.png" class="logo-img" alt="OneMore Logo">
            </a>


            <div class="collapse navbar-collapse justify-content-center" id="navbarNav">

                <ul class="navbar-nav mx-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/shop">
                            Shop
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/contact">
                            Contact Us
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/about">
                            About Us
                        </a>
                    </li>

                </ul>


                <div class="nav-icons d-flex align-items-center">

                    <a href="/profile" class="text-white me-3">
                        <i class="fa-regular fa-user"></i>
                    </a>

                    <a href="/wishlist" class="text-white me-3">
                        <i class="fa-regular fa-heart"></i>
                    </a>

                    <a href="/cart" class="text-white">
                        <i class="fa-solid fa-bag-shopping"></i>
                    </a>

                </div>

            </div>

        </div>

    </nav>



    <!-- ==================== CONTACT HERO ==================== -->

    <section class="contact-hero">

        <h1>CONTACT US</h1>

        <p>
            Have a question about our products or your order?
            We're here to help. Get in touch with the OneMore team.
        </p>

    </section>



    <!-- ==================== CONTACT CONTENT ==================== -->

    <section class="contact-section">

        <div class="container-fluid">

            <div class="row g-5 align-items-start">


                <!-- CONTACT INFORMATION -->

                <div class="col-lg-5">

                    <div class="contact-info">

                        <h3>
                            Let's Talk
                        </h3>

                        <p>
                            Whether you need help choosing the right audio product,
                            have a question about your order, or simply want to
                            get in touch, feel free to reach out to us.
                        </p>


                        <!-- Email -->

                        <div class="info-item">

                            <div class="info-icon">
                                <i class="fa-regular fa-envelope"></i>
                            </div>

                            <div>
                                <h6>Email</h6>
                                <p>onemore@gmail.com</p>
                            </div>

                        </div>


                        <!-- Phone -->

                        <div class="info-item">

                            <div class="info-icon">
                                <i class="fa-solid fa-phone"></i>
                            </div>

                            <div>
                                <h6>Phone</h6>
                                <p>+91 8888888888</p>
                            </div>

                        </div>


                        <!-- Working Hours -->

                        <div class="info-item">

                            <div class="info-icon">
                                <i class="fa-regular fa-clock"></i>
                            </div>

                            <div>
                                <h6>Support Hours</h6>
                                <p>Monday - Saturday, 9:00 AM - 6:00 PM</p>
                            </div>

                        </div>


                        <!-- Location -->

                        <div class="info-item">

                            <div class="info-icon">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>

                            <div>
                                <h6>Location</h6>
                                <p>Kerala, India</p>
                            </div>

                        </div>

                    </div>

                </div>



                <!-- CONTACT FORM -->

                <div class="col-lg-7">

                    <div class="contact-form-card">

                        <h3>
                            Send Us a Message
                        </h3>

                        <form>

                            <div class="row g-4">

                                <!-- Name -->

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Your Name
                                    </label>

                                    <input type="text" name="name" class="form-control" placeholder="Enter your name"
                                        required>

                                </div>


                                <!-- Email -->

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Email Address
                                    </label>

                                    <input type="email" name="email" class="form-control" placeholder="Enter your email"
                                        required>

                                </div>


                                <!-- Subject -->

                                <div class="col-12">

                                    <label class="form-label">
                                        Subject
                                    </label>

                                    <input type="text" name="subject" class="form-control"
                                        placeholder="What can we help you with?" required>

                                </div>


                                <!-- Message -->

                                <div class="col-12">

                                    <label class="form-label">
                                        Message
                                    </label>

                                    <textarea name="message" class="form-control"
                                        placeholder="Write your message here..." required></textarea>

                                </div>


                                <!-- Submit -->

                                <div class="col-12">

                                    <button type="button" class="submit-btn">
                                        Send Message
                                        <i class="fa-solid fa-arrow-right ms-2"></i>
                                    </button>

                                </div>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- ==================== FOOTER ==================== -->

    <footer>

        <div class="row text-center footer-logo-container">

            <div class="col-12">

                <img src="/images/logo.png" class="logo-img" alt="OneMore Footer Logo">

            </div>

        </div>


        <div class="row g-4">


            <!-- Support -->

            <div class="col-md-3">

                <h6 class="footer-heading">
                    Support
                </h6>

                <ul class="list-unstyled footer-links">

                    <li>
                        <a href="#">
                            Order Status
                        </a>
                    </li>

                    <li>
                        <a href="#">
                            Product Support
                        </a>
                    </li>

                    <li>
                        <a href="#">
                            Shipping & Return Policy
                        </a>
                    </li>

                    <li>
                        <a href="#">
                            Complaint Registration
                        </a>
                    </li>

                </ul>

            </div>


            <!-- About -->

            <div class="col-md-3">

                <h6 class="footer-heading">
                    About Us
                </h6>

                <ul class="list-unstyled footer-links">

                    <li>
                        <a href="/contact">
                            Contact Us
                        </a>
                    </li>

                    <li>
                        <a href="#">
                            Privacy Policy
                        </a>
                    </li>

                    <li>
                        <a href="#">
                            Terms of Use
                        </a>
                    </li>

                </ul>

            </div>


            <!-- Contact -->

            <div class="col-md-3">

                <h6 class="footer-heading">
                    Contact
                </h6>

                <p class="small text-white mb-2">
                    <i class="fa-regular fa-envelope me-2"></i>
                    onemore@gmail.com
                </p>

                <p class="small text-white">
                    <i class="fa-solid fa-phone me-2"></i>
                    +91 8888888888
                </p>

            </div>


            <!-- Social -->

            <div class="col-md-3">

                <h6 class="footer-heading">
                    Connect with us
                </h6>

                <div class="social-icons">

                    <a href="#">
                        <i class="fa-brands fa-instagram"></i>
                    </a>

                    <a href="#">
                        <i class="fa-brands fa-facebook"></i>
                    </a>

                    <a href="#">
                        <i class="fa-brands fa-x-twitter"></i>
                    </a>

                </div>

            </div>

        </div>


        <div class="text-center copyright">

            © 2024 OneMore Audio. All Rights Reserved.

        </div>

    </footer>



    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js">
    </script>

</body>

</html>