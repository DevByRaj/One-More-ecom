<!DOCTYPE html>
<html lang="en">

<head>
  <script>
    window.history.forward();
    function noBack() {
      window.history.forward();
    }
  </script>

  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, private">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Verify OTP | OneMore</title>
  <link rel="icon" type="image/png" href="/images/logo.png">

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: #0b0b0b;
      color: #fff;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* NAVBAR */
    .otp-nav {
      background: #111;
      border-bottom: 1px solid #292929;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .otp-nav .nav-inner {
      max-width: 1400px;
      margin: auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      padding: 14px 5%;
    }

    .otp-nav .nav-logo {
      display: block;
      flex-shrink: 0;
    }

    .otp-nav .logo-img {
      width: 80px;
      height: auto;
      object-fit: contain;
      display: block;
    }

    .otp-nav .nav-links {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: clamp(18px, 3vw, 40px);
    }

    .otp-nav .nav-links a {
      font-size: 13px;
      font-weight: 400;
      color: #ccc;
      text-decoration: none;
      white-space: nowrap;
      transition: color 0.2s;
    }

    .otp-nav .nav-links a:hover {
      color: #fff;
    }

    .otp-nav .nav-icons {
      display: flex;
      gap: 20px;
      align-items: center;
      flex-shrink: 0;
    }

    .otp-nav .nav-icons a {
      color: #ccc;
      font-size: 18px;
      text-decoration: none;
      transition: color 0.2s;
    }

    .otp-nav .nav-icons a:hover {
      color: #fff;
    }

    /* MAIN BACKGROUND */
    .otp-main {
      flex: 1;
      position: relative;
      isolation: isolate;
      overflow: hidden;
      background:
        radial-gradient(ellipse at 15% 35%, rgba(85, 85, 85, 0.2), transparent 40%),
        radial-gradient(ellipse at 85% 75%, rgba(60, 60, 60, 0.16), transparent 40%),
        #0b0b0b;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 65px 24px;
      min-height: 570px;
    }

    .otp-main::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: linear-gradient(135deg,
          transparent 49%,
          rgba(255, 255, 255, 0.025) 50%,
          transparent 51%);
      background-size: 38px 38px;
      pointer-events: none;
      z-index: -1;
    }

    .otp-layout {
      width: 100%;
      max-width: 1000px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
      align-items: center;
      gap: 65px;
      margin: auto;
    }

    /* LEFT BRANDING */
    .otp-intro {
      max-width: 480px;
    }

    .otp-intro .eyebrow {
      font-size: 11px;
      color: #aaa;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .otp-intro h1 {
      font-size: clamp(36px, 4.3vw, 56px);
      line-height: 1.15;
      font-weight: 700;
      letter-spacing: -1.5px;
      margin-bottom: 22px;
    }

    .otp-intro h1 span {
      display: block;
      color: #a7a7b5;
    }

    .otp-intro .intro-text {
      max-width: 420px;
      color: #bcbcbc;
      font-size: 14px;
      line-height: 1.9;
      margin-bottom: 32px;
    }

    .otp-benefits {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .otp-benefit {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .otp-benefit .benefit-icon {
      width: 44px;
      height: 44px;
      border: 1px solid #414141;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 16px;
      flex-shrink: 0;
      background: rgba(255, 255, 255, 0.04);
    }

    .otp-benefit h3 {
      color: #f5f5f5;
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 4px;
    }

    .otp-benefit p {
      color: #aaa;
      font-size: 11px;
      line-height: 1.6;
    }

    .otp-tagline {
      margin-top: 30px;
      font-size: 18px;
      font-style: italic;
      color: #a7a7b5;
      line-height: 1.7;
    }

    /* OTP CARD */
    .otp-card {
      background: linear-gradient(145deg, #f8f8fa, #e9e9ed);
      color: #1a1a1a;
      border: 1px solid #fff;
      border-radius: 20px;
      width: 100%;
      padding: 34px 28px 30px;
      display: flex;
      flex-direction: column;
      align-items: center;
      box-shadow: 0 24px 65px rgba(0, 0, 0, 0.35);
    }

    .otp-card .lock-icon {
      width: 58px;
      height: 58px;
      border-radius: 50%;
      background: #dedee4;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 23px;
      margin-bottom: 20px;
    }

    .otp-card .card-title {
      font-size: 25px;
      line-height: 1.3;
      font-weight: 600;
      text-align: center;
      margin-bottom: 10px;
      letter-spacing: -0.5px;
    }

    .otp-card .card-description {
      font-size: 12px;
      color: #777783;
      line-height: 1.8;
      text-align: center;
      margin-bottom: 27px;
    }

    .otp-card .otp-label {
      width: 100%;
      font-size: 12px;
      font-weight: 600;
      text-align: left;
      margin-bottom: 12px;
    }

    /* OTP INPUTS */
    .otp-card .otp-row {
      display: flex;
      justify-content: center;
      gap: 10px;
      width: 100%;
      margin-bottom: 20px;
    }

    .otp-card .otp-box {
      width: 56px;
      height: 56px;
      min-width: 0;
      background: #fff;
      border: 1.5px solid #c8c8d0;
      border-radius: 10px;
      font-family: 'Poppins', sans-serif;
      font-size: 21px;
      font-weight: 600;
      color: #1a1a1a;
      text-align: center;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
      caret-color: #1a1a1a;
      padding: 0;
    }

    .otp-card .otp-box:focus {
      border-color: #333;
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.07);
    }

    .otp-card .otp-box.filled {
      border-color: #777;
    }

    /* RESEND + TIMER */
    .otp-card .resend-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      width: 100%;
      margin-bottom: 23px;
    }

    .otp-card .resend-text {
      font-size: 10px;
      color: #777;
      font-weight: 400;
    }

    .otp-card .resend-link {
      font-size: 10px;
      font-weight: 600;
      color: #171717;
      cursor: pointer;
      text-decoration: underline;
      transition: color 0.2s;
      margin-left: 3px;
    }

    .otp-card .resend-link:hover {
      color: #555;
    }

    .otp-card .resend-link.disabled {
      color: #aaa;
      cursor: default;
      pointer-events: none;
    }

    .otp-card .timer {
      font-size: 12px;
      font-weight: 600;
      color: #1a1a1a;
      letter-spacing: 0.5px;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .otp-card .timer.expired {
      color: #c0392b;
    }

    /* VERIFY BUTTON */
    .otp-card .submit-btn {
      width: 100%;
      background: #111;
      color: #fff;
      font-family: 'Poppins', sans-serif;
      font-size: 13px;
      font-weight: 500;
      padding: 13px;
      border: none;
      border-radius: 9px;
      cursor: pointer;
      letter-spacing: 0.3px;
      transition: background 0.2s, transform 0.15s;
      margin-bottom: 12px;
    }

    .otp-card .submit-btn:hover {
      background: #333;
    }

    .otp-card .submit-btn:active {
      transform: scale(0.98);
    }

    .otp-card .otp-error {
      color: #c0392b;
      font-size: 11px;
      text-align: center;
      line-height: 1.6;
      margin-bottom: 12px;
      overflow-wrap: anywhere;
    }

    .otp-divider {
      width: 100%;
      height: 1px;
      background: #d4d4da;
      margin: 13px 0 18px;
    }

    .otp-security {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 11px;
      background: rgba(0, 0, 0, 0.045);
      border-radius: 9px;
      padding: 12px;
    }

    .otp-security .security-icon {
      flex-shrink: 0;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #e0e0e5;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
    }

    .otp-security p {
      font-size: 9px;
      color: #666;
      line-height: 1.8;
    }

    /* TOAST */
    #toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      max-width: calc(100vw - 32px);
      background: #1a1a1a;
      color: #fff;
      font-size: 12px;
      padding: 12px 20px;
      border-radius: 8px;
      display: none;
      border: 1px solid #444;
      z-index: 999;
      font-family: 'Poppins', sans-serif;
      animation: fadeUp 0.25s ease;
      overflow-wrap: anywhere;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* FOOTER */
    .otp-footer {
      background: #101010;
      padding: 38px 5% 20px;
      color: #fff;
      border-top: 1px solid #242424;
    }

    .otp-footer .footer-logo-row {
      display: flex;
      justify-content: center;
      margin-bottom: 28px;
    }

    .otp-footer .footer-logo-row img {
      width: 80px;
      height: auto;
      object-fit: contain;
    }

    .otp-footer .footer-grid {
      max-width: 1250px;
      margin: 0 auto 28px;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 25px;
    }

    .otp-footer .footer-col {
      min-width: 0;
      padding-right: 15px;
      border-right: 1px solid #292929;
    }

    .otp-footer .footer-col:last-child {
      border-right: none;
    }

    .otp-footer .footer-col-title {
      font-size: 12px;
      font-weight: 600;
      color: #fff;
      margin-bottom: 14px;
      letter-spacing: 0.4px;
      text-transform: uppercase;
    }

    .otp-footer .footer-col a {
      display: block;
      font-size: 11px;
      font-weight: 300;
      color: #aaa;
      text-decoration: none;
      margin-bottom: 8px;
      line-height: 1.6;
      overflow-wrap: anywhere;
      transition: color 0.2s;
    }

    .otp-footer .footer-col a:hover {
      color: #fff;
    }

    .otp-footer .contact-row {
      margin-bottom: 8px;
      overflow-wrap: anywhere;
    }

    .otp-footer .contact-label,
    .otp-footer .contact-val {
      font-size: 11px;
    }

    .otp-footer .contact-label {
      color: #fff;
      font-weight: 500;
    }

    .otp-footer .contact-val {
      color: #aaa;
      margin-left: 4px;
    }

    .otp-footer .social-row {
      display: flex;
      gap: 14px;
      margin-top: 6px;
    }

    .otp-footer .social-row a {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
    }

    .otp-footer .social-row svg {
      width: 19px;
      height: 19px;
      fill: #ccc;
      transition: fill 0.2s;
    }

    .otp-footer .social-row a:hover svg {
      fill: #fff;
    }

    .otp-footer .footer-bottom {
      max-width: 1250px;
      margin: 0 auto;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-top: 18px;
      font-size: 11px;
      color: #777;
      font-weight: 300;
      text-align: center;
    }

    /* TABLET */
    @media (max-width: 950px) {
      .otp-nav .nav-inner {
        padding: 14px 4%;
        gap: 15px;
      }

      .otp-nav .nav-links {
        gap: 18px;
      }

      .otp-nav .nav-links a {
        font-size: 12px;
      }

      .otp-nav .logo-img {
        width: 65px;
      }

      .otp-nav .nav-icons {
        gap: 14px;
      }

      .otp-layout {
        grid-template-columns: minmax(0, 1fr) minmax(290px, 340px);
        gap: 30px;
      }

      .otp-intro h1 {
        font-size: 40px;
      }

      .otp-card {
        padding: 30px 22px;
      }

      .otp-card .otp-box {
        width: 52px;
        height: 52px;
      }

      .otp-footer .footer-grid {
        gap: 18px;
      }
    }

    /* MOBILE */
    @media (max-width: 700px) {
      .otp-nav .nav-inner {
        padding: 13px 18px;
        flex-wrap: wrap;
        gap: 12px;
      }

      .otp-nav .logo-img {
        width: 48px;
      }

      .otp-nav .nav-icons {
        margin-left: auto;
        gap: 18px;
      }

      .otp-nav .nav-icons a {
        font-size: 17px;
      }

      .otp-nav .nav-links {
        position: static;
        transform: none;
        order: 3;
        width: 100%;
        justify-content: space-between;
        gap: 8px;
        padding-top: 10px;
        border-top: 1px solid #292929;
      }

      .otp-nav .nav-links a {
        font-size: 11px;
      }

      .otp-main {
        min-height: auto;
        padding: 45px 18px;
      }

      .otp-layout {
        grid-template-columns: minmax(0, 1fr);
        max-width: 440px;
        gap: 30px;
      }

      .otp-intro {
        max-width: 100%;
      }

      .otp-intro .eyebrow {
        font-size: 10px;
        letter-spacing: 2.5px;
        margin-bottom: 14px;
      }

      .otp-intro h1 {
        font-size: clamp(34px, 8vw, 44px);
        letter-spacing: -1px;
        margin-bottom: 16px;
      }

      .otp-intro .intro-text {
        font-size: 13px;
        margin-bottom: 22px;
      }

      .otp-benefits {
        display: grid;
        grid-template-columns: 1fr;
        gap: 14px;
      }

      .otp-benefit .benefit-icon {
        width: 38px;
        height: 38px;
        font-size: 14px;
      }

      .otp-benefit h3 {
        font-size: 12px;
      }

      .otp-benefit p {
        font-size: 10px;
      }

      .otp-tagline {
        display: none;
      }

      .otp-card {
        max-width: 100%;
        padding: 30px 24px 25px;
        border-radius: 17px;
      }

      .otp-card .card-title {
        font-size: 23px;
      }

      .otp-card .card-description {
        margin-bottom: 23px;
      }

      .otp-card .otp-box {
        width: min(58px, 17vw);
        height: 52px;
        font-size: 20px;
      }

      .otp-card .otp-row {
        gap: 10px;
      }

      .otp-footer {
        padding: 32px 22px 18px;
      }

      .otp-footer .footer-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 25px 18px;
      }

      .otp-footer .footer-col {
        padding-right: 10px;
      }

      .otp-footer .footer-col:nth-child(2) {
        border-right: none;
      }

      .otp-footer .footer-col-title {
        font-size: 11px;
      }

      .otp-footer .footer-col a,
      .otp-footer .contact-label,
      .otp-footer .contact-val {
        font-size: 10px;
      }

      #toast {
        bottom: 15px;
        right: 12px;
        left: 12px;
        width: auto;
        text-align: center;
      }
    }

    /* SMALL MOBILE */
    @media (max-width: 380px) {
      .otp-nav .nav-inner {
        padding: 12px;
      }

      .otp-nav .logo-img {
        width: 42px;
      }

      .otp-nav .nav-icons {
        gap: 14px;
      }

      .otp-nav .nav-links a {
        font-size: 10px;
      }

      .otp-main {
        padding: 35px 13px;
      }

      .otp-intro h1 {
        font-size: 33px;
      }

      .otp-card {
        padding: 25px 16px 22px;
      }

      .otp-card .card-title {
        font-size: 21px;
      }

      .otp-card .otp-row {
        gap: 8px;
      }

      .otp-card .otp-box {
        width: min(54px, 16vw);
        height: 48px;
        font-size: 18px;
      }

      .otp-card .resend-text,
      .otp-card .resend-link {
        font-size: 9px;
      }

      .otp-footer {
        padding: 28px 15px 15px;
      }

      .otp-footer .footer-grid {
        gap: 22px 12px;
      }
    }

    /* REDUCED MOTION */
    @media (prefers-reduced-motion: reduce) {

      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body onload="noBack()" onpageshow="if (event.persisted) noBack();">

  <div id="toast" role="status" aria-live="polite"></div>

  <!-- NAVBAR -->
  <nav class="otp-nav">
    <div class="nav-inner">

      <a href="/" class="nav-logo" aria-label="OneMore home">
        <img src="/images/logo.png" alt="OneMore Logo" class="logo-img">
      </a>

      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/shop">Shop</a>
        <a href="/contact">Contact Us</a>
        <a href="/about">About Us</a>
      </div>

      <div class="nav-icons">
        <a href="/login" aria-label="Login">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="7" r="4"></circle>
            <path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"></path>
          </svg>
        </a>

        <a href="/wishlist" aria-label="Wishlist">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
            <path
              d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z">
            </path>
          </svg>
        </a>

        <a href="/cart" aria-label="Cart">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <path d="M16 10a4 4 0 0 1-8 0"></path>
          </svg>
        </a>
      </div>

    </div>
  </nav>

  <!-- MAIN -->
  <main class="otp-main">
    <div class="otp-layout">

      <!-- BRANDING SECTION -->
      <section class="otp-intro">
        <p class="eyebrow">One More. Always With You.</p>

        <h1>
          Almost
          <span>There.</span>
        </h1>

        <p class="intro-text">
          Verify your email to continue your journey with OneMore.
          Enter the four-digit OTP sent to your email address.
        </p>

        <div class="otp-benefits">

          <div class="otp-benefit">
            <div class="benefit-icon">
              <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7">
                <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"></path>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            </div>
            <div>
              <h3>Secure Verification</h3>
              <p>Help keep your account protected</p>
            </div>
          </div>

          <div class="otp-benefit">
            <div class="benefit-icon">
              <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7">
                <path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"></path>
              </svg>
            </div>
            <div>
              <h3>Quick Verification</h3>
              <p>Enter your OTP to move to the next step</p>
            </div>
          </div>

          <div class="otp-benefit">
            <div class="benefit-icon">
              <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.7">
                <path
                  d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1 7.8 7.8 7.8-7.8 1.1-1.1a5.5 5.5 0 0 0-.1-7.8z">
                </path>
              </svg>
            </div>
            <div>
              <h3>Welcome Back</h3>
              <p>Your OneMore experience is waiting</p>
            </div>
          </div>

        </div>

        <p class="otp-tagline">
          One step closer to<br>
          everything you love.
        </p>
      </section>

      <!-- OTP CARD -->
      <section class="otp-card">

        <div class="lock-icon">
          <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.8">
            <rect x="4" y="10" width="16" height="12" rx="2"></rect>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
            <circle cx="12" cy="15" r="1"></circle>
            <path d="M12 16v2"></path>
          </svg>
        </div>

        <div class="card-title">Verify OTP</div>

        <p class="card-description">
          Enter the 4-digit verification code sent to your email.
        </p>

        <form action="/verify-otp" method="POST" id="otpForm">
          <input type="hidden" name="email" value="<%= email %>">
          <input type="hidden" name="type" value="<%= type %>">

          <div class="otp-label">Verification Code</div>

          <div class="otp-row">
            <input class="otp-box" id="otp1" inputmode="numeric" autocomplete="one-time-code" aria-label="OTP digit 1"
              maxlength="1">
            <input class="otp-box" id="otp2" inputmode="numeric" aria-label="OTP digit 2" maxlength="1">
            <input class="otp-box" id="otp3" inputmode="numeric" aria-label="OTP digit 3" maxlength="1">
            <input class="otp-box" id="otp4" inputmode="numeric" aria-label="OTP digit 4" maxlength="1">
          </div>

          <input type="hidden" name="otp" id="fullOtp">

          <button type="submit" class="submit-btn">
            Verify &amp; Continue
          </button>

          <% if (locals.error) { %>
            <p class="otp-error" role="alert">
              <%= error %>
            </p>
            <% } %>
        </form>

        <div class="resend-row">
          <div>
            <span class="resend-text">Didn't get the OTP?</span>
            <a class="resend-link disabled" id="resend-btn" onclick="resendOTP()">Resend OTP</a>
          </div>

          <div class="timer" id="timer">01:00</div>
        </div>

        <div class="otp-divider"></div>

        <div class="otp-security">
          <div class="security-icon">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7">
              <path d="M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11z"></path>
            </svg>
          </div>
          <p>
            Keep your verification code private.
            Never share your OTP with anyone.
          </p>
        </div>

      </section>

    </div>
  </main>

  <!-- FOOTER -->
  <footer class="otp-footer">

    <div class="footer-logo-row">
      <img src="/images/logo.png" alt="OneMore Logo" class="logo-img">
    </div>

    <div class="footer-grid">

      <div class="footer-col">
        <div class="footer-col-title">SUPPORT</div>
        <a href="/orders">Order Status</a>
        <a href="/contact">Product Support</a>
        <a href="/shipping-return-policy">Shipping &amp; Return Policy</a>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">About Us</div>
        <a href="/contact">Contact Us</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms">Terms of use</a>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">Contact</div>
        <div class="contact-row">
          <span class="contact-label">Email :</span>
          <span class="contact-val">onemore@gmail.com</span>
        </div>
      </div>

      <div class="footer-col">
        <div class="footer-col-title">Connect with us</div>

        <div class="social-row">
          <a href="#" aria-label="Instagram">
            <svg viewBox="0 0 24 24">
              <path
                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4z">
              </path>
            </svg>
          </a>

          <a href="#" aria-label="Facebook">
            <svg viewBox="0 0 24 24">
              <path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z">
              </path>
            </svg>
          </a>
        </div>
      </div>

    </div>

    <div class="footer-bottom">
      © 2025 OneMore. All Rights Reserved.
    </div>

  </footer>

  <script>
    /* OTP INPUT BEHAVIOUR */
    const boxes = ['otp1', 'otp2', 'otp3', 'otp4'].map(
      id => document.getElementById(id)
    );

    boxes.forEach((box, i) => {
      box.addEventListener('input', () => {
        box.value = box.value.replace(/\D/g, '').slice(-1);

        if (box.value) {
          box.classList.add('filled');

          if (i < boxes.length - 1) {
            boxes[i + 1].focus();
          }
        } else {
          box.classList.remove('filled');
        }
      });

      box.addEventListener('keydown', e => {
        if (e.key === 'Backspace' && !box.value && i > 0) {
          boxes[i - 1].focus();
          boxes[i - 1].value = '';
          boxes[i - 1].classList.remove('filled');
        }
      });

      box.addEventListener('paste', e => {
        e.preventDefault();

        const digits = (
          e.clipboardData.getData('text') || ''
        ).replace(/\D/g, '').slice(0, 4);

        digits.split('').forEach((d, j) => {
          if (boxes[j]) {
            boxes[j].value = d;
            boxes[j].classList.add('filled');
          }
        });

        const next = boxes[Math.min(digits.length, 3)];

        if (next) {
          next.focus();
        }
      });
    });

    /* COUNTDOWN TIMER */
    let totalSeconds = <%= locals.remainingSeconds || 60 %>;
    let timerInterval = null;

    function startTimer() {
      clearInterval(timerInterval);

      const timerEl = document.getElementById('timer');
      const resendEl = document.getElementById('resend-btn');

      resendEl.classList.add('disabled');

      if (totalSeconds <= 0) {
        timerEl.textContent = '00:00';
        timerEl.classList.add('expired');
        resendEl.classList.remove('disabled');
        return;
      }

      timerEl.classList.remove('expired');

      const updateTimer = () => {
        const m = String(Math.floor(totalSeconds / 60)).padStart(2, '0');
        const s = String(totalSeconds % 60).padStart(2, '0');

        timerEl.textContent = `${m}:${s}`;

        if (totalSeconds <= 0) {
          clearInterval(timerInterval);
          timerEl.textContent = '00:00';
          timerEl.classList.add('expired');
          resendEl.classList.remove('disabled');
        }
      };

      updateTimer();

      timerInterval = setInterval(() => {
        totalSeconds--;
        updateTimer();
      }, 1000);
    }

    startTimer();

    /* RESEND OTP */
    async function resendOTP() {
      const resendEl = document.getElementById('resend-btn');

      if (resendEl.classList.contains('disabled')) {
        return;
      }

      const email = "<%= email %>";
      const type = "<%= type %>";

      try {
        const res = await fetch("/resend-otp", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({ email, type })
        });

        if (res.ok) {
          boxes.forEach(b => {
            b.value = '';
            b.classList.remove('filled');
          });

          boxes[0].focus();

          totalSeconds = 60;
          document.getElementById('timer').classList.remove('expired');
          startTimer();

          showToast("OTP sent successfully!");
        } else {
          showToast("Failed to resend OTP");
        }
      } catch (err) {
        showToast("Error connecting to server");
      }
    }

    /* TOAST */
    function showToast(msg) {
      const t = document.getElementById('toast');

      t.textContent = msg;
      t.style.display = 'block';

      setTimeout(() => {
        t.style.display = 'none';
      }, 3000);
    }

    /* OTP SUBMISSION */
    document.getElementById("otpForm").addEventListener("submit", function (e) {
      const otpValue = boxes.map(b => b.value).join('');

      if (otpValue.length < 4) {
        e.preventDefault();
        showToast("Enter full 4-digit OTP");
        return;
      }

      document.getElementById("fullOtp").value = otpValue;
    });

    /* PREVENT BACK-FORWARD CACHE RESTORATION */
    window.addEventListener("pageshow", function (event) {
      if (event.persisted) {
        window.location.reload();
      }
    });
  </script>

</body>

