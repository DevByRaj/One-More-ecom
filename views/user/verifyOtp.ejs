<!DOCTYPE html>
<html lang="en">
<head>
<meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate, private">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>verify OTP</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Poppins', sans-serif;
    background: #1a1a1a;
    color: #1a1a1a;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* ── NAVBAR ── */
  nav {
    background: #1a1a1a;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    position: sticky; top: 0; z-index: 100;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 36px;
    position: relative;
  }

  /* ── IM LOGO ── */
  .nav-logo { cursor: pointer; }
  .nav-logo svg { width: 56px; height: 46px; display: block; }

  .nav-links {
    display: flex; gap: 40px;
    position: absolute; left: 50%; transform: translateX(-50%);
  }
  .nav-links a {
    font-size: 14px; font-weight: 400;
    color: #ccc; text-decoration: none;
    cursor: pointer; transition: color 0.2s;
  }
  .nav-links a:hover { color: #fff; }

  .nav-icons { display: flex; gap: 20px; align-items: center; }
  .nav-icons svg {
    width: 22px; height: 22px;
    stroke: #ccc; fill: none;
    cursor: pointer; stroke-width: 1.6;
    transition: stroke 0.2s;
  }
  .nav-icons svg:hover { stroke: #fff; }

   .logo-img {
  width: 80px;     /* adjust size */
  height: auto;
  object-fit: contain;
}

  /* ── MAIN ── */
  main {
    flex: 1;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 20px;
  }

  /* ── OTP CARD ── */
  .card {
    background: #ececea;
    border: 1px solid #d0d0cc;
    border-radius: 14px;
    width: 100%;
    max-width: 340px;
    padding: 36px 32px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .card-title {
    font-size: 16px;
    font-weight: 500;
    color: #1a1a1a;
    text-align: center;
    margin-bottom: 28px;
    letter-spacing: 0.2px;
  }

  /* ── OTP INPUTS ── */
  .otp-row {
    display: flex;
    gap: 10px;
    margin-bottom: 18px;
  }

  .otp-box {
    width: 56px;
    height: 52px;
    background: #fff;
    border: 1.5px solid #c8c8c4;
    border-radius: 8px;
    font-family: 'Poppins', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #1a1a1a;
    text-align: center;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    caret-color: #1a1a1a;
  }
  .otp-box:focus {
    border-color: #888;
    box-shadow: 0 0 0 3px rgba(0,0,0,0.07);
  }
  .otp-box.filled {
    border-color: #999;
  }

  /* ── RESEND + TIMER ROW ── */
  .resend-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 24px;
  }

  .resend-text {
    font-size: 12px;
    color: #666;
    font-weight: 400;
  }
  .resend-link {
    font-size: 12px;
    font-weight: 600;
    color: #1a1a1a;
    cursor: pointer;
    text-decoration: none;
    transition: color 0.2s;
    margin-left: 4px;
  }
  .resend-link:hover { color: #444; }
  .resend-link.disabled {
    color: #aaa;
    cursor: default;
    pointer-events: none;
  }

  .timer {
    font-size: 13px;
    font-weight: 500;
    color: #1a1a1a;
    letter-spacing: 0.5px;
    font-variant-numeric: tabular-nums;
  }
  .timer.expired { color: #c0392b; }

  /* ── SUBMIT BUTTON ── */
  .submit-btn {
    width: 100%;
    background: #1a1a1a;
    color: #fff;
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 500;
    padding: 13px;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    letter-spacing: 0.3px;
    transition: background 0.2s, transform 0.15s;
  }
  .submit-btn:hover { background: #333; }
  .submit-btn:active { transform: scale(0.98); }
  .submit-btn:disabled {
    background: #888;
    cursor: not-allowed;
    transform: none;
  }

  /* ── TOAST ── */
  #toast {
    position: fixed; bottom: 24px; right: 24px;
    background: #1a1a1a; color: #fff;
    font-size: 12px; padding: 11px 20px;
    border-radius: 6px; display: none;
    border: 1px solid #444; z-index: 999;
    font-family: 'Poppins', sans-serif;
    animation: fadeUp 0.25s ease;
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── FOOTER ── */
  footer {
    background: #1a1a1a;
    padding: 40px 60px 20px;
    color: #fff;
  }

  .footer-logo-row {
    display: flex;
    justify-content: center;
    margin-bottom: 28px;
  }

  .footer-logo-big svg { width: 72px; height: 60px; }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 20px;
    margin-bottom: 28px;
  }

  .footer-col-title {
    font-size: 12px; font-weight: 700;
    color: #fff; margin-bottom: 14px;
    letter-spacing: 0.4px; text-transform: uppercase;
  }

  .footer-col a {
    display: block; font-size: 11.5px;
    font-weight: 300; color: #aaa;
    text-decoration: none; margin-bottom: 8px;
    cursor: pointer; transition: color 0.2s; line-height: 1.5;
  }
  .footer-col a:hover { color: #fff; }

  .contact-row { margin-bottom: 6px; }
  .contact-label { font-size: 11.5px; color: #fff; font-weight: 500; }
  .contact-val   { font-size: 11.5px; color: #aaa; margin-left: 4px; }

  .social-row { display: flex; gap: 14px; margin-top: 6px; }
  .social-row svg {
    width: 20px; height: 20px; fill: #ccc;
    cursor: pointer; transition: fill 0.2s;
  }
  .social-row svg:hover { fill: #fff; }

  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.07);
    padding-top: 18px;
    font-size: 11px; color: #555; font-weight: 300;
  }
</style>
</head>
<body>

<div id="toast"></div>

<!-- NAVBAR -->
<nav>
  <div class="nav-inner">

    <!-- IM Logo — swap SVG here to change logo -->
    <div class="nav-logo">
  <img src="/images/logo.png" alt="logo" class="logo-img">
</div>

    <div class="nav-links">
      <a>Home</a>
      <a>Shop</a>
      <a>Contact Us</a>
      <a>About Us</a>
    </div>

    <div class="nav-icons">
      <!-- person -->
      <svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
      <!-- heart -->
      <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      <!-- cart -->
      <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
    </div>

  </div>
</nav>

<!-- MAIN -->
<main>
  <div class="card">
    <form action="/verify-otp" method="POST">

  <input type="hidden" name="email" value="<%= email %>">
  <input type="hidden" name="type" value="<%= type %>">

  <!-- OTP boxes -->
  <div class="otp-row">
    <input class="otp-box" id="otp1" maxlength="1">
    <input class="otp-box" id="otp2" maxlength="1">
    <input class="otp-box" id="otp3" maxlength="1">
    <input class="otp-box" id="otp4" maxlength="1">
  </div>

  <!-- hidden full OTP -->
  <input type="hidden" name="otp" id="fullOtp">

  <button type="submit" class="submit-btn">Verify</button>
  <% if (error) { %>
  <p style="color:red;"><%= error %></p>
<% } %>

</form>

    <!-- resend + timer -->
    <div class="resend-row">
      <div>
        <span class="resend-text">Didn't get the OTP?</span>
        <a class="resend-link disabled" id="resend-btn" onclick="resendOTP()">Resend OTP</a>
      </div>
      <div class="timer" id="timer">00:60</div>
    </div>

    <!-- submit -->
    
  </div>
</main>

<!-- FOOTER -->
<footer>
  <div class="footer-logo-row">
    <div class="footer-logo">
  <img src="/images/logo.png" class="logo-img">
</div>
  </div>

  <div class="footer-grid">
    <!-- SUPPORT -->
    <div class="footer-col">
      <div class="footer-col-title">SUPPORT</div>
      <a>Order Status</a>
      <a>Product Support</a>
      <a>Shipping &amp; Return Policy</a>
      <a>Complaint Registration</a>
    </div>

    <!-- About Us -->
    <div class="footer-col">
      <div class="footer-col-title">About Us</div>
      <a>Contact Us</a>
      <a>Privacy Policy</a>
      <a>Terms of use</a>
    </div>

    <!-- Contact -->
    <div class="footer-col">
      <div class="footer-col-title">Contact</div>
      <div class="contact-row">
        <span class="contact-label">Email :</span>
        <span class="contact-val">onemore@gmail.com</span>
      </div>
      <div class="contact-row">
        <span class="contact-label">Phone :</span>
        <span class="contact-val">+91 8888888888</span>
      </div>
    </div>

    <!-- Connect -->
    <div class="footer-col">
      <div class="footer-col-title">Connect with us</div>
      <div class="social-row">
        <!-- Instagram -->
        <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        <!-- Facebook -->
        <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        <!-- X -->
        <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </div>
    </div>
  </div>

  <div class="footer-bottom">© 2025 onemore . All Rights Reserved.</div>
</footer>

<script>
  /* ── OTP INPUT BEHAVIOUR ── */
  const boxes = ['otp1','otp2','otp3','otp4'].map(id => document.getElementById(id));

  boxes.forEach((box, i) => {
    /* only allow digits */
    box.addEventListener('input', () => {
      box.value = box.value.replace(/\D/g, '').slice(-1);
      if (box.value) {
        box.classList.add('filled');
        if (i < boxes.length - 1) boxes[i + 1].focus();
      } else {
        box.classList.remove('filled');
      }
    });

    /* backspace moves back */
    box.addEventListener('keydown', e => {
      if (e.key === 'Backspace' && !box.value && i > 0) {
        boxes[i - 1].focus();
        boxes[i - 1].value = '';
        boxes[i - 1].classList.remove('filled');
      }
    });

    /* handle paste */
    box.addEventListener('paste', e => {
      e.preventDefault();
      const digits = (e.clipboardData.getData('text') || '').replace(/\D/g, '').slice(0, 4);
      digits.split('').forEach((d, j) => {
        if (boxes[j]) {
          boxes[j].value = d;
          boxes[j].classList.add('filled');
        }
      });
      const next = boxes[Math.min(digits.length, 3)];
      if (next) next.focus();
    });
  });

  /* ── COUNTDOWN TIMER ── */
  let totalSeconds = <%= locals.remainingSeconds || 60 %>;
  let timerInterval = null;

  function startTimer() {
    clearInterval(timerInterval);
    const timerEl  = document.getElementById('timer');
    const resendEl = document.getElementById('resend-btn');
    resendEl.classList.add('disabled');

    timerInterval = setInterval(() => {
      totalSeconds--;
      const m = String(Math.floor(totalSeconds / 60)).padStart(2, '0');
      const s = String(totalSeconds % 60).padStart(2, '0');
      timerEl.textContent = `${m}:${s}`;

      if (totalSeconds <= 0) {
        clearInterval(timerInterval);
        timerEl.textContent = '00:00';
        timerEl.classList.add('expired');
        resendEl.classList.remove('disabled');
      }
    }, 1000);
  }

  startTimer();

  /* ── RESEND OTP ── */

async function resendOTP() {
  const resendEl = document.getElementById('resend-btn');
  if (resendEl.classList.contains('disabled')) return;

  const email = "<%= email %>";
  const type = "<%= type %>";

  try {
    const res = await fetch("/resend-otp", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({ email, type })
    });

    const data = await res.text();

    // reset OTP boxes
    boxes.forEach(b => { b.value = ''; b.classList.remove('filled'); });
    boxes[0].focus();

    // restart timer
    totalSeconds = 60;
    document.getElementById('timer').classList.remove('expired');
    startTimer();

    showToast("OTP sent successfully!");

  } catch (err) {
    showToast("Failed to resend OTP");
  }
}

  /* ── SUBMIT ── */
document.querySelector("form").addEventListener("submit", function (e) {
  const boxes = document.querySelectorAll(".otp-box");
  const otp = Array.from(boxes).map(b => b.value).join('');

  if (otp.length < 4) {
    e.preventDefault();
    showToast("Enter full OTP");
    return;
  }

  document.getElementById("fullOtp").value = otp;
});

window.addEventListener("pageshow", function (event) {
    if (event.persisted) {
      window.location.reload();
    }
  });

</script>
</body>
</html>