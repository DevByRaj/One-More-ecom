<!DOCTYPE html>
<html lang="en">
<head>
<meta http-equiv="Cache-Control" content="no-store" />
<meta http-equiv="Pragma" content="no-cache" />
<meta http-equiv="Expires" content="0" />
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Personal Information</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
 
  body {
    font-family: 'Poppins', sans-serif;
    background: #1a1a1a;
    color: #1a1a1a;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
 
  /* ── NAVBAR ── */
  nav {
    background: #1a1a1a;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    position: sticky; top: 0; z-index: 100;
  }
  .nav-inner {
    display: flex;
    height: 90px;
    align-items: center;
    justify-content: space-between;
    padding: 14px 32px;
  }


   .logo-img {
   width: 80px;     /* adjust size */
   height: auto;
   object-fit: contain;
  }

  .nav-links {
    display: flex; gap: 36px;
    position: absolute; left: 50%; transform: translateX(-50%);
  }
  .nav-links a {
    font-size: 14px; font-weight: 400;
    color: #ccc; text-decoration: none;
    cursor: pointer; transition: color 0.2s;
  }
  .nav-links a:hover { color: #fff; }
  .nav-icons { display: flex; gap: 18px; align-items: center; }
  .nav-icons svg {
    width: 22px; height: 22px;
    stroke: #ccc; fill: none;
    cursor: pointer; stroke-width: 1.6;
  }
  .nav-icons svg:hover { stroke: #fff; }
 
  /* ── PAGE WRAPPER ── */
  main {
    flex: 1;
    background: #f0f0eb;
    padding: 60px 40px 32px;
  }
 
  .page-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 24px;
    max-width: 760px;
    margin: 0 auto;
  }
 
  /* ── SIDEBAR ── */
  .sidebar {
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 10px;
    padding: 20px 0 16px;
    height: fit-content;
  }
 
  .sidebar-title {
    font-size: 13px;
    font-weight: 600;
    color: #1a1a1a;
    padding: 0 20px 16px;
    border-bottom: 1px solid #eee;
    letter-spacing: 0.3px;
  }
 
  .sidebar-menu {
    padding: 10px 0;
  }
 
  .menu-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 400;
    color: #444;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    border-radius: 0;
  }
  .menu-item:hover { background: #f5f5f5; color: #1a1a1a; }
  .menu-item.active { color: #1a1a1a; font-weight: 500; }
 
  .menu-item svg {
    width: 16px; height: 16px;
    stroke: #888; fill: none;
    stroke-width: 1.6; flex-shrink: 0;
  }
  .menu-item.active svg { stroke: #1a1a1a; }
  .menu-item:hover svg  { stroke: #1a1a1a; }
 
  /* logout red */
  .menu-item.logout { color: #c0392b; }
  .menu-item.logout svg { stroke: #c0392b; }
  .menu-item.logout:hover { background: #fff5f5; }
 
  /* ── MAIN PANEL ── */
  .panel {
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 10px;
    padding: 28px 32px 32px;
  }
 
  .panel-title {
    font-size: 15px;
    font-weight: 600;
    color: #1a1a1a;
    text-align: center;
    margin-bottom: 28px;
    letter-spacing: 0.2px;
  }
 
  /* ── PROFILE HEADER ── */
  .profile-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 28px;
    padding-bottom: 24px;
    border-bottom: 1px solid #eee;
  }
 
  .avatar-wrap {
    position: relative;
    width: 72px; height: 72px; flex-shrink: 0;
  }
 
  .avatar {
    width: 72px; height: 72px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid #ddd;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, #1a1a2e, #2a2a4e);
  }
 
  /* headphone avatar SVG */
  .avatar svg { width: 56px; height: 56px; }
 
  .avatar-edit {
    position: absolute;
    bottom: 0; right: 0;
    width: 22px; height: 22px;
    background: #1a1a1a;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; border: 2px solid #fff;
  }
  .avatar-edit svg {
    width: 10px; height: 10px;
    stroke: #fff; fill: none; stroke-width: 2;
  }
 
  .ref-section {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
 
  .ref-label {
    font-size: 11px;
    font-weight: 500;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    border: 1px solid #ccc;
    padding: 4px 10px;
    border-radius: 4px;
  }
 
  .ref-code {
    font-size: 12px;
    font-weight: 600;
    color: #1a1a1a;
    letter-spacing: 0.5px;
    border: 1px solid #ccc;
    padding: 4px 12px;
    border-radius: 4px;
    background: #f5f5f5;
  }
 
  .copy-btn {
    background: #4a9dd4;
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    padding: 5px 14px;
    border-radius: 4px;
    border: none;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    letter-spacing: 0.3px;
    transition: background 0.2s;
  }
  .copy-btn:hover { background: #3a8dc4; }
 
  /* ── PROFILE FIELDS ── */
  .field-group {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 32px;
  }
 
  .field-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
 
  .field-value {
    font-size: 14px;
    font-weight: 400;
    color: #1a1a1a;
    padding: 10px 0;
    border-bottom: 1px solid #eee;
    letter-spacing: 0.2px;
  }
 
  .field-value.name  { font-size: 15px; font-weight: 500; }
  .field-value.email { color: #444; }
  .field-value.phone { color: #444; }

  .field-label {
  font-size: 13px;
  color: #888;
  font-weight: 500;
  letter-spacing: 0.5px;
}
 
  /* ── UPDATE BUTTON ── */
  .update-wrap {
    display: flex;
    justify-content: center;
  }
 
  .update-btn {
    background: #1a1a1a;
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    padding: 10px 36px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    font-family: 'Poppins', sans-serif;
    letter-spacing: 0.3px;
    transition: background 0.2s;
  }
  .update-btn:hover { background: #333; }
 
  /* ── FOOTER ── */
  footer {
    background: #1a1a1a;
    padding: 40px 48px 20px;
    color: #fff;
  }

  /* Center the footer logo container */
.footer-logo {
  display: flex;
  justify-content: center; /* Horizontal center */
  align-items: center;     /* Vertical center */
  width: 100%;
  margin-bottom: 40px;     /* Space between logo and the links below */
}

/* Ensure the image inside stays responsive */
.footer-logo .logo-img {
  width: 80px;            /* Increased slightly for footer prominence */
  height: auto;
  display: block;
}
 
  .footer-logo-row {
    display: flex;
    justify-content: center;
    margin-bottom: 28px;
  }
 
  .footer-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 20px;
    margin-bottom: 28px;
  }
 
  .footer-col-title {
    font-size: 12px; font-weight: 700;
    color: #fff; margin-bottom: 12px;
    letter-spacing: 0.3px; text-transform: uppercase;
  }
 
  .footer-col a {
    display: block; font-size: 11px;
    font-weight: 300; color: #aaa;
    text-decoration: none; margin-bottom: 7px;
    cursor: pointer; transition: color 0.2s;
  }
  .footer-col a:hover { color: #fff; }
 
  .footer-contact-label { font-size: 11px; color: #fff; font-weight: 500; }
  .footer-contact-val   { font-size: 11px; color: #aaa; margin-left: 4px; }
 
  .footer-social { display: flex; gap: 14px; margin-top: 6px; }
  .footer-social svg {
    width: 18px; height: 18px; fill: #ccc;
    cursor: pointer; transition: fill 0.2s;
  }
  .footer-social svg:hover { fill: #fff; }
 
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.06);
    padding-top: 16px;
    font-size: 11px; color: #555;
    font-weight: 300;
  }

  .modal {
  display: none;
  position: fixed;
  z-index: 2000;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.6);
}

.modal-box {
  background: #fff;
  padding: 25px;
  width: 320px;
  margin: 15% auto;
  border-radius: 10px;
  text-align: center;
}

.modal-buttons {
  margin-top: 15px;
  display: flex;
  justify-content: space-between;
}

.logout-confirm {
  background: #1a1a1a;
  color: white;
  padding: 8px 16px;
  text-decoration: none;
  border-radius: 5px;
}
 
  /* ── TOAST ── */
  #toast {
    position: fixed; bottom: 24px; right: 24px;
    background: #222; color: #fff;
    font-size: 12px; padding: 10px 18px;
    border-radius: 6px; display: none;
    border: 1px solid #444; z-index: 999;
    animation: fadeIn 0.2s ease;
  }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; } }
</style>
</head>
<body>
 
<div id="toast"></div>
 
<!-- NAVBAR -->
<nav>
  <div class="nav-inner">
    <div class="nav-logo">
  <img src="/images/logo.png" alt="logo" class="logo-img">
</div>
    <div class="nav-links">
    <a href="/">Home</a>
    <a href="#">Shop</a>
    <a href="#">Contact Us</a>
    <a href="#">About Us</a>
  </div>
    <div class="nav-icons">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
      <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
    </div>
  </div>
</nav>
 
<!-- MAIN -->
<main>
  <div class="page-layout">
 
    <!-- SIDEBAR -->
    <aside class="sidebar">
      <div class="sidebar-title">My Account</div>
      <div class="sidebar-menu">
 
        <div class="menu-item active">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="7" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
          Personal Information
        </div>
 
        <div class="menu-item">
          <svg viewBox="0 0 24 24"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          Address
        </div>
 
        <div class="menu-item">
          <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3H8a2 2 0 0 0-2 2v2h12V5a2 2 0 0 0-2-2z"/></svg>
          Order
        </div>
 
        <div class="menu-item">
          <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          Wallet
        </div>
 
        <div class="menu-item">
          <svg viewBox="0 0 24 24"><path d="M7 7h10l1 10H6L7 7z"/><path d="M9 7V5a3 3 0 0 1 6 0v2"/></svg>
          Coupon
        </div>
 
        <div class="menu-item">
          <svg viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          Password Change
        </div>
        
        <a href="/logout" class="menu-item logout">
  <svg viewBox="0 0 24 24">
    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
    <polyline points="16 17 21 12 16 7"/>
    <line x1="21" y1="12" x2="9" y2="12"/>
  </svg>
  Logout
</a>
        
 
      </div>
    </aside>
 
    <!-- PROFILE PANEL -->
    <div class="panel">
      <div class="panel-title">Personal Information</div>
 
      <!-- avatar + ref -->
      <div class="profile-header">
        <div class="avatar-wrap">
  <div class="avatar">
    <img src="<%= user && user.profileImage ? user.profileImage : '/images/default-user.png' %>"
         style="width:100%; height:100%; border-radius:50%; object-fit:cover;">
  </div> <!-- ✅ ADD THIS -->
</div>
 
        <div class="ref-section">
          <span class="ref-label">REF</span>
          <span class="ref-code">XANFIMI234</span>
          <button class="copy-btn" onclick="copyRef()">copy</button>
        </div>
      </div>
 
      <!-- fields -->
      <div class="field-group">

  <div class="field-row">
    <label class="field-label">Name</label>
    <div class="field-value name"><%= user.name %></div>
  </div>

  <div class="field-row">
    <label class="field-label">Email</label>
    <div class="field-value email"><%= user.email %></div>
  </div>

  <div class="field-row">
    <label class="field-label">Phone</label>
    <div class="field-value phone"><%= user.phone || "Not added" %></div>
  </div>

</div>
 
      <!-- update button -->
      <div class="update-wrap">
        <a href="/profile/edit">
            <button class="update-btn">Edit Profile</button>
        </a>
      </div>
    </div>
 
  </div>
</main>
 
<!-- FOOTER -->
<footer>
  <div class="footer-logo">
  <img src="/images/logo.png" class="logo-img">
</div>
 
  <div class="footer-grid">
    <div class="footer-col">
      <div class="footer-col-title">SUPPORT</div>
      <a>Order Status</a>
      <a>Product Support</a>
      <a>Shipping &amp; Return Policy</a>
      <a>Complaint Registration</a>
    </div>
    <div class="footer-col">
      <div class="footer-col-title">About Us</div>
      <a>Contact Us</a>
      <a>Privacy Policy</a>
      <a>Terms of use</a>
      <a>FAQ</a>
    </div>
    <div class="footer-col">
      <div class="footer-col-title">Contact</div>
      <div style="margin-bottom:6px;">
        <span class="footer-contact-label">Email :</span>
        <span class="footer-contact-val">onemore@gmail.com</span>
      </div>
      <div>
        <span class="footer-contact-label">Phone :</span>
        <span class="footer-contact-val">+91 8888888888</span>
      </div>
    </div>
    <div class="footer-col">
      <div class="footer-col-title">Connect with us</div>
      <div class="footer-social">
        <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      </div>
    </div>
  </div>
 
  <div class="footer-bottom">© 2025 onemore . All Rights Reserved.</div>
</footer>
 
<script>
  function copyRef() {
    navigator.clipboard.writeText('XANFIMI234').catch(() => {});
    showToast('Ref code copied!');
  }
  function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.style.display = 'block';
    clearTimeout(t._t);
    t._t = setTimeout(() => t.style.display = 'none', 2500);
  }
 
  // sidebar nav highlight
  document.querySelectorAll('.menu-item:not(.logout)').forEach(item => {
    item.addEventListener('click', function() {
      document.querySelectorAll('.menu-item').forEach(i => i.classList.remove('active'));
      this.classList.add('active');
    });
  });

  window.addEventListener("pageshow", function (event) {
    if (event.persisted || window.performance.getEntriesByType("navigation")[0].type === "back_forward") {
      window.location.reload();
    }
  }); 
</script>
</body>
</html>