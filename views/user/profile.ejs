<!DOCTYPE html>
<html lang="en">

<head>
  <meta http-equiv="Cache-Control" content="no-store">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>My Profile | OneMore</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">

  <style>

:root {
  --black: #090909;
  --background: #f7f7f4;
  --surface: #ffffff;
  --surface-hover: #f1f1ec;
  --border: #e7e7df;
  --lime: #d7f36b;
  --lime-hover: #c6e451;
  --white: #242422;
  --muted: #77776e;
  --danger: #c73d35;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  font-family: 'Poppins', sans-serif;
  color: var(--white);
  background: var(--background);
}

a {
  text-decoration: none;
}

button {
  font-family: inherit;
}

/* Profile navbar: limited to this page */
.profile-page-navbar {
  position: relative;
  z-index: 1000;
  background: #242422;
}

.profile-page-navbar nav,
.profile-page-navbar .navbar {
  background-color: #242422 !important;
}

.profile-page-navbar .navbar a,
.profile-page-navbar .navbar .nav-link,
.profile-page-navbar .navbar i,
.profile-page-navbar .navbar svg {
  color: #ffffff !important;
}

.profile-page-navbar .navbar a:hover,
.profile-page-navbar .navbar .nav-link:hover {
  color: var(--lime) !important;
}

.profile-page-navbar img {
  object-fit: contain;
}

/* Page heading */
main {
  flex: 1;
  padding: 48px 24px 65px;
  background:
    radial-gradient(
      ellipse at 8% 0%,
      rgba(215, 243, 107, 0.10),
      transparent 35%
    ),
    var(--background);
}

.account-heading,
.page-layout {
  max-width: 1120px;
  margin-right: auto;
  margin-left: auto;
}

.account-heading {
  margin-bottom: 30px;
}

.account-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 10px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 2px;
  text-transform: uppercase;
}

.account-eyebrow::before {
  content: "";
  width: 23px;
  height: 3px;
  background: var(--lime-hover);
}

.account-heading h1 {
  margin: 0;
  font-size: clamp(27px, 3vw, 36px);
  font-weight: 600;
  letter-spacing: -1.2px;
}

.account-heading p {
  margin: 10px 0 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.7;
}

/* Main layout */
.page-layout {
  display: grid;
  grid-template-columns: 245px minmax(0, 1fr);
  align-items: start;
  gap: 25px;
}

/* Sidebar */
.sidebar {
  height: fit-content;
  overflow: hidden;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 8px 28px rgba(30, 30, 20, 0.045);
}

.sidebar-top {
  padding: 22px 20px 18px;
  border-bottom: 1px solid var(--border);
}

.sidebar-title {
  margin: 0;
  color: #88887d;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.sidebar-menu {
  display: flex;
  flex-direction: column;
  gap: 5px;
  padding: 12px;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 44px;
  min-width: 0;
  padding: 11px 12px;
  color: #5d5d55;
  border-radius: 7px;
  font-size: 12px;
  font-weight: 400;
  line-height: 1.5;
  transition: background 0.2s ease, color 0.2s ease;
}

.menu-item svg {
  width: 17px;
  height: 17px;
  flex-shrink: 0;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
}

.menu-item:hover {
  color: #242422;
  background: #f5f5ef;
}

.menu-item.active {
  color: #242422;
  background: #edf4d7;
  font-weight: 600;
}

.menu-item.logout {
  margin-top: 5px;
  color: var(--danger);
}

.menu-item.logout:hover {
  background: #fff0ed;
}

/* Profile card */
.panel {
  min-width: 0;
  overflow: hidden;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  box-shadow: 0 8px 28px rgba(30, 30, 20, 0.045);
}

.panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 25px 30px;
  border-bottom: 1px solid var(--border);
}

.panel-heading h2 {
  margin: 0;
  font-size: 17px;
  font-weight: 600;
  letter-spacing: -0.4px;
}

.account-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--muted);
  font-size: 10px;
  white-space: nowrap;
}

.account-status span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #8caf3c;
}

.panel-body {
  padding: 30px;
}

/* Profile identity */
.profile-header {
  display: flex;
  align-items: center;
  gap: 20px;
  min-width: 0;
  padding-bottom: 27px;
  margin-bottom: 27px;
  border-bottom: 1px solid var(--border);
}

.avatar-wrap {
  width: 86px;
  height: 86px;
  flex-shrink: 0;
  padding: 3px;
  border: 1px solid #e5eacb;
  border-radius: 50%;
  background: #f4f6e8;
}

.avatar {
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 50%;
  background: #e8e9dd;
}

.avatar img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.profile-identity {
  min-width: 0;
  flex: 1;
}

.profile-identity h3 {
  margin: 0 0 5px;
  overflow-wrap: anywhere;
  font-size: 17px;
  font-weight: 600;
  letter-spacing: -0.35px;
}

.profile-identity p {
  margin: 0 0 14px;
  color: var(--muted);
  font-size: 12px;
}

.ref-section {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  min-width: 0;
}

.ref-label {
  color: var(--muted);
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 1px;
}

.ref-code {
  display: inline-block;
  max-width: 100%;
  padding: 7px 10px;
  overflow-wrap: anywhere;
  color: #242422;
  background: #f5f5ef;
  border: 1px solid #e7e7dc;
  border-radius: 5px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.4px;
}

.copy-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 8px 12px;
  color: #242422;
  background: var(--lime);
  border: 1px solid var(--lime);
  border-radius: 5px;
  cursor: pointer;
  font-size: 10px;
  font-weight: 600;
  transition: background 0.2s ease;
}

.copy-btn:hover {
  background: var(--lime-hover);
}

/* Account details */
.details-heading {
  margin: 0 0 18px;
  color: #858579;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1.5px;
  text-transform: uppercase;
}

.field-group {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 25px;
  margin-bottom: 28px;
}

.field-row {
  min-width: 0;
  padding: 17px 0;
  border-bottom: 1px solid #eeeee7;
}

.field-label {
  display: block;
  margin-bottom: 9px;
  color: #858579;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.8px;
  text-transform: uppercase;
}

.field-value {
  min-width: 0;
  overflow-wrap: anywhere;
  color: #242422;
  font-size: 13px;
  font-weight: 500;
  line-height: 1.7;
}

.field-value.email,
.field-value.phone {
  color: #515149;
  font-weight: 400;
}

.update-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding-top: 3px;
}

.edit-note {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.7;
}

.update-wrap a {
  flex-shrink: 0;
  text-decoration: none;
}

.update-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 43px;
  padding: 0 22px;
  color: #fff;
  background: #242422;
  border: 1px solid #242422;
  border-radius: 6px;
  cursor: pointer;
  font-size: 11px;
  font-weight: 500;
  transition: color 0.2s ease, background 0.2s ease;
}

.update-btn:hover {
  color: #242422;
  background: var(--lime);
  border-color: var(--lime);
}

/* Success toast */
.profile-toast {
  position: fixed;
  z-index: 9999;
  top: 20px;
  left: 50%;
  display: flex;
  align-items: center;
  gap: 12px;
  width: 470px;
  max-width: calc(100% - 30px);
  padding: 15px 17px;
  overflow: hidden;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 9px;
  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.14);
  transform: translateX(-50%);
  animation: toastSlideDown 0.3s ease;
}

.toast-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  color: #466b27;
  background: #edf5dc;
  border-radius: 50%;
  font-size: 15px;
}

.toast-content {
  flex: 1;
  min-width: 0;
}

.toast-title {
  margin-bottom: 3px;
  overflow-wrap: anywhere;
  color: #426b27;
  font-size: 13px;
  font-weight: 600;
}

.toast-message {
  color: #77776e;
  font-size: 11px;
  line-height: 1.6;
}

.toast-close {
  padding: 5px;
  color: #777;
  background: transparent;
  border: none;
  cursor: pointer;
}

.toast-progress {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 3px;
  background: var(--lime-hover);
  animation: toastProgress 4s linear forwards;
}

@keyframes toastSlideDown {
  from {
    opacity: 0;
    transform: translate(-50%, -12px);
  }
  to {
    opacity: 1;
    transform: translate(-50%, 0);
  }
}

@keyframes toastProgress {
  from { width: 100%; }
  to { width: 0; }
}

/* Footer */
footer {
  padding: 36px 35px 18px;
  color: #fff;
  background: #242422;
}

.footer-logo {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30px;
}

.footer-logo .logo-img {
  display: block;
  width: 72px;
  height: auto;
}

.footer-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 25px;
  max-width: 1120px;
  margin: 0 auto 28px;
}

.footer-col {
  min-width: 0;
}

.footer-col-title {
  margin-bottom: 13px;
  color: #fff;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.footer-col a {
  display: block;
  margin-bottom: 7px;
  color: #b9b9b0;
  font-size: 10px;
  font-weight: 300;
  line-height: 1.8;
  cursor: pointer;
  transition: color 0.2s ease;
}

.footer-col a:hover {
  color: var(--lime);
}

.footer-contact-label {
  color: #fff;
  font-size: 10px;
  font-weight: 500;
}

.footer-contact-val {
  margin-left: 3px;
  overflow-wrap: anywhere;
  color: #b9b9b0;
  font-size: 10px;
}

.footer-social {
  display: flex;
  gap: 14px;
  margin-top: 8px;
}

.footer-social svg {
  width: 17px;
  height: 17px;
  fill: #c9c9c1;
  cursor: pointer;
  transition: fill 0.2s ease;
}

.footer-social svg:hover {
  fill: var(--lime);
}

.footer-bottom {
  max-width: 1120px;
  margin: 0 auto;
  padding-top: 16px;
  color: #85857d;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  font-size: 10px;
  font-weight: 300;
  text-align: center;
}

/* General toast */
#toast {
  position: fixed;
  z-index: 9999;
  right: 20px;
  bottom: 20px;
  display: none;
  max-width: calc(100% - 40px);
  padding: 11px 16px;
  color: #fff;
  background: #242422;
  border: 1px solid #454540;
  border-radius: 6px;
  font-size: 12px;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.12);
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Tablet */
@media (max-width: 900px) {
  main {
    padding: 35px 20px 45px;
  }

  .page-layout {
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 18px;
  }

  .panel-heading,
  .panel-body {
    padding: 22px;
  }

  .profile-header {
    gap: 15px;
  }

  .avatar-wrap {
    width: 74px;
    height: 74px;
  }

  .footer-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    row-gap: 25px;
  }
}

/* Mobile */
@media (max-width: 640px) {
  main {
    padding: 27px 14px 35px;
  }

  .account-heading {
    margin-bottom: 22px;
  }

  .account-heading h1 {
    font-size: 27px;
  }

  .account-heading p {
    max-width: 330px;
    font-size: 12px;
  }

  .page-layout {
    grid-template-columns: minmax(0, 1fr);
    gap: 15px;
  }

  .sidebar,
  .panel {
    border-radius: 9px;
  }

  .sidebar-top {
    padding: 15px 16px 12px;
  }

  .sidebar-menu {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 5px;
    padding: 9px;
  }

  .menu-item {
    min-height: 42px;
    gap: 8px;
    padding: 9px;
    font-size: 11px;
  }

  .menu-item svg {
    width: 15px;
    height: 15px;
  }

  .menu-item.logout {
    margin-top: 0;
  }

  .panel-heading {
    padding: 20px 18px;
  }

  .panel-heading h2 {
    font-size: 16px;
  }

  .panel-body {
    padding: 20px 18px 22px;
  }

  .profile-header {
    align-items: flex-start;
    gap: 13px;
    padding-bottom: 22px;
    margin-bottom: 22px;
  }

  .avatar-wrap {
    width: 65px;
    height: 65px;
  }

  .profile-identity h3 {
    font-size: 15px;
  }

  .profile-identity p {
    margin-bottom: 11px;
    font-size: 11px;
  }

  .ref-section {
    gap: 6px;
  }

  .ref-code {
    padding: 6px 8px;
    font-size: 10px;
  }

  .copy-btn {
    padding: 7px 9px;
    font-size: 10px;
  }

  .field-group {
    grid-template-columns: minmax(0, 1fr);
    margin-bottom: 23px;
  }

  .field-row {
    padding: 15px 0;
  }

  .field-label {
    margin-bottom: 7px;
  }

  .field-value {
    font-size: 13px;
  }

  .update-wrap {
    align-items: stretch;
    flex-direction: column;
    gap: 13px;
  }

  .update-wrap a,
  .update-btn {
    width: 100%;
  }

  .update-btn {
    min-height: 45px;
  }

  footer {
    padding: 29px 18px 17px;
  }

  .footer-logo {
    margin-bottom: 24px;
  }

  .footer-logo .logo-img {
    width: 65px;
  }

  .footer-grid {
    gap: 23px 15px;
    margin-bottom: 24px;
  }

  .footer-col-title,
  .footer-col a,
  .footer-contact-label,
  .footer-contact-val {
    font-size: 9px;
  }

  .profile-toast {
    top: 12px;
    padding: 12px;
  }

  .toast-icon {
    width: 33px;
    height: 33px;
  }

  .toast-title {
    font-size: 12px;
  }

  .toast-message {
    font-size: 10px;
  }
}

@media (max-width: 380px) {
  main {
    padding-right: 10px;
    padding-left: 10px;
  }

  .sidebar-menu {
    grid-template-columns: minmax(0, 1fr);
  }

  .profile-header {
    flex-direction: column;
  }

  .profile-identity,
  .ref-section {
    width: 100%;
  }

  .account-status {
    font-size: 9px;
  }

  footer {
    padding-right: 14px;
    padding-left: 14px;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
}

  </style>
 
</head>

<body>

  <% if (typeof error !=='undefined' && error) { %>
    <div class="alert alert-danger text-center mb-0">
      <%= error %>
    </div>
    <% } %>

      <% if (typeof success !=='undefined' && success) { %>
        <div class="profile-toast" id="profileToast">
          <div class="toast-icon">
            <i class="fas fa-check"></i>
          </div>

          <div class="toast-content">
            <div class="toast-title">
              <%= success %>
            </div>
            <div class="toast-message">
              Your information has been saved successfully.
            </div>
          </div>

          <button type="button" class="toast-close" onclick="closeProfileToast()">
            <i class="fas fa-times"></i>
          </button>

          <div class="toast-progress"></div>
        </div>
        <% } %>

          <div id="toast"></div>

          <!-- Shared navbar: styling is scoped to this profile page -->
          <div class="profile-page-navbar">
            <%- include("../partials/navbar") %>
          </div>

          <main>
            <div class="account-heading">
              <div class="account-eyebrow">Your OneMore Account</div>
              <h1>My Account</h1>
              <p>Manage your personal details and keep your account information up to date.</p>
            </div>

            <div class="page-layout">

              <!-- Account sidebar -->
              <aside class="sidebar">
                <div class="sidebar-top">
                  <div class="sidebar-title">Account Menu</div>
                </div>

                <nav class="sidebar-menu">
                  <div class="menu-item active" aria-current="page">
                    <svg viewBox="0 0 24 24">
                      <circle cx="12" cy="7" r="4" />
                      <path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" />
                    </svg>
                    <span>Personal Information</span>
                  </div>

                  <a href="/address" class="menu-item">
                    <svg viewBox="0 0 24 24">
                      <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                      <polyline points="9 22 9 12 15 12 15 22" />
                    </svg>
                    <span>Address</span>
                  </a>

                  <a href="/orders" class="menu-item">
                    <svg viewBox="0 0 24 24">
                      <rect x="2" y="7" width="20" height="14" rx="2" />
                      <path d="M16 3H8a2 2 0 0 0-2 2v2h12V5a2 2 0 0 0-2-2z" />
                    </svg>
                    <span>Order</span>
                  </a>

                  <a href="/wallet" class="menu-item">
                    <svg viewBox="0 0 24 24">
                      <rect x="2" y="5" width="20" height="14" rx="2" />
                      <line x1="2" y1="10" x2="22" y2="10" />
                    </svg>
                    <span>Wallet</span>
                  </a>

                  <a href="/coupons" class="menu-item">
                    <svg viewBox="0 0 24 24">
                      <path d="M7 7h10l1 10H6L7 7z" />
                      <path d="M9 7V5a3 3 0 0 1 6 0v2" />
                    </svg>
                    <span>Coupon</span>
                  </a>

                  <a href="/change-password" class="menu-item">
                    <svg viewBox="0 0 24 24">
                      <rect x="4" y="10" width="16" height="11" rx="2" />
                      <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    </svg>
                    <span>Change Password</span>
                  </a>

                  <a href="/logout" class="menu-item logout">
                    <svg viewBox="0 0 24 24">
                      <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                      <polyline points="16 17 21 12 16 7" />
                      <line x1="21" y1="12" x2="9" y2="12" />
                    </svg>
                    <span>Logout</span>
                  </a>
                </nav>
              </aside>

              <!-- Profile panel -->
              <section class="panel">
                <div class="panel-heading">
                  <h2>Personal Information</h2>
                  <div class="account-status">
                    <span></span>
                    My Profile
                  </div>
                </div>

                <div class="panel-body">

                  <div class="profile-header">
                    <div class="avatar-wrap">
                      <div class="avatar">
                        <img src="<%= user && user.profileImage ? user.profileImage : '/images/default-user.png' %>"
                          alt="Profile picture">
                      </div>
                    </div>

                    <div class="profile-identity">
                      <h3>
                        <%= user.name %>
                      </h3>
                      <p>Welcome to your OneMore account.</p>

                      <div class="ref-section">
                        <span class="ref-label">REF CODE</span>

                        <span class="ref-code" id="refCode" data-ref="<%= user.referralCode %>">
                          <%= user.referralCode %>
                        </span>

                        <button type="button" class="copy-btn" onclick="copyRef()">
                          <i class="far fa-copy"></i>
                          Copy
                        </button>
                      </div>
                    </div>
                  </div>

                  <h3 class="details-heading">Account Details</h3>

                  <div class="field-group">
                    <div class="field-row">
                      <label class="field-label">Full Name</label>
                      <div class="field-value name">
                        <%= user.name %>
                      </div>
                    </div>

                    <div class="field-row">
                      <label class="field-label">Email Address</label>
                      <div class="field-value email">
                        <%= user.email %>
                      </div>
                    </div>

                    <div class="field-row">
                      <label class="field-label">Phone Number</label>
                      <div class="field-value phone">
                        <%= user.phone || "Not added" %>
                      </div>
                    </div>
                  </div>

                  <div class="update-wrap">
                    <div class="edit-note">
                      Need to change your details?<br>
                      You can update them from your profile settings.
                    </div>

                    <a href="/profile/edit">
                      <button type="button" class="update-btn">
                        Edit Profile
                        <i class="fas fa-arrow-right"></i>
                      </button>
                    </a>
                  </div>

                </div>
              </section>

            </div>
          </main>

          <!-- Footer -->
          <footer>
            <div class="footer-logo">
              <img src="/images/logo.png" class="logo-img" alt="OneMore">
            </div>

            <div class="footer-grid">
              <div class="footer-col">
                <div class="footer-col-title">Support</div>
                <a>Order Status</a>
                <a>Product Support</a>
                <a>Shipping &amp; Return Policy</a>
                <a>Complaint Registration</a>
              </div>

              <div class="footer-col">
                <div class="footer-col-title">About Us</div>
                <a>Contact Us</a>
                <a>Privacy Policy</a>
                <a>Terms of use</a>
                <a>FAQ</a>
              </div>

              <div class="footer-col">
                <div class="footer-col-title">Contact</div>
                <div style="margin-bottom: 7px;">
                  <span class="footer-contact-label">Email:</span>
                  <span class="footer-contact-val">onemore@gmail.com</span>
                </div>
                <div>
                  <span class="footer-contact-label">Phone:</span>
                  <span class="footer-contact-val">+91 8888888888</span>
                </div>
              </div>

              <div class="footer-col">
                <div class="footer-col-title">Connect With Us</div>
                <div class="footer-social">
                  <svg viewBox="0 0 24 24" aria-label="Instagram">
