                  </svg>

                  <svg viewBox="0 0 24 24" aria-label="X">
                    <path
                      d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                  </svg>
                </div>
              </div>
            </div>

            <div class="footer-bottom">
              © 2025 OneMore. All Rights Reserved.
            </div>
          </footer>

          <script>
            function copyRef() {
              const refElement = document.getElementById("refCode");

              if (!refElement) return;

              const refCode = refElement.dataset.ref;

              if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(refCode)
                  .then(() => showToast("Referral code copied!"))
                  .catch(() => fallbackCopyRef(refCode));
              } else {
                fallbackCopyRef(refCode);
              }
            }

            function fallbackCopyRef(text) {
              const textArea = document.createElement("textarea");
              textArea.value = text;
              textArea.style.position = "fixed";
              textArea.style.opacity = "0";

              document.body.appendChild(textArea);
              textArea.select();

              try {
                document.execCommand("copy");
                showToast("Referral code copied!");
              } catch (error) {
                showToast("Unable to copy referral code.");
              }

              textArea.remove();
            }

            function showToast(msg) {
              const toast = document.getElementById("toast");
              if (!toast) return;

              toast.textContent = msg;
              toast.style.display = "block";

              clearTimeout(toast._t);
              toast._t = setTimeout(() => {
                toast.style.display = "none";
              }, 2500);
            }

            setTimeout(() => {
              closeProfileToast();
            }, 4000);

            function closeProfileToast() {
              const toast = document.getElementById("profileToast");
              if (!toast) return;

              toast.style.transition = "opacity 0.3s ease, transform 0.3s ease";
              toast.style.opacity = "0";
              toast.style.transform = "translate(-50%, -15px)";

              setTimeout(() => {
                toast.remove();
              }, 300);
            }

            window.addEventListener("pageshow", function (event) {
              const navigation = performance.getEntriesByType("navigation")[0];

              if (
                event.persisted ||
                (navigation && navigation.type === "back_forward")
              ) {
                window.location.reload();
              }
            });
          </script>

</body>

</html>