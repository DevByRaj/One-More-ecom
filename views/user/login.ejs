<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login</title>

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      background: #0f0f0f;
      color: #fff;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    /* NAVBAR */
    nav {
      background: #0f0f0f;
      padding: 20px 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo-img {
      width: 60px;
    }

    .nav-links {
      display: flex;
      gap: 40px;
    }

    .nav-links a {
      color: #cfcfcf;
      text-decoration: none;
      font-size: 14px;
      transition: color 0.3s;
    }

    .nav-links a:hover {
      color: #fff;
    }

    .icons {
      display: flex;
      gap: 25px;
    }

    .icons i {
      font-size: 18px;
      color: #ccc;
      cursor: pointer;
    }

    /* MAIN */
    .main {
      background: #dcdcdc;
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 40px 20px;
    }

    /* CARD */
    .card {
      background: #efefef;
      border: 2px solid #000;
      border-radius: 20px;
      padding: 40px 30px;
      width: 100%;
      max-width: 380px;
      text-align: center;
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    }

    .card h2 {
      margin-bottom: 25px;
      color: #000;
      font-weight: 600;
    }

    /* INPUT */
    .card input {
      width: 100%;
      padding: 12px;
      padding-right: 40px;
      margin-bottom: 5px;
      border-radius: 10px;
      border: 1.5px solid transparent;
      background: #cfcfcf;
      font-family: 'Poppins', sans-serif;
      transition: border-color 0.3s;
    }

    .card input:focus {
      outline: none;
      border-color: #000;
    }

    /* INPUT GROUP */
    .input-group {
      position: relative;
    }

    .toggle-eye {
      position: absolute;
      right: 15px;
      top: 50%;
      transform: translateY(-50%);
      cursor: pointer;
      color: #555;
      padding: 5px;
    }

    /* ERROR */
    .error-msg {
      color: #d93025;
      font-size: 11px;
      text-align: left;
      margin-bottom: 12px;
      min-height: 15px;
    }

    /* LINKS */
    .links {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      margin-bottom: 20px;
    }

    .links a {
      color: #000;
      text-decoration: none;
      font-weight: 500;
    }

    .links a:hover {
      text-decoration: underline;
    }

    /* BUTTON */
    .btn {
      width: 100%;
      padding: 12px;
      background: #000;
      color: #fff;
      border-radius: 10px;
      border: none;
      cursor: pointer;
      font-weight: 500;
      font-family: 'Poppins', sans-serif;
      transition: background 0.3s;
    }

    .btn:hover {
      background: #333;
    }

    /* GOOGLE */
    .google-text {
      margin-top: 20px;
      font-size: 12px;
      color: #555;
      position: relative;
    }

    .google-icon {
      margin-top: 10px;
    }

    .google-icon a {
      display: inline-block;
      padding: 8px;
      border-radius: 50%;
      background: #fff;
      border: 1px solid #ddd;
      line-height: 0;
    }

    /* FOOTER */
    footer {
      background: #0f0f0f;
      padding: 60px 80px 30px;
    }

    .footer-logo {
      display: flex;
      justify-content: center;
      margin-bottom: 40px;
    }

    .footer-logo img {
      width: 80px;
    }

    .footer-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 30px;
      max-width: 1200px;
      margin: 0 auto;
    }

    .footer-section h4 {
      color: #fff;
      margin-bottom: 15px;
      font-size: 15px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .footer-section p {
      color: #aaa;
      font-size: 13px;
      margin-bottom: 8px;
      cursor: pointer;
    }

    .footer-section p:hover {
      color: #fff;
    }

    .bottom {
      margin-top: 50px;
      font-size: 12px;
      color: #555;
      text-align: center;
      border-top: 1px solid #222;
      padding-top: 20px;
    }
  </style>
</head>

<body>

  <nav>
    <a href="/"><img src="/images/logo.png" class="logo-img" alt="Logo"></a>

    <div class="nav-links">
      <a href="/">Home</a>
      <a href="#">Shop</a>
      <a href="#">Contact Us</a>
      <a href="#">About Us</a>
    </div>

    <div class="icons">
      <i class="fa-regular fa-user"></i>
      <i class="fa-regular fa-heart"></i>
      <i class="fa-solid fa-cart-shopping"></i>
    </div>
  </nav>

  <div class="main">
    <div class="card">
      <h2>Login</h2>

      <% if(success){ %>

        <div style="
          color:#28a745;
          background:#d4edda;
          padding:10px;
          border-radius:8px;
          text-align:center;
          margin-bottom:15px;
          font-size:13px;
          font-weight:500;
        ">

          <%= success %>

        </div>

        <% } %>

          <% if(errors.general){ %>
            <div style="color:#d93025; text-align:center; margin-bottom:15px; font-size: 13px;">
              <%= errors.general %>
            </div>
            <% } %>



              <!-- FORM -->
              <form id="loginForm" action="/login" method="POST" novalidate>

                <!-- EMAIL -->
                <input type="email" id="email" name="email" placeholder="Email" value="<%= oldData?.email || '' %>">
                <div id="emailError" class="error-msg">
                  <%= errors?.email %>
                </div>

                <!-- PASSWORD -->
                <div class="input-group">
                  <input type="password" id="password" name="password" placeholder="Password">
                  <i class="fa-solid fa-eye toggle-eye" onclick="togglePassword()"></i>
                </div>
                <div id="passwordError" class="error-msg">
                  <%= errors?.password %>
                </div>

                <div class="links">
                  <a href="/signup">Signup</a>
                  <a href="/forgot-password">Forgot Password?</a>
                </div>

                <button type="submit" class="btn">Login</button>

              </form>

              <!-- GOOGLE AUTH -->
              <p class="google-text">Or continue with</p>

              <div class="google-icon">
                <a href="/auth/google">
                  <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" width="24" alt="Google">
                </a>
              </div>
    </div>
  </div>

  <footer>
    <div class="footer-logo">
      <img src="/images/logo.png" alt="Footer Logo">
    </div>

    <div class="footer-container">
      <div class="footer-section">
        <h4>SUPPORT</h4>
        <p>Order Status</p>
        <p>Product Support</p>
        <p>Shipping & Return Policy</p>
        <p>Complaint Registration</p>
      </div>

      <div class="footer-section">
        <h4>About Us</h4>
        <p>Contact Us</p>
        <p>Privacy Policy</p>
        <p>Terms of use</p>
        <p>FAQ</p>
      </div>

      <div class="footer-section">
        <h4>Contact</h4>
        <p>Email: onemore@gmail.com</p>
        <p>Phone: +91 8888888888</p>
      </div>

      <div class="footer-section">
        <h4>Connect with us</h4>
        <p>Instagram</p>
        <p>Facebook</p>
        <p>X</p>
      </div>
    </div>

    <div class="bottom">
      © 2025 onemore. All Rights Reserved.
    </div>
  </footer>

  <script>
    const form = document.getElementById("loginForm");

    form.addEventListener("submit", function (e) {
      let valid = true;

      const email = document.getElementById("email");
      const password = document.getElementById("password");

      const emailError = document.getElementById("emailError");
      const passwordError = document.getElementById("passwordError");

      emailError.textContent = "";
      passwordError.textContent = "";

      const emailPattern = /^[^ ]+@[^ ]+\.[a-z]{2,3}$/;
      const passwordPattern = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[@$!%*?&])[A-Za-z\d@$!%*?&]{6,}$/;

      // EMAIL VALIDATION
      if (email.value.trim() === "") {
        emailError.textContent = "Email is required";
        valid = false;
      } else if (!emailPattern.test(email.value)) {
        emailError.textContent = "Enter valid email";
        valid = false;
      }

      // PASSWORD VALIDATION
      if (password.value.trim() === "") {
        passwordError.textContent = "Password is required";
        valid = false;
      } else if (!passwordPattern.test(password.value)) {
        passwordError.textContent =
          "Must include uppercase, lowercase, number & special character";
        valid = false;
      }

      if (!valid) e.preventDefault();
    });

    function togglePassword() {
      const input = document.getElementById("password");
      const icon = document.querySelector(".toggle-eye");

      if (input.type === "password") {
        input.type = "text";
        icon.classList.replace("fa-eye", "fa-eye-slash");
      } else {
        input.type = "password";
        icon.classList.replace("fa-eye-slash", "fa-eye");
      }
    }
  </script>

</body>

</html>