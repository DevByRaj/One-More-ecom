<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Login</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

<!-- Font Awesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Poppins', sans-serif;
  background: #0f0f0f;
  color: #fff;
}

/* ================= NAVBAR ================= */
nav {
  background: #0f0f0f;
  padding: 20px 60px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
 .logo-img {
   width: 60px;     /* adjust size */
   height: auto;
   object-fit: contain;
  }


.logo {
  font-size: 28px;
  font-weight: 600;
}

.nav-links {
  display: flex;
  gap: 40px;
}

.nav-links a {
  color: #cfcfcf;
  text-decoration: none;
  font-size: 14px;
}

.nav-links a:hover {
  color: #fff;
}

.icons {
  display: flex;
  gap: 25px;
}

.icons i {
  font-size: 18px;
  cursor: pointer;
  color: #ccc;
}

.icons i:hover {
  color: #fff;
}

/* ================= MAIN ================= */
.main {
  background: #dcdcdc;
  min-height: 70vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* ================= CARD ================= */
.card {
  background: #efefef;
  border: 2px solid #000;
  border-radius: 20px;
  padding: 40px 30px;
  width: 360px;
  text-align: center;
}

.card h2 {
  margin-bottom: 25px;
  color: #000;
  font-weight: 500;
}

/* ================= INPUT ================= */
.card input {
  width: 100%;
  padding: 12px;
  margin-bottom: 15px;
  border-radius: 10px;
  border: none;
  background: #cfcfcf;
  outline: none;
}

/* ================= LINKS ================= */
.links {
  display: flex;
  justify-content: space-between;
  font-size: 12px;
  margin-bottom: 15px;
}

.links a {
  color: #000;
  text-decoration: none;
}

/* ================= BUTTON ================= */
.btn {
  width: 100%;
  padding: 12px;
  background: #000;
  color: #fff;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 500;
}

.btn:hover {
  background: #222;
}

/* ================= GOOGLE ================= */
.google-text {
  margin-top: 10px;
  font-size: 12px;
  color: #555;
}

.google-icon {
  font-size: 18px;
  margin-top: 5px;
}

/* ================= FOOTER ================= */
footer {
  background: #0f0f0f;
  padding: 50px 80px;
}

.footer-logo {
  display: flex;
  justify-content: center; /* Horizontal center */
  align-items: center;     /* Vertical center */
  width: 100%;
  margin-bottom: 40px;     /* Space between logo and the links below */
}

/* Ensure the image inside stays responsive */
.footer-logo .logo-img {
  width: 80px;            /* Increased slightly for footer prominence */
  height: auto;
  display: block;
}
  

.footer-logo {
  text-align: center;
  font-size: 40px;
  font-weight: 600;
  margin-bottom: 20px;
}

.footer-container {
  display: flex;
  justify-content: space-between;
}

.footer-section h4 {
  color: #fff;
  margin-bottom: 12px;
  font-size: 14px;
}

.footer-section p {
  font-size: 13px;
  color: #aaa;
  margin-bottom: 6px;
}

.bottom {
  margin-top: 30px;
  font-size: 12px;
  color: #777;
}
</style>
</head>

<body>

<!-- NAVBAR -->
<nav>
   <img src="/images/logo.png" alt="logo" class="logo-img">
</div>

  <div class="nav-links">
    <a href="/">Home</a>
    <a href="#">Shop</a>
    <a href="#">Contact Us</a>
    <a href="#">About Us</a>
  </div>

  <div class="icons">
    <i class="fa-regular fa-user"></i>
    <i class="fa-regular fa-heart"></i>
    <i class="fa-solid fa-cart-shopping"></i>
  </div>
</nav>

<!-- MAIN -->
<div class="main">
  <div class="card">

    <h2>Login</h2>

    <form action="/login" method="POST">

      <input type="email" name="email" placeholder="Email" required>
      <input type="password" name="password" placeholder="Password" required>

      <div class="links">
        <a href="/signup">Signup</a>
        <a href="#">Forget Password?</a>
      </div>

      <button type="submit" class="btn">Login</button>

    </form>

    <p class="google-text">Or continue with</p>
    <div class="google-icon">
  <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google" width="20">
</div>

  </div>
</div>

<!-- FOOTER -->
<footer>

  <div class="footer-logo">
  <img src="/images/logo.png" class="logo-img">
</div>

  <div class="footer-container">

    <div class="footer-section">
      <h4>SUPPORT</h4>
      <p>Order Status</p>
      <p>Product Support</p>
      <p>Shipping & Return Policy</p>
      <p>Complaint Registration</p>
    </div>

    <div class="footer-section">
      <h4>About Us</h4>
      <p>Contact Us</p>
      <p>Privacy Policy</p>
      <p>Terms of use</p>
      <p>FAQ</p>
    </div>

    <div class="footer-section">
      <h4>Contact</h4>
      <p>Email : onemore@gmail.com</p>
      <p>Phone : +91 8888888888</p>
    </div>

    <div class="footer-section">
      <h4>Connect with us</h4>
      <p>Instagram</p>
      <p>Facebook</p>
      <p>X</p>
    </div>

  </div>

  <div class="bottom">
    © 2025 onemore. All Rights Reserved.
  </div>

</footer>

</body>
</html>