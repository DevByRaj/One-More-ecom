<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forget Password | OneMore</title>
  <link rel="icon" type="image/png" href="/images/logo.png">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #0f0f0f;
      color: #fff;
      font-family: 'Poppins', sans-serif;
      min-height: 100vh;
    }

    /* NAVBAR */
    .forgot-nav {
      background: rgba(15, 15, 15, 0.97);
      padding: 18px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 25px;
      border-bottom: 1px solid #252525;
      position: relative;
      z-index: 2;
    }

    .forgot-nav .logo-img {
      width: 60px;
      height: auto;
      object-fit: contain;
    }

    .forgot-nav .nav-links {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 35px;
    }

    .forgot-nav .nav-links a {
      color: #cfcfcf;
      text-decoration: none;
      font-size: 13px;
      white-space: nowrap;
      transition: color 0.3s ease;
    }

    .forgot-nav .nav-links a:hover {
      color: #fff;
    }

    .forgot-nav .icons {
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .forgot-nav .icons a {
      color: #ccc;
      font-size: 18px;
      text-decoration: none;
      transition: color 0.3s ease;
    }

    .forgot-nav .icons a:hover {
      color: #fff;
    }

    /* MAIN SECTION */
    .forgot-main {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      background:
        radial-gradient(ellipse at 15% 30%, rgba(70, 70, 70, 0.20), transparent 40%),
        radial-gradient(ellipse at 85% 80%, rgba(45, 45, 45, 0.18), transparent 35%),
        #0b0b0b;
      min-height: 650px;
      padding: 80px 7%;
      display: flex;
      align-items: center;
    }

    .forgot-main::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: linear-gradient(135deg,
          transparent 48%,
          rgba(255, 255, 255, 0.025) 49%,
          transparent 50%);
      background-size: 35px 35px;
      opacity: 0.5;
      pointer-events: none;
      z-index: -1;
    }

    .forgot-layout {
      width: 100%;
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      gap: 70px;
    }

    /* LEFT BRANDING CONTENT */
    .forgot-content {
      max-width: 500px;
    }

    .forgot-content .eyebrow {
      color: #aaa;
      font-size: 11px;
      letter-spacing: 4px;
      text-transform: uppercase;
      margin-bottom: 22px;
    }

    .forgot-content h1 {
      font-size: clamp(36px, 4vw, 58px);
      line-height: 1.12;
      font-weight: 700;
      letter-spacing: -1.8px;
      margin-bottom: 25px;
    }

    .forgot-content h1 span {
      display: block;
      color: #a7a7b5;
    }

    .forgot-content .intro {
      color: #bdbdbd;
      font-size: 14px;
      line-height: 1.9;
      max-width: 420px;
      margin-bottom: 35px;
    }

    .forgot-features {
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    .forgot-feature {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .forgot-feature .feature-icon {
      width: 46px;
      height: 46px;
      border: 1px solid #444;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 17px;
      flex-shrink: 0;
      background: rgba(255, 255, 255, 0.04);
    }

    .forgot-feature h3 {
      font-size: 13px;
      font-weight: 500;
      margin-bottom: 4px;
      color: #f5f5f5;
    }

    .forgot-feature p {
      font-size: 11px;
      color: #aaa;
      margin: 0;
    }

    .forgot-tagline {
      margin-top: 35px;
      color: #a8a8b7;
      font-size: 19px;
      font-style: italic;
      line-height: 1.6;
    }

    /* FORM CARD */
    .forgot-card {
      background: linear-gradient(145deg, #f8f8fa, #e7e7eb);
      border: 1px solid rgba(255, 255, 255, 0.6);
      border-radius: 22px;
      padding: 42px;
      width: 100%;
      max-width: 480px;
      color: #111;
      box-shadow: 0 25px 70px rgba(0, 0, 0, 0.35);
      justify-self: center;
    }

    .forgot-lock {
      width: 58px;
      height: 58px;
      display: flex;
      justify-content: center;
      align-items: center;
      border-radius: 50%;
      background: #dedee4;
      color: #111;
      font-size: 23px;
      margin-bottom: 23px;
    }

    .forgot-card h2 {
      font-size: 30px;
      font-weight: 600;
      letter-spacing: -0.8px;
      margin-bottom: 12px;
    }

    .forgot-card .card-description {
      font-size: 13px;
      line-height: 1.9;
      color: #777783;
      margin-bottom: 30px;
    }

    .forgot-card .field-label {
      display: block;
      text-align: left;
      font-size: 12px;
      font-weight: 600;
      margin-bottom: 9px;
      color: #202027;
    }

    .forgot-card .email-wrapper {
      position: relative;
    }

    .forgot-card .email-wrapper i {
      position: absolute;
      left: 16px;
      top: 50%;
      transform: translateY(-50%);
      color: #777783;
      font-size: 16px;
    }

    .forgot-card input {
      width: 100%;
      padding: 14px 15px 14px 45px;
      border-radius: 10px;
      border: 1px solid #c7c7d0;
      background: rgba(255, 255, 255, 0.75);
      color: #111;
      font-family: inherit;
      font-size: 13px;
      outline: none;
      transition: border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .forgot-card input::placeholder {
      color: #8b8b96;
    }

    .forgot-card input:focus {
      border-color: #333;
      box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.06);
    }

    .forgot-card .error-msg {
      color: #dc2626;
      font-size: 11px;
      margin-top: 8px;
      margin-bottom: 10px;
      text-align: left;
      line-height: 1.6;
      overflow-wrap: anywhere;
    }

    .forgot-card .server-error {
      background: #fee2e2;
      border: 1px solid #fca5a5;
      border-radius: 8px;
      padding: 10px;
      color: #b91c1c;
    }

    .forgot-card .form-actions {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 15px;
      margin-top: 24px;
    }

    .forgot-card .login-link {
      color: #171717;
      text-decoration: none;
      font-size: 12px;
      font-weight: 600;
      white-space: nowrap;
    }

    .forgot-card .login-link i {
      color: #777;
      margin-right: 7px;
    }

    .forgot-card .login-link:hover {
      text-decoration: underline;
    }

    .forgot-card .send-otp-btn {
      padding: 13px 21px;
      background: #090909;
      color: #fff;
      border: 1px solid #090909;
      border-radius: 9px;
      font-family: inherit;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 9px;
      transition: background 0.25s ease, transform 0.25s ease;
    }

    .forgot-card .send-otp-btn:hover {
      background: #292929;
      transform: translateY(-1px);
    }

    .forgot-divider {
      height: 1px;
      background: #d0d0d6;
      margin: 28px 0 22px;
    }

    .forgot-privacy {
      display: flex;
      align-items: center;
      gap: 13px;
      padding: 15px;
      border-radius: 9px;
      background: rgba(0, 0, 0, 0.045);
    }

    .forgot-privacy i {
      font-size: 17px;
      color: #333;
      flex-shrink: 0;
    }

    .forgot-privacy p {
      color: #62626d;
      font-size: 10px;
      line-height: 1.8;
      margin: 0;
    }

    /* FOOTER */
    .forgot-footer {
      background: #0b0b0b;
      padding: 45px 6% 20px;
      border-top: 1px solid #202020;
    }

    .forgot-footer .footer-logo {
      display: flex;
      justify-content: center;
      align-items: center;
      margin-bottom: 38px;
    }

    .forgot-footer .footer-logo img {
      width: 80px;
      max-width: 100%;
      height: auto;
      display: block;
    }

    .forgot-footer .footer-container {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 30px;
      max-width: 1250px;
      margin: 0 auto;
    }

    .forgot-footer .footer-section {
      padding-right: 20px;
      border-right: 1px solid #292929;
    }

    .forgot-footer .footer-section:last-child {
      border-right: none;
    }

    .forgot-footer .footer-section h4 {
      color: #fff;
      margin-bottom: 14px;
      font-size: 13px;
      font-weight: 600;
    }

    .forgot-footer .footer-section p {
      font-size: 11px;
      line-height: 1.9;
      color: #aaa;
      margin-bottom: 5px;
      overflow-wrap: anywhere;
    }

    .forgot-footer .bottom {
      max-width: 1250px;
      margin: 30px auto 0;
      padding-top: 18px;
      border-top: 1px solid #292929;
      font-size: 11px;
      color: #777;
      text-align: center;
    }

    /* TABLET */
    @media (max-width: 1000px) {
      .forgot-nav {
        padding: 18px 4%;
        gap: 15px;
      }

      .forgot-nav .nav-links {
        gap: 20px;
      }

      .forgot-nav .nav-links a {
        font-size: 12px;
      }

      .forgot-nav .icons {
        gap: 17px;
      }

      .forgot-main {
        padding: 65px 5%;
      }

      .forgot-layout {
        gap: 35px;
      }

      .forgot-card {
        padding: 32px 26px;
      }

      .forgot-content h1 {
        font-size: 42px;
      }

      .forgot-footer {
        padding-left: 4%;
        padding-right: 4%;
      }
    }

    /* MOBILE */
    @media (max-width: 700px) {
      .forgot-nav {
        padding: 15px 20px;
        flex-wrap: wrap;
        gap: 12px;
      }

      .forgot-nav .logo-img {
        width: 45px;
      }

      .forgot-nav .nav-links {
        order: 3;
        width: 100%;
        justify-content: space-between;
        gap: 8px;
        padding-top: 9px;
        border-top: 1px solid #252525;
      }

      .forgot-nav .nav-links a {
        font-size: 11px;
      }

      .forgot-nav .icons {
        margin-left: auto;
        gap: 18px;
      }

      .forgot-nav .icons a {
        font-size: 16px;
      }

      .forgot-main {
        min-height: auto;
        padding: 55px 20px;
      }

      .forgot-layout {
        grid-template-columns: 1fr;
        gap: 38px;
        max-width: 480px;
      }

      .forgot-content {
        max-width: 100%;
      }

      .forgot-content .eyebrow {
        font-size: 10px;
        letter-spacing: 3px;
        margin-bottom: 15px;
      }

      .forgot-content h1 {
        font-size: clamp(34px, 8vw, 46px);
        letter-spacing: -1px;
        margin-bottom: 17px;
      }

      .forgot-content .intro {
        font-size: 13px;
        margin-bottom: 25px;
      }

      .forgot-features {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .forgot-feature .feature-icon {
        width: 40px;
        height: 40px;
        font-size: 15px;
      }

      .forgot-tagline {
        display: none;
      }

      .forgot-card {
        max-width: 100%;
        padding: 30px 24px;
        border-radius: 17px;
      }

      .forgot-card h2 {
        font-size: 26px;
      }

      .forgot-card .card-description {
        margin-bottom: 24px;
      }

      .forgot-footer {
        padding: 35px 22px 18px;
      }

      .forgot-footer .footer-logo {
        margin-bottom: 30px;
      }

      .forgot-footer .footer-logo img {
        width: 65px;
      }

      .forgot-footer .footer-container {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 26px 18px;
      }

      .forgot-footer .footer-section {
        padding-right: 10px;
      }

      .forgot-footer .footer-section:nth-child(2) {
        border-right: none;
      }

      .forgot-footer .footer-section h4 {
        font-size: 12px;
      }

      .forgot-footer .footer-section p {
        font-size: 10px;
      }
    }

    /* SMALL MOBILE */
    @media (max-width: 380px) {
      .forgot-nav {
        padding: 13px 12px;
      }

      .forgot-nav .logo-img {
        width: 40px;
      }

      .forgot-nav .nav-links a {
        font-size: 10px;
      }

      .forgot-nav .icons {
        gap: 14px;
      }

      .forgot-main {
        padding: 40px 14px;
      }

      .forgot-content h1 {
        font-size: 34px;
      }

      .forgot-card {
        padding: 25px 17px;
      }

      .forgot-card h2 {
        font-size: 23px;
      }

      .forgot-card .form-actions {
        gap: 10px;
      }

      .forgot-card .send-otp-btn {
        padding: 12px 14px;
        font-size: 11px;
      }

      .forgot-footer {
        padding: 30px 15px 15px;
      }

      .forgot-footer .footer-container {
        gap: 22px 12px;
      }
    }
  </style>
</head>

<body>

  <!-- NAVBAR -->
  <nav class="forgot-nav">
    <a href="/" aria-label="OneMore home">
      <img src="/images/logo.png" alt="OneMore Logo" class="logo-img">
    </a>

    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/shop">Shop</a>
      <a href="/contact">Contact Us</a>
      <a href="/about">About Us</a>
    </div>

    <div class="icons">
      <a href="/login" aria-label="Login"><i class="fa-regular fa-user"></i></a>
      <a href="/wishlist" aria-label="Wishlist"><i class="fa-regular fa-heart"></i></a>
      <a href="/cart" aria-label="Cart"><i class="fa-solid fa-cart-shopping"></i></a>
    </div>
  </nav>

  <!-- MAIN -->
  <main class="forgot-main">
    <div class="forgot-layout">

      <!-- LEFT BRANDING SECTION -->
      <section class="forgot-content">
        <p class="eyebrow">One More. Always With You.</p>

        <h1>
          Forgot Your
          <span>Password?</span>
        </h1>

        <p class="intro">
          No worries! Enter your email address and we'll send you a code
          to reset your password.
        </p>

        <div class="forgot-features">
          <div class="forgot-feature">
            <div class="feature-icon">
              <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div>
              <h3>Secure &amp; Safe</h3>
              <p>Your account security matters to us</p>
            </div>
          </div>

          <div class="forgot-feature">
            <div class="feature-icon">
              <i class="fa-solid fa-bolt"></i>
            </div>
            <div>
              <h3>Fast Reset</h3>
              <p>Receive your OTP to continue</p>
            </div>
          </div>

          <div class="forgot-feature">
            <div class="feature-icon">
              <i class="fa-regular fa-heart"></i>
            </div>
            <div>
              <h3>Back to Shopping</h3>
              <p>Stay connected with OneMore</p>
            </div>
          </div>
        </div>

        <p class="forgot-tagline">
          Reset your password.<br>
          Get back to what you love.
        </p>
      </section>

      <!-- FORGOT PASSWORD CARD -->
      <section class="forgot-card">
        <div class="forgot-lock">
          <i class="fa-solid fa-lock"></i>
        </div>

        <h2>Forget Password</h2>

        <p class="card-description">
          Enter your email address and we'll send you an OTP to reset your password.
        </p>

        <form id="forgotForm" action="/forgot-password" method="POST" novalidate>

          <label for="email" class="field-label">Email Address</label>

          <div class="email-wrapper">
            <i class="fa-regular fa-envelope"></i>
            <input type="email" id="email" name="email" placeholder="Enter your email" autocomplete="email" required>
          </div>

          <div id="emailError" class="error-msg" aria-live="polite"></div>

          <% if (error) { %>
            <div class="error-msg server-error" role="alert">
              <i class="fa-solid fa-circle-exclamation"></i>
              <%= error %>
            </div>
            <% } %>

              <div class="form-actions">
                <a href="/login" class="login-link">
                  <i class="fa-solid fa-arrow-left"></i> Back to Login
                </a>

                <button type="submit" class="send-otp-btn">
                  <i class="fa-regular fa-paper-plane"></i>
                  Send OTP
                </button>
              </div>
        </form>

        <div class="forgot-divider"></div>

        <div class="forgot-privacy">
          <i class="fa-solid fa-shield-halved"></i>
          <p>
            Your account security is important to us.
            We'll use your email to help you reset your password.
          </p>
        </div>
      </section>

    </div>
  </main>

  <!-- FOOTER -->
  <footer class="forgot-footer">
    <div class="footer-logo">
      <img src="/images/logo.png" alt="OneMore Logo">
    </div>

    <div class="footer-container">

      <div class="footer-section">
        <h4>SUPPORT</h4>
        <p>Order Status</p>
        <p>Product Support</p>
        <p>Shipping &amp; Return Policy</p>
        <p>Complaint Registration</p>
      </div>

      <div class="footer-section">
        <h4>About Us</h4>
        <p>Contact Us</p>
        <p>Privacy Policy</p>
        <p>Terms of use</p>
        <p>FAQ</p>
      </div>

      <div class="footer-section">
        <h4>Contact</h4>
        <p>Email : onemore@gmail.com</p>
        <p>Phone : +91 8888888888</p>
      </div>

      <div class="footer-section">
        <h4>Connect with us</h4>
        <p>Instagram</p>
        <p>Facebook</p>
        <p>X</p>
      </div>

    </div>

    <div class="bottom">
      © 2025 OneMore. All Rights Reserved.
    </div>
  </footer>

  <!-- EMAIL VALIDATION -->
  <script>
    const form = document.getElementById("forgotForm");
    const email = document.getElementById("email");
    const emailError = document.getElementById("emailError");

    form.addEventListener("submit", function (e) {
      emailError.textContent = "";

      const value = email.value.trim();
      const pattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      if (value === "") {
        emailError.textContent = "Email is required";
        e.preventDefault();
      } else if (!pattern.test(value)) {
        emailError.textContent = "Enter valid email";
        e.preventDefault();
      }
    });
  </script>

</body>

</html>