<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Forget Password</title>

  <!-- Bootstrap -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- ✅ Font Awesome (for icons) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

  <!-- Google Font (same as login) -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: #0f0f0f;
      color: #fff;
      font-family: 'Poppins', sans-serif;
    }

    /* ================= NAVBAR ================= */
    .navbar {
      background: #0f0f0f;
      padding: 20px 60px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

     .logo-img {
   width: 60px;     /* adjust size */
   height: auto;
   object-fit: contain;
  }


.logo {
  font-size: 28px;
  font-weight: 600;
}

    .nav-links {
      display: flex;
      gap: 40px;
    }

    .nav-links a {
      color: #cfcfcf;
      text-decoration: none;
      font-size: 14px;
    }

    .nav-links a:hover {
      color: #fff;
    }

    .icons {
      display: flex;
      gap: 25px;
    }

    .icons i {
      font-size: 18px;
      cursor: pointer;
      color: #ccc;
    }

    .icons i:hover {
      color: #fff;
    }

    /* ================= MAIN ================= */
    .main {
      background: #dcdcdc;
      min-height: 70vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    /* ================= CARD ================= */
    .card {
      background: #efefef;
      border-radius: 20px;
      padding: 40px 30px;
      width: 360px;
      text-align: center;
      color: #000;
    }

    .card h2 {
      margin-bottom: 25px;
      font-weight: 500;
    }

    /* ================= INPUT ================= */
    .card input {
      width: 100%;
      padding: 12px;
      margin-bottom: 10px;
      border-radius: 10px;
      border: none;
      background: #cfcfcf;
      outline: none;
    }

    /* ================= LINKS ================= */
    .links {
      display: flex;
      justify-content: center;
      gap: 15px;
      font-size: 12px;
      margin-bottom: 15px;
    }

    .links a {
      color: #000;
      text-decoration: underline;
    }

    /* ================= BUTTON ================= */
    .btn {
      padding: 10px 25px;
      background: #000;
      color: #fff;
      border: none;
      border-radius: 10px;
      cursor: pointer;
    }

    .btn:hover {
      background: #222;
    }

    .error-msg {
      color: red;
      font-size: 12px;
      margin-bottom: 10px;
    }

    /* ================= FOOTER ================= */
    footer {
      background: #0f0f0f;
      padding: 50px 80px;
    }

   .footer-logo {
  display: flex;
  justify-content: center; /* Horizontal center */
  align-items: center;     /* Vertical center */
  width: 100%;
  margin-bottom: 40px;     /* Space between logo and the links below */
}

/* Ensure the image inside stays responsive */
   .footer-logo .logo-img {
    width: 80px;            /* Increased slightly for footer prominence */
    height: auto;
    display: block;
  }
  

    .footer-logo {
      text-align: center;
      font-size: 40px;
      font-weight: 600;
      margin-bottom: 20px;
    }

    .footer-container {
      display: flex;
      justify-content: space-between;
    }

    .footer-section h4 {
      color: #fff;
      margin-bottom: 12px;
      font-size: 14px;
    }

    .footer-section p {
      font-size: 13px;
      color: #aaa;
      margin-bottom: 6px;
    }

    .bottom {
      margin-top: 30px;
      font-size: 12px;
      color: #777;
    }
  </style>
</head>

<body>

<!-- NAVBAR -->
<nav class="navbar">
   <img src="/images/logo.png" alt="logo" class="logo-img">

  <div class="nav-links">
    <a href="/">Home</a>
    <a href="#">Shop</a>
    <a href="#">Contact Us</a>
    <a href="#">About Us</a>
  </div>

  <div class="icons">
    <a href="/login"><i class="fa-regular fa-user"></i></a>
    <a href="#"><i class="fa-regular fa-heart"></i></a>
    <a href="#"><i class="fa-solid fa-cart-shopping"></i></a>
  </div>
</nav>

<!-- MAIN -->
<div class="main">
  <div class="card">

    <h2>Forget Password</h2>

    <form id="forgotForm" action="/forgot-password" method="POST">

      <input type="email" id="email" name="email" placeholder="Email">
      <div id="emailError" class="error-msg"></div>

      <div class="links">
        <a href="/login">Login</a>
        <button type="submit" class="btn">Send OTP</button>
      </div>

    </form>

  </div>
</div>

<!-- FOOTER -->
<footer>

  <div class="footer-logo">
  <img src="/images/logo.png" class="logo-img">
</div>

  <div class="footer-container">

    <div class="footer-section">
      <h4>SUPPORT</h4>
      <p>Order Status</p>
      <p>Product Support</p>
      <p>Shipping & Return Policy</p>
      <p>Complaint Registration</p>
    </div>

    <div class="footer-section">
      <h4>About Us</h4>
      <p>Contact Us</p>
      <p>Privacy Policy</p>
      <p>Terms of use</p>
      <p>FAQ</p>
    </div>

    <div class="footer-section">
      <h4>Contact</h4>
      <p>Email : onemore@gmail.com</p>
      <p>Phone : +91 8888888888</p>
    </div>

    <div class="footer-section">
      <h4>Connect with us</h4>
      <p>Instagram</p>
      <p>Facebook</p>
      <p>X</p>
    </div>

  </div>

  <div class="bottom">
    © 2025 onemore. All Rights Reserved.
  </div>

</footer>

<!-- VALIDATION -->
<script>
  const form = document.getElementById("forgotForm");
  const email = document.getElementById("email");
  const error = document.getElementById("emailError");

  form.addEventListener("submit", function (e) {
    error.textContent = "";

    const value = email.value.trim();
    const pattern = /^[^ ]+@[^ ]+\.[a-z]{2,3}$/;

    if (value === "") {
      error.textContent = "Email is required";
      e.preventDefault();
    } else if (!pattern.test(value)) {
      error.textContent = "Enter valid email";
      e.preventDefault();
    }
  });
</script>

</body>
</html>