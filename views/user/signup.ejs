<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Signup</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Poppins', sans-serif;
  background: #0f0f0f;
  color: #fff;
}

/* NAVBAR */
nav {
  background: #0f0f0f;
  padding: 20px 60px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo-img {
  width: 60px;
}

.nav-links {
  display: flex;
  gap: 40px;
}

.nav-links a {
  color: #cfcfcf;
  text-decoration: none;
  font-size: 14px;
}

.icons {
  display: flex;
  gap: 25px;
  font-size: 18px;
}

/* MAIN */
.main {
  background: #dcdcdc;
  min-height: 70vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* CARD */
.card {
  background: #efefef;
  border: 2px solid #000;
  border-radius: 20px;
  padding: 35px 30px;
  width: 360px;
  text-align: center;
}

.card h2 {
  margin-bottom: 20px;
  color: #000;
}

/* INPUT */
.card input {
  width: 100%;
  padding: 12px;
  margin-bottom: 5px;
  border-radius: 10px;
  border: none;
  background: #cfcfcf;
  outline: none;
}

/* ERROR */
.error-msg {
  color: red;
  font-size: 12px;
  text-align: left;
  margin-bottom: 8px;
}

/* LOGIN LINK */
.login-link {
  text-align: right;
  font-size: 12px;
  margin-bottom: 10px;
}

.login-link a {
  color: #000;
}

.toggle-eye {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  cursor: pointer;
  color: #555;
  font-size: 14px;
}

.toggle-eye:hover {
  color: #000;
}

/* prevent text overlap */
.card input {
  padding-right: 35px;
}

/* BUTTON */
.btn {
  width: 100%;
  padding: 12px;
  background: #000;
  color: #fff;
  border-radius: 10px;
  border: none;
}

/* GOOGLE */
.google-btn {
  display: flex;
  justify-content: center;
  gap: 10px;
  margin-top: 10px;
  text-decoration: none;
  color: black;
}

/* FOOTER */
footer {
  background: #0f0f0f;
  padding: 50px 80px;
}

.footer-logo {
  display: flex;
  justify-content: center;
  margin-bottom: 40px;
}

.footer-logo img {
  width: 80px;
}

.footer-container {
  display: flex;
  justify-content: space-between;
}

.footer-section h4 {
  color: #fff;
}

.footer-section p {
  color: #aaa;
  font-size: 13px;
}

.bottom {
  margin-top: 30px;
  font-size: 12px;
  color: #777;
}
</style>
</head>

<body>

<!-- NAVBAR -->
<nav>
  <img src="/images/logo.png" class="logo-img">

  <div class="nav-links">
    <a href="/">Home</a>
    <a href="#">Shop</a>
    <a href="#">Contact Us</a>
    <a href="#">About Us</a>
  </div>

  <div class="icons">
    <i class="fa-regular fa-user"></i>
    <i class="fa-regular fa-heart"></i>
    <i class="fa-solid fa-cart-shopping"></i>
  </div>
</nav>

<!-- MAIN -->
<div class="main">
  <div class="card">

    <h2>Signup</h2>

    <!-- 🔥 IMPORTANT: novalidate added -->
    <form id="signupForm" action="/signup" method="POST" novalidate>

      <!-- NAME -->
      <input type="text" id="name" name="name" placeholder="Username"
        value="<%= oldData?.name || '' %>">
      <div id="nameError" class="error-msg">
        <%= errors?.find(e => e.path === 'name')?.msg %>
      </div>

      <!-- EMAIL -->
      <input type="email" id="email" name="email" placeholder="Email"
        value="<%= oldData?.email || '' %>">
      <div id="emailError" class="error-msg">
        <%= errors?.find(e => e.path === 'email')?.msg %>
      </div>

      <!-- PASSWORD -->
<div style="position: relative;">
  <input type="password" id="password" name="password" placeholder="Password">
  <i class="fa-solid fa-eye toggle-eye" onclick="togglePassword('password', this)"></i>
</div>
<div id="passwordError" class="error-msg">
  <%= errors?.find(e => e.path === 'password')?.msg %>
</div>

<!-- CONFIRM PASSWORD -->
<div style="position: relative;">
  <input type="password" id="confirmPassword" name="confirmPassword" placeholder="Confirm Password">
  <i class="fa-solid fa-eye toggle-eye" onclick="togglePassword('confirmPassword', this)"></i>
</div>
<div id="confirmError" class="error-msg">
  <%= errors?.find(e => e.path === 'confirmPassword')?.msg %>
</div>

      <!-- REF CODE -->
      <input type="text" id="refCode" name="refCode" placeholder="ref Code"
        value="<%= oldData?.refCode || '' %>">

      <div class="login-link">
        <a href="/login">Login</a>
      </div>

      <button type="submit" class="btn">Signup</button>

    </form>

    <a href="/auth/google" class="google-btn">
      <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" width="20">
      Continue with Google
    </a>

  </div>
</div>

<!-- FOOTER -->
<footer>

  <div class="footer-logo">
    <img src="/images/logo.png">
  </div>

  <div class="footer-container">

    <div class="footer-section">
      <h4>SUPPORT</h4>
      <p>Order Status</p>
      <p>Product Support</p>
      <p>Shipping & Return Policy</p>
      <p>Complaint Registration</p>
    </div>

    <div class="footer-section">
      <h4>About Us</h4>
      <p>Contact Us</p>
      <p>Privacy Policy</p>
      <p>Terms of use</p>
      <p>FAQ</p>
    </div>

    <div class="footer-section">
      <h4>Contact</h4>
      <p>Email : onemore@gmail.com</p>
      <p>Phone : +91 8888888888</p>
    </div>

    <div class="footer-section">
      <h4>Connect with us</h4>
      <p>Instagram</p>
      <p>Facebook</p>
      <p>X</p>
    </div>

  </div>

  <div class="bottom">
    © 2025 onemore. All Rights Reserved.
  </div>

</footer>

<!-- JS VALIDATION -->
<script>
const form = document.getElementById("signupForm");

form.addEventListener("submit", function (e) {
  let valid = true;

  const name = document.getElementById("name");
  const email = document.getElementById("email");
  const password = document.getElementById("password");
  const confirmPassword = document.getElementById("confirmPassword");

  const nameError = document.getElementById("nameError");
  const emailError = document.getElementById("emailError");
  const passwordError = document.getElementById("passwordError");
  const confirmError = document.getElementById("confirmError");

  nameError.textContent = "";
  emailError.textContent = "";
  passwordError.textContent = "";
  confirmError.textContent = "";

  // NAME
  if (name.value.trim() === "") {
    nameError.textContent = "Username is required";
    valid = false;
  } else if (name.value.length < 3) {
    nameError.textContent = "Minimum 3 characters required";
    valid = false;
  }

  // EMAIL
  const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  if (email.value.trim() === "") {
    emailError.textContent = "Email is required";
    valid = false;
  } else if (!emailPattern.test(email.value)) {
    emailError.textContent = "Enter valid email";
    valid = false;
  }

  // PASSWORD
  if (password.value.trim() === "") {
    passwordError.textContent = "Password is required";
    valid = false;
  } else if (password.value.length < 6) {
    passwordError.textContent = "Minimum 6 characters required";
    valid = false;
  }

  // CONFIRM PASSWORD
  if (confirmPassword.value.trim() === "") {
    confirmError.textContent = "Confirm your password";
    valid = false;
  } else if (password.value !== confirmPassword.value) {
    confirmError.textContent = "Passwords do not match";
    valid = false;
  }

  if (!valid) e.preventDefault();
});
function togglePassword(inputId, icon) {
  const input = document.getElementById(inputId);

  if (input.type === "password") {
    input.type = "text";
    icon.classList.replace("fa-eye", "fa-eye-slash");
  } else {
    input.type = "password";
    icon.classList.replace("fa-eye-slash", "fa-eye");
  }
}
</script>

</body>
</html>