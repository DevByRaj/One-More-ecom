<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Signup</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Poppins', sans-serif;
  background: #0f0f0f;
  color: #fff;
}

/* ================= NAVBAR ================= */
nav {
  background: #0f0f0f;
  padding: 20px 60px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo {
  font-size: 28px;
  font-weight: 600;
}

.nav-links {
  display: flex;
  gap: 40px;
}

.nav-links a {
  color: #cfcfcf;
  text-decoration: none;
  font-size: 14px;
}

.nav-links a:hover {
  color: #fff;
}

.icons {
  display: flex;
  gap: 25px;
  font-size: 18px;
}

/* ================= MAIN ================= */
.main {
  background: #dcdcdc;
  min-height: 70vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* ================= CARD ================= */
.card {
  background: #efefef;
  border: 2px solid #000;
  border-radius: 20px;
  padding: 35px 30px;
  width: 360px;
  text-align: center;
}

.card h2 {
  margin-bottom: 20px;
  color: #000;
  font-weight: 500;
}

/* ================= INPUT ================= */
.card input {
  width: 100%;
  padding: 12px;
  margin-bottom: 12px;
  border-radius: 10px;
  border: none;
  background: #cfcfcf;
  outline: none;
}

/* ================= LOGIN LINK ================= */
.login-link {
  text-align: right;
  font-size: 12px;
  margin-bottom: 10px;
}

.login-link a {
  color: #000;
  text-decoration: none;
}

/* ================= BUTTON ================= */
.btn {
  width: 100%;
  padding: 12px;
  background: #000;
  color: #fff;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  font-weight: 500;
}

.btn:hover {
  background: #222;
}

/* ================= GOOGLE ================= */
.google-text {
  margin-top: 10px;
  font-size: 12px;
  color: #555;
}

.google-icon {
  font-size: 18px;
  margin-top: 5px;
}

/* ================= FOOTER ================= */
footer {
  background: #0f0f0f;
  padding: 50px 80px;
}

.footer-container {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

/* center logo */
.footer-logo {
  text-align: center;
  font-size: 40px;
  font-weight: 600;
  margin-bottom: 20px;
}

.footer-section h4 {
  color: #fff;
  margin-bottom: 12px;
  font-size: 14px;
}

.footer-section p {
  font-size: 13px;
  color: #aaa;
  margin-bottom: 6px;
}

/* bottom line */
.bottom {
  margin-top: 30px;
  font-size: 12px;
  color: #777;
  text-align: left;
}
</style>
</head>

<body>

<!-- NAVBAR -->
<nav>
  <div class="logo">IM</div>

  <div class="nav-links">
    <a href="/">Home</a>
    <a href="#">Shop</a>
    <a href="#">Contact Us</a>
    <a href="#">About Us</a>
  </div>

<div class="icons">
  <i class="fa-regular fa-user"></i>
  <i class="fa-regular fa-heart"></i>
  <i class="fa-solid fa-cart-shopping"></i>
</div>
</nav>

<!-- MAIN -->
<div class="main">
  <div class="card">

    <h2>Signup</h2>

    <form action="/signup" method="POST">
      <input type="text" name="name" placeholder="Username" required>
      <input type="email" name="email" placeholder="Email" required>
      <input type="password" name="password" placeholder="Password" required>
      <input type="password" name="confirmPassword" placeholder="Confirm Password" required>
      <input type="text" name="refCode" placeholder="ref Code">

      <div class="login-link">
        <a href="/login">Login</a>
      </div>

      <button type="submit" class="btn">Signup</button>
    </form>

    <p class="google-text">Or Signup with</p>
    <div class="google-icon">
  <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google" width="20">
</div>

  </div>
</div>

<!-- FOOTER -->
<footer>

  <!-- center logo -->
  <div class="footer-logo">IM</div>

  <div class="footer-container">

    <div class="footer-section">
      <h4>SUPPORT</h4>
      <p>Order Status</p>
      <p>Product Support</p>
      <p>Shipping & Return Policy</p>
      <p>Complaint Registration</p>
    </div>

    <div class="footer-section">
      <h4>About Us</h4>
      <p>Contact Us</p>
      <p>Privacy Policy</p>
      <p>Terms of use</p>
      <p>FAQ</p>
    </div>

    <div class="footer-section">
      <h4>Contact</h4>
      <p>Email : onemore@gmail.com</p>
      <p>Phone : +91 8888888888</p>
    </div>

    <div class="footer-section">
      <h4>Connect with us</h4>
      <p>Instagram</p>
      <p>Facebook</p>
      <p>X</p>
    </div>

  </div>

  <div class="bottom">
    © 2025 onemore. All Rights Reserved.
  </div>

</footer>

</body>
</html>