<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Collection | OneMore</title>
    <link rel="icon" type="image/png" href="/images/logo.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <style>

    :root {
        --bg-dark: #111111;
        --text-muted: #777777;
        --danger-red: #d93838;
        --success-green: #23834a;
        --accent: #ffdc60;
        --page-bg: #fafafa;
        --line: #ececec;
        --card-shadow: 0 10px 30px rgba(0, 0, 0, .055);
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        background: var(--page-bg);
        color: #242424;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
    }

    img { max-width: 100%; }

    /* Main shop layout */
    .main-container {
        display: flex;
        align-items: flex-start;
        gap: 32px;
        max-width: 1600px;
        margin: 0 auto;
        padding: 38px clamp(16px, 3.5vw, 54px) 50px;
    }

    .sidebar {
        width: 250px;
        flex: 0 0 250px;
        border: 1px solid #ededed;
        border-radius: 18px;
        padding: 24px 20px;
        background: #fff;
        box-shadow: 0 6px 24px rgba(0,0,0,.025);
    }

    .filter-label {
        display: block;
        margin-bottom: 18px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: #111;
    }

    .filter-section {
        padding-bottom: 17px;
        margin-bottom: 16px;
        border-bottom: 1px solid #f0f0f0;
    }

    .filter-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 10px;
        color: #242424;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        user-select: none;
    }

    .filter-header i {
        color: #777;
        font-size: 11px;
        transition: transform .25s ease;
    }

    .filter-section.collapsed .filter-header i { transform: rotate(-90deg); }

    .filter-content {
        max-height: 500px;
        overflow: hidden;
        margin-top: 10px;
        opacity: 1;
        transition: max-height .3s ease, opacity .25s ease, margin-top .2s ease;
    }

    .filter-section.collapsed .filter-content {
        max-height: 0 !important;
        margin-top: 0;
        opacity: 0;
        pointer-events: none;
    }

    .filter-section .form-check { min-height: 22px; }
    .filter-section .form-check-input {
        width: 15px;
        height: 15px;
        margin-top: 3px;
        border-color: #cfcfcf;
        cursor: pointer;
    }
    .filter-section .form-check-input:checked {
        background-color: #111;
        border-color: #111;
    }
    .filter-section .form-check-label,
    .filter-options-list label {
        color: #555;
        font-size: 12px;
        line-height: 1.65;
        cursor: pointer;
    }

    .filter-options-list { list-style: none; padding: 0; margin: 0; }
    .filter-options-list li { padding: 5px 0; font-size: 12px; }
    .filter-options-list input { accent-color: #111; margin-right: 7px; }

    .price-inputs { width: 100%; }
    .price-inputs input {
        width: 40%;
        min-width: 0;
        height: 36px;
        border: 1px solid #dedede;
        border-radius: 8px;
        padding: 5px 7px;
        background: #fff;
        font-family: inherit;
        font-size: 12px;
        outline: none;
    }
    .price-inputs input:focus {
        border-color: #888;
        box-shadow: 0 0 0 3px rgba(0,0,0,.05);
    }

    .sidebar .btn {
        min-height: 40px;
        font-size: 12px;
        font-weight: 500;
        transition: transform .2s ease, background .2s ease;
    }
    .sidebar .btn:hover { transform: translateY(-1px); }

    .content-area { min-width: 0; flex: 1; }

    .section-title {
        margin: 0;
        color: #151515;
        font-size: clamp(24px, 2.4vw, 32px);
        line-height: 1.25;
        font-weight: 700;
        letter-spacing: -.8px;
    }

    .search-container { position: relative; margin: 24px 0 18px; }
    .search-container form { position: relative; }
    .search-bar {
        width: 100%;
        height: 48px;
        border: 1px solid #e5e5e5;
        border-radius: 13px;
        padding: 0 54px 0 17px;
        background: #fff;
        color: #222;
        font-family: inherit;
        font-size: 13px;
        outline: none;
        transition: border-color .2s ease, box-shadow .2s ease;
    }
    .search-bar:focus {
        border-color: #aaa;
        box-shadow: 0 0 0 4px rgba(0,0,0,.035);
    }
    .search-icon-btn {
        position: absolute;
        top: 7px;
        right: 7px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border: 0;
        border-radius: 9px;
        background: #111;
        color: #fff;
        transition: background .2s ease;
    }
    .search-icon-btn i { color: #fff !important; }
    .search-icon-btn:hover { background: #333; }

    .toggle-container { font-size: 12px; color: var(--text-muted); }
    .btn-yes {
        padding: 4px 20px;
        border: none;
        border-radius: 20px;
        background: #111;
        color: #fff;
        font-size: 12px;
    }

    .sort-row { width: 100%; margin-bottom: 12px; }
    .btn-sort-black {
        float: right;
        min-width: 155px;
        height: 40px;
        padding: 0 35px 0 14px;
        border: 1px solid #e3e3e3;
        border-radius: 10px;
        appearance: auto;
        background: #fff;
        color: #222;
        font-family: inherit;
        font-size: 12px;
        cursor: pointer;
    }

    /* Product cards */
    .product-card {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100%;
        margin-bottom: 0;
        overflow: hidden;
        border: 1px solid #f0f0f0;
        border-radius: 17px;
        background: #fff;
        box-shadow: 0 4px 16px rgba(0,0,0,.025);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
    }
    .product-card:hover {
        transform: translateY(-4px);
        border-color: #e6e6e6;
        box-shadow: var(--card-shadow);
    }

    .product-img-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        border-radius: 0;
        background: linear-gradient(145deg, #fbfbfb, #f4f4f4);
    }
    .product-img {
        width: 100%;
        height: 100%;
        padding: 14px;
        border-radius: 0;
        object-fit: contain;
        transition: transform .35s ease;
    }
    .product-img-wrapper:hover .product-img { transform: scale(1.055); }

    .wishlist-btn {
        position: absolute;
        z-index: 5;
        top: 12px;
        right: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border: 1px solid rgba(0,0,0,.04);
        border-radius: 50%;
        background: rgba(255,255,255,.96);
        box-shadow: 0 3px 12px rgba(0,0,0,.08);
        cursor: pointer;
        transition: transform .2s ease, background .2s ease;
    }
    .wishlist-btn:hover { transform: scale(1.08); }
    .wishlist-btn i { color: #555; font-size: 15px; transition: color .2s ease; }
    .wishlist-btn.active-wishlist i { color: #f04470 !important; }

    .product-info {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 14px 14px 16px;
        min-width: 0;
    }
    .product-info > .d-flex:first-child { gap: 8px; }
    .product-info .text-muted.small {
        font-size: 11px;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }
    .rating { flex-shrink: 0; color: #f4b400; font-size: 10px; white-space: nowrap; }
    .rating .text-muted { font-size: 9px !important; }
    .product-name {
        margin-bottom: 0;
        color: #1d1d1d;
        font-size: 14px;
        font-weight: 600;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }
    .product-price { min-width: 0; font-size: 13px; line-height: 1.6; }
    .product-price .fs-5 { font-size: 1rem !important; }
    .product-price .badge {
        display: inline-block;
        max-width: 100%;
        white-space: normal;
        font-size: 9px;
        line-height: 1.35;
        font-weight: 500;
    }
    .stock-status-text {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 9px;
        font-weight: 600;
        letter-spacing: .15px;
        line-height: 1.4;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .stock-status-text.danger { color: var(--danger-red); }
    .stock-status-text.success { color: var(--success-green); }
    .out-stock .product-img-wrapper { opacity: .72; }
    .out-stock .product-img { filter: grayscale(15%); }

    /* Pagination */
    .pagination-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 42px 0 25px;
        overflow-x: auto;
    }
    .custom-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        list-style: none;
        margin: 0;
        padding: 4px;
        white-space: nowrap;
    }
    .custom-pagination li a {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border: 1px solid #eee;
        border-radius: 50%;
        background: #fff;
        color: #444;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: all .2s ease;
    }
    .custom-pagination li:first-child a,
    .custom-pagination li:last-child a {
        width: auto;
        padding: 0 17px;
        border-radius: 22px;
        font-size: 12px;
        font-weight: 600;
    }
    .custom-pagination li a:hover { border-color: #111; background: #f5f5f5; color: #111; }
    .custom-pagination li a.active-page {
        border-color: #111 !important;
        background: #111 !important;
        color: #fff !important;
        box-shadow: 0 4px 10px rgba(0,0,0,.12);
    }
    .custom-pagination li a.disabled-link {
        pointer-events: none;
        color: #bbb !important;
        background: #f8f8f8 !important;
        border-color: #f1f1f1 !important;
        opacity: .7;
    }

    /* Footer */
    footer {
        margin-top: 35px;
        padding: 55px clamp(18px, 5vw, 80px) 22px;
        background: #111;
        color: #fff;
    }
    .footer-logo { display: block; margin-bottom: 35px; text-align: center; }
    .footer-logo img { width: auto; height: 58px; object-fit: contain; }
    .footer-head {
        margin-bottom: 18px;
        color: var(--accent);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1px;
        text-transform: uppercase;
    }
    .footer-links a {
        display: block;
        margin-bottom: 11px;
        color: #d0d0d0;
        font-size: 12px;
        text-decoration: none;
        opacity: .85;
        transition: color .2s ease, opacity .2s ease;
    }
    .footer-links a:hover { color: #fff; opacity: 1; }
    footer p { color: #d0d0d0; font-size: 12px; overflow-wrap: anywhere; }
    .social-icons i {
        margin-right: 15px;
        color: #d0d0d0;
        font-size: 1.25rem;
        cursor: pointer;
        transition: color .2s ease, transform .2s ease;
    }
    .social-icons i:hover { color: #fff; transform: translateY(-2px); }

    .sidebar-toggle {
        display: none;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        margin-bottom: 16px;
        padding: 9px 16px;
        border: 0;
        border-radius: 10px;
        background: #111;
        color: #fff;
        font-family: inherit;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
    }

    @media (max-width: 1199.98px) {
        .main-container { gap: 24px; padding-left: 24px; padding-right: 24px; }
        .sidebar { width: 225px; flex-basis: 225px; padding: 20px 16px; }
        .product-info { padding: 12px 11px 14px; }
        .product-name { font-size: 13px; }
    }

    @media (max-width: 991.98px) {
        .main-container { gap: 20px; padding: 28px 20px 40px; }
        .sidebar { width: 210px; flex-basis: 210px; }
        .section-title { font-size: 25px; }
        .product-info { padding: 11px 10px 13px; }
        .product-name { font-size: 12px; }
        .stock-status-text { font-size: 8px; }
        .product-price { font-size: 12px; }
        footer { padding-top: 45px; }
    }

    @media (max-width: 767.98px) {
        .main-container {
            display: flex;
            flex-direction: column;
            gap: 0;
            padding: 20px 14px 32px;
        }
        .sidebar-toggle { display: inline-flex; width: 100%; }
        .sidebar {
            display: block;
            width: 100%;
            flex: 0 0 auto;
            max-height: 0;
            margin: 0 0 0;
            padding: 0 16px;
            overflow: hidden;
            border: 0;
            border-radius: 14px;
            box-shadow: none;
            transition: max-height .35s ease, padding .25s ease, margin .25s ease, border .25s ease;
        }
        .sidebar.open {
            max-height: 2000px;
            margin-bottom: 22px;
            padding: 18px 16px;
            border: 1px solid #ededed;
            box-shadow: 0 6px 24px rgba(0,0,0,.035);
        }
        .filter-label { margin-bottom: 15px; }
        .filter-section { padding-bottom: 13px; margin-bottom: 13px; }
        .filter-header { padding: 3px 0; }
        .content-area { width: 100%; }
        .content-area > .d-flex.justify-content-between {
            align-items: flex-start !important;
            gap: 8px;
        }
        .section-title { font-size: 25px; letter-spacing: -.5px; }
        .search-container { margin: 17px 0 13px; }
        .search-bar { height: 45px; font-size: 12px; }
        .btn-sort-black { float: none; width: 100%; min-width: 0; height: 42px; }
        .w-100.mb-5.overflow-hidden { margin-bottom: 10px !important; }
        .content-area .row.g-4.mt-2 {
            --bs-gutter-x: 12px;
            --bs-gutter-y: 15px;
            margin-top: 5px !important;
        }
        .content-area .row.g-4.mt-2 > [class*="col-"] {
            margin-bottom: 0 !important;
        }
        .product-card { border-radius: 13px; }
        .product-img-wrapper { aspect-ratio: 1 / 1; }
        .product-img { padding: 9px; }
        .wishlist-btn { top: 8px; right: 8px; width: 32px; height: 32px; }
        .wishlist-btn i { font-size: 13px; }
        .product-info { padding: 10px 9px 12px; }
        .product-info > .d-flex:first-child { align-items: flex-start !important; gap: 5px; }
        .product-info .text-muted.small { font-size: 9px; }
        .rating { font-size: 8px; }
        .rating .text-muted { font-size: 8px !important; }
        .product-name { margin-top: 5px !important; font-size: 12px; line-height: 1.4; }
        .product-info > .d-flex.justify-content-between.align-items-center.mt-2 {
            align-items: flex-start !important;
            flex-direction: column;
            gap: 7px;
        }
        .product-price { width: 100%; font-size: 11px; }
        .product-price .fs-5 { font-size: .92rem !important; }
        .product-price .badge { font-size: 8px; }
        .stock-status-text { font-size: 8px; white-space: normal; }
        .pagination-wrapper { justify-content: flex-start; margin: 28px 0 10px; }
        .custom-pagination { gap: 5px; width: 100%; }
        .custom-pagination li a { width: 32px; height: 32px; font-size: 11px; }
        .custom-pagination li:first-child a,
        .custom-pagination li:last-child a { padding: 0 10px; font-size: 11px; }
        footer { margin-top: 25px; padding: 38px 20px 20px; }
        .footer-logo { margin-bottom: 28px; }
        .footer-logo img { height: 48px; }
        .footer-head { margin-bottom: 13px; font-size: 11px; }
        .footer-links a, footer p { font-size: 11px; line-height: 1.6; }
        footer .row { --bs-gutter-x: 1rem; }
        .social-icons i { margin-right: 12px; font-size: 1.15rem; }
    }

    @media (max-width: 400px) {
        .main-container { padding: 16px 10px 28px; }
        .section-title { font-size: 23px; }
        .content-area .row.g-4.mt-2 { --bs-gutter-x: 9px; --bs-gutter-y: 12px; }
        .product-card { border-radius: 11px; }
        .product-info { padding: 9px 8px 10px; }
        .product-name { font-size: 11px; }
        .product-info .text-muted.small { font-size: 8px; }
        .product-price { font-size: 10px; }
        .stock-status-text { font-size: 7px; }
        .wishlist-btn { width: 29px; height: 29px; }
        .custom-pagination { gap: 4px; }
        .custom-pagination li a { width: 29px; height: 29px; }
        .custom-pagination li:first-child a,
        .custom-pagination li:last-child a { padding: 0 8px; }
        footer { padding-left: 15px; padding-right: 15px; }
    }

    @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
            scroll-behavior: auto !important;
            transition-duration: .01ms !important;
            animation-duration: .01ms !important;
        }
    }

    </style>
</head>

<body>
    <% const selectedCategories=query.category ? (Array.isArray(query.category) ? query.category : [query.category]) :
        []; const selectedBrands=query.brand ? (Array.isArray(query.brand) ? query.brand : [query.brand]) : []; const
        selectedColors=query.color ? (Array.isArray(query.color) ? query.color : [query.color]) : []; const
        selectedPlaytimes=query.playtime ? (Array.isArray(query.playtime) ? query.playtime : [query.playtime]) : []; %>

    <%- include("../partials/navbar") %>

        <div class="main-container">

            <button class="sidebar-toggle" onclick="toggleSidebar()" id="filterToggleBtn">
                <i class="fa-solid fa-sliders"></i> Filters
            </button>

            <aside class="sidebar" id="sidebar">
                <span class="filter-label">Filter By</span>
                <form action="/shop" method="GET" id="filterForm">

                    <input type="hidden" name="search" value="<%= query.search || '' %>">
                    <input type="hidden" name="sort" value="<%= query.sort || '' %>">

                    <div class="filter-section <%= selectedCategories.length > 0 ? '' : 'collapsed' %>">
                        <div class="filter-header mb-3" onclick="toggleFilterDropdown(this)">
                            Category <i class="fa-solid fa-chevron-down small"></i>
                        </div>
                        <div class="filter-content">
                            <% categories.forEach(category=> { %>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="category"
                                        value="<%= category._id %>" id="cat-<%= category._id %>"
                                        <%=selectedCategories.includes(category._id.toString()) ? 'checked' : '' %>
                                    >
                                    <label class="form-check-label small" for="cat-<%= category._id %>">
                                        <%= category.name %>
                                    </label>
                                </div>
                                <% }) %>
                        </div>
                    </div>

                    <div class="filter-section <%= selectedBrands.length > 0 ? '' : 'collapsed' %>">
                        <div class="filter-header mb-3" onclick="toggleFilterDropdown(this)">
                            Brand <i class="fa-solid fa-chevron-down small"></i>
                        </div>
                        <div class="filter-content">
                            <% brands.forEach(brand=> { %>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="brand"
                                        value="<%= brand._id %>" id="brand-<%= brand._id %>"
                                        <%=selectedBrands.includes(brand._id.toString()) ? 'checked' : '' %>
                                    >
                                    <label class="form-check-label small" for="brand-<%= brand._id %>">
                                        <%= brand.name %>
                                    </label>
                                </div>
                                <% }) %>
                        </div>
                    </div>

                    <div class="filter-section <%= (query.minPrice || query.maxPrice) ? '' : 'collapsed' %>">
                        <div class="filter-header" onclick="toggleFilterDropdown(this)">
                            Price <i class="fa-solid fa-chevron-down small"></i>
                        </div>
                        <div class="filter-content">
                            <div class="price-inputs d-flex align-items-center gap-2 justify-content-center">
                                <input type="number" name="minPrice" placeholder="Min"
                                    value="<%= query.minPrice || '' %>">
                                <div style="width: 20px; height: 1px; background: #000;"></div>
                                <input type="number" name="maxPrice" placeholder="Max"
                                    value="<%= query.maxPrice || '' %>">
                            </div>
                            <button type="submit" class="btn btn-dark btn-sm w-100 mt-3 rounded-pill"
                                style="font-size: 11px; padding: 6px 0;">Apply Filter</button>
                        </div>
                    </div>

                    <div class="filter-section <%= selectedColors.length > 0 ? '' : 'collapsed' %>">
                        <div class="filter-header mb-3" onclick="toggleFilterDropdown(this)">
                            Color <i class="fa-solid fa-chevron-down small"></i>
                        </div>
                        <div class="filter-content">
                            <% colors.forEach(color=> { %>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="color" value="<%= color %>"
                                        id="color-<%= color %>" <%=selectedColors.includes(color.toString()) ? 'checked'
                                        : '' %>
                                    >
                                    <label class="form-check-label small" for="color-<%= color %>">
                                        <%= color %>
                                    </label>
                                </div>
                                <% }) %>
                        </div>
                    </div>

                    <div class="filter-section <%= selectedPlaytimes.length > 0 ? '' : 'collapsed' %>">
                        <div class="filter-header" onclick="toggleFilterDropdown(this)">
                            Audio Playtime <i class="fa-solid fa-chevron-down small"></i>
                        </div>
                        <div class="filter-content">
                            <ul class="filter-options-list">
                                <li>
                                    <label>
                                        <input type="checkbox" name="playtime" value="10"
                                            <%=selectedPlaytimes.includes('10') ? 'checked' : '' %>> Up to 10 Hours
                                    </label>
                                </li>
                                <li>
                                    <label>
                                        <input type="checkbox" name="playtime" value="20"
                                            <%=selectedPlaytimes.includes('20') ? 'checked' : '' %>> Up to 20 Hours
                                    </label>
                                </li>
                                <li>
                                    <label>
                                        <input type="checkbox" name="playtime" value="30"
                                            <%=selectedPlaytimes.includes('30') ? 'checked' : '' %>> 30+ Hours
                                    </label>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <a href="/shop" class="btn btn-outline-dark w-100 rounded-pill mt-3">Clear Filters</a>
                    <button type="submit" class="btn btn-dark w-100 mt-3 rounded-pill">Apply Filters</button>
                </form>
            </aside>

            <main class="content-area">
                <div class="d-flex justify-content-between align-items-end">
                    <h1 class="section-title">Our Collection</h1>
                    
                </div>

                <div class="search-container">
                    <form action="/shop" method="GET">
                        <input type="text" name="search" class="search-bar" placeholder="Search An Item"
                            value="<%= query.search || '' %>">
                        <button type="submit" class="search-icon-btn"><i class="fa fa-search text-muted"></i></button>
                        <input type="hidden" name="sort" value="<%= query.sort || '' %>">
                        <% if(query.search){ %>
                            <a href="/shop" class="btn btn-sm btn-outline-dark rounded-pill mt-2">Clear</a>
                            <% } %>
                    </form>
                </div>

                <div class="w-100 mb-5 overflow-hidden">
                    <select class="btn-sort-black"
                        onchange="const p = new URLSearchParams(window.location.search); p.set('sort', this.value); window.location.href='/shop?'+p.toString();">
                        <option value="">Sort</option>
                        <option value="a-z" <%=query.sort==='a-z' ? 'selected' : '' %>>Name: A-Z</option>
                        <option value="z-a" <%=query.sort==='z-a' ? 'selected' : '' %>>Name: Z-A</option>
                        <option value="low-high" <%=query.sort==='low-high' ? 'selected' : '' %>>Price: Low-High
                        </option>
                        <option value="high-low" <%=query.sort==='high-low' ? 'selected' : '' %>>Price: High-Low
                        </option>
                    </select>
                </div>

                <div class="row g-4 mt-2">
                    <% if(products.length> 0) { %>
                        <% products.forEach(product=> { %>
                            <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-6 mb-5">
                                <div class="product-card <%= product.isOutOfStock ? 'out-stock' : '' %>">

                                    <% let inWishlist=false; if (wishlist && wishlist.includes(product._id.toString()))
                                        { inWishlist=true; } %>

                                        <button class="wishlist-btn <%= inWishlist ? 'active-wishlist' : '' %>"
                                            data-product-id="<%= product._id %>"
                                            data-variant-id="<%= product.variant ? product.variant._id : '' %>">
                                            <i
                                                class="<%= inWishlist ? 'fa-solid fa-heart' : 'fa-regular fa-heart' %>"></i>
                                        </button>

                                        <a href="/productDetails?id=<%= product._id %>"
                                            class="text-decoration-none text-dark">
                                            <div class="product-img-wrapper">
                                                <img src="<%= product.productImage[0] %>" class="product-img"
                                                    alt="<%= product.productName %>">
                                            </div>
                                        </a>

                                        <div class="product-info">
                                            <!-- ROW 1: Brand on Left, Stars on Right -->
                                            <div class="d-flex justify-content-between align-items-center">
                                                <div class="text-muted small">
                                                    <%= (product.brand && product.brand.name) ? product.brand.name
                                                        : "Brand" %>
                                                </div>
                                                <div class="rating">
                                                    <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i
                                                        class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                                                    <span class="text-muted" style="font-size: 9px;">(4.0)</span>
                                                </div>
                                            </div>

                                            <!-- ROW 2: Product Title spans full width -->
                                            <div class="product-name mt-1">
                                                <%= product.productName %>
                                            </div>

                                            <!-- ROW 3: Prices on Left, Dynamic Availability Badges on Right -->
                                            <div class="d-flex justify-content-between align-items-center mt-2">
                                                <div class="product-price">
                                                
                                                    <% if(product.variant){ %>
                                                
                                                        <% if(product.offer && product.offer.appliedOffer){ %>
                                                        
                                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                        
                                                                <span class="fw-bold text-dark fs-5">
                                                                    ₹<%= product.offer.finalPrice.toFixed(2) %>
                                                                </span>
                                                        
                                                                <span class="text-muted text-decoration-line-through small">
                                                                    ₹<%= product.offer.originalPrice.toFixed(2) %>
                                                                </span>
                                                        
                                                                <div class="d-flex align-items-center gap-2 mt-1">
                                                                
                                                                <span class="badge bg-success">
                                                                    <%= product.offer.appliedOffer.offerName %>
                                                                        -
                                                                        <% if(product.offer.appliedOffer.offerType==="PERCENTAGE" ){ %>
                                                                            <%= product.offer.appliedOffer.discountValue %>% OFF
                                                                                <% } else { %>
                                                                                    ₹<%= product.offer.appliedOffer.discountValue %> OFF
                                                                                        <% } %>
                                                                </span>                                                              
                                                                </div>
                                                        
                                                            </div>
                                                        
                                                            <% } else { %>
                                                
                                                                <% if(product.variant.salePrice < product.variant.regularPrice){ %>
                                                
                                                                    <span class="text-muted text-decoration-line-through me-2 small">
                                                                        ₹<%= product.variant.regularPrice %>
                                                                    </span>
                                                
                                                                    <span class="fw-bold text-dark">
                                                                        ₹<%= product.variant.salePrice %>
                                                                    </span>
                                                
                                                                    <% } else { %>
                                                
                                                                        <span class="fw-bold text-dark">
                                                                            ₹<%= product.variant.salePrice %>
                                                                        </span>
                                                
                                                                        <% } %>
                                                
                                                                            <% } %>
                                                
                                                                                <% } %>
                                                
                                                </div>

                                                <div>
                                                    <% if(product.isOutOfStock){ %>
                                                        <span class="stock-status-text danger">
                                                            <i class="fa-solid fa-circle-exclamation"></i> Out of Stock
                                                        </span>
                                                        <% } else { %>
                                                            <span class="stock-status-text success">
                                                                <i class="fa-solid fa-circle-check"></i> In Stock
                                                            </span>
                                                            <% } %>
                                                </div>
                                            </div>
                                        </div>
                                </div>
                            </div>
                            <% }) %>
                                <% } else { %>
                                    <div class="text-center p-5 w-100">
                                        <h4>No products found</h4>
                                    </div>
                                    <% } %>
                </div>

                <% if(totalPages> 1){ %>
                    <div class="pagination-wrapper">
                        <ul class="custom-pagination">
                            <li>
                                <a class="<%= currentPage === 1 ? 'disabled-link' : '' %>"
                                    href="?page=<%= currentPage - 1 %>&search=<%= query.search || '' %>&sort=<%= query.sort || '' %>&category=<%= query.category || '' %>">Prev</a>
                            </li>
                            <% for(let i=1; i <=totalPages; i++){ %>
                                <li>
                                    <a class="<%= currentPage === i ? 'active-page' : '' %>"
                                        href="?page=<%= i %>&search=<%= query.search || '' %>&sort=<%= query.sort || '' %>&category=<%= query.category || '' %>">
                                        <%= i %>
                                    </a>
                                </li>
                                <% } %>
                                    <li>
                                        <a class="<%= currentPage === totalPages ? 'disabled-link' : '' %>"
                                            href="?page=<%= currentPage + 1 %>&search=<%= query.search || '' %>&sort=<%= query.sort || '' %>&category=<%= query.category || '' %>">Next</a>
                                    </li>
                        </ul>
                    </div>
                    <% } %>
            </main>
        </div>

        <footer>
            <div class="footer-logo"><img src="/images/logo.png" height="50" alt="Logo"></div>
            <div class="row">
                <div class="col-md-3 col-6 mb-4">
                    <div class="footer-head">Support</div>
                    <div class="footer-links">
                        <a href="#">Order Status</a>
                        <a href="#">Product Support</a>
                        <a href="#">Shipping & Return Policy</a>
                        <a href="#">Complaint Registration</a>
                    </div>
                </div>
                <div class="col-md-3 col-6 mb-4">
                    <div class="footer-head">About Us</div>
                    <div class="footer-links">
                        <a href="#">Contact Us</a>
                        <a href="#">Privacy Policy</a>
                        <a href="#">Terms of use</a>
                        <a href="#">FAQ</a>
                    </div>
                </div>
                <div class="col-md-3 col-6 mb-4">
                    <div class="footer-head">Contact</div>
                    <p class="small mb-1">Email : onemore@gmail.com</p>
                    <p class="small">Phone : +91 8888888888</p>
                </div>
                <div class="col-md-3 col-6 mb-4 text-md-end">
                    <div class="footer-head">Connect with us</div>
                    <div class="social-icons">
                        <i class="fa-brands fa-instagram"></i>
                        <i class="fa-brands fa-facebook"></i>
                        <i class="fa-brands fa-x-twitter"></i>
                    </div>
                </div>
            </div>
            <div class="text-center mt-5 pt-4 border-top border-secondary small opacity-50">
                © 2026 onemore. All Rights Reserved.
            </div>
        </footer>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            function toggleSidebar() {
                const sidebar = document.getElementById('sidebar');
                const btn = document.getElementById('filterToggleBtn');
                sidebar.classList.toggle('open');
                btn.innerHTML = sidebar.classList.contains('open')
                    ? '<i class="fa-solid fa-xmark"></i> Close Filters'
                    : '<i class="fa-solid fa-sliders"></i> Filters';
            }

            function toggleFilterDropdown(headerElement) {
                const parentSection = headerElement.parentElement;
                parentSection.classList.toggle('collapsed');
            }

            document.querySelectorAll(".wishlist-btn").forEach(button => {
                button.addEventListener("click", async function (e) {
                    e.preventDefault();

                    const productId = this.dataset.productId;
                    const variantId = this.dataset.variantId;
                    const heartIcon = this.querySelector("i");
                    const currentButton = this;

                    try {
                        const response = await fetch("/wishlist/toggle", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                productId,
                                variantId
                            })
                        });

                        const result = await response.json();

                        if (result.success) {
                            const isAdding = (result.action === 'added' || result.message.toLowerCase().includes('add'));

                            if (isAdding) {
                                currentButton.classList.add('active-wishlist');
                                heartIcon.className = "fa-solid fa-heart";
                            } else {
                                currentButton.classList.remove('active-wishlist');
                                heartIcon.className = "fa-regular fa-heart";
                            }

                            const wishlistLink = document.querySelector('a[href="/wishlist"]');

                            if (wishlistLink) {

                                let badge = document.getElementById("wishlistCountBadge");

                                const newCount = parseInt(result.wishlistCount || 0);

                                if (newCount > 0) {

                                    if (!badge) {

                                        badge = document.createElement("span");
                                        badge.id = "wishlistCountBadge";
                                        badge.className = "count-badge";

                                        wishlistLink.appendChild(badge);
                                    }

                               badge.textContent = String(newCount);

                                } else {

                                    if (badge) {
                                        badge.remove();
                                    }

                                }

                            }

                            const Toast = Swal.mixin({
                                toast: true,
                                position: 'top-end',
                                showConfirmButton: false,
                                timer: 2000,
                                timerProgressBar: true,
                                didOpen: (toast) => {
                                    toast.addEventListener('mouseenter', Swal.stopTimer)
                                    toast.addEventListener('mouseleave', Swal.resumeTimer)
                                }
                            });

                            Toast.fire({
                                icon: 'success',
                                title: result.message
                            });

                        } else {
                            Swal.fire({
                                icon: "info",
                                title: "Info",
                                text: result.message
                            });
                        }

                    } catch (error) {
                        console.error("Wishlist operation error:", error);
                    }
                });
            });
        </script>
</body>

</html>