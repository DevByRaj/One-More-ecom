<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Collection | OneMore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-dark: #121212;
            --text-muted: #888;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #fff;
            color: #333;
        }

        /* Navbar */
        nav {
            background-color: var(--bg-dark);
            padding: 15px 50px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-link {
            font-size: 13px;
            margin: 0 10px;
        }

        .nav-icons a {
            color: #fff;
            margin-left: 20px;
            font-size: 1.1rem;
        }

        /* Sidebar & Layout */
        .main-container {
            display: flex;
            padding: 40px 60px;
            gap: 20px;
        }

        .sidebar {
            width: 220px;
            flex-shrink: 0;
            border-right: 1px solid #eee;
            padding-right: 20px;
        }

        .sidebar h2 {
            font-size: 1.5rem;
            font-weight: 800;
            margin-bottom: 40px;
        }

        .filter-label {
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 15px;
            display: block;
        }

        .filter-section {
            border-bottom: 1px solid #f0f0f0;
            padding-bottom: 15px;
            margin-bottom: 15px;
        }

        .filter-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            text-transform: capitalize;
        }

        .price-inputs input {
            width: 60px;
            font-size: 10px;
            border-radius: 15px;
            border: 1px solid #000;
            text-align: center;
            padding: 2px;
        }

        /* Content Area */
        .content-area {
            flex: 1;
            padding-left: 20px;
        }

        .section-title {
            font-size: 24px;
            font-weight: 700;
        }

        /* Search & Sort UI */
        .search-container {
            position: relative;
            margin: 20px 0;
        }

        .search-bar {
            width: 100%;
            border-radius: 25px;
            border: 1px solid #ddd;
            padding: 10px 25px;
            font-size: 13px;
        }

        .search-icon-btn {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: #eee;
            border-radius: 50%;
            width: 30px;
            height: 30px;
        }

        .toggle-container {
            font-size: 12px;
            color: var(--text-muted);
        }

        .btn-yes {
            background: #000;
            color: #fff;
            border-radius: 20px;
            padding: 2px 25px;
            font-size: 12px;
            border: none;
        }

        .btn-sort-black {
            background: #000;
            color: #fff;
            border-radius: 8px;
            padding: 5px 30px;
            font-size: 13px;
            border: none;
            float: right;
        }

        /* Product Cards */
        .product-card {
            border: none;
            position: relative;
            margin-bottom: 30px;
        }

        .product-img {
            width: 100%;
            border-radius: 12px;
            aspect-ratio: 1/1.2;
            object-fit: cover;
            background: #f8f8f8;
        }

        .wishlist-btn {
            position: absolute;
            right: 10px;
            bottom: 80px;
            background: none;
            border: none;
            font-size: 1.1rem;
        }

        .product-info {
            padding: 12px 0;
        }

        .product-name {
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 2px;
        }

        .product-price {
            font-size: 12px;
            font-weight: 500;
        }

        .rating {
            color: #ffc107;
            font-size: 10px;
            margin-top: 4px;
        }

        /* Footer */
        footer {
            background: var(--bg-dark);
            color: #fff;
            padding: 60px 80px 20px;
            margin-top: 50px;
        }

        .footer-logo {
            font-size: 2rem;
            font-weight: 900;
            margin-bottom: 30px;
            text-align: center;
        }

        .footer-head {
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

        .footer-links a {
            color: #fff;
            text-decoration: none;
            font-size: 12px;
            display: block;
            margin-bottom: 10px;
            opacity: 0.8;
        }

        .social-icons i {
            font-size: 1.5rem;
            margin-right: 15px;
            cursor: pointer;
        }

        .load-more-btn {
            background: #222;
            color: #fff;
            border-radius: 25px;
            padding: 10px 40px;
            font-size: 14px;
            border: none;
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/"><img src="/images/logo.png" height="40"></a>
            <div class="collapse navbar-collapse justify-content-center">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link text-white" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="/shop">Shop</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="/contact">Contact Us</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="/about">About Us</a></li>
                </ul>
            </div>
            <div class="nav-icons d-flex align-items-center">
                <a href="/profile"><i class="fa-regular fa-user"></i></a>
                <a href="/wishlist"><i class="fa-regular fa-heart"></i></a>
                <a href="/cart"><i class="fa-solid fa-cart-shopping"></i></a>
            </div>
        </div>
    </nav>

    <div class="main-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <h2>ANC</h2>
            <span class="filter-label">Filter :</span>

            <form action="/shop" method="GET" id="filterForm">
                <div class="filter-section">
                    <div class="filter-header">Category <i class="fa-solid fa-chevron-down small"></i></div>
                </div>
                <div class="filter-section">
                    <div class="filter-header">Brand <i class="fa-solid fa-chevron-down small"></i></div>
                </div>
                <div class="filter-section">
                    <div class="filter-header">Price <i class="fa-solid fa-chevron-up small"></i></div>
                    <div class="price-inputs d-flex align-items-center gap-2 mt-3 justify-content-center">
                        <input type="number" name="minPrice" placeholder="Min" value="<%= query.minPrice %>">
                        <div style="width: 20px; height: 1px; background: #000;"></div>
                        <input type="number" name="maxPrice" placeholder="Max" value="<%= query.maxPrice %>">
                    </div>
                    <button type="submit" class="btn btn-dark btn-sm w-100 mt-2 rounded-pill"
                        style="font-size: 10px;">Apply</button>
                </div>
                <div class="filter-section">
                    <div class="filter-header">Color <i class="fa-solid fa-chevron-down small"></i></div>
                </div>
                <div class="filter-section">
                    <div class="filter-header">Audio Playtime <i class="fa-solid fa-chevron-down small"></i></div>
                </div>
            </form>
        </aside>

        <!-- Main Content -->
        <main class="content-area">
            <div class="d-flex justify-content-between align-items-end">
                <h1 class="section-title">Our Collection</h1>
                <div class="toggle-container d-flex align-items-center gap-2">
                    looking for someone else
                    <button class="btn-yes">Yes</button>
                </div>
            </div>

            <div class="search-container">
                <form action="/shop" method="GET">
                    <input type="text" name="search" class="search-bar" placeholder="Search An Item"
                        value="<%= query.search %>">
                    <button type="submit" class="search-icon-btn"><i class="fa fa-search text-muted"></i></button>
                    <!-- Persist existing filters -->
                    <input type="hidden" name="sort" value="<%= query.sort %>">
                </form>
            </div>

            <div class="w-100 mb-5 overflow-hidden">
                <select class="btn-sort-black"
                    onchange="const p = new URLSearchParams(window.location.search); p.set('sort', this.value); window.location.href='/shop?'+p.toString();">
                    <option value="">Sort</option>
                    <option value="low-high" <%=query.sort==='low-high' ? 'selected' : '' %>>Price: Low-High</option>
                    <option value="high-low" <%=query.sort==='high-low' ? 'selected' : '' %>>Price: High-Low</option>
                </select>
            </div>

            <!-- Product Grid -->
            <div class="row g-4 mt-2">
                <% if(products.length> 0) { %>
                    <% products.forEach(product=> { %>
                        <!-- Inside the products.forEach loop -->
                        <div class="col-md-4">
                            <div class="product-card">
                                <!-- Dynamic Link to Detail Page -->
                                <a href="/productDetails?id=<%= product._id %>" class="text-decoration-none text-dark">
                                    <img src="/uploads/<%= product.productImage[0] %>" class="product-img" alt="<%= product.productName %>">
                                </a>
                        
                                <button class="wishlist-btn" onclick="addToWishlist('<%= product._id %>')">
                                    <i class="fa-regular fa-heart"></i>
                                </button>
                        
                                <div class="product-info">
                                    <div class="product-name">
                                        <%= product.productName %>
                                    </div>
                                    <div class="product-price">
                                        <% if (product.salePrice < product.regularPrice) { %>
                                            <!-- Show struck-through regular price only if there is a discount -->
                                            <span class="text-muted text-decoration-line-through me-2">₹100<%= product.regularPrice %></span>
                                            <b>₹<%= product.salePrice %></b>
                                            <% } else { %>
                                                <!-- Show only regular price if no sale price exists -->
                                                <b>₹<%= product.regularPrice %></b>
                                                <% } %>
                                    </div>
                                    <div class="rating">
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <span class="text-muted" style="font-size: 9px;">(4.0)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <div class="text-center p-5 w-100">
                                    <h4>No products found</h4>
                                </div>
                                <% } %>
            </div>

            <!-- Pagination -->
            <% if(totalPages> 1) { %>
                <div class="text-center mt-5">
                    <p class="small text-muted mb-3">Showing 1 - <%= products.length %> of Total items</p>
                    <div class="pagination justify-content-center gap-2">
                        <% for(let i=1; i <=totalPages; i++) { %>
                            <a href="/shop?page=<%= i %>&search=<%= query.search %>&sort=<%= query.sort %>&minPrice=<%= query.minPrice %>&maxPrice=<%= query.maxPrice %>"
                                class="btn btn-outline-dark btn-sm rounded-pill <%= currentPage === i ? 'active-page' : '' %>">
                                <%= i %>
                            </a>
                            <% } %>
                    </div>
                    <button class="load-more-btn mt-4">Load More <i
                            class="fa-solid fa-chevron-right ms-2 small"></i></button>
                </div>
                <% } %>
        </main>
    </div>

    <!-- Footer -->
    <footer>
        <div class="footer-logo"><img src="/images/logo.png" height="50"></div>
        <div class="row">
            <div class="col-md-3">
                <div class="footer-head">Support</div>
                <div class="footer-links">
                    <a href="#">Order Status</a>
                    <a href="#">Product Support</a>
                    <a href="#">Shipping & Return Policy</a>
                    <a href="#">Complaint Registration</a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="footer-head">About Us</div>
                <div class="footer-links">
                    <a href="#">Contact Us</a>
                    <a href="#">Privacy Policy</a>
                    <a href="#">Terms of use</a>
                    <a href="#">FAQ</a>
                </div>
            </div>
            <div class="col-md-3">
                <div class="footer-head">Contact</div>
                <p class="small mb-1">Email : onemore@gmail.com</p>
                <p class="small">Phone : +91 8888888888</p>
            </div>
            <div class="col-md-3 text-md-end">
                <div class="footer-head">Connect with us</div>
                <div class="social-icons">
                    <i class="fa-brands fa-instagram"></i>
                    <i class="fa-brands fa-facebook"></i>
                    <i class="fa-brands fa-x-twitter"></i>
                </div>
            </div>
        </div>
        <div class="text-center mt-5 pt-4 border-top border-secondary small opacity-50">
            © 2025 onemore. All Rights Reserved.
        </div>
    </footer>

</body>

</html>