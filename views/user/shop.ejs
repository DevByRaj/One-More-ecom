<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Our Collection | OneMore</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-dark: #121212;
            --text-muted: #888;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #fff;
            color: #333;
        }

        /* Navbar */
        nav {
            background-color: var(--bg-dark);
            padding: 15px 50px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-link {
            font-size: 13px;
            margin: 0 10px;
        }

        .nav-icons a {
            color: #fff;
            margin-left: 20px;
            font-size: 1.1rem;
        }

        /* Sidebar & Layout */
        .main-container {
            display: flex;
            padding: 40px 60px;
            gap: 20px;
        }

        .sidebar {
            width: 220px;
            flex-shrink: 0;
            border-right: 1px solid #eee;
            padding-right: 20px;
        }

        .filter-label {
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 15px;
            display: block;
        }

        .filter-section {
            border-bottom: 1px solid #f0f0f0;
            padding-bottom: 15px;
            margin-bottom: 15px;
        }

        .filter-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            text-transform: capitalize;
        }

        .price-inputs input {
            width: 60px;
            font-size: 10px;
            border-radius: 15px;
            border: 1px solid #000;
            text-align: center;
            padding: 2px;
        }

        /* Content Area */
        .content-area {
            flex: 1;
            padding-left: 20px;
        }

        .section-title {
            font-size: 24px;
            font-weight: 700;
        }

        /* Search & Sort UI */
        .search-container {
            position: relative;
            margin: 20px 0;
        }

        .search-bar {
            width: 100%;
            border-radius: 25px;
            border: 1px solid #ddd;
            padding: 10px 25px;
            font-size: 13px;
        }

        .search-icon-btn {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: #eee;
            border-radius: 50%;
            width: 30px;
            height: 30px;
        }

        .toggle-container {
            font-size: 12px;
            color: var(--text-muted);
        }

        .btn-yes {
            background: #000;
            color: #fff;
            border-radius: 20px;
            padding: 2px 25px;
            font-size: 12px;
            border: none;
        }

        .btn-sort-black {
            background: #000;
            color: #fff;
            border-radius: 8px;
            padding: 5px 30px;
            font-size: 13px;
            border: none;
            float: right;
        }

        /* Product Cards */
        .product-card {
            border: none;
            position: relative;
            margin-bottom: 30px;
        }

        .product-img {
            width: 100%;
            height: 320px;
            object-fit: cover;
            border-radius: 18px;
            display: block;
            background: #f5f5f5;
            transition: 0.3s ease;
        }

        .product-img:hover {
            transform: scale(1.02);
        }

        .product-card {
            position: relative;
        }

        .product-info {
            padding-top: 14px;
        }

        .product-name {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .product-price {
            margin-top: 4px;
            font-size: 18px;
        }

        .wishlist-btn {
            position: absolute;
            right: 10px;
            bottom: 80px;
            background: none;
            border: none;
            font-size: 1.1rem;
        }

        .product-info {
            padding: 12px 0;
        }

        .product-name {
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 2px;
        }

        .product-price {
            font-size: 12px;
            font-weight: 500;
        }

        .rating {
            color: #ffc107;
            font-size: 10px;
            margin-top: 4px;
        }

        /* Footer */
        footer {
            background: var(--bg-dark);
            color: #fff;
            padding: 60px 80px 20px;
            margin-top: 50px;
        }

        .footer-logo {
            font-size: 2rem;
            font-weight: 900;
            margin-bottom: 30px;
            text-align: center;
        }

        .footer-head {
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 20px;
        }

        .footer-links a {
            color: #fff;
            text-decoration: none;
            font-size: 12px;
            display: block;
            margin-bottom: 10px;
            opacity: 0.8;
        }

        .social-icons i {
            font-size: 1.5rem;
            margin-right: 15px;
            cursor: pointer;
        }

        .load-more-btn {
            background: #222;
            color: #fff;
            border-radius: 25px;
            padding: 10px 40px;
            font-size: 14px;
            border: none;
        }

        /* ── RESPONSIVE ─────────────────────────────────────────── */

        /* Sidebar toggle (mobile) */
        .sidebar-toggle {
            display: none;
            background: #000;
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 7px 18px;
            font-size: 13px;
            margin-bottom: 16px;
            cursor: pointer;
        }

        /* Tablet – 992px */
        @media (max-width: 992px) {
            nav {
                padding: 12px 20px;
            }

            .main-container {
                padding: 30px 24px;
                gap: 16px;
            }

            .sidebar {
                width: 180px;
            }

            .content-area {
                padding-left: 10px;
            }

            .product-img {
                height: 260px;
            }
        }

        /* Mobile – 768px */
        @media (max-width: 768px) {
            nav {
                padding: 10px 16px;
            }

            /* Stack sidebar above content */
            .main-container {
                flex-direction: column;
                padding: 20px 16px;
                gap: 0;
            }

            .sidebar {
                width: 100%;
                border-right: none;
                border-bottom: 1px solid #eee;
                padding-right: 0;
                padding-bottom: 16px;
                margin-bottom: 20px;
                /* Collapsed by default on mobile */
                overflow: hidden;
                max-height: 0;
                transition: max-height 0.35s ease;
            }

            .sidebar.open {
                max-height: 1000px;
            }

            .sidebar-toggle {
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

            .content-area {
                padding-left: 0;
            }

            .section-title {
                font-size: 20px;
            }

            /* Stack header row */
            .content-area>.d-flex.justify-content-between {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }

            .toggle-container {
                font-size: 11px;
            }

            .btn-sort-black {
                float: none;
                width: 100%;
                text-align: left;
            }

            /* Product images a bit shorter */
            .product-img {
                height: 220px;
            }

            .product-name {
                font-size: 13px;
            }

            .product-price {
                font-size: 13px;
            }

            /* Footer */
            footer {
                padding: 40px 24px 20px;
            }

            .footer-logo {
                margin-bottom: 20px;
            }

            .social-icons {
                margin-top: 16px;
            }

            .text-md-end {
                text-align: left !important;
            }
        }

        /* Small phones – 480px */
        @media (max-width: 480px) {
            .main-container {
                padding: 16px 12px;
            }

            .section-title {
                font-size: 18px;
            }

            .product-img {
                height: 190px;
                border-radius: 12px;
            }

            .wishlist-btn {
                bottom: 70px;
                font-size: 1rem;
            }

            footer {
                padding: 30px 16px 16px;
            }

            .load-more-btn {
                width: 100%;
            }

            /* Pagination wraps neatly */
            .pagination {
                flex-wrap: wrap;
            }
        }

        /* Navbar toggler icon color fix */
        .navbar-toggler-icon {
            filter: invert(1);
        }
    </style>
</head>

<body>

    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/"><img src="/images/logo.png" height="40"></a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link text-white" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="/shop">Shop</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="/contact">Contact Us</a></li>
                    <li class="nav-item"><a class="nav-link text-white" href="/about">About Us</a></li>
                </ul>
                <!-- Icons inside collapsed menu on mobile -->
                <div class="nav-icons d-flex align-items-center ms-lg-auto mt-2 mt-lg-0">
                    <a href="/profile"><i class="fa-regular fa-user"></i></a>
                    <a href="/wishlist"><i class="fa-regular fa-heart"></i></a>
                    <a href="/cart"><i class="fa-solid fa-cart-shopping"></i></a>
                </div>
            </div>
        </div>
    </nav>

    <div class="main-container">

        <!-- Mobile filter toggle -->
        <button class="sidebar-toggle" onclick="toggleSidebar()" id="filterToggleBtn">
            <i class="fa-solid fa-sliders"></i> Filters
        </button>

        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <span class="filter-label">Filter :</span>

            <form action="/shop" method="GET" id="filterForm">
                <div class="filter-section">
                    <div class="filter-header">Category <i class="fa-solid fa-chevron-down small"></i></div>
                </div>
                <div class="filter-section">
                    <div class="filter-header">Brand <i class="fa-solid fa-chevron-down small"></i></div>
                </div>
                <div class="filter-section">
                    <div class="filter-header">Price <i class="fa-solid fa-chevron-up small"></i></div>
                    <div class="price-inputs d-flex align-items-center gap-2 mt-3 justify-content-center">
                        <input type="number" name="minPrice" placeholder="Min" value="<%= query.minPrice %>">
                        <div style="width: 20px; height: 1px; background: #000;"></div>
                        <input type="number" name="maxPrice" placeholder="Max" value="<%= query.maxPrice %>">
                    </div>
                    <button type="submit" class="btn btn-dark btn-sm w-100 mt-2 rounded-pill"
                        style="font-size: 10px;">Apply</button>
                </div>
                <div class="filter-section">
                    <div class="filter-header">Color <i class="fa-solid fa-chevron-down small"></i></div>
                </div>
                <div class="filter-section">
                    <div class="filter-header">Audio Playtime <i class="fa-solid fa-chevron-down small"></i></div>
                </div>
            </form>
        </aside>

        <!-- Main Content -->
        <main class="content-area">
            <div class="d-flex justify-content-between align-items-end">
                <h1 class="section-title">Our Collection</h1>
                <div class="toggle-container d-flex align-items-center gap-2">
                    looking for someone else
                    <button class="btn-yes">Yes</button>
                </div>
            </div>

            <div class="search-container">
                <form action="/shop" method="GET">
                    <input type="text" name="search" class="search-bar" placeholder="Search An Item"
                        value="<%= query.search %>">
                    <button type="submit" class="search-icon-btn">
                        <i class="fa fa-search text-muted"></i>
                    </button>
                    <!-- Persist existing filters -->
                    <input type="hidden" name="sort" value="<%= query.sort %>">
                    <% if(query.search){ %>
                        <a href="/shop" class="btn btn-sm btn-outline-dark rounded-pill mt-2">
                            Clear
                        </a>
                        <% } %>
                </form>
            </div>

            <div class="w-100 mb-5 overflow-hidden">
                <select class="btn-sort-black"
                    onchange="const p = new URLSearchParams(window.location.search); p.set('sort', this.value); window.location.href='/shop?'+p.toString();">
                    <option value="">Sort</option>
                    <option value="low-high" <%=query.sort==='low-high' ? 'selected' : '' %>>Price: Low-High</option>
                    <option value="high-low" <%=query.sort==='high-low' ? 'selected' : '' %>>Price: High-Low</option>
                </select>
            </div>

            <!-- Product Grid -->
            <div class="row g-4 mt-2">
                <% if(products.length> 0) { %>
                    <% products.forEach(product=> { %>
                        <div class="col-xl-4 col-lg-4 col-md-6 col-sm-6 col-6 mb-5">
                            <div class="product-card">
                                <a href="/productDetails?id=<%= product._id %>" class="text-decoration-none text-dark">
                                    <img src="<%= product.productImage[0] %>" class="product-img"
                                        alt="<%= product.productName %>">
                                </a>

                                <button class="wishlist-btn" onclick="addToWishlist('<%= product._id %>')">
                                    <i class="fa-regular fa-heart"></i>
                                </button>

                                <div class="product-info">
                                    <div class="text-muted small mb-1">
                                        <%= product.brand.name || "Brand" %>
                                    </div>
                                    <div class="product-name">
                                        <%= product.productName %>
                                    </div>
                                    <div class="product-price mt-1">
                                        <% if(product.variant){ %>
                                            <% if(product.variant.salePrice < product.variant.regularPrice){ %>
                                                <span class="text-muted text-decoration-line-through me-2 small">
                                                    ₹<%= product.variant.regularPrice %>
                                                </span>
                                                <span class="fw-bold text-dark">
                                                    ₹<%= product.variant.salePrice %>
                                                </span>
                                                <% } else { %>
                                                    <span class="fw-bold text-dark">
                                                        ₹<%= product.variant.salePrice %>
                                                    </span>
                                                    <% } %>
                                                        <% } %>
                                    </div>
                                    <div class="rating">
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <i class="fa-solid fa-star"></i>
                                        <span class="text-muted" style="font-size: 9px;">(4.0)</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <div class="text-center p-5 w-100">
                                    <h4>No products found</h4>
                                </div>
                                <% } %>
            </div>

            <!-- Pagination -->
            <% if(totalPages> 1) { %>
                <div class="text-center mt-5">
                    <p class="small text-muted mb-3">Showing 1 - <%= products.length %> of Total items</p>
                    <div class="pagination justify-content-center gap-2">
                        <% for(let i=1; i <=totalPages; i++) { %>
                            <a href="/shop?page=<%= i %>&search=<%= query.search %>&sort=<%= query.sort %>&minPrice=<%= query.minPrice %>&maxPrice=<%= query.maxPrice %>"
                                class="btn btn-outline-dark btn-sm rounded-pill <%= currentPage === i ? 'active-page' : '' %>">
                                <%= i %>
                            </a>
                            <% } %>
                    </div>
                    <button class="load-more-btn mt-4">Load More <i
                            class="fa-solid fa-chevron-right ms-2 small"></i></button>
                </div>
                <% } %>
        </main>
    </div>

    <!-- Footer -->
    <footer>
        <div class="footer-logo"><img src="/images/logo.png" height="50"></div>
        <div class="row">
            <div class="col-md-3 col-6 mb-4">
                <div class="footer-head">Support</div>
                <div class="footer-links">
                    <a href="#">Order Status</a>
                    <a href="#">Product Support</a>
                    <a href="#">Shipping & Return Policy</a>
                    <a href="#">Complaint Registration</a>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-4">
                <div class="footer-head">About Us</div>
                <div class="footer-links">
                    <a href="#">Contact Us</a>
                    <a href="#">Privacy Policy</a>
                    <a href="#">Terms of use</a>
                    <a href="#">FAQ</a>
                </div>
            </div>
            <div class="col-md-3 col-6 mb-4">
                <div class="footer-head">Contact</div>
                <p class="small mb-1">Email : onemore@gmail.com</p>
                <p class="small">Phone : +91 8888888888</p>
            </div>
            <div class="col-md-3 col-6 mb-4 text-md-end">
                <div class="footer-head">Connect with us</div>
                <div class="social-icons">
                    <i class="fa-brands fa-instagram"></i>
                    <i class="fa-brands fa-facebook"></i>
                    <i class="fa-brands fa-x-twitter"></i>
                </div>
            </div>
        </div>
        <div class="text-center mt-5 pt-4 border-top border-secondary small opacity-50">
            © 2025 onemore. All Rights Reserved.
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const btn = document.getElementById('filterToggleBtn');
            sidebar.classList.toggle('open');
            btn.innerHTML = sidebar.classList.contains('open')
                ? '<i class="fa-solid fa-xmark"></i> Close Filters'
                : '<i class="fa-solid fa-sliders"></i> Filters';
        }
    </script>

</body>

</html>