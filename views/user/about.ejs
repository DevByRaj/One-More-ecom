<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>About Us | OneMore Audio</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;500;600;700&display=swap"
        rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-dark: #121212;
            --text-muted: #aaaaaa;
            --accent: #ffdc60;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #ffffff;
            color: #333;
            margin: 0;
        }


        /* ==================== NAVBAR ==================== */

        .navbar {
            background-color: var(--bg-dark);
            padding: 15px 50px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .logo-img {
            height: 60px;
            width: auto;
            object-fit: contain;
        }

        .nav-link {
            font-weight: 400;
            font-size: 0.85rem;
            color: #ffffff !important;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            padding: 0 15px !important;
            transition: opacity 0.3s ease;
        }

        .nav-link:hover {
            opacity: 0.7;
        }

        .nav-icons a {
            color: #fff;
            margin-left: 20px;
            font-size: 1.1rem;
        }

        .nav-icons i {
            transition: transform 0.2s ease;
        }

        .nav-icons i:hover {
            transform: scale(1.1);
        }


        /* ==================== ABOUT HERO ==================== */

        .about-hero {
            background-color: var(--bg-dark);
            color: #ffffff;
            padding: 90px 30px;
            text-align: center;
        }

        .about-hero h1 {
            font-size: 2.8rem;
            font-weight: 700;
            letter-spacing: 4px;
            margin-bottom: 15px;
        }

        .about-hero p {
            color: #cccccc;
            font-size: 0.95rem;
            letter-spacing: 1px;
            max-width: 700px;
            margin: auto;
            line-height: 1.8;
        }


        /* ==================== OUR STORY ==================== */

        .about-section {
            padding: 90px 80px;
        }

        .about-image {
            width: 100%;
            height: 430px;
            object-fit: cover;
            border-radius: 18px;
        }

        .about-content {
            padding-left: 35px;
        }

        .section-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #777;
            margin-bottom: 12px;
        }

        .section-title {
            font-size: 2rem;
            font-weight: 700;
            color: #121212;
            margin-bottom: 20px;
        }

        .about-content p {
            color: #777;
            font-size: 0.9rem;
            line-height: 1.9;
            margin-bottom: 15px;
        }


        /* ==================== MISSION ==================== */

        .mission-section {
            background-color: #f7f7f7;
            padding: 80px;
            text-align: center;
        }

        .mission-section h2 {
            font-size: 1.9rem;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .mission-section>p {
            max-width: 750px;
            margin: auto;
            color: #777;
            font-size: 0.9rem;
            line-height: 1.9;
        }


        /* ==================== VALUES ==================== */

        .values-section {
            padding: 90px 80px;
        }

        .value-card {
            background: #ffffff;
            border-radius: 16px;
            padding: 35px 25px;
            text-align: center;
            height: 100%;
            border: 1px solid #eeeeee;
            transition: transform 0.35s ease,
                box-shadow 0.35s ease;
        }

        .value-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
        }

        .value-icon {
            width: 60px;
            height: 60px;
            background-color: #f4f4f4;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            transition: all 0.3s ease;
        }

        .value-icon i {
            font-size: 1.2rem;
            color: #121212;
        }

        .value-card:hover .value-icon {
            background-color: #121212;
        }

        .value-card:hover .value-icon i {
            color: #ffffff;
        }

        .value-card h5 {
            font-size: 1rem;
            font-weight: 600;
            margin-bottom: 12px;
        }

        .value-card p {
            color: #777;
            font-size: 0.82rem;
            line-height: 1.7;
            margin: 0;
        }


        /* ==================== AUDIO SECTION ==================== */

        .audio-section {
            background-color: #121212;
            color: #ffffff;
            padding: 90px 80px;
        }

        .audio-section h2 {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .audio-section p {
            color: #aaaaaa;
            font-size: 0.9rem;
            line-height: 1.9;
            max-width: 700px;
        }

        .audio-highlight {
            margin-top: 35px;
        }

        .audio-highlight span {
            display: inline-block;
            border: 1px solid #333;
            border-radius: 30px;
            padding: 10px 18px;
            margin: 5px;
            font-size: 0.75rem;
            color: #dddddd;
            letter-spacing: 0.5px;
        }


        /* ==================== FOOTER ==================== */

        footer {
            background-color: var(--bg-dark);
            color: #fff;
            padding: 80px 80px 30px;
        }

        .footer-logo-container {
            margin-bottom: 65px;
        }

        .footer-heading {
            font-size: 1rem;
            font-weight: 700;
            margin-bottom: 25px;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--accent);
        }

        .footer-links li {
            margin-bottom: 12px;
        }

        .footer-links a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 0.85rem;
            transition: color 0.2s;
        }

        .footer-links a:hover {
            color: #fff;
        }

        .social-icons i {
            font-size: 1.3rem;
            margin-right: 20px;
            color: var(--text-muted);
            transition: color 0.3s;
        }

        .social-icons i:hover {
            color: #fff;
        }

        .copyright {
            border-top: 1px solid #2a2a2a;
            margin-top: 60px;
            padding-top: 30px;
            font-size: 0.75rem;
            color: #555;
        }


        /* ==================== MOBILE ==================== */

        @media (max-width: 768px) {

            .navbar {
                padding: 15px 20px;
            }

            .logo-img {
                height: 45px;
            }

            .about-hero {
                padding: 70px 20px;
            }

            .about-hero h1 {
                font-size: 2rem;
            }

            .about-section {
                padding: 55px 20px;
            }

            .about-image {
                height: 300px;
                margin-bottom: 35px;
            }

            .about-content {
                padding-left: 0;
            }

            .mission-section {
                padding: 60px 20px;
            }

            .values-section {
                padding: 60px 20px;
            }

            .audio-section {
                padding: 60px 20px;
            }

            footer {
                padding: 60px 25px 25px;
            }
        }
    </style>

</head>


<body>


